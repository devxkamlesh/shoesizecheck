---
// Footer.astro — Redesigned modern multi-column footer with company links, status badge & disclaimer
---

<footer class="site-footer" id="site-footer">
  <div class="footer-inner">

    <!-- Top Section: Brand & Multi-Column Navigation -->
    <div class="footer-grid">

      <!-- Column 1: Brand & Mission -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo" aria-label="AllShoeSizeConverter Home">
          <div class="footer-logo-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 16v-2.38C4 11.5 2.97 10.5 3 8c.03-2.72 1.49-6 4.5-6C9.37 2 10 3.8 10 5.5c0 3.11-2 5.66-2 8.68V16a2 2 0 1 1-4 0Z"/>
              <path d="M20 20v-2.38c0-2.12 1.03-3.12 1-5.62-.03-2.72-1.49-6-4.5-6C14.63 6 14 7.8 14 9.5c0 3.11 2 5.66 2 8.68V20a2 2 0 1 0 4 0Z"/>
              <path d="M16 17h4"/>
              <path d="M4 13h4"/>
            </svg>
          </div>
          <span class="footer-wordmark">AllShoeSizeConverter</span>
        </a>

        <p class="footer-tagline">
          The definitive global footwear sizing platform. Providing mathematically verified conversion algorithms, age-growth milestone charts, and brand fit guidelines across all international standards.
        </p>

        <div class="footer-status-badge">
          <span class="status-dot"></span>
          <span class="status-text">Online Sizing Engine • Free &amp; Private</span>
        </div>
      </div>

      <!-- Column 2: Regional Standards -->
      <div class="footer-col">
        <h3 class="footer-heading">Regional Standards</h3>
        <ul class="footer-links">
          <li><a href="/country/">All Countries</a></li>
          <li><a href="/country/us/">United States</a></li>
          <li><a href="/country/uk/">United Kingdom</a></li>
          <li><a href="/country/europe/">European Union</a></li>
          <li><a href="/country/india/">India (BIS Bha)</a></li>
          <li><a href="/country/japan/">Japan (CM)</a></li>
          <li><a href="/country/australia/">Australia</a></li>
          <li><a href="/country/mexico/">Mexico</a></li>
        </ul>
      </div>

      <!-- Column 3: Sizing Tools -->
      <div class="footer-col">
        <h3 class="footer-heading">Specialty Tools</h3>
        <ul class="footer-links">
          <li><a href="/kids-shoe-size-by-age/">Kids Size by Age</a></li>
          <li><a href="/mondopoint-shoe-size/">Mondopoint Ski Boots</a></li>
          <li><a href="/shoe-size-by-foot-length/">Size by Foot Length</a></li>
          <li><a href="/shoe-size-in-cm/">Shoe Size in CM</a></li>
          <li><a href="/what-is-my-shoe-size/">Find My Shoe Size</a></li>
          <li><a href="/shoe-size-in-inches/">Size in Inches</a></li>
        </ul>
      </div>

      <!-- Column 4: Top Conversions -->
      <div class="footer-col">
        <h3 class="footer-heading">Quick Conversions</h3>
        <ul class="footer-links">
          <li><a href="/converters/">All Converters</a></li>
          <li><a href="/us-to-eu-shoe-size/">US to EU Sizing</a></li>
          <li><a href="/us-to-uk-shoe-size/">US to UK Sizing</a></li>
          <li><a href="/us-to-india-shoe-size/">US to India Sizing</a></li>
          <li><a href="/eu-to-us-shoe-size/">EU to US Sizing</a></li>
          <li><a href="/uk-to-us-shoe-size/">UK to US Sizing</a></li>
          <li><a href="/india-to-us-shoe-size/">India to US Sizing</a></li>
          <li><a href="/eu-to-cm-shoe-size/">EU to CM Sizing</a></li>
          <li><a href="/us-to-cm-shoe-size/">US to CM Sizing</a></li>
        </ul>
      </div>


      <!-- Column 5: Company & Legal -->
      <div class="footer-col">
        <h3 class="footer-heading">Company &amp; Legal</h3>
        <ul class="footer-links">
          <li><a href="/about/">About Us</a></li>
          <li><a href="/contact/">Contact Us</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms &amp; Conditions</a></li>
          <li><a href="/.well-known/api-catalog">API Catalog (RFC 9727)</a></li>
          <li><a href="/llms.txt">LLM Information</a></li>
        </ul>
      </div>

    </div>

    <!-- Middle Divider -->
    <div class="footer-divider"></div>

    <!-- Bottom Section: Disclaimers, Copyright & Back to Top -->
    <div class="footer-bottom">
      <div class="footer-disclaimer-wrap">
        <p class="footer-disclaimer">
          <strong>Disclaimer:</strong> AllShoeSizeConverter provides conversion guides based on standard ISO, Brannock, Paris Point, and Barleycorn calculations. Because individual shoe lasts, brand silhouettes, and manufacturing tolerances vary, always verify with brand-specific sizing charts prior to ordering footwear.
        </p>
        <p class="footer-copy">
          &copy; {new Date().getFullYear()} AllShoeSizeConverter. All rights reserved. Made with precision for global online shoppers.
        </p>
      </div>

      <button id="back-to-top" class="back-to-top-btn" aria-label="Scroll back to top of page" title="Back to top">
        <span>Top</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5M5 12l7-7 7 7"/>
        </svg>
      </button>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background: var(--v-canvas);
    border-top: 1px solid var(--v-hairline);
    padding: 64px 24px 36px;
    position: relative;
  }
  .footer-inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  /* Grid layout */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    gap: 40px;
  }

  /* Brand Column */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--v-ink);
  }
  .footer-logo-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--v-elevated), var(--v-hairline-soft));
    border: 1px solid var(--v-hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--v-link);
    box-shadow: var(--v-shadow-whisper);
  }
  .footer-wordmark {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.02em;
    color: var(--v-ink);
  }
  .footer-tagline {
    font-size: 13.5px;
    color: var(--v-body);
    line-height: 22px;
    margin: 0;
    max-width: 300px;
  }

  .footer-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: var(--v-r-full);
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    width: fit-content;
    margin-top: 4px;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }
  .status-text {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--v-ink);
    letter-spacing: 0.02em;
  }

  /* Link Columns */
  .footer-col {
    display: flex;
    flex-direction: column;
  }
  .footer-heading {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--v-ink);
    margin: 0 0 16px;
  }
  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-links li a {
    font-size: 13.5px;
    color: var(--v-body);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .footer-links li a:hover {
    color: var(--v-link);
    transform: translateX(2px);
  }
  .flag {
    font-size: 14px;
  }

  /* Divider */
  .footer-divider {
    height: 1px;
    background: var(--v-hairline);
    margin: 44px 0 28px;
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .footer-disclaimer-wrap {
    max-width: 860px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-disclaimer {
    font-size: 12px;
    color: var(--v-mute);
    line-height: 18px;
    margin: 0;
  }
  .footer-copy {
    font-size: 12.5px;
    color: var(--v-body);
    margin: 0;
  }

  /* Back to Top */
  .back-to-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--v-body);
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .back-to-top-btn:hover {
    color: var(--v-ink);
    border-color: var(--v-link);
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 36px;
    }
    .footer-brand-col {
      grid-column: span 3;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .footer-brand-col {
      grid-column: span 2;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  const backToTopBtn = document.getElementById('back-to-top');
  backToTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
