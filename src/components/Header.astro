---
// Header.astro — Redesigned modern navigation bar with glassmorphism & accessible drawer
---

<header class="nav-bar" id="site-header">
  <div class="nav-inner">

    <!-- Logo with modern gradient badge -->
    <a href="/" class="nav-logo" aria-label="AllShoeSizeConverter Home">
      <div class="nav-logo-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 16v-2.38C4 11.5 2.97 10.5 3 8c.03-2.72 1.49-6 4.5-6C9.37 2 10 3.8 10 5.5c0 3.11-2 5.66-2 8.68V16a2 2 0 1 1-4 0Z"/>
          <path d="M20 20v-2.38c0-2.12 1.03-3.12 1-5.62-.03-2.72-1.49-6-4.5-6C14.63 6 14 7.8 14 9.5c0 3.11 2 5.66 2 8.68V20a2 2 0 1 0 4 0Z"/>
          <path d="M16 17h4"/>
          <path d="M4 13h4"/>
        </svg>
      </div>
      <div class="nav-logo-text">
        <span class="nav-wordmark">AllShoeSizeConverter</span>
        <span class="nav-tag">GLOBAL</span>
      </div>
    </a>

    <!-- Desktop nav links -->
    <nav class="nav-links" aria-label="Main navigation">
      <a href="/country/us/" class="nav-link">US Sizes</a>
      <a href="/country/uk/" class="nav-link">UK Sizes</a>
      <a href="/country/europe/" class="nav-link">EU Sizes</a>
      <a href="/country/india/" class="nav-link">India Sizes</a>
      <a href="/kids-shoe-size-by-age/" class="nav-link">Kids by Age</a>
      <a href="/mondopoint-shoe-size/" class="nav-link">Ski / Mondo</a>
      <a href="/about/" class="nav-link">About</a>
    </nav>

    <!-- Desktop CTA & Theme Toggle -->
    <div class="nav-actions">
      <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle dark mode" title="Toggle theme">
        <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>

      <a href="/#converter" class="btn-convert-header">
        <span>Convert</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Mobile menu trigger -->
    <button class="nav-menu-btn" id="nav-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="hamburger-bar bar-top"></span>
      <span class="hamburger-bar bar-mid"></span>
      <span class="hamburger-bar bar-bot"></span>
    </button>

  </div>

  <!-- Mobile menu drawer -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert>
    <div class="mobile-menu-inner">
      <nav class="mobile-nav" aria-label="Mobile navigation">

        <!-- Section 1: Countries -->
        <div class="mobile-group">
          <span class="mobile-group-title">Regional Sizing Standards</span>
          <div class="mobile-grid-links">
            <a href="/country/us/" class="mobile-link"><span class="link-flag">🇺🇸</span> US Sizing</a>
            <a href="/country/uk/" class="mobile-link"><span class="link-flag">🇬🇧</span> UK Sizing</a>
            <a href="/country/europe/" class="mobile-link"><span class="link-flag">🇪🇺</span> EU Sizing</a>
            <a href="/country/india/" class="mobile-link"><span class="link-flag">🇮🇳</span> India Sizing</a>
            <a href="/country/japan/" class="mobile-link"><span class="link-flag">🇯🇵</span> Japan Sizing</a>
            <a href="/country/australia/" class="mobile-link"><span class="link-flag">🇦🇺</span> Australia</a>
          </div>
        </div>

        <!-- Section 2: Tools & Calculators -->
        <div class="mobile-group">
          <span class="mobile-group-title">Specialty Calculators</span>
          <a href="/kids-shoe-size-by-age/" class="mobile-link">👶 Kids &amp; Toddler by Age</a>
          <a href="/mondopoint-shoe-size/" class="mobile-link">⛷️ Mondopoint Ski Boots</a>
          <a href="/shoe-size-by-foot-length/" class="mobile-link">📏 Sizing by Foot Length</a>
          <a href="/shoe-size-in-cm/" class="mobile-link">📐 Shoe Size in CM</a>
          <a href="/what-is-my-shoe-size/" class="mobile-link">🔍 Find My True Size</a>
        </div>

        <!-- Section 3: Company & Information -->
        <div class="mobile-group">
          <span class="mobile-group-title">Company &amp; Legal</span>
          <div class="mobile-grid-links">
            <a href="/about/" class="mobile-link">About Us</a>
            <a href="/contact/" class="mobile-link">Contact Us</a>
            <a href="/privacy-policy/" class="mobile-link">Privacy Policy</a>
            <a href="/terms/" class="mobile-link">Terms of Service</a>
          </div>
        </div>

        <!-- Section 4: Theme switcher -->
        <div class="mobile-theme-row">
          <span class="mobile-theme-label">Visual Theme</span>
          <button id="mobile-theme-toggle" class="mobile-theme-btn" aria-label="Toggle theme">
            <svg class="sun-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
            </svg>
            <svg class="moon-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
            <span class="light-text">Light Mode</span>
            <span class="dark-text">Dark Mode</span>
          </button>
        </div>

        <div class="mobile-actions">
          <a href="/#converter" class="btn-primary mobile-cta">Open Sizing Engine</a>
        </div>

      </nav>
    </div>
  </div>
</header>

<style>
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .nav-inner {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    height: 56px;
  }

  /* Logo styling */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--v-ink);
    flex-shrink: 0;
  }
  .nav-logo-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--v-elevated), var(--v-hairline-soft));
    border: 1px solid var(--v-hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--v-link);
    box-shadow: var(--v-shadow-whisper);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .nav-logo:hover .nav-logo-icon {
    transform: scale(1.05);
    border-color: var(--v-link);
  }
  .nav-logo-text {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-wordmark {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.02em;
    color: var(--v-ink);
  }
  .nav-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: var(--v-r-full);
    background: var(--v-hairline-soft);
    color: var(--v-link);
    border: 1px solid var(--v-hairline);
  }

  /* Desktop links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .nav-link {
    padding: 6px 12px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--v-body);
    text-decoration: none;
    border-radius: var(--v-r-full);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover {
    color: var(--v-ink);
    background: var(--v-hairline-soft);
  }

  /* Desktop actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .theme-toggle-btn {
    width: 34px;
    height: 34px;
    border-radius: var(--v-r-full);
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    color: var(--v-body);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .theme-toggle-btn:hover {
    color: var(--v-ink);
    border-color: var(--v-body);
  }

  .sun-icon { display: block; }
  .moon-icon { display: none; }
  :global(html.dark) .sun-icon { display: none; }
  :global(html.dark) .moon-icon { display: block; }

  .btn-convert-header {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
    background: var(--v-link);
    text-decoration: none;
    border-radius: var(--v-r-full);
    box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25);
    transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  .btn-convert-header:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
  }
  .btn-convert-header svg {
    transition: transform 0.15s ease;
  }
  .btn-convert-header:hover svg {
    transform: translateX(2px);
  }

  /* Mobile menu button */
  .nav-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    width: 36px;
    height: 36px;
    gap: 4.5px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-sm);
    cursor: pointer;
    padding: 0;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .hamburger-bar {
    width: 16px;
    height: 1.8px;
    background-color: var(--v-ink);
    border-radius: 2px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    transform-origin: center;
  }
  .nav-menu-btn[aria-expanded="true"] .bar-top {
    transform: translateY(6.3px) rotate(45deg);
  }
  .nav-menu-btn[aria-expanded="true"] .bar-mid {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-menu-btn[aria-expanded="true"] .bar-bot {
    transform: translateY(-6.3px) rotate(-45deg);
  }

  /* Mobile menu drawer */
  .mobile-menu {
    background: var(--v-elevated);
    border-bottom: 1px solid var(--v-hairline);
    max-height: 0;
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.25s ease,
                visibility 0.35s ease,
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                padding 0.35s ease;
    padding: 0 24px;
    pointer-events: none;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  }
  .mobile-menu.open {
    visibility: visible;
    max-height: 85vh;
    opacity: 1;
    transform: translateY(0);
    padding: 20px 24px 28px;
    pointer-events: auto;
  }
  .mobile-menu-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .mobile-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-group-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--v-mute);
    margin-bottom: 6px;
  }
  .mobile-grid-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .mobile-link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--v-body);
    text-decoration: none;
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-sm);
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .mobile-link:hover {
    color: var(--v-ink);
    border-color: var(--v-link);
    transform: translateX(2px);
  }
  .link-flag {
    font-size: 14px;
  }

  /* Mobile theme row */
  .mobile-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-sm);
  }
  .mobile-theme-label {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--v-ink);
  }
  .mobile-theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--v-ink);
    cursor: pointer;
  }
  .light-text { display: inline; }
  .dark-text { display: none; }
  :global(html.dark) .light-text { display: none; }
  :global(html.dark) .dark-text { display: inline; }

  .mobile-actions {
    margin-top: 4px;
  }
  .mobile-cta {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 12px;
    font-size: 14px;
    font-weight: 600;
    border-radius: var(--v-r-sm);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .btn-convert-header { display: none; }
    .nav-menu-btn { display: flex; }
  }
</style>

<script>
  // Mobile Menu Logic
  const btn = document.getElementById('nav-menu-btn');
  const menu = document.getElementById('mobile-menu');

  function openMenu() {
    btn?.setAttribute('aria-expanded', 'true');
    menu?.classList.add('open');
    menu?.setAttribute('aria-hidden', 'false');
    menu?.removeAttribute('inert');
  }

  function closeMenu() {
    btn?.setAttribute('aria-expanded', 'false');
    menu?.classList.remove('open');
    menu?.setAttribute('aria-hidden', 'true');
    menu?.setAttribute('inert', '');
  }

  btn?.addEventListener('click', () => {
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close menu when clicking any mobile link
  document.querySelectorAll('.mobile-link, .mobile-cta').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      btn?.focus();
    }
  });

  // Theme Toggle Logic
  const toggleBtn = document.getElementById('theme-toggle');
  const mobileToggleBtn = document.getElementById('mobile-theme-toggle');

  function toggleTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      document.documentElement.classList.add('light');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      document.documentElement.classList.remove('light');
      localStorage.setItem('theme', 'dark');
    }
  }

  toggleBtn?.addEventListener('click', toggleTheme);
  mobileToggleBtn?.addEventListener('click', toggleTheme);
</script>
