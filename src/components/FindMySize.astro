---
// FindMySize.astro: Foot length calculator, Geist design
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, SIZE_DATA } from '../data/shoe-sizes';

const quickRefRows = [
  { cm: 23, in: '9.1"', usM: 5, usW: 6.0, eu: 36.5, india: 4.0 },
  { cm: 24, in: '9.4"', usM: 6, usW: 7.0, eu: 38.5, india: 5.5 },
  { cm: 25, in: '9.8"', usM: 7, usW: 8.0, eu: 40.0, india: 6.5 },
  { cm: 26, in: '10.2"', usM: 8, usW: 9.0, eu: 41.0, india: 7.5 },
  { cm: 26.5, in: '10.4"', usM: 8.5, usW: 9.5, eu: 41.5, india: 8.0 },
  { cm: 27, in: '10.6"', usM: 9, usW: 10.0, eu: 42.0, india: 8.5 },
  { cm: 28, in: '11.0"', usM: 10, usW: 11.0, eu: 44.0, india: 9.5 },
  { cm: 29, in: '11.4"', usM: 11, usW: '-', eu: 45.0, india: 10.5 },
  { cm: 30, in: '11.8"', usM: 12, usW: '-', eu: 46.0, india: 11.5 },
];

const serializedSizeData = JSON.stringify(SIZE_DATA);
---

<section id="find-my-size" class="fms-section">
  <div class="fms-container">
    <div class="fms-grid">

      <!-- Left: Tool -->
      <div class="fms-tool">
        <p class="mono-eyebrow">Find my shoe size</p>
        <h2 class="heading-lg">Find your size by foot length</h2>
        <p class="fms-sub body-lg">Enter your foot length in centimeters or inches to see your shoe size in every system.</p>

        <div class="card-elevated fms-card">
          <div class="fms-inputs">
            <div class="fms-input-group fms-length-group">
              <label class="step-label" for="fms-length">
                <span class="step-num">1</span> Foot length
              </label>
              <div class="fms-length-row">
                <input type="number" id="fms-length" class="form-input fms-number" placeholder="e.g. 27" min="15" max="36" step="0.5" aria-label="Foot length measurement"/>
                <select id="fms-unit" class="form-select fms-unit-select" aria-label="Unit of measurement">
                  <option value="cm" selected>CM</option>
                  <option value="inches">Inches</option>
                </select>
              </div>
              <p class="fms-hint body-sm">Measure heel to longest toe on flat ground</p>
            </div>
            <div class="fms-input-group">
              <label class="step-label" for="fms-gender">
                <span class="step-num">2</span> Gender
              </label>
              <select id="fms-gender" class="form-select" aria-label="Gender for shoe sizing">
                <option value="men">Men</option>
                <option value="women">Women</option>
                <option value="kids">Kids</option>
              </select>
            </div>
          </div>

          <div id="fms-results" class="fms-results" aria-live="polite">
            <p class="fms-placeholder">Enter your foot length above to see results</p>
          </div>

          <div class="fms-width-note" id="fms-width-note" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>These are approximate sizes based on foot length. Wide feet may need to size up by half a size.</span>
          </div>
        </div>

        <!-- Reference table -->
        <div class="card fms-ref">
          <p class="mono-eyebrow" style="margin-bottom:12px">Quick reference</p>
          <div class="fms-ref-grid">
            <div class="fms-ref-row fms-ref-header">
              <span>cm</span><span>in</span><span>US M</span><span>US W</span><span>EU</span><span>India</span>
            </div>
            {quickRefRows.map(r => (
              <div class="fms-ref-row">
                <span>{r.cm}</span>
                <span>{r.in}</span>
                <span>{r.usM}</span>
                <span>{r.usW}</span>
                <span>{r.eu}</span>
                <span>{r.india}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Guide -->
      <div class="fms-guide card">
        <p class="mono-eyebrow" style="margin-bottom:16px">How to measure</p>
        <ol class="fms-steps">
          <li class="fms-step"><div class="fms-step-num">1</div><div class="fms-step-body"><strong>Prepare</strong><span>Place paper on a hard floor against a wall</span></div></li>
          <li class="fms-step"><div class="fms-step-num">2</div><div class="fms-step-body"><strong>Stand naturally</strong><span>Heel touching wall, weight even</span></div></li>
          <li class="fms-step"><div class="fms-step-num">3</div><div class="fms-step-body"><strong>Mark longest toe</strong><span>Pencil mark at the tip</span></div></li>
          <li class="fms-step"><div class="fms-step-num">4</div><div class="fms-step-body"><strong>Measure</strong><span>Wall edge to mark in cm or inches</span></div></li>
          <li class="fms-step"><div class="fms-step-num">5</div><div class="fms-step-body"><strong>Both feet</strong><span>Use the larger measurement</span></div></li>
          <li class="fms-step"><div class="fms-step-num">6</div><div class="fms-step-body"><strong>Afternoon</strong><span>Feet expand slightly during the day. Measure later in the afternoon.</span></div></li>
        </ol>
        <a href="/shoe-size-by-foot-length/" class="btn-ghost fms-more-link">
          Full guide
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .fms-section { padding: 96px 24px; background: var(--v-canvas); border-top: 1px solid var(--v-hairline); }
  .fms-container { max-width: 1100px; margin: 0 auto; }
  .fms-grid { display: grid; grid-template-columns: 1fr 320px; gap: 32px; align-items: start; }
  .fms-sub { margin: 8px 0 24px; max-width: 540px; }
  .fms-card { padding: 24px; margin-bottom: 24px; }
  .fms-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px; }
  .fms-length-group { grid-column: span 2; }
  .fms-length-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; }
  .fms-number { text-align: center; font-size: 18px; font-weight: 600; }
  .fms-unit-select { min-width: 90px; }
  .fms-hint { margin-top: 6px; color: var(--v-mute); }
  .fms-results { min-height: 80px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
  .fms-placeholder { color: var(--v-mute); font-size: 14px; text-align: center; }
  .fms-result-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; width: 100%; }
  .fms-result-item { background: var(--v-hairline-soft); border: 1px solid var(--v-hairline); border-radius: var(--v-r-sm); padding: 12px; text-align: center; }
  .fms-results :global(.fms-result-sys) { font-family: var(--font-mono); font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--v-mute); margin-bottom: 4px; }
  .fms-results :global(.fms-result-val) { font-size: 22px; font-weight: 600; font-family: var(--font-display); color: var(--v-ink); letter-spacing: -0.4px; }

  .fms-width-note { display: flex; gap: 8px; align-items: flex-start; font-size: 13px; color: var(--v-body); padding: 12px 16px; background: var(--v-hairline-soft); border-radius: var(--v-r-sm); line-height: 18px; }
  .fms-width-note svg { flex-shrink: 0; margin-top: 2px; color: var(--v-link); }

  .fms-ref { padding: 16px; }
  .fms-ref-grid { display: flex; flex-direction: column; gap: 1px; }
  .fms-ref-row { display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; font-size: 13px; color: var(--v-body); padding: 4px 4px; border-radius: 3px; }
  .fms-ref-row:nth-child(even) { background: var(--v-hairline-soft); }
  .fms-ref-header { font-family: var(--font-mono); font-weight: 600; font-size: 11px; text-transform: uppercase; color: var(--v-ink); background: transparent !important; }

  .fms-guide { position: sticky; top: 64px; padding: 24px; }
  .fms-steps { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .fms-step { display: flex; gap: 12px; align-items: flex-start; }
  .fms-step-num { width: 24px; height: 24px; border-radius: var(--v-r-full); background: var(--v-ink); color: var(--v-canvas); font-size: 11px; font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-family: var(--font-mono); }
  .fms-step-body { display: flex; flex-direction: column; gap: 2px; font-size: 13px; line-height: 18px; }
  .fms-step-body strong { color: var(--v-ink); font-weight: 600; font-size: 13px; }
  .fms-step-body span { color: var(--v-body); }
  .fms-more-link { width: 100%; justify-content: center; text-decoration: none; }

  @media (max-width: 900px) { .fms-grid { grid-template-columns: 1fr; } .fms-guide { position: static; } }
  @media (max-width: 640px) { .fms-section { padding: 64px 16px; } .fms-inputs { grid-template-columns: 1fr; } .fms-length-group { grid-column: span 1; } }
</style>

<script is:inline define:vars={{ serializedSizeData }}>
  const FMS_DATA = JSON.parse(serializedSizeData);

  const lengthInput = document.getElementById('fms-length');
  const unitSelect = document.getElementById('fms-unit');
  const genderSelect = document.getElementById('fms-gender');
  const resultsEl = document.getElementById('fms-results');
  const widthNote = document.getElementById('fms-width-note');

  function findClosestIndex(arr, val) {
    let closest = 0, minDiff = Infinity;
    arr.forEach((v, i) => { const d = Math.abs(Number(v) - val); if (d < minDiff) { minDiff = d; closest = i; } });
    return closest;
  }

  function calculateSizes() {
    const rawVal = parseFloat(lengthInput.value);
    const unit = unitSelect.value;
    const gender = genderSelect.value;
    if (!rawVal || isNaN(rawVal)) { showPlaceholder(); return; }

    const cmVal = unit === 'inches' ? rawVal * 2.54 : rawVal;
    const data = FMS_DATA[gender];
    const idx = findClosestIndex(data.cm, cmVal);
    const systems = [
      { key: 'us', label: gender === 'men' ? 'US M' : gender === 'women' ? 'US W' : 'US K' },
      { key: 'uk', label: 'UK' }, { key: 'eu', label: 'EU' },
      { key: 'india', label: 'India' }, { key: 'jp', label: 'JP' }, { key: 'inches', label: 'Inches' },
    ];
    const html = systems.map(s => `<div class="fms-result-item"><span class="fms-result-sys">${s.label}</span><span class="fms-result-val">${data[s.key]?.[idx] ?? '-'}</span></div>`).join('');
    resultsEl.innerHTML = `<div style="width:100%"><div class="fms-result-grid">${html}</div></div>`;
    if (widthNote) widthNote.hidden = false;
  }

  function showPlaceholder() {
    resultsEl.innerHTML = '<p class="fms-placeholder">Enter your foot length above to see results</p>';
    if (widthNote) widthNote.hidden = true;
  }

  lengthInput?.addEventListener('input', calculateSizes);
  unitSelect?.addEventListener('change', () => {
    const val = parseFloat(lengthInput.value);
    if (!val || isNaN(val)) return;
    if (unitSelect.value === 'inches') { lengthInput.value = String(Math.round((val / 2.54) * 10) / 10); lengthInput.min = '6'; lengthInput.max = '15'; }
    else { lengthInput.value = String(Math.round(val * 2.54 * 10) / 10); lengthInput.min = '15'; lengthInput.max = '36'; }
    calculateSizes();
  });
  genderSelect?.addEventListener('change', calculateSizes);
</script>
