---
// PopularConversions.astro — Clean, simple quick shoe size conversion cards
interface ConversionItem {
  title: string;
  subtitle: string;
  href: string;
}

const conversions: ConversionItem[] = [
  { title: 'US to EU', subtitle: 'American to European sizes', href: '/us-to-eu-shoe-size/' },
  { title: 'US to UK', subtitle: 'American to British sizes', href: '/us-to-uk-shoe-size/' },
  { title: 'US to India', subtitle: 'American to Indian sizes', href: '/us-to-india-shoe-size/' },
  { title: 'EU to US', subtitle: 'European to American sizes', href: '/eu-to-us-shoe-size/' },
  { title: 'UK to US', subtitle: 'British to American sizes', href: '/uk-to-us-shoe-size/' },
  { title: 'India to US', subtitle: 'Indian to American sizes', href: '/india-to-us-shoe-size/' },
  { title: 'EU to UK', subtitle: 'European to British sizes', href: '/eu-to-uk-shoe-size/' },
  { title: 'US to CM', subtitle: 'US sizes to Centimeters', href: '/us-to-cm-shoe-size/' },
  { title: 'EU to CM', subtitle: 'EU sizes to Centimeters', href: '/eu-to-cm-shoe-size/' },
];
---

<section class="pop-section">
  <div class="pop-inner">
    <div class="pop-header">
      <p class="pop-eyebrow">POPULAR CONVERSIONS</p>
      <h2 class="pop-heading">Quick Shoe Size Conversions</h2>
      <p class="pop-sub">Jump to the most commonly searched shoe size conversions. Each page includes a dedicated converter and full chart.</p>
    </div>

    <div class="pop-grid">
      {conversions.map(c => (
        <a href={c.href} class="conv-card">
          <div class="conv-text">
            <span class="conv-title">{c.title}</span>
            <span class="conv-desc">{c.subtitle}</span>
          </div>
          <span class="conv-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .pop-section {
    padding: 64px 24px;
    background: var(--v-elevated);
    border-top: 1px solid var(--v-hairline);
  }
  .pop-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .pop-header {
    margin-bottom: 28px;
  }
  .pop-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--v-mute);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .pop-heading {
    font-size: 26px;
    font-weight: 700;
    color: var(--v-ink);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .pop-sub {
    font-size: 15px;
    color: var(--v-body);
    line-height: 24px;
    max-width: 580px;
    margin: 0;
  }

  .pop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .conv-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .conv-card:hover {
    border-color: var(--v-link);
    background: var(--v-elevated);
    box-shadow: var(--v-shadow-whisper);
    transform: translateY(-1px);
  }
  .conv-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .conv-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--v-ink);
    letter-spacing: -0.01em;
  }
  .conv-desc {
    font-size: 12.5px;
    color: var(--v-mute);
  }
  .conv-arrow {
    color: var(--v-mute);
    display: flex;
    align-items: center;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .conv-card:hover .conv-arrow {
    color: var(--v-link);
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .pop-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .pop-section {
      padding: 44px 16px;
    }
    .pop-heading {
      font-size: 22px;
    }
    .pop-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
