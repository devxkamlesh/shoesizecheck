              <span class="snap-main">UK Size 8 in EU → EU 42.0</span>
              <span class="snap-detail">Foot length: 27.0 cm · US Men 9.0 · 10.6 inches · uk size 8 in eu</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">UK Size 10 in EU → EU 44.5 / 45</span>
              <span class="snap-detail">Foot length: 29.0 cm · US Men 11.0 · 11.4 inches · uk size 10 in eu</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">UK Size 5 in EU → EU 38.0</span>
              <span class="snap-detail">Foot length: 24.0 cm · US Women 7.0 · 9.4 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">UK Size 6 in EU → EU 39.0</span>
              <span class="snap-detail">Foot length: 25.0 cm · US Women 8.0 · 9.8 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">UK Size 7 in EU → EU 40.5 / 41</span>
              <span class="snap-detail">Foot length: 26.0 cm · US Men 8.0 · 10.2 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">UK Size 9 in EU → EU 43.0</span>
