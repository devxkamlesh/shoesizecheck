                    <td class="primary-cell"><strong>UK {r.uk.toFixed(1)}</strong></td>
                    <td class="highlight-cell"><strong>EU {r.eu.toFixed(1)}</strong></td>
                    <td>{r.cm.toFixed(1)} cm</td>
                    <td>{r.inch.toFixed(1)}"</td>
                    <td>US {r.us.toFixed(1)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div class="table-panel" id="tab-kids" role="tabpanel">
          <h3 class="table-heading">Kids' British to European Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Kids UK to EU shoe size chart">
              <thead>
                <tr>
                  <th>UK Kids Size</th>
                  <th>EU Kids Size</th>
                  <th>Foot Length (CM)</th>
                  <th>US Kids Size</th>
                  <th>Age Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>UK {r.uk}</strong></td>
                    <td class="highlight-cell"><strong>EU {r.eu.toFixed(1)}</strong></td>
                    <td>{r.cm.toFixed(1)} cm</td>
                    <td>US {r.us}</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
