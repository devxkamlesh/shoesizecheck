  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content="uk to eu shoe size, eu shoe size to uk, eu size to uk, uk foot size to eu, european shoe size to uk, uk size 10 in eu, eu foot size to uk, european sizes to uk, uk size 8 in eu, convert shoe size eu to uk, shoe size chart uk eu, euro foot size to uk, equivalent shoe sizes uk europe, convert euro shoe size to uk" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <!-- Breadcrumbs -->
