          <div class="table-wrapper">
            <table class="size-table" aria-label="Women UK to EU shoe size chart">
              <thead>
                <tr>
                  <th>UK Shoe Size</th>
                  <th>EU Shoe Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                  <th>US Women Size</th>
                </tr>
              </thead>
              <tbody>
