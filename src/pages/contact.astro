---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/contact/`;
const pageTitle = 'Contact Us — Sizing Support & Inquiries';
const pageDescription = 'Have questions, sizing feedback, or a brand chart suggestion? Contact the AllShoeSizeConverter team. We respond within 24–48 hours.';
const ogImage = `${domain}/og-image.png`;

const contactPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact AllShoeSizeConverter",
  "description": pageDescription,
  "url": pageCanonical,
  "mainEntity": {
    "@type": "Organization",
    "name": "AllShoeSizeConverter",
    "url": domain,
    "email": "support@allshoesizeconverter.com"
  }
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={contactPageSchema} />
  </Fragment>

  <Header />

  <main id="main-content" class="contact-page">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Contact Us' },
    ]} />

    <section class="contact-hero">
      <div class="contact-inner">
        <p class="mono-eyebrow">Get in Touch</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,44px)">Contact Our Team</h1>
        <p class="hero-sub body-lg">Have a question about a shoe conversion, feedback on brand fit, or a suggestion for our sizing tools? We’d love to hear from you.</p>
      </div>
    </section>

    <section class="contact-body-band">
      <div class="contact-inner">

        <!-- Direct Channels — Primary -->
        <div class="channels-grid">

          <a href="mailto:support@allshoesizeconverter.com" class="channel-card card-elevated">
            <span class="channel-label">General Support</span>
            <span class="channel-email">support@allshoesizeconverter.com</span>
            <span class="channel-desc body-sm text-mute">Questions about shoe sizes, conversions, or anything else — we're here to help.</span>
          </a>

          <a href="mailto:editorial@allshoesizeconverter.com" class="channel-card card-elevated">
            <span class="channel-label">Editorial &amp; Corrections</span>
            <span class="channel-email">editorial@allshoesizeconverter.com</span>
            <span class="channel-desc body-sm text-mute">Found an inaccuracy in a sizing chart? Let our editorial team know.</span>
          </a>

          <a href="mailto:partnerships@allshoesizeconverter.com" class="channel-card card-elevated">
            <span class="channel-label">Business &amp; Partnerships</span>
            <span class="channel-email">partnerships@allshoesizeconverter.com</span>
            <span class="channel-desc body-sm text-mute">Interested in collaborating, licensing data, or brand integrations?</span>
          </a>

        </div>

        <!-- Response commitment -->
        <div class="response-banner card-elevated">
          <p class="heading-sm" style="margin:0 0 4px">We typically respond within 24–48 business hours</p>
          <p class="body-sm text-mute" style="margin:0">Please include your shoe model or size system in your email so we can help faster.</p>
        </div>

        <!-- Quick Self-Service Links -->
        <div class="solutions-section">
          <h2 class="heading-md" style="margin-bottom:8px">Looking for Immediate Answers?</h2>
          <p class="body-sm text-mute" style="margin-bottom:24px">Jump straight to our verified guides — no wait needed.</p>

          <div class="solutions-grid">
            <a href="/shoe-size-by-foot-length/" class="solution-link">How to measure foot length in CM &amp; Inches</a>
            <a href="/kids-shoe-size-by-age/" class="solution-link">Kids &amp; Toddler sizing by age</a>
            <a href="/mondopoint-shoe-size/" class="solution-link">Ski boot &amp; Mondopoint conversions</a>
            <a href="/country/us/" class="solution-link">US Shoe Size Chart &amp; Width Guide</a>
            <a href="/country/uk/" class="solution-link">UK &amp; Clarks Width Fittings</a>
            <a href="/country/india/" class="solution-link">India Shoe Size Chart &amp; BIS Guide</a>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .contact-page {
    background: var(--v-canvas);
    min-height: 80vh;
  }
  .contact-hero {
    padding: 56px 24px 32px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1), transparent 60%);
    border-bottom: 1px solid var(--v-hairline);
  }
  .contact-inner {
    max-width: 860px;
    margin: 0 auto;
  }
  .hero-sub {
    color: var(--v-mute);
    margin-top: 12px;
    max-width: 620px;
    margin-left: auto;
    margin-right: auto;
  }
  .contact-body-band {
    padding: 48px 24px 80px;
  }

  /* Channel Cards */
  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 32px;
  }
  .channel-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 28px 24px;
    text-decoration: none;
    box-shadow: var(--v-shadow-whisper);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .channel-card:hover {
    border-color: var(--v-link);
    box-shadow: 0 4px 20px rgba(37, 99, 235, 0.08);
    transform: translateY(-2px);
  }
  .channel-label {
    display: block;
    font-size: 12px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--v-mute);
    letter-spacing: 0.05em;
  }
  .channel-email {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--v-link);
    word-break: break-all;
  }
  .channel-desc {
    display: block;
    margin-top: 4px;
    line-height: 1.5;
  }

  /* Response Banner */
  .response-banner {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 20px 24px;
    margin-bottom: 48px;
    text-align: center;
    box-shadow: var(--v-shadow-whisper);
  }

  /* Solutions Section */
  .solutions-section {
    border-top: 1px solid var(--v-hairline);
    padding-top: 40px;
  }
  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .solution-link {
    display: block;
    padding: 16px 20px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    font-size: 13px;
    font-weight: 500;
    color: var(--v-body);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .solution-link:hover {
    color: var(--v-link);
    border-color: var(--v-link);
    background: rgba(37, 99, 235, 0.04);
  }

  @media (max-width: 768px) {
    .channels-grid {
      grid-template-columns: 1fr;
    }
    .solutions-grid {
      grid-template-columns: 1fr;
    }
    .channel-card {
      padding: 22px 18px;
    }
  }
  @media (min-width: 769px) and (max-width: 1024px) {
    .channels-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .solutions-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

