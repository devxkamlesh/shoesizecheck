---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/us-to-eu-shoe-size/`;
const pageTitle = 'US to EU shoe size converter: American to European size chart';
const pageDescription = 'Convert US to EU shoe sizes. European shoe size charts for men, women, and kids with formula guides and brand conversion benchmarks.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'What is the EU shoe size to US?',
    a: 'To convert an EU shoe size to US, determine whether you need men\'s or women\'s sizing because EU sizing is unisex while US sizing is gender-specific. For men, subtract 33 from your EU size (EU 42 − 33 = US Men\'s 9). For women, subtract 30.5 (EU 38.5 − 30.5 = US Women\'s 8).'
  },
  {
    q: 'What is EU to US shoe size?',
    a: 'An EU to US shoe size conversion translates continental European sizes based on the Paris Point (2/3 cm, or 6.67 mm) to the American shoe size scale based on 1/3 inch barleycorns (8.46 mm). Common adult benchmarks include EU 38.5 = US Women\'s 8, EU 40 = US Men\'s 7, EU 42 = US Men\'s 9, and EU 44 = US Men\'s 10.'
  },
  {
    q: 'How do I convert my shoe size from EU to US?',
    a: 'Determine your category first because US women\'s sizes run 1.5 sizes larger than US men\'s for the same foot length. For men, subtract 33 from the EU number. For women, subtract 30.5. Verify your foot length in centimeters against our conversion table.'
  },
  {
    q: 'What is EU shoe size to US for women and men?',
    a: 'Because the European sizing system is unisex, a single EU number represents different US sizes depending on gender. EU 39 corresponds to US Men\'s 6.5 and US Women\'s 8.5. EU 41 translates to US Men\'s 8.0 and US Women\'s 10.0.'
  },
  {
    q: 'What are the primary US to EU shoe size conversions?',
    a: 'Standard conversions for men include US 7 = EU 40, US 8 = EU 41, US 9 = EU 42, US 10 = EU 44, US 11 = EU 45, and US 12 = EU 46. Standard conversions for women include US 6 = EU 36.5, US 7 = EU 37.5, US 8 = EU 38.5, US 9 = EU 40, and US 10 = EU 41.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'EU to US Shoe Size Converter', href: '/eu-to-us-shoe-size/' },
  { label: 'US to UK Shoe Size Converter', href: '/us-to-uk-shoe-size/' },
  { label: 'US to CM Shoe Size Calculator', href: '/us-to-cm-shoe-size/' },
  { label: 'European Shoe Sizing Guide', href: '/country/europe/' },
  { label: 'United States Shoe Sizing Guide', href: '/country/us/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
  { label: 'Mondopoint Ski Boot Sizing', href: '/mondopoint-shoe-size/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'US to EU Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Interactive Conversion Engine · Paris Point vs. Barleycorn</p>
        <h1 class="display-xl">US to EU Shoe Size Converter</h1>
        <p class="hero-sub body-lg">
          Convert American shoe sizes to European standards across men's, women's, and kids' footwear. Compare European shoe size charts, conversion offsets, and brand fit guidelines.
        </p>

        <!-- Quick conversion pills -->
        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men Formula:</span>
            <span class="badge-val">EU ≈ US + 33</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women Formula:</span>
            <span class="badge-val">EU ≈ US + 30.5</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">EU Unit:</span>
            <span class="badge-val">Paris Point (2/3 cm)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Converter Tool Component -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert US to EU Shoe Size</h2>
            <p class="conv-card-sub">Select your gender and US shoe size below to calculate exact European (EU) and metric centimeter (CM) equivalents.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category / Gender
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select gender or category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> American (US) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select US shoe size">
                <option value="" disabled>Select US size</option>
                {menSizes.map(s => <option value={String(s.us)} selected={s.us === 9.0 ? true : undefined}>{s.us} US</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">United States (US)</span>
                <span class="conv-val" id="res-us">9</span>
                <span class="conv-note" id="res-us-sub">Men's Standard</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">European Union (EU)</span>
                <span class="conv-val" id="res-eu">42</span>
                <span class="conv-note" id="res-eu-sub">Paris Point Unisex</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed Length</span>
                <span class="conv-val-sm" id="res-cm">27.0 cm</span>
                <span class="conv-note" id="res-in">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Conversion Snapshot Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Most Common US to European Shoe Size Conversions</h2>
        <p class="section-sub">Quick-reference benchmarks for the most frequently searched adult shoe sizes.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 9 → EU 42</span>
              <span class="snap-detail">Foot length: 27.0 cm · UK 8.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 10 → EU 43</span>
              <span class="snap-detail">Foot length: 28.0 cm · UK 9.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 10.5 → EU 44</span>
              <span class="snap-detail">Foot length: 28.5 cm · UK 10.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 7 → EU 37.5</span>
              <span class="snap-detail">Foot length: 24.0 cm · UK 5.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 8 → EU 38.5</span>
              <span class="snap-detail">Foot length: 25.0 cm · UK 6.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 9 → EU 39.5</span>
              <span class="snap-detail">Foot length: 26.0 cm · UK 7.0</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Comprehensive Conversion Charts Section -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">Comprehensive European Shoe Size Chart</h2>
        <p class="section-sub">Full conversion tables cross-referencing US, EU, UK, centimeters (CM), and inches across all categories.</p>

        <!-- Tab Controls for Tables -->
        <div class="table-tabs" role="tablist">
          <button class="tab-btn active" data-target="tab-men" role="tab" aria-selected="true">Men's US to EU Chart</button>
          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's US to EU Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' US to EU Chart</button>
        </div>

        <!-- Men's Table -->
        <div class="table-panel active" id="tab-men" role="tabpanel">
          <h3 class="table-heading">Men's European and US shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Men US to EU shoe size conversion chart">
              <thead>
                <tr>
                  <th>US Size</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>EU {r.eu}</strong></td>
                    <td>UK {r.uk}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Table -->
        <div class="table-panel" id="tab-women" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Women's European and US shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Women US to EU shoe size conversion chart">
              <thead>
                <tr>
                  <th>US Size</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>EU {r.eu}</strong></td>
                    <td>UK {r.uk}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div class="table-panel" id="tab-kids" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Kids' European and US shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Kids US to EU shoe size conversion chart">
              <thead>
                <tr>
                  <th>US Size</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Growth Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>EU {r.eu}</strong></td>
                    <td>{r.cm} cm</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- Deep-Dive SEO Editorial Content -->
    <section class="editorial-band">
      <div class="page-inner prose-article">

        <h2 class="editorial-main-title">European shoe size guide: US to EU conversions</h2>

        <p class="lead-paragraph">
          Converting an American shoe size to European standards requires understanding the mathematical, anatomical, and structural distinctions between both systems. In the United States, sizes follow the customary barleycorn scale. Continental Europe uses the metric Paris point.
        </p>

        <h3>1. Underlying mathematics: barleycorn and Paris point</h3>
        <p>
          American footwear sizing derives from the English barleycorn system, where each full size increment represents 1/3 inch (8.46 millimeters). A half size step represents 1/6 inch (4.23 mm). Learn more in our guide on <a href="/shoe-size-in-inches/">shoe sizes in inches and barleycorn history</a>.
        </p>
        <p>
          Continental Europe uses the Paris Point, defined as 2/3 of a centimeter (6.67 millimeters). Because one Paris Point is smaller than an American size increment of 8.46 mm, the numerical offset between European and American sizes shifts across the size scale.
        </p>

        <h3>2. Gender differences: unisex European sizing</h3>
        <p>
          European footwear sizing is unisex. An EU size 42 uses a 27.0 cm footbed regardless of whether the shoe is labeled for men or women.
        </p>
        <p>
          American sizing uses separate baseline scales for men and women. In the US, a men's size 8 fits an anatomical foot length of 26.0 cm, whereas a women's size 8 fits a foot length of 25.0 cm. An EU 39 represents a US Men's 6.5 and a US Women's 8.5.
        </p>

        <h3>3. Conversion formulas</h3>
        <p>
          Standard linear conversion formulas approximate European equivalents:
        </p>
        <ul>
          <li>For men: add 33 to your American men's size (US Men's 9 + 33 = EU 42).</li>
          <li>For women: add 30.5 to your American women's size (US Women's 8 + 30.5 = EU 38.5).</li>
          <li>To convert EU to US: subtract 33 for men (EU 44 − 33 = US 11) or subtract 30.5 for women (EU 38.5 − 30.5 = US 8).</li>
        </ul>

        <h3>4. Brand variations</h3>
        <p>
          Shoe manufacturers interpret European and American conversions with slight variations:
        </p>
        <ul>
          <li>Nike and Jordan: on Nike men's tags, US 9 converts to EU 42.5 (27.0 cm), US 9.5 to EU 43 (27.5 cm), and US 10 to EU 44 (28.0 cm).</li>
          <li>Adidas and Puma: German sportswear labels use thirds of a Paris point, such as EU 42 2/3 (US 9) and EU 43 1/3 (US 9.5).</li>
          <li>Birkenstock: uses true unisex sizing where EU 41 fits a 26.5 cm footbed.</li>
          <li>Italian dress shoes: classic leather dress shoes from Italian makers frequently fit roomier than athletic sneakers.</li>
        </ul>

        <h3>5. Measuring foot length</h3>
        <p>
          To find your European size from foot length, measure both feet from heel to longest toe in centimeters. See our step-by-step instructions on <a href="/shoe-size-by-foot-length/">measuring shoe size by foot length</a>. A foot length of 27.0 cm aligns with EU 42 and US Men's 9.
        </p>

        <h3>6. Half sizes and width considerations</h3>
        <p>
          Many European fashion labels produce only whole integer sizes (38, 39, 40, 41, 42). For performance running footwear, buyers typically select the next full European size to maintain toe clearance. For formal leather shoes, leather uppers yield over time. Width standards also vary between US and European lasts.
        </p>

      </div>
    </section>

    <!-- FAQ Accordion Section with Schema Matching -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Direct answers to the most common questions regarding US and European shoe sizing conversions.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0 ? true : undefined}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Links & Cross-Converters -->
    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resUs = document.getElementById('res-us');
    const resUsSub = document.getElementById('res-us-sub');
    const resEu = document.getElementById('res-eu');
    const resEuSub = document.getElementById('res-eu-sub');
    const resCm = document.getElementById('res-cm');
    const resIn = document.getElementById('res-in');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach((item, idx) => {
        const opt = document.createElement('option');
        opt.value = String(item.us);
        opt.textContent = `${item.us} US`;
        // default select middle size
        if (gender === 'men' && item.us === 9.0) opt.selected = true;
        if (gender === 'women' && item.us === 8.0) opt.selected = true;
        if (gender === 'kids' && item.us === '10C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "Men's Standard";
      if (gender === 'women') { list = WOMEN; label = "Women's Standard"; }
      if (gender === 'kids') { list = KIDS; label = "Kids' Standard"; }

      const match = list.find(item => String(item.us) === String(val));
      if (!match) return;

      if (resUs) resUs.textContent = String(match.us);
      if (resUsSub) resUsSub.textContent = label;
      if (resEu) resEu.textContent = String(match.eu);
      if (resEuSub) resEuSub.textContent = "Paris Point Unisex";
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resIn) resIn.textContent = match.inch ? `${match.inch} inches` : `${match.stage || 'Metric'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Interactive Tab Controller for Tables
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Hero */
  .page-hero {
    padding: 56px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .page-inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    color: var(--v-ink);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .hero-sub {
    font-size: 16px;
    color: var(--v-body);
    line-height: 26px;
    max-width: 680px;
    margin: 0 auto 24px;
  }

  /* Quick Stat Badges */
  .quick-stat-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    font-size: 12.5px;
    box-shadow: var(--v-shadow-whisper);
  }
  .badge-label {
    color: var(--v-mute);
  }
  .badge-val {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--v-ink);
  }

  /* Converter Band */
  .converter-band {
    padding: 40px 24px 56px;
    background: var(--v-canvas);
  }
  .conv-card {
    padding: 32px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    box-shadow: var(--v-shadow-floating);
  }
  .conv-card-header {
    margin-bottom: 24px;
  }
  .heading-md {
    font-size: 22px;
    font-weight: 700;
    color: var(--v-ink);
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  .conv-card-sub {
    font-size: 14px;
    color: var(--v-mute);
    margin: 0;
  }

  .conv-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  .step-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--v-ink);
    margin-bottom: 8px;
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--v-link);
    color: #ffffff;
    font-size: 11px;
    font-family: var(--font-mono);
    border-radius: var(--v-r-full);
  }
  .form-select {
    width: 100%;
