---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/india-to-eu-shoe-size/`;
const pageTitle = 'India to EU shoe size converter: Indian to European chart';
const pageDescription = 'Convert Indian shoe sizes to European (EU) sizes. Full India to EU size charts for men, women, and kids with Bata and brand fit tips.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'What is Indian shoe size 8 in EU?',
    a: 'Indian size 8 corresponds to EU size 42 (27.0 cm foot length). For women, Indian size 8 corresponds to EU 41 (27.0 cm).'
  },
  {
    q: 'What is India shoe size 7 in EU?',
    a: 'Indian size 7 for men corresponds to EU size 40.5 (25.5 cm foot length). For women, Indian size 7 corresponds to EU 37.5 (24.0 cm).'
  },
  {
    q: 'How does Bata or Red Tape shoe size convert to European size?',
    a: 'Domestic Indian brands like Bata, Red Tape, Liberty, Woodland, and Metro use Indian sizing under IS 1638:1969, which matches UK sizing. For men, India 8 corresponds to EU 42 and India 9 corresponds to EU 42.5.'
  },
  {
    q: 'Why do some European shoes fit narrower in India?',
    a: 'European lasts are constructed on standard medium width profiles that taper toward the toe box. The CSIR-CLRI 2022 survey report showed that Indian feet have broader ball girth, so selecting a half size up in tapered European footwear helps prevent lateral pressure.'
  },
  {
    q: 'How do Indian women\'s shoe sizes convert to European sizes?',
    a: 'To convert Indian women\'s shoe sizes to European standards, add approximately 31 to 32 to your Indian size (India 5 = EU 37.5; India 6 = EU 38.5).'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'EU to India Shoe Size Converter', href: '/eu-to-india-shoe-size/' },
  { label: 'India to US Shoe Size Converter', href: '/india-to-us-shoe-size/' },
  { label: 'India to UK Shoe Size Converter', href: '/india-to-uk-shoe-size/' },
  { label: 'India Shoe Sizing Guide', href: '/country/india/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'India to EU Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Bata & Indian Sizing to Continental Paris Point</p>
        <h1 class="display-xl">India to EU Shoe Size Converter</h1>
        <p class="hero-sub body-lg">
          Convert Indian footwear sizes to European (EU) standards accurately. Designed for Indian buyers purchasing imported footwear, luxury European leather, and international sneaker drops.
        </p>

        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men Formula:</span>
            <span class="badge-val">EU ≈ India + 34</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women Formula:</span>
            <span class="badge-val">EU ≈ India + 33</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Indian Reference:</span>
            <span class="badge-val">Bata / Red Tape Scale</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert Indian Size to European (EU) Size</h2>
            <p class="conv-card-sub">Select your gender category and Indian shoe size to compute the exact European (EU) size and foot length in centimeters.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Footwear</option>
                <option value="women">Women's Footwear</option>
                <option value="kids">Kids' Footwear</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> Indian (IND / UK) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select Indian shoe size">
                <option value="" disabled>Select India size</option>
                {menSizes.map(s => <option value={String(s.india)} selected={s.india === 8.0 ? true : undefined}>{s.india} India (UK)</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">India (IND / UK)</span>
                <span class="conv-val" id="res-in">8</span>
                <span class="conv-note" id="res-in-sub">Men's Standard</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">European Union (EU)</span>
                <span class="conv-val" id="res-eu">42</span>
                <span class="conv-note" id="res-eu-sub">Paris Point Unisex</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed Length</span>
                <span class="conv-val-sm" id="res-cm">27.0 cm</span>
                <span class="conv-note" id="res-in-meas">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Popular Indian to European Shoe Size Benchmarks</h2>
        <p class="section-sub">Quick conversions for the most common domestic Indian footwear sizes.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Standard</span>
            <div class="snap-body">
              <span class="snap-main">India 7 → EU 41</span>
              <span class="snap-detail">Foot length: 26.0 cm · US 8.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Standard</span>
            <div class="snap-body">
              <span class="snap-main">India 8 → EU 42</span>
              <span class="snap-detail">Foot length: 27.0 cm · US 9.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Standard</span>
            <div class="snap-body">
              <span class="snap-main">India 9 → EU 43</span>
              <span class="snap-detail">Foot length: 28.0 cm · US 10.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Standard</span>
            <div class="snap-body">
              <span class="snap-main">India 5 → EU 38</span>
              <span class="snap-detail">Foot length: 24.0 cm · US 7.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Standard</span>
            <div class="snap-body">
              <span class="snap-main">India 6 → EU 39</span>
              <span class="snap-detail">Foot length: 25.0 cm · US 8.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Standard</span>
            <div class="snap-body">
              <span class="snap-main">India 7 → EU 40.5</span>
              <span class="snap-detail">Foot length: 26.0 cm · US 9.0</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Charts Section -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">India to EU Shoe Size Chart</h2>
        <p class="section-sub">Comprehensive cross-reference tables connecting Indian domestic sizes with European Paris Points and centimeter footbed measurements.</p>

        <div class="table-tabs" role="tablist">
          <button class="tab-btn active" data-target="tab-men" role="tab" aria-selected="true">Men's India to EU Chart</button>
          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's India to EU Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' India to EU Chart</button>
        </div>

        <!-- Men's Table -->
        <div class="table-panel active" id="tab-men" role="tabpanel">
          <h3 class="table-heading">Men's Indian to European Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Men India to EU shoe size chart">
              <thead>
                <tr>
                  <th>India Size (UK)</th>
                  <th>EU Size</th>
                  <th>US Size</th>
                  <th>Footbed (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>India {r.india}</strong></td>
                    <td class="highlight-cell"><strong>EU {r.eu}</strong></td>
                    <td>US {r.us}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Table -->
        <div class="table-panel" id="tab-women" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Women's Indian to European Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Women India to EU shoe size chart">
              <thead>
                <tr>
                  <th>India Size (UK)</th>
                  <th>EU Size</th>
                  <th>US Size</th>
                  <th>Footbed (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>India {r.india}</strong></td>
                    <td class="highlight-cell"><strong>EU {r.eu}</strong></td>
                    <td>US {r.us}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div class="table-panel" id="tab-kids" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Kids' Indian to European Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Kids India to EU shoe size chart">
              <thead>
                <tr>
                  <th>India Size</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>India {r.india}</strong></td>
                    <td class="highlight-cell"><strong>EU {r.eu}</strong></td>
                    <td>{r.cm} cm</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- Editorial Guide -->
    <article class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">Converting Indian shoe sizes to European sizes: fit guide</h2>

        <p class="lead-paragraph">
          Most Indian footwear brands, including Bata India, Red Tape, Liberty, and Woodland, size shoes according to standard IS 1638:1969, which uses the British imperial scale. When shopping for European brands labeled in Paris Points (such as EU 40, 41, 42, 43, and 44), applying calibrated offsets ensures an accurate fit.
        </p>

        <h3>1. Origin and units of Indian and European sizing</h3>
        <p>
          Indian footwear standards adopted the British barleycorn system under IS 1638:1969, where each size increment equals 1/3 inch (8.46 millimeters). An Indian size 8 has a footbed length equal to a UK 8 (fitting a 27.0 cm foot). For details on the imperial sizing system, see our guide on <a href="/shoe-size-in-inches/">shoe sizes in inches and barleycorn measurements</a>.
        </p>
        <p>
          Continental European sizing relies on the Paris Point (2/3 of a centimeter, or 6.67 millimeters). Because the Paris Point is shorter than a barleycorn, European shoe sizes scale at different intervals and require offset charts.
        </p>

        <h3>2. Conversion formulas</h3>
        <p>
          Because Indian sizing is identical in length to UK sizing, European conversions align directly:
        </p>
        <ul>
          <li>For men: adding 33.5 to 34 to your Indian size provides the European equivalent. Indian size 8 equals EU 42 (27.0 cm footbed). Indian size 7 equals EU 40.5 (25.5 cm), and Indian size 9 equals EU 42.5 (27.5 cm).</li>
          <li>For women: adding 32.5 to your Indian size yields the European equivalent. An Indian women's size 5 (24.0 cm) corresponds to EU 37.5, and Indian size 6 (25.0 cm) corresponds to EU 38.5.</li>
          <li>For kids: match bare foot length in centimeters against our table. An Indian child size 8C (15.5 cm) equals EU 25, while an Indian youth size 1Y (20.0 cm) equals EU 32.</li>
        </ul>

        <h3>3. Common size benchmarks</h3>
        <p>
          Standard benchmarks between Indian and European sizes include:
        </p>
        <ul>
          <li>EU 37.5 corresponds to Indian women's size 5 (24.0 cm foot length).</li>
          <li>EU 38.5 corresponds to Indian women's size 6 (25.0 cm foot length).</li>
          <li>EU 40.5 represents Indian men's size 7 (25.5 cm foot length).</li>
          <li>EU 41.5 represents Indian men's size 8 (26.5 cm foot length).</li>
          <li>EU 42.0 represents Indian men's size 8.5 (27.0 cm foot length).</li>
          <li>EU 44.0 represents Indian men's size 9.5 (28.0 cm foot length).</li>
        </ul>

        <h3>4. Domestic Indian shoe brands and European lasts</h3>
        <p>
          Domestic Indian shoe manufacturers calibrate their lasts to the UK and Indian standard:
        </p>
        <ul>
          <li>Bata India: formal shoes follow IS 1638:1969. A men's Bata size 8 fits a 27.0 cm foot length and matches EU 42.</li>
          <li>Red Tape, Woodland, and Liberty: leather footwear and outdoor boots from these makers use domestic sizing. Moving from Woodland size 8 to European hiking boots typically requires EU 42.</li>
          <li>Campus and Sparx: sports shoes from domestic makers follow Indian sizing numbers. A size 7 running shoe corresponds to EU 40.5.</li>
        </ul>

        <h3>5. Forefoot width and morphology</h3>
        <p>
          The CSIR-Central Leather Research Institute (CSIR-CLRI) completed an anthropometric foot survey across India, published in their 2022 survey report. The report documented that Indian feet show broader metatarsal ball girth and higher dorsal instep measurements relative to European lasts. When buying European formal dress shoes or fashion boots with tapered toe boxes, selecting a half size up prevents pressure along the lateral metatarsal heads.
        </p>

        <h3>6. Measuring foot length</h3>
        <p>
          To find your European size, measure your foot length from heel to longest toe in centimeters. See our step-by-step instructions on <a href="/shoe-size-by-foot-length/">measuring shoe size by foot length</a>. A foot length of 27.0 cm corresponds to Indian size 8.5 and European size 42.
        </p>
      </div>
    </article>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Authoritative answers to common Indian to European shoe size conversion questions.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0 ? true : undefined}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resIn = document.getElementById('res-in');
    const resInSub = document.getElementById('res-in-sub');
    const resEu = document.getElementById('res-eu');
    const resEuSub = document.getElementById('res-eu-sub');
    const resCm = document.getElementById('res-cm');
    const resInMeas = document.getElementById('res-in-meas');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.india);
        opt.textContent = `${item.india} India (UK)`;
        if (gender === 'men' && item.india === 8.0) opt.selected = true;
        if (gender === 'women' && item.india === 5.0) opt.selected = true;
        if (gender === 'kids' && item.india === '9.5C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "Men's Standard";
      if (gender === 'women') { list = WOMEN; label = "Women's Standard"; }
      if (gender === 'kids') { list = KIDS; label = "Kids' Standard"; }

      const match = list.find(item => String(item.india) === String(val));
      if (!match) return;

      if (resIn) resIn.textContent = String(match.india);
      if (resInSub) resInSub.textContent = label;
      if (resEu) resEu.textContent = String(match.eu);
      if (resEuSub) resEuSub.textContent = "Paris Point Unisex";
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resInMeas) resInMeas.textContent = match.inch ? `${match.inch} inches` : `${match.stage || 'Metric'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Hero */
  .page-hero {
    padding: 56px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .page-inner { max-width: 960px; margin: 0 auto; }
  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    color: var(--v-ink);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .hero-sub { font-size: 16px; color: var(--v-body); line-height: 26px; max-width: 680px; margin: 0 auto 24px; }

  /* Quick Stat Badges */
  .quick-stat-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    font-size: 12.5px;
    box-shadow: var(--v-shadow-whisper);
  }
  .badge-label { color: var(--v-mute); }
  .badge-val { font-family: var(--font-mono); font-weight: 700; color: var(--v-ink); }

  /* Converter Band */
  .converter-band { padding: 40px 24px 56px; background: var(--v-canvas); }
  .conv-card {
    padding: 32px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    box-shadow: var(--v-shadow-floating);
  }
  .conv-card-header { margin-bottom: 24px; }
  .heading-md { font-size: 22px; font-weight: 700; color: var(--v-ink); letter-spacing: -0.02em; margin: 0 0 6px; }
  .conv-card-sub { font-size: 14px; color: var(--v-mute); margin: 0; }

  .conv-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  .step-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--v-ink);
    margin-bottom: 8px;
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--v-link);
    color: #ffffff;
    font-size: 11px;
    font-family: var(--font-mono);
    border-radius: var(--v-r-full);
  }
  .form-select {
    width: 100%;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--v-ink);
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    outline: none;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .form-select:focus { border-color: var(--v-link); box-shadow: 0 0 0 3px var(--v-link-soft); }

