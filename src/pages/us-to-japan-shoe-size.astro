              <thead>
                <tr>
                  <th>US Women Size</th>
                  <th>Japan Size (CM)</th>
                  <th>Mondopoint (MM)</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us.toFixed(1)}</strong></td>
                    <td class="highlight-cell"><strong>{r.jp.toFixed(1)} cm (JP)</strong></td>
                    <td>{Math.round(r.jp * 10)} mm</td>
                    <td>EU {r.eu.toFixed(1)}</td>
                    <td>UK {r.uk.toFixed(1)}</td>
                    <td>{r.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div class="table-panel" id="tab-kids" role="tabpanel">
          <h3 class="table-heading">Kids' & Youth US to Japan Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Kids US to Japan shoe size chart">
