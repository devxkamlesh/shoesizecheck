---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/us-to-japan-shoe-size/`;
const pageTitle = 'US to Japan shoe size converter: men, women, and kids chart';
const pageDescription = 'Convert US shoe sizes to Japanese sizes. Complete US to Japan shoe size chart for men, women, and kids with JP centimeter sizing and width guidance.';
const ogImage = `${domain}/og-image.png`;

// Derive table datasets from centralized single source of truth
const menSizes = MEN_SIZE_ROWS.map(r => ({ us: r.us, jp: r.cm, eu: r.eu, uk: r.uk, inch: r.inch }));
const womenSizes = WOMEN_SIZE_ROWS.map(r => ({ us: r.us, jp: r.cm, eu: r.eu, uk: r.uk, inch: r.inch }));
const kidsSizes = KIDS_SIZE_ROWS.map(r => ({ us: r.us, jp: r.cm, eu: r.eu, stage: r.stage }));

const faqs = [
  {
    q: 'How do I convert US shoe size to Japan shoe size?',
    a: 'Japan shoe sizing is metric and directly equals footbed length in centimeters (CM). For American men, convert your size by adding 18 to your US size (for example, US Men 9.0 + 18 = 27.0 cm / 270 JP). For American women, add 17 to your US size (for example, US Women 7.5 + 17 = 24.5 cm / 245 JP). Verifying foot length directly in centimeters provides the most reliable fit.'
  },
  {
    q: 'What is 24.5 Japan shoe size in US sizing?',
    a: 'A 24.5 Japan shoe size equals a foot length of 24.5 centimeters. In American footwear, a 24.5 JP translates to an American US Women\'s 7.5 or an American US Men\'s 6.5 (European EU 38.5, UK 5.5).'
  },
  {
    q: 'What are US 9.5 and 10.5 in Japanese shoe sizes?',
    a: 'An American Men\'s US 9.5 corresponds to 27.5 cm (27.5 JP / 275 mm) in Japan, equivalent to European EU 42.5. An American Men\'s US 10.5 corresponds to 28.5 cm (28.5 JP / 285 mm) in Japan, equivalent to European EU 44.0.'
  },
  {
    q: 'What do EU shoe sizes like 38 and 41 equal in Japan?',
    a: 'A European EU 38 corresponds to 24.0 cm (24.0 JP) in Japanese footwear, which equals a US Women\'s 7.0 or US Men\'s 6.0. An EU 41 corresponds to 26.0 cm (26.0 JP) in Japanese sizing, which equals an American US Men\'s 8.0 or US Women\'s 9.0.'
  },
  {
    q: 'How do Japanese shoe widths differ from American footwear widths?',
    a: 'Under the Japanese Industrial Standard (JIS S 5037), the baseline standard width for adult men\'s footwear in Japan is 2E (EE), whereas standard American men\'s footwear defaults to D width (Medium). Japanese lasts are sculpted with wider forefoot ball girth and higher instep clearance. If you have narrow feet, consider selecting D width or sizing down half a centimeter when buying Japanese heritage footwear.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'Japan Shoe Sizing Guide', href: '/country/japan/' },
  { label: 'United States Shoe Sizing Guide', href: '/country/us/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
  { label: 'Mondopoint Shoe Size Guide', href: '/mondopoint-shoe-size/' },
  { label: 'US to EU Shoe Size Converter', href: '/us-to-eu-shoe-size/' },
  { label: 'US to UK Shoe Size Converter', href: '/us-to-uk-shoe-size/' },
  { label: 'US to India Shoe Size Converter', href: '/us-to-india-shoe-size/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <div class="page-inner pt-4">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Converters', href: '/converters/' },
        { label: 'US to Japan', href: '/us-to-japan-shoe-size/' }
      ]} />
    </div>

    <!-- Hero Section -->
    <section class="hero-band">
      <div class="page-inner hero-content">
        <span class="badge-pill">Metric Footwear Sizing</span>
        <h1 class="display-xl">US to Japan shoe size converter</h1>
        <p class="hero-sub body-lg">
          Convert American (US) shoe sizes to Japanese sizes (JP cm) for men, women, and children. See equivalent foot lengths, EU sizes, UK sizes, and width standards.
        </p>
        <p class="hero-answer"><strong>Direct answer:</strong> Japanese shoe sizes match foot length in centimeters. A US men's 9 equals Japan 27.0 (270 mm), while a US women's 7.5 equals Japan 24.5 (245 mm).</p>

        <div class="quick-stats-row">
          <div class="stat-badge">
            <span class="stat-lbl">US Men 9.0:</span>
            <span class="stat-val">27.0 JP (270 mm)</span>
          </div>
          <div class="stat-badge">
            <span class="stat-lbl">US Women 7.5:</span>
            <span class="stat-val">24.5 JP (245 mm)</span>
          </div>
          <div class="stat-badge">
            <span class="stat-lbl">Standard Width:</span>
            <span class="stat-val">2E (EE) in Japan</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="calc-band">
      <div class="page-inner">
        <div class="calc-card card-elevated">
          <div class="calc-header">
            <h2 class="heading-md">Convert American (US) size to Japan (JP)</h2>
            <p class="calc-sub">Choose your category and US shoe size to view your metric Japanese equivalent.</p>
          </div>

          <div class="calc-grid">
            <div class="calc-field">
              <label class="field-lbl" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="calc-field">
              <label class="field-lbl" for="conv-size">
                <span class="step-num">2</span> American (US) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select US size">
                <option value="" disabled>Select US size</option>
                {menSizes.map(s => <option value={String(s.us)} selected={s.us === 9.0 ? true : undefined}>{s.us} US Men</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Display -->
          <div class="res-box" id="res-box" aria-live="polite">
            <div class="res-display">
              <div class="res-col">
                <span class="res-sys">United States</span>
                <span class="res-val" id="res-us">9</span>
                <span class="res-note" id="res-us-sub">US Men's Size</span>
              </div>
              <div class="res-arrow" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="res-col res-primary">
                <span class="res-sys">Japan (JP / CM)</span>
                <span class="res-val" id="res-jp">27.0</span>
                <span class="res-note" id="res-jp-sub">Centimeters (270 mm)</span>
              </div>
              <div class="res-col res-secondary">
                <span class="res-sys">Equivalent Sizes</span>
                <span class="res-val-sm" id="res-aux">EU 42.0 · UK 8.5</span>
                <span class="res-note" id="res-inch">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Popular Benchmarks -->
    <section class="bench-band">
      <div class="page-inner">
        <h2 class="section-title">Common US to Japan shoe size benchmarks</h2>
        <p class="section-sub">Standard conversion points between American footwear sizes and Japanese metric measurements.</p>

        <div class="bench-grid">
          <div class="bench-card">
            <span class="bench-cat">Men</span>
            <span class="bench-main">US 8 Men → 26.0 JP</span>
            <span class="bench-aux">260 mm · EU 41 · UK 7.5</span>
          </div>
          <div class="bench-card">
            <span class="bench-cat">Men</span>
            <span class="bench-main">US 9 Men → 27.0 JP</span>
            <span class="bench-aux">270 mm · EU 42 · UK 8.5</span>
          </div>
          <div class="bench-card">
            <span class="bench-cat">Men</span>
            <span class="bench-main">US 9.5 Men → 27.5 JP</span>
            <span class="bench-aux">275 mm · EU 42.5 · UK 9.0</span>
          </div>
          <div class="bench-card">
            <span class="bench-cat">Men</span>
            <span class="bench-main">US 10 Men → 28.0 JP</span>
            <span class="bench-aux">280 mm · EU 43 · UK 9.5</span>
          </div>
          <div class="bench-card">
            <span class="bench-cat">Men</span>
            <span class="bench-main">US 10.5 Men → 28.5 JP</span>
            <span class="bench-aux">285 mm · EU 44 · UK 10.0</span>
          </div>
          <div class="bench-card">
            <span class="bench-cat">Women</span>
            <span class="bench-main">US 7 Women → 24.0 JP</span>
            <span class="bench-aux">240 mm · EU 37.5 · UK 5.0</span>
          </div>
          <div class="bench-card">
            <span class="bench-cat">Women</span>
            <span class="bench-main">US 7.5 Women → 24.5 JP</span>
            <span class="bench-aux">245 mm · EU 38.0 · UK 5.5</span>
          </div>
          <div class="bench-card">
            <span class="bench-cat">Women</span>
            <span class="bench-main">US 8 Women → 25.0 JP</span>
            <span class="bench-aux">250 mm · EU 38.5 · UK 6.0</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Tabbed Charts Band -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">US to Japan shoe size conversion charts</h2>
        <p class="section-sub">Metric centimeter, Japanese Industrial Standard, and international size mappings.</p>

        <div class="tab-row" role="tablist" aria-label="Footwear Category Tables">
          <button class="tab-btn active" role="tab" aria-selected="true" data-target="panel-men">Men's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-women">Women's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-kids">Kids' Sizes</button>
        </div>

        <!-- Men's Table -->
        <div id="panel-men" class="panel-box active" role="tabpanel">
          <h3 class="panel-title">Men's US to Japan shoe size chart</h3>
          <div class="table-wrap">
            <table class="size-tbl">
              <thead>
                <tr>
                  <th>US Men Size</th>
                  <th>Japan (JP cm)</th>
                  <th>Mondopoint (mm)</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="cell-main"><strong>US {r.us}</strong></td>
                    <td class="cell-hi"><strong>{r.jp.toFixed(1)} cm</strong></td>
                    <td>{Math.round(r.jp * 10)} mm</td>
                    <td>EU {r.eu}</td>
                    <td>UK {r.uk}</td>
                    <td>{r.inch}″</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Table -->
        <div id="panel-women" class="panel-box" role="tabpanel" style="display: none;">
          <h3 class="panel-title">Women's US to Japan shoe size chart</h3>
          <div class="table-wrap">
            <table class="size-tbl">
              <thead>
                <tr>
                  <th>US Women Size</th>
                  <th>Japan (JP cm)</th>
                  <th>Mondopoint (mm)</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="cell-main"><strong>US {r.us}</strong></td>
                    <td class="cell-hi"><strong>{r.jp.toFixed(1)} cm</strong></td>
                    <td>{Math.round(r.jp * 10)} mm</td>
                    <td>EU {r.eu}</td>
                    <td>UK {r.uk}</td>
                    <td>{r.inch}″</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div id="panel-kids" class="panel-box" role="tabpanel" style="display: none;">
          <h3 class="panel-title">Kids' US to Japan shoe size chart</h3>
          <div class="table-wrap">
            <table class="size-tbl">
              <thead>
                <tr>
                  <th>US Kids Size</th>
                  <th>Japan (JP cm)</th>
                  <th>Mondopoint (mm)</th>
                  <th>EU Size</th>
                  <th>Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="cell-main"><strong>US {r.us}</strong></td>
                    <td class="cell-hi"><strong>{r.jp} cm</strong></td>
                    <td>{Math.round(r.jp * 10)} mm</td>
                    <td>EU {r.eu}</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial Prose Section -->
    <article class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">How to convert US to Japan shoe size: footwear guide</h2>
        
        <p class="lead-paragraph">
          When purchasing sneakers from Japanese makers like ASICS and Mizuno, Japanese sizing provides an intuitive reference. Unlike Western systems based on arbitrary scales, the Japanese system is purely metric.
        </p>

        <h3>Understanding Japan shoe size: the JIS S 5037 metric standard</h3>
        <p>
          The official foundation of Japanese footwear is codified under the Japanese Industrial Standard JIS S 5037:1998. Under this standard, shoe size represents the anatomical length of the foot in centimeters, or millimeters under the international Mondopoint standard. A size marked 27.0 accommodates a foot measuring 27.0 centimeters from heel to the tip of the longest toe.
        </p>
        <p>
          A 27.0 cm footbed measures 27.0 cm regardless of whether the footwear is designed for men or women. Because American shoe sizes are segmented into distinct men's and women's scales, converting an American shoe size to Japanese numbers requires gender-specific formulas.
        </p>

        <h3>Core formulas: American shoe size to Japanese conversions</h3>
        <p>
          To approximate shoe size from an American number to a Japanese centimeter size, use these standard conversions:
        </p>
        <ul>
          <li>For adult American men's footwear, adding 18 to your US shoe size approximates your Japanese centimeter size. For example, US Men 7.0 + 18 = 25.0 cm (JP 25.0), and US Men 9.0 + 18 = 27.0 cm (JP 27.0).</li>
          <li>For American women's sizes, adding 17 to your US size gives the approximate Japanese centimeter size. For example, US Women 6.0 + 17 = 23.0 cm (JP 23.0), and US Women 7.5 + 17 = 24.5 cm (JP 24.5).</li>
          <li>Children's footwear in Japan increments by 0.5 cm intervals. An American toddler 6C translates to approximately 13.0 cm, while a little kid 10C corresponds to 16.5 cm.</li>
        </ul>

        <h3>Reverse conversions: Japan shoe size to US equivalence</h3>
        <p>
          International buyers translating Japanese shoe numbers to American sizes can reference these common points:
        </p>
        <ul>
          <li>A Japanese size 24.5 (24.5 cm) converts to an American US Women's 7.5 or an American US Men's 6.5 (European EU 38.5).</li>
          <li>A Japanese size 26.0 (26.0 cm) converts to an American US Men's 8.0 or US Women's 9.0 (European EU 41).</li>
          <li>A Japanese size 27.0 (27.0 cm) converts to an American US Men's 9.0 or US Women's 10.0 (European EU 42).</li>
          <li>A Japanese size 28.0 (28.0 cm) converts to an American US Men's 10.0 or US Women's 11.0 (European EU 43).</li>
        </ul>

        <h3>Japanese footwear brands and width standards</h3>
        <p>
          Foot width is just as important as foot length when ordering shoes. For detailed width measurements, consult our <a href="/what-is-my-shoe-size/">shoe size calculation guide</a>. Under JIS S 5037, standard adult men's footwear in Japan defaults to 2E (EE) width, whereas standard American men's footwear defaults to D width (Medium). Japanese lasts incorporate a wider forefoot ball girth. If you have narrow feet, select D width where offered or adjust your sizing accordingly.
        </p>

        <h3>Measuring your foot for a Japan shoe size chart</h3>
        <p>
          Because Japanese sizing reflects your foot length in centimeters, a direct foot measurement provides the most accurate result. For step-by-step tracing instructions, visit our guide on <a href="/shoe-size-by-foot-length/">how to measure foot length</a>.
        </p>
      </div>
    </article>

    <!-- FAQ Accordion Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Answers to common queries about Japanese footwear sizing, metric centimeters, and American conversions.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Links Band -->
    <RelatedLinks title="Related shoe size converters and regional guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resUs = document.getElementById('res-us');
    const resUsSub = document.getElementById('res-us-sub');
    const resJp = document.getElementById('res-jp');
    const resJpSub = document.getElementById('res-jp-sub');
    const resAux = document.getElementById('res-aux');
    const resInch = document.getElementById('res-inch');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.us);
        opt.textContent = `${item.us} US`;
        if (gender === 'men' && item.us === 9.0) opt.selected = true;
        if (gender === 'women' && item.us === 7.5) opt.selected = true;
        if (gender === 'kids' && item.us === '10C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "US Men's Size";
      if (gender === 'women') { list = WOMEN; label = "US Women's Size"; }
      if (gender === 'kids') { list = KIDS; label = "US Kids' Size"; }

      const match = list.find(item => String(item.us) === String(val));
      if (!match) return;

      const mm = Math.round(Number(match.jp) * 10);

      if (resUs) resUs.textContent = String(match.us);
      if (resUsSub) resUsSub.textContent = label;
      if (resJp) resJp.textContent = Number(match.jp).toFixed(1);
      if (resJpSub) resJpSub.textContent = `Centimeters (${mm} mm)`;
      if (resAux) {
        if (gender === 'kids') {
          resAux.textContent = `EU ${match.eu} · ${match.stage}`;
        } else {
          resAux.textContent = `EU ${match.eu} · UK ${match.uk}`;
        }
      }
      if (resInch) {
        resInch.textContent = match.inch ? `${match.inch} inches` : 'Metric';
      }
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.panel-box');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Layout tokens */
  .page-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .pt-4 { padding-top: 16px; }

  /* Hero */
  .hero-band {
    padding: 48px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .hero-content { max-width: 820px; }
  .badge-pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 14px;
    color: var(--v-ink);
  }
  .hero-sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--v-body);
    max-width: 700px;
    margin: 0 auto 20px;
  }
  .hero-answer {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-left: 3px solid var(--v-link);
    border-radius: var(--v-r-md);
    padding: 12px 18px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--v-ink);
    max-width: 640px;
    margin: 0 auto 24px;
    text-align: left;
  }
  .quick-stats-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .stat-badge {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    padding: 6px 16px;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .stat-lbl { color: var(--v-mute); }
  .stat-val { font-weight: 700; color: var(--v-ink); font-family: var(--font-mono); }

