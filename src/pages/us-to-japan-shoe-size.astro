  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content="us to japan shoe size, shoe size conversion japan, american shoe size to japan, american shoe size to japanese, japan shoe size, japan shoe size to american, japan shoe size to us, japan size to us size shoes, japan to american shoe size, jp size shoes, shoe size chart us to japan, shoe size conversion japan to us, shoe size conversion japan us, shoe size japanese to us, shoe size us to jp, 10.5 shoe size in japan, 24.5 japan shoe size to us, 38 shoe size in japan, 41 shoe size in japan, 9.5 us to japan size, eu shoe size to japan, japan foot size to us, japan shoe size chart, japan shoe size cm, japan shoe size to europe, japan shoe size to us shoe size, japan shoe size to us women's, japan shoe sizing to us, japan us shoe size chart" />
