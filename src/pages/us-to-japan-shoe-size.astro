                    <td class="primary-cell"><strong>US {r.us.toFixed(1)}</strong></td>
                    <td class="highlight-cell"><strong>{r.jp.toFixed(1)} cm (JP)</strong></td>
                    <td>{Math.round(r.jp * 10)} mm</td>
                    <td>EU {r.eu.toFixed(1)}</td>
