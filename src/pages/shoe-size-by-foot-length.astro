---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FindMySize from '../components/FindMySize.astro';
import Footer from '../components/Footer.astro';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/shoe-size-by-foot-length/`;
const pageTitle = 'Shoe Size by Foot Length — Men, Women & Kids Chart';
const pageDescription = 'Determine your shoe size by length of foot in cm or inches. Accurate charts for men, women, and kids covering US, UK, EU, India, and Japan.';
const ogImage = `${domain}/og-image.png`;


const faqs = [
  {
    q: 'How to determine shoe size by length of foot?',
    a: 'Stand on a blank paper taped to a hard floor, with your heel lightly touching a flat wall. Trace or mark the tip of your longest toe, keeping the pen perpendicular to the paper. Measure the distance from the edge to the mark in centimeters or millimeters. Then look up that measurement in our chart, adding approximately 10 to 15 mm of space for normal toe movement.'
  },
  {
    q: 'How to find women\'s shoe size by foot length?',
    a: 'Measure your foot in centimeters and refer to the women\'s chart. For instance, a foot measuring 23.5 cm to 24 cm requires a US Women\'s 7.5, UK 5.5, or EU 38. Keep in mind that US Women\'s sizes run 1.5 to 2 sizes higher numerically than US Men\'s for the exact same length.'
  },
  {
    q: 'What is my shoe size by foot length in UK sizing?',
    a: 'UK shoe sizing uses a 1/3-inch (barleycorn) scale. A foot length of 25.5 cm equals UK 7, 26 cm equals UK 7.5, and 27 cm equals UK 8.5. If you shop Indian footwear brands like Bata or Woodland, their sizes match UK sizing one-to-one.'
  },
  {
    q: 'How do kids and child shoe sizes work by foot length?',
    a: 'Kids\' shoe sizing starts at infant size 0C (~8.5 cm) up to youth 7Y (~25 cm). Toddler sizes usually cover 11 to 15 cm, while older children range from 16 to 22 cm. Always measure a child\'s foot standing up with socks on, and add 12 mm (~0.5 inch) to allow for natural growth.'
  },
  {
    q: 'Should I size up if my foot measurement is between two sizes?',
    a: 'Yes, always choose the larger size. Feet swell throughout the day, and shoes that fit tightly against your toes can lead to ingrown toenails and blisters. You can always add a thin insole or wear cushioned socks to secure a roomier fit.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content="shoe size by foot length, women's shoe size by foot length, shoe size by foot length uk, kids shoe size by foot length, child shoe size by foot length, how to determine shoe size by length of foot" />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />
  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
