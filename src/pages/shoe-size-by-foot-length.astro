---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FindMySize from '../components/FindMySize.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/shoe-size-by-foot-length/`;
const pageTitle = 'Shoe size by foot length: men, women, and kids chart';
const pageDescription = 'Determine your shoe size by length of foot in centimeters or inches. Sizing charts for men, women, and kids covering US, UK, EU, India, and Japan.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'How to determine shoe size by length of foot?',
    a: 'Stand on a blank paper taped to a hard floor, with your heel lightly touching a flat wall. Mark the tip of your longest toe, keeping the pen perpendicular to the paper. Measure the distance from the edge to the mark in centimeters or millimeters. Then look up that measurement in our chart, adding approximately 10 to 15 mm of space for normal toe movement.'
  },
  {
    q: 'How to find women\'s shoe size by foot length?',
    a: 'Measure your foot in centimeters and refer to the women\'s chart. For instance, a foot measuring 24.0 cm corresponds to a US Women\'s 7.0, UK 5.0, or EU 37.5. Keep in mind that US Women\'s sizes run numerically higher than US Men\'s for the exact same length.'
  },
  {
    q: 'What is my shoe size by foot length in UK sizing?',
    a: 'UK shoe sizing uses a 1/3-inch (barleycorn) scale. A foot length of 25.5 cm equals UK 7.0, 26.0 cm equals UK 7.5, and 27.0 cm equals UK 8.5. If you shop Indian footwear brands like Bata or Woodland, their sizes match UK sizing one-to-one.'
  },
  {
    q: 'How do kids and child shoe sizes work by foot length?',
    a: 'Kids\' shoe sizing starts at infant size 1C (~11.0 cm) up to youth 5Y (~23.5 cm). Toddler sizes usually cover 11 to 15 cm, while older children range from 16 to 22 cm. Always measure a child\'s foot standing up with socks on, and add 12 mm (~0.5 inch) to allow for natural growth.'
  },
  {
    q: 'Should I size up if my foot measurement is between two sizes?',
    a: 'Yes, choose the larger size. Feet expand throughout the day, and shoes that fit tightly against your toes can lead to irritation and blisters. You can add a thin insole or wear cushioned socks to secure a roomier fit.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />
  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Shoe Size by Foot Length' },
    ]} />

    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Foot Length to Shoe Size</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,48px)">Shoe size by foot length</h1>
        <p class="hero-sub body-lg">Measure your foot from heel to toe in centimeters or inches, and find your shoe size across US, UK, EU, India, and Japan.</p>
        <div class="hero-badges">
          <span class="badge-trust">Men, Women and Kids</span>
          <span class="badge-trust">Centimeters and Inches</span>
          <span class="badge-trust">Unified Standards</span>
        </div>
      </div>
    </section>

    <FindMySize />

    <section class="table-band">
      <div class="page-inner">
        <h2 class="heading-md">Men's foot length to shoe size chart</h2>
        <div class="scroll-x">
          <table class="size-table" aria-label="Men foot length to shoe size chart">
            <thead><tr><th>Foot Length (CM)</th><th>Inches</th><th>US Men</th><th>UK</th><th>EU</th><th>India</th><th>Japan (CM)</th></tr></thead>
            <tbody>
              {MEN_SIZE_ROWS.map(r => (
                <tr>
                  <td><strong>{r.cm.toFixed(1)}</strong></td>
                  <td>{r.inch.toFixed(1)}″</td>
                  <td>US {r.us}</td>
                  <td>UK {r.uk}</td>
                  <td>EU {r.eu}</td>
                  <td>India {r.india}</td>
                  <td>{r.cm.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="heading-md" style="margin-top:48px">Women's shoe size by foot length</h2>
        <div class="scroll-x">
          <table class="size-table" aria-label="Women foot length to shoe size chart">
            <thead><tr><th>Foot Length (CM)</th><th>Inches</th><th>US Women</th><th>UK</th><th>EU</th><th>India</th><th>Japan (CM)</th></tr></thead>
            <tbody>
              {WOMEN_SIZE_ROWS.map(r => (
                <tr>
                  <td><strong>{r.cm.toFixed(1)}</strong></td>
                  <td>{r.inch.toFixed(1)}″</td>
                  <td>US {r.us}</td>
                  <td>UK {r.uk}</td>
                  <td>EU {r.eu}</td>
                  <td>India {r.india}</td>
                  <td>{r.cm.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="heading-md" style="margin-top:48px">Kids and child shoe size by foot length</h2>
        <div class="scroll-x">
          <table class="size-table" aria-label="Kids and child foot length to shoe size chart">
            <thead><tr><th>Foot Length (CM)</th><th>Inches</th><th>US Kids</th><th>UK Child</th><th>EU Kids</th><th>India</th><th>Stage</th></tr></thead>
            <tbody>
              {KIDS_SIZE_ROWS.map(r => (
                <tr>
                  <td><strong>{r.cm}</strong></td>
                  <td>{r.inch}″</td>
                  <td>US {r.us}</td>
                  <td>UK {r.uk}</td>
                  <td>EU {r.eu}</td>
                  <td>India {r.india}</td>
                  <td>{r.stage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="tip-box">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <p>Always measure feet in the late afternoon. Standing and walking during the day expands feet slightly due to normal blood flow. Measuring in the evening ensures you do not buy shoes that pinch during full days on your feet.</p>
        </div>
      </div>
    </section>

    <!-- Comprehensive Foot Length Guide -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">Foot Length Sizing Guide</p>
            <h2 class="prose-main-title">Why foot length provides a universal sizing baseline</h2>
            <p class="prose-lead">Shoe size numbers are regional conventions. Your actual foot length in centimeters provides a reliable measurement across brands.</p>
          </header>

          <div class="content-prose">
            <p>Shoe size numbers vary across countries. In the United Kingdom, sizes increment by 1/3 inch (one barleycorn). The United States uses that same 1/3-inch increment but starts at a different base point and adds separate offsets for men and women. European manufacturers use Paris Points (2/3 of a centimeter per size). A person wearing a US Men's 9 fits a UK 8.5, an EU 42, an India 8.5, or a Japanese 27.0. Physical foot measurement in centimeters resolves regional differences.</p>

            <h3 class="heading-md">How foot length relates to shoe interior clearance</h3>
            <p>Shoes are built around molds known as lasts. A correctly fitted shoe includes 10 to 15 millimeters (approx. 0.4 to 0.6 inches) of clearance beyond your longest toe.</p>
            
            <div class="prose-callout">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <p>Ensure you have roughly one thumbnail width (12 to 15 mm) between your longest toe and the front tip of the shoe when standing upright. This clearance accommodates forward foot slide during walking.</p>
            </div>

            <p>This toe clearance allows your foot to elongate naturally as your arch flattens during weight-bearing movement. Without this buffer, your toes strike the front bumper, causing irritation.</p>

            <h3 class="heading-md">Women's shoe size by foot length: fit nuances</h3>
            <p>While an adult woman and an adult man might both measure 24.5 cm from heel to toe, their footwear needs differ. Female feet generally display a narrower heel in proportion to the forefoot. When women buy men's or unisex shoes based purely on foot length, they often experience heel slippage. Women purchasing unisex athletic models can select brands that construct women's models on dedicated lasts.</p>

            <h3 class="heading-md">Tracking child foot length as feet grow</h3>
            <p>Children's feet develop rapidly, and pliable cartilage means children often do not notice when shoes have become tight. Measuring foot length on a regular schedule prevents ill-fitting footwear:</p>
            <ul>
              <li>Toddlers between ages 1 and 3 grow approximately 1.5 millimeters per month, requiring checks every 2 to 3 months.</li>
              <li>Young children between ages 4 and 8 grow roughly 1 millimeter per month, making checks every 4 months advisable.</li>
              <li>Youth aged 9 and older experience growth spurts alongside height changes, requiring measurement every 6 months.</li>
            </ul>
            <p>Do not purchase children's shoes two sizes too large to grow into. Excessive length causes the child's foot to bend behind the shoe's engineered flex point, causing tripping. Keep extra toe room to roughly 12 millimeters (~0.5 inch).</p>

            <h3 class="heading-md">How to handle uneven foot measurements</h3>
            <p>Most individuals have one foot that measures slightly longer or wider than the other, often by 3 to 6 millimeters. Always size your footwear to fit the larger foot. You can adjust the fit for the smaller foot with a thin insole insert or tongue pad.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="faq-band" id="faq">
      <div class="page-inner">
        <p class="mono-eyebrow">Help and Guidelines</p>
        <h2 class="heading-md">Frequently asked questions</h2>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <div class="faq-item">
              <button class="faq-trigger" aria-expanded="false" id={`flfaq-${i}`} aria-controls={`flfaq-c-${i}`}>
                <span>{f.q}</span>
                <span class="faq-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                  </svg>
                </span>
              </button>
              <div class="faq-content" id={`flfaq-c-${i}`} role="region" aria-labelledby={`flfaq-${i}`}>
                <div class="faq-inner">{f.a}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero { padding: 48px 24px 40px; background: var(--v-canvas); }
  .page-inner { max-width: 900px; margin: 0 auto; }
  .hero-sub { margin: 12px 0 20px; max-width: 600px; }
  .hero-badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .table-band { padding: 64px 24px; background: var(--v-canvas); border-top: 1px solid var(--v-hairline); }
  .tip-box { display: flex; gap: 12px; align-items: flex-start; margin-top: 32px; padding: 16px 20px; background: var(--v-elevated); border: 1px solid var(--v-hairline); border-radius: var(--v-r-md); font-size: 13px; color: var(--v-body); line-height: 20px; }
  .tip-box svg { flex-shrink: 0; margin-top: 2px; color: var(--v-link); }
  .tip-box p { margin: 0; }
  @media (max-width: 640px) {
    .page-hero { padding: 32px 16px; }
    .table-band { padding: 48px 16px; }
  }
</style>

<script>
  document.querySelectorAll('.faq-trigger').forEach(t => {
    t.addEventListener('click', () => {
      const exp = t.getAttribute('aria-expanded') === 'true';
      t.setAttribute('aria-expanded', String(!exp));
      t.nextElementSibling?.classList.toggle('open', !exp);
    });
  });
</script>
