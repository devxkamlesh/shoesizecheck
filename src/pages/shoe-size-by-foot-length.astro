              <tr><td>27.5</td><td>10.8"</td><td>9.5</td><td>9</td><td>42</td><td>8.5</td><td>27.5</td></tr>
              <tr><td>28.0</td><td>11.0"</td><td>10</td><td>9.5</td><td>43</td><td>9</td><td>28</td></tr>
              <tr><td>28.5</td><td>11.2"</td><td>10.5</td><td>10</td><td>43</td><td>9.5</td><td>28.5</td></tr>
              <tr><td>29.0</td><td>11.4"</td><td>11</td><td>10.5</td><td>44</td><td>10</td><td>29</td></tr>
