            <thead><tr><th>Foot Length (CM)</th><th>Inches</th><th>US Kids</th><th>UK Child</th><th>EU Kids</th><th>Age Category</th></tr></thead>
            <tbody>
              <tr><td>11.0</td><td>4.3"</td><td>1C</td><td>0.5</td><td>17</td><td>Infant (0–6 mo)</td></tr>
              <tr><td>12.0</td><td>4.7"</td><td>2C</td><td>1</td><td>18</td><td>Infant (6–12 mo)</td></tr>
