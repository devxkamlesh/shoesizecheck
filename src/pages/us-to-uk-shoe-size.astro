---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/us-to-uk-shoe-size/`;
const pageTitle = 'US to UK shoe size converter: American to British chart';
const pageDescription = 'Convert US shoe sizes to UK sizes. Accurate US to UK conversion chart for men, women, and kids with shoe size guides, formulas, and brand tips.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'What is the formula to convert US shoe sizes to UK?',
    a: 'To convert a US shoe size to UK, subtract 0.5 from American men\'s sizes (UK = US − 0.5; for example, US 10 Men = UK 9.5). For American women\'s sizes, subtract 2 full sizes (UK = US − 2; for example, US 8 Women = UK 6). For children\'s footwear, UK sizes are typically 0.5 to 1 size smaller than US.'
  },
  {
    q: 'How do US women\'s shoe sizes compare to UK women\'s sizes?',
    a: 'US women\'s shoe sizes are 2 sizes larger than British UK women\'s sizes because their sizing scales start from different reference points. An American woman wearing a US 7 wears a UK 5 (24.0 cm footbed), and a US 8 woman corresponds to a UK 6 (25.0 cm footbed).'
  },
  {
    q: 'Why are US shoe sizes different from UK sizes if both use inches?',
    a: 'Both systems use the barleycorn standard (1/3 inch per full size step). The US scale begins size 1 at a 3 11/12 inch last length for children, whereas the UK scale begins at 4 inches. Over successive adult size increments, this historical offset produces a 0.5-size gap in men\'s footwear and a 2-size gap in women\'s footwear.'
  },
  {
    q: 'How do I convert half sizes from US to UK footwear?',
    a: 'Both systems use identical 1/6 inch (4.23 mm) increments for half sizes. In men\'s sizing, the half size drops by 0.5 (for example, US 9.5 becomes UK 9.0; US 8.5 becomes UK 8.0). In women\'s sizing, subtract 2 from the half size (for example, US 8.5 becomes UK 6.5; US 7.5 becomes UK 5.5).'
  },
  {
    q: 'Do athletic sneaker brands fit the same across US and UK sizes?',
    a: 'Athletic sneaker brands maintain specific international labeling on shoe box tongues. For example, Nike Men\'s US 10 corresponds to UK 9 and EU 44, using a 1-size offset. Adidas Men\'s US 10 corresponds to UK 9.5 and EU 44. To eliminate fitting discrepancies, check the centimetre (CM) footbed measurement.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'UK to US Shoe Size Converter', href: '/uk-to-us-shoe-size/' },
  { label: 'US to EU Shoe Size Converter', href: '/us-to-eu-shoe-size/' },
  { label: 'US to India Shoe Size Converter', href: '/us-to-india-shoe-size/' },
  { label: 'United States Shoe Sizing Guide', href: '/country/us/' },
  { label: 'United Kingdom Shoe Sizing Guide', href: '/country/uk/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'US to UK Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Barleycorn offset conversion</p>
        <h1 class="display-xl">US to UK shoe size converter</h1>
        <p class="hero-sub body-lg">
          Convert American (US) shoe sizes to British (UK) sizes. Use the interactive calculator, review conversion charts for men, women, and kids, and check the math behind cross-Atlantic footwear sizing.
        </p>

        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men's Offset:</span>
            <span class="badge-val">UK = US − 0.5</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women's Offset:</span>
            <span class="badge-val">UK = US − 2.0</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Base Step:</span>
            <span class="badge-val">1/3 Inch (Barleycorn)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert American (US) to British (UK) Size</h2>
            <p class="conv-card-sub">Select your gender and American size to instantly calculate your matching UK shoe size, EU equivalent, and exact foot length.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> American (US) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select American shoe size">
                <option value="" disabled>Select US size</option>
                {menSizes.map(s => <option value={String(s.us)} selected={s.us === 9.0 ? true : undefined}>{s.us} US Men</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">United States (US)</span>
                <span class="conv-val" id="res-us">9</span>
                <span class="conv-note" id="res-us-sub">Men's Standard</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">United Kingdom (UK)</span>
                <span class="conv-val" id="res-uk">8.5</span>
                <span class="conv-note" id="res-uk-sub">UK = US − 0.5</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed Length</span>
                <span class="conv-val-sm" id="res-cm">27.0 cm</span>
                <span class="conv-note" id="res-in-meas">10.6 inches · EU 42</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Popular US to UK Shoe Size Benchmarks</h2>
        <p class="section-sub">Quick reference for the most commonly searched adult sizes when converting American to British footwear.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 8 → UK 7.5</span>
              <span class="snap-detail">Foot length: 26.0 cm · EU 41 · 10.2″</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 9 → UK 8.5</span>
              <span class="snap-detail">Foot length: 27.0 cm · EU 42 · 10.6″</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 10 → UK 9.5</span>
              <span class="snap-detail">Foot length: 28.0 cm · EU 44 · 11.0″</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 11 → UK 10.5</span>
              <span class="snap-detail">Foot length: 29.0 cm · EU 45 · 11.4″</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 7 → UK 5</span>
              <span class="snap-detail">Foot length: 24.0 cm · EU 37.5 · 9.4″</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 8 → UK 6</span>
              <span class="snap-detail">Foot length: 25.0 cm · EU 38.5 · 9.8″</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Comprehensive Conversion Tables -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">Complete US to UK shoe size conversion charts</h2>
        <p class="section-sub">Comprehensive US to UK size chart covering men's, women's, and children's categories with European and metric equivalents.</p>

        <!-- Tabs -->
        <div class="table-tabs" role="tablist" aria-label="Footwear Category Tables">
          <button class="tab-btn active" role="tab" aria-selected="true" data-target="panel-men">Men's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-women">Women's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-kids">Kids' Sizes</button>
        </div>

        <!-- Men's Panel -->
        <div id="panel-men" class="table-panel active" role="tabpanel">
          <h3 class="table-heading">Men's US to UK shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>US Men Size</th>
                  <th>UK Size</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>UK {r.uk}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}″</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Panel -->
        <div id="panel-women" class="table-panel" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Women's US to UK shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>US Women Size</th>
                  <th>UK Size</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>UK {r.uk}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}″</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Panel -->
        <div id="panel-kids" class="table-panel" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Kids' US to UK shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>US Kids Size</th>
                  <th>UK Kids Size</th>
                  <th>EU Size</th>
                  <th>Footbed (CM)</th>
                  <th>Development Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>UK {r.uk}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- Editorial Guide -->
    <section class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">The complete US to UK shoe size guide: formulas, widths, and brand notes</h2>

        <p class="lead-paragraph">
          Shoppers purchasing footwear from British retailers like Clarks, ASOS, and End Clothing must convert American sizes accurately. Both the American and British sizing systems share the imperial unit of the barleycorn, but an initial offset requires separate calculations for men and women.
        </p>

        <h3>1. Shared barleycorn heritage and scale offsets</h3>
        <p>
          Both the United States and the United Kingdom base their shoe sizing on the barleycorn, an imperial unit of one-third of an inch (8.46 millimeters). A half-size step represents one-sixth of an inch (4.23 mm). Full details on imperial footwear units appear in our <a href="/shoe-size-in-inches/">shoe size in inches guide</a>.
        </p>
        <p>
          American and British sizes differ because their scales start from different baseline points. In the nineteenth century, American manufacturers set their baseline size 1 at 3 11/12 inches, while British lasts started at 4 inches. This produces a consistent half-size offset in men's footwear and a two-size offset in women's footwear.
        </p>

        <h3>2. Converting American men's sizes to British footwear (UK = US − 0.5)</h3>
        <p>
          For men, convert US shoe size to UK by subtracting 0.5 from the American size:
        </p>
        <ul>
          <li>US 7 converts to UK 6.5 (25.0 cm foot length).</li>
          <li>US 7.5 converts to UK 7.0 (25.5 cm foot length).</li>
          <li>US 8 converts to UK 7.5 (26.0 cm foot length).</li>
          <li>US 8.5 converts to UK 8.0 (26.5 cm foot length).</li>
          <li>US 9 converts to UK 8.5 (27.0 cm foot length).</li>
          <li>US 9.5 converts to UK 9.0 (27.5 cm foot length).</li>
          <li>US 10 converts to UK 9.5 (28.0 cm foot length).</li>
          <li>US 10.5 converts to UK 10.0 (28.5 cm foot length).</li>
          <li>US 11 converts to UK 10.5 (29.0 cm foot length).</li>
        </ul>
        <p>
          An American men's size 8 corresponds to UK 7.5 and EU 41.
        </p>

        <h3>3. Converting American women's sizes to British footwear (UK = US − 2)</h3>
        <p>
          In women's footwear, the American scale starts three sizes ahead of men's sizing, while British women's sizing shares the same baseline scale as British men's sizing. To convert, subtract two full sizes:
        </p>
        <ul>
          <li>US 5 converts to UK 3.0 (22.0 cm).</li>
          <li>US 6 converts to UK 4.0 (23.0 cm).</li>
          <li>US 7 converts to UK 5.0 (24.0 cm).</li>
          <li>US 8 converts to UK 6.0 (25.0 cm).</li>
          <li>US 9 converts to UK 7.0 (26.0 cm).</li>
        </ul>
        <p>
          This two-size reduction ensures proper heel-to-ball proportion in women's pumps, loafers, and boots.
        </p>

        <h3>4. Width standards between American and British lasts</h3>
        <p>
          Shoe fit depends on foot width as well as length. American and British manufacturers label widths with different letter codes:
        </p>
        <ul>
          <li>In men's shoes, standard American medium is D, narrow is B or C, and wide is E or 2E. In the UK, medium is F, wide is G, and extra wide is H.</li>
          <li>In women's shoes, standard American medium is B, narrow is 2A, and wide is D. In the UK, standard is D, and wide is E or EEE.</li>
        </ul>
        <p>
          Shoppers with broad feet buying Goodyear-welted British shoes from Church's, Tricker's, or Loake should choose a British G fitting to ensure forefoot room.
        </p>

        <h3>5. Brand conversion notes for athletic and dress shoes</h3>
        <p>
          Major athletic brands follow specific internal conversion charts printed on shoe tongues:
        </p>
        <ul>
          <li>Nike applies a 1-size offset for men: US 10 corresponds to UK 9 and EU 44 for a 28.0 cm foot length. For women, Nike applies a 2.5-size offset: US 8 corresponds to UK 5.5 and EU 39 for a 25.0 cm foot length.</li>
          <li>Adidas uses one-third fractional increments: for men, US 9 translates to UK 8.5 and EU 42 2/3.</li>
          <li>Clarks and Dr. Martens build shoes on British lasts and convert to US by adding 0.5 for men and 2 for women.</li>
        </ul>
        <p>
          To verify your physical foot length before ordering, measure your feet following our <a href="/shoe-size-by-foot-length/">shoe size by foot length guide</a>.
        </p>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Direct answers to common questions about converting US shoe sizes to UK sizes.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0 ? true : undefined}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resUs = document.getElementById('res-us');
    const resUsSub = document.getElementById('res-us-sub');
    const resUk = document.getElementById('res-uk');
    const resUkSub = document.getElementById('res-uk-sub');
    const resCm = document.getElementById('res-cm');
    const resInMeas = document.getElementById('res-in-meas');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.us);
        opt.textContent = `${item.us} US ${gender === 'men' ? 'Men' : gender === 'women' ? 'Women' : ''}`;
        if (gender === 'men' && item.us === 9.0) opt.selected = true;
        if (gender === 'women' && item.us === 8.0) opt.selected = true;
        if (gender === 'kids' && item.us === '10C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      if (gender === 'women') list = WOMEN;
      if (gender === 'kids') list = KIDS;

      const match = list.find(item => String(item.us) === String(val));
      if (!match) return;

      if (resUs) resUs.textContent = String(match.us);
      if (resUsSub) resUsSub.textContent = gender === 'men' ? "US Men's Standard" : gender === 'women' ? "US Women's Standard" : "US Kids' Standard";
      if (resUk) resUk.textContent = String(match.uk);
      if (resUkSub) resUkSub.textContent = gender === 'men' ? "UK = US − 0.5" : gender === 'women' ? "UK = US − 2.0" : "British Children's";
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resInMeas) resInMeas.textContent = match.inch ? `${match.inch} inches · EU ${match.eu}` : `EU ${match.eu} · ${match.stage || 'Youth'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Hero */
  .page-hero {
    padding: 56px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .page-inner { max-width: 960px; margin: 0 auto; }
  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    color: var(--v-ink);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .hero-sub { font-size: 16px; color: var(--v-body); line-height: 26px; max-width: 680px; margin: 0 auto 24px; }

  /* Quick Stat Badges */
  .quick-stat-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    font-size: 12.5px;
    box-shadow: var(--v-shadow-whisper);
  }
  .badge-label { color: var(--v-mute); }
  .badge-val { font-family: var(--font-mono); font-weight: 700; color: var(--v-ink); }

  /* Converter Band */
  .converter-band { padding: 40px 24px 56px; background: var(--v-canvas); }
  .conv-card {
    padding: 32px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    box-shadow: var(--v-shadow-floating);
