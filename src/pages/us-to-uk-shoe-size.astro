---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/us-to-uk-shoe-size/`;
const pageTitle = 'US to UK Shoe Size Converter — American to British Chart';
const pageDescription = 'Convert US shoe sizes to UK sizes instantly. Accurate US to UK conversion chart for men, women, and kids with shoe size guides, formulas, and brand tips.';
const ogImage = `${domain}/og-image.png`;

// Men's table data (US, UK, EU, CM, Inches)
const menSizes = [
  { us: 6.0, uk: 5.5, eu: 38.5, cm: 24.0, inch: 9.4 },
  { us: 6.5, uk: 6.0, eu: 39.0, cm: 24.5, inch: 9.6 },
  { us: 7.0, uk: 6.5, eu: 40.0, cm: 25.0, inch: 9.8 },
  { us: 7.5, uk: 7.0, eu: 40.5, cm: 25.5, inch: 10.0 },
  { us: 8.0, uk: 7.5, eu: 41.0, cm: 26.0, inch: 10.2 },
  { us: 8.5, uk: 8.0, eu: 41.5, cm: 26.5, inch: 10.4 },
  { us: 9.0, uk: 8.5, eu: 42.0, cm: 27.0, inch: 10.6 },
  { us: 9.5, uk: 9.0, eu: 42.5, cm: 27.5, inch: 10.8 },
  { us: 10.0, uk: 9.5, eu: 43.0, cm: 28.0, inch: 11.0 },
  { us: 10.5, uk: 10.0, eu: 44.0, cm: 28.5, inch: 11.2 },
  { us: 11.0, uk: 10.5, eu: 44.5, cm: 29.0, inch: 11.4 },
  { us: 11.5, uk: 11.0, eu: 45.0, cm: 29.5, inch: 11.6 },
  { us: 12.0, uk: 11.5, eu: 46.0, cm: 30.0, inch: 11.8 },
