---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/eu-to-us-shoe-size/`;
const pageTitle = 'EU to US shoe size converter: European to US chart';
const pageDescription = 'Convert European (EU) shoe sizes to US sizes. Full EU to US conversion charts for men, women, and kids with boot sizing and fit guidelines.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'How do I convert my shoe size from EU to US?',
    a: 'To convert an EU shoe size to US, determine whether you need men\'s or women\'s sizing because the European system is unisex while the US splits by gender. For men, subtract 33 from your European size (for example, EU 42 − 33 = US Men\'s 9). For women, subtract 30.5 (for example, EU 38.5 − 30.5 = US Women\'s 8).'
  },
  {
    q: 'What is EU 42 in US shoe size?',
    a: 'An EU 42 corresponds to US Men\'s 9.0 (27.0 cm foot length). On athletic brand charts like Nike, EU 42 corresponds to US Men\'s 8.5 (26.5 cm).'
  },
  {
    q: 'What is EU 38 and EU 39 in US women\'s sizing?',
    a: 'In women\'s footwear, an EU 38 translates to US Women\'s 7.5 (24.5 cm foot length). An EU 39 corresponds to US Women\'s 8.5 (25.5 cm foot length).'
  },
  {
    q: 'How do EU boot sizes convert to US sizes?',
    a: 'When translating EU boot size to US for hiking boots or winter boots, outdoor boot buyers often choose a half size larger to accommodate thicker socks.'
  },
  {
    q: 'Is European shoe sizing unisex?',
    a: 'European shoe sizing is unisex. An EU 41 fits a 26.5 cm footbed whether labeled for men or women.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'US to EU Shoe Size Converter', href: '/us-to-eu-shoe-size/' },
  { label: 'EU to UK Shoe Size Converter', href: '/eu-to-uk-shoe-size/' },
  { label: 'EU to CM Shoe Size Calculator', href: '/eu-to-cm-shoe-size/' },
  { label: 'European Shoe Sizing Guide', href: '/country/europe/' },
  { label: 'United States Shoe Sizing Guide', href: '/country/us/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
  { label: 'Kids Shoe Size by Age', href: '/kids-shoe-size-by-age/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'EU to US Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Continental Paris Point conversion</p>
        <h1 class="display-xl">EU to US shoe size converter</h1>
        <p class="hero-sub body-lg">
          Convert European (EU) shoe sizes to American (US) sizes. Review conversion charts for men, women, and kids with metric foot lengths and brand notes.
        </p>

        <!-- Quick stat pills -->
        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men Offset:</span>
            <span class="badge-val">US ≈ EU − 33</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women Offset:</span>
            <span class="badge-val">US ≈ EU − 30.5</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">EU Standard:</span>
            <span class="badge-val">Unisex Paris Point</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Converter Tool -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert EU to US Shoe Size</h2>
            <p class="conv-card-sub">Select your gender category and European (EU) shoe size to compute the exact American (US) and footbed centimeter (CM) equivalents.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category / Gender
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Footwear</option>
                <option value="women">Women's Footwear</option>
                <option value="kids">Kids' Footwear</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> European (EU) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select European shoe size">
                <option value="" disabled>Select EU size</option>
                {menSizes.map(s => <option value={String(s.eu)} selected={s.eu === 42 ? true : undefined}>{s.eu} EU</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">European Union (EU)</span>
                <span class="conv-val" id="res-eu">42</span>
                <span class="conv-note" id="res-eu-sub">Paris Point Unisex</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">United States (US)</span>
                <span class="conv-val" id="res-us">9</span>
                <span class="conv-note" id="res-us-sub">Men's Standard</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed Length</span>
                <span class="conv-val-sm" id="res-cm">27.0 cm</span>
                <span class="conv-note" id="res-in">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Popular Benchmarks -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Popular European to American Shoe Size Benchmarks</h2>
        <p class="section-sub">Essential conversion reference points for the most commonly purchased European footwear sizes.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 42 → US Men 9</span>
              <span class="snap-detail">Foot length: 27.0 cm · UK 8.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 43 → US Men 10</span>
              <span class="snap-detail">Foot length: 28.0 cm · UK 9.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 44 → US Men 10.5</span>
              <span class="snap-detail">Foot length: 28.5 cm · UK 10.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 38 → US Women 7.5</span>
              <span class="snap-detail">Foot length: 24.5 cm · UK 5.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 38.5 → US Women 8</span>
              <span class="snap-detail">Foot length: 25.0 cm · UK 6.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 39 → US Women 8.5</span>
              <span class="snap-detail">Foot length: 25.5 cm · UK 6.5</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Charts Section -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">EU and US Shoe Size Chart</h2>
        <p class="section-sub">Comprehensive cross-comparison tables detailing European, American, British, metric centimeter, and imperial inch measurements.</p>

        <!-- Tab Controls -->
        <div class="table-tabs" role="tablist">
          <button class="tab-btn active" data-target="tab-men" role="tab" aria-selected="true">Men's EU to US Chart</button>
          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's EU to US Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' EU to US Chart</button>
        </div>

        <!-- Men's Table -->
        <div class="table-panel active" id="tab-men" role="tabpanel">
          <h3 class="table-heading">Men's European to US shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Men EU to US shoe size conversion chart">
              <thead>
                <tr>
                  <th>EU Size</th>
                  <th>US Size</th>
                  <th>UK Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>EU {r.eu}</strong></td>
                    <td class="highlight-cell"><strong>US {r.us}</strong></td>
                    <td>UK {r.uk}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Table -->
        <div class="table-panel" id="tab-women" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Women's European to US shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Women EU to US shoe size conversion chart">
              <thead>
                <tr>
                  <th>EU Size</th>
                  <th>US Size</th>
                  <th>UK Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>EU {r.eu}</strong></td>
                    <td class="highlight-cell"><strong>US {r.us}</strong></td>
                    <td>UK {r.uk}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div class="table-panel" id="tab-kids" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Kids' European to US shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Kids EU to US shoe size conversion chart">
              <thead>
                <tr>
                  <th>EU Size</th>
                  <th>US Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>EU {r.eu}</strong></td>
                    <td class="highlight-cell"><strong>US {r.us}</strong></td>
                    <td>{r.cm} cm</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- In-Depth SEO Guide -->
    <section class="editorial-band">
      <div class="page-inner prose-article">

        <h2 class="editorial-main-title">Comprehensive EU to US shoe size conversion guide: sizing, lasts, and fit dynamics</h2>

        <p class="lead-paragraph">
          Translating European shoe sizes to American footwear is necessary when buying imported shoes or international athletic apparel online. Because European shoemakers use different base units than American factories, finding your ideal fit requires understanding the relationship between Paris Points and barleycorns.
        </p>

        <h3>1. Paris Points and imperial barleycorns</h3>
        <p>
          The difference between European and American sizing stems from their historical units. In continental Europe, footwear lasts are engineered around the Paris Point, equal to two-thirds of a centimeter (6.67 mm). Every full step in European sizing represents an increase of 6.67 millimeters along the footbed length.
        </p>
        <p>
          In contrast, American footwear manufacturers use the barleycorn system, where one full size equals one-third of an inch (8.46 millimeters), and a half size represents one-sixth of an inch (4.23 millimeters). Full details on imperial footwear units appear in our <a href="/shoe-size-in-inches/">shoe size in inches guide</a>. Because 6.67 mm does not divide evenly into 8.46 mm, whole numbers do not align directly across systems.
        </p>

        <h3>2. Gender scaling: unisex European sizing</h3>
        <p>
          Continental European footwear sizing is unisex. An EU 41 built by a European factory possesses the identical 26.5 cm footbed length whether it is labelled for a man or a woman.
        </p>
        <p>
          American shoemaking, however, maintains distinct numerical scales by gender. A US Men's 8.5 is engineered for a 26.5 cm foot, while a US Women's 8.5 fits a foot measuring roughly 25.5 cm. Consequently, when converting an EU size to US, gender determines the result: an EU size 40 translates to US Men's 7.0 (25.0 cm), but corresponds to US Women's 9.0 (26.0 cm).
        </p>

        <h3>3. Mental math formulas from EU to US</h3>
        <p>
          When you need quick mental math to convert an EU size to US, keep these formulas in mind:
        </p>
        <ul>
          <li>For men, subtract 33 from the European size to approximate American men's sizing (for example, EU 42 − 33 = US Men's 9).</li>
          <li>For women, subtract 30.5 from the European size to approximate American women's sizing (for example, EU 38.5 − 30.5 = US Women's 8).</li>
          <li>To reverse the calculation from US to EU, add 33 for men (US 9 + 33 = EU 42) and add 30.5 for women (US 8 + 30.5 = EU 38.5).</li>
        </ul>

        <h3>4. Converting EU boot sizes to US footwear</h3>
        <p>
          European boot brands like Meindl, Lowa, and Salomon construct uppers with heavy structural reinforcement, waterproof membranes, and dense linings. Because winter and hiking socks are thicker than dress socks, outdoor boot buyers often choose a half size larger to maintain toe clearance on descents.
        </p>

        <h3>5. Brand comparison: American and European manufacturers</h3>
        <p>
          Individual brand conventions can vary from the standard ISO chart:
        </p>
        <ul>
          <li>Nike size labeling differs from the standard ISO chart. On standard conversion charts, EU 42 corresponds to US Men's 9.0 (27.0 cm). Nike size labels list EUR 42 as US Men's 8.5 (26.5 cm) and EUR 42.5 as US Men's 9.0 (27.0 cm).</li>
          <li>Adidas builds on Paris Points and uses fractional third-sizes (such as EU 42 2/3 for US Men's 9 and EU 43 1/3 for US Men's 9.5).</li>
          <li>Dr. Martens and Birkenstock produce footwear in full European integer sizes without half increments.</li>
        </ul>

        <h3>6. Measuring foot length in centimeters</h3>
        <p>
          To find your shoe size without conversion discrepancies, measure your barefoot length in centimeters following our <a href="/shoe-size-by-foot-length/">shoe size by foot length guide</a>. A measurement of 27.0 cm aligns with EU 42 and US Men's 9.0.
        </p>

      </div>
    </section>

    <!-- FAQ Accordion Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Direct answers to common European to American shoe size questions.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0 ? true : undefined}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Links -->
    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resEu = document.getElementById('res-eu');
    const resEuSub = document.getElementById('res-eu-sub');
    const resUs = document.getElementById('res-us');
    const resUsSub = document.getElementById('res-us-sub');
    const resCm = document.getElementById('res-cm');
    const resIn = document.getElementById('res-in');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.eu);
        opt.textContent = `${item.eu} EU`;
        if (gender === 'men' && item.eu === 42) opt.selected = true;
        if (gender === 'women' && item.eu === 38.5) opt.selected = true;
        if (gender === 'kids' && item.eu === 27) opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "Men's Standard";
      if (gender === 'women') { list = WOMEN; label = "Women's Standard"; }
      if (gender === 'kids') { list = KIDS; label = "Kids' Standard"; }

      const match = list.find(item => String(item.eu) === String(val));
      if (!match) return;

      if (resEu) resEu.textContent = String(match.eu);
      if (resEuSub) resEuSub.textContent = "Paris Point Unisex";
      if (resUs) resUs.textContent = String(match.us);
      if (resUsSub) resUsSub.textContent = label;
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resIn) resIn.textContent = match.inch ? `${match.inch} inches` : `${match.stage || 'Metric'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Hero */
  .page-hero {
    padding: 56px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .page-inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    color: var(--v-ink);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .hero-sub {
    font-size: 16px;
    color: var(--v-body);
    line-height: 26px;
    max-width: 680px;
    margin: 0 auto 24px;
  }

  /* Quick Stat Badges */
  .quick-stat-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    font-size: 12.5px;
    box-shadow: var(--v-shadow-whisper);
  }
  .badge-label {
    color: var(--v-mute);
  }
  .badge-val {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--v-ink);
  }

  /* Converter Band */
  .converter-band {
    padding: 40px 24px 56px;
    background: var(--v-canvas);
  }
  .conv-card {
    padding: 32px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    box-shadow: var(--v-shadow-floating);
  }
  .conv-card-header {
    margin-bottom: 24px;
  }
  .heading-md {
    font-size: 22px;
    font-weight: 700;
    color: var(--v-ink);
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  .conv-card-sub {
    font-size: 14px;
    color: var(--v-mute);
    margin: 0;
  }

  .conv-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  .step-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--v-ink);
    margin-bottom: 8px;
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--v-link);
    color: #ffffff;
    font-size: 11px;
    font-family: var(--font-mono);
    border-radius: var(--v-r-full);
  }
  .form-select {
    width: 100%;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--v-ink);
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
