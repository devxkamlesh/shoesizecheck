          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's EU to US Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' EU to US Chart</button>
        </div>

        <!-- Men's Table -->
