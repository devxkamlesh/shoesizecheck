---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content="us to eu shoe size, us to euro shoe size, european shoe size to american, us to european shoe size, american shoe size to european, american shoe size to eu, european foot size to us, eu foot size to us, us foot size to eu, european us shoe size chart, eu to american shoe size, us and eu shoe sizes, us and european shoe sizes, american and european shoe sizes, eu and us shoe size chart, eu boot size to us, eu to us foot size, feet size us to eu, shoes size chart us to eu" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'EU to US Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Continental Paris Point to American Barleycorn Conversion</p>
        <h1 class="display-xl">EU to US Shoe Size Converter</h1>
        <p class="hero-sub body-lg">
          Convert European shoe sizes to American standards instantly across men’s, women’s, and kids’ footwear. Explore calibrated conversion charts, metric centimeter comparisons, and cross-border fit guidance.
        </p>

        <!-- Quick stat pills -->
        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men Offset:</span>
            <span class="badge-val">US ≈ EU − 33</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women Offset:</span>
            <span class="badge-val">US ≈ EU − 30.5</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">EU Standard:</span>
            <span class="badge-val">Unisex Paris Point</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Converter Tool -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert EU to US Shoe Size</h2>
            <p class="conv-card-sub">Select your gender category and European (EU) shoe size to compute the exact American (US) and footbed centimeter (CM) equivalents.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category / Gender
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Footwear</option>
                <option value="women">Women's Footwear</option>
                <option value="kids">Kids' Footwear</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> European (EU) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select European shoe size">
                <option value="" disabled>Select EU size</option>
                {menSizes.map(s => <option value={String(s.eu)} selected={s.eu === 42 ? true : undefined}>{s.eu} EU</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">European Union (EU)</span>
                <span class="conv-val" id="res-eu">42</span>
                <span class="conv-note" id="res-eu-sub">Paris Point Unisex</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">United States (US)</span>
                <span class="conv-val" id="res-us">9</span>
                <span class="conv-note" id="res-us-sub">Men's Standard</span>
