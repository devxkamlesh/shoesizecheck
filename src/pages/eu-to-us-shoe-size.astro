          <div class="snap-card">
            <span class="snap-tag">Men Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 42 → US Men 9</span>
              <span class="snap-detail">Foot length: 27.0 cm · UK 8.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 43 → US Men 10</span>
              <span class="snap-detail">Foot length: 28.0 cm · UK 9.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 44 → US Men 10.5</span>
              <span class="snap-detail">Foot length: 28.5 cm · UK 10.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 38 → US Women 7.5</span>
              <span class="snap-detail">Foot length: 24.5 cm · UK 5.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 38.5 → US Women 8</span>
              <span class="snap-detail">Foot length: 25.0 cm · UK 6.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Standard</span>
            <div class="snap-body">
              <span class="snap-main">EU 39 → US Women 8.5</span>
              <span class="snap-detail">Foot length: 25.5 cm · UK 6.5</span>
            </div>
