---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA, MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/korea/`;
const pageTitle = 'Korea Shoe Size Chart: Korean MM Sizing and Footwear Guide';
const pageDescription = 'Korea shoe size chart for men, women, and kids. Convert Korean millimeter sizes (KR mm) to US, UK, EU, and CM with Musinsa and brand guides.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'How does a Korea shoe size work?',
    a: 'In South Korea, shoe size is based directly on anatomical foot length measured in millimeters according to national standard KS M 6681. A Korea shoe size of 260 means the shoe accommodates a foot measuring 260 millimeters (26.0 centimeters). Sizes increase in 5 mm increments.'
  },
  {
    q: 'What is foot size in Korea compared to US shoe sizes?',
    a: 'Under ISO/TS 19407:2015 tables for men, Korea 260 mm converts to US Men 8.0, 265 mm equals US Men 8.5, 270 mm equals US Men 9.0, and 280 mm equals US Men 10.0. For women, Korea 230 mm converts to US Women 6.0, 235 mm equals US Women 6.5, 240 mm equals US Women 7.0, and 250 mm equals US Women 8.0.'
  },
  {
    q: 'How do you convert Korea shoe sizes to Japanese or centimeter sizes?',
    a: 'South Korea and Japan follow the metric Mondopoint framework. South Korea measures in millimeters, while Japan measures in centimeters. Divide the Korean millimeter size by 10 to obtain centimeters: KR 270 mm equals JP 27.0 cm.'
  },
  {
    q: 'How do children shoe sizes work in Korea?',
    a: 'Children shoe sizes in South Korea follow the continuous metric millimeter scale. Infant sizes start at 105 mm (10.5 cm), toddler sizes run from 115 mm to 155 mm, and youth sizes span from 160 mm to 220 mm.'
  },
  {
    q: 'How do popular Korean footwear brands like Fila Korea, Pro-Specs, and MLB Korea fit?',
    a: 'Fila Korea chunky sneakers fit true to Korean millimeter length, though buyers with wider feet often select a half size up (5 mm larger). Pro-Specs athletic shoes are designed for East Asian foot morphology with generous forefoot room and secure heel fit.'
  },
  {
    q: 'Are Korean shoe sizes unisex in length?',
    a: 'Physical length in millimeters is unisex: a size 250 shoe represents a 250 mm footbed in men or women styles. Women models are lasted with narrower heel cups and lower instep volume than men models of the same millimeter number.'
  },
  {
    q: 'What is the most common foot size in Korea for men and women?',
    a: 'For adult women in South Korea, the most common sizes on platforms like Musinsa are 235 mm, 240 mm, and 245 mm. For adult men, the most common sizes sold across retail stores in Seoul are 265 mm, 270 mm, and 275 mm.'
  },
  {
    q: 'How do I perform an accurate foot size measurement at home for Korean footwear?',
    a: 'Tape a sheet of paper to a hard floor against a flat wall. Stand upright with your heel touching the wall. Mark the tip of your longest toe with a vertical pencil. Measure the distance from the paper edge to your pencil mark in millimeters. That millimeter number is your Korean shoe size.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const conversionLinks = [
  { label: 'Shoe Size in CM', href: '/shoe-size-in-cm/' },
  { label: 'Mondopoint Shoe Size Guide', href: '/mondopoint-shoe-size/' },
  { label: 'Shoe Size by Foot Length', href: '/shoe-size-by-foot-length/' },
  { label: 'US to EU Shoe Size', href: '/us-to-eu-shoe-size/' },
  { label: 'What Is My Shoe Size?', href: '/what-is-my-shoe-size/' },
  { label: 'Kids Shoe Size by Age', href: '/kids-shoe-size-by-age/' },
];

const countryLinks = [
  { label: 'Japan', href: '/country/japan/' },
  { label: 'China', href: '/country/china/' },
  { label: 'United States', href: '/country/us/' },
  { label: 'United Kingdom', href: '/country/uk/' },
  { label: 'Europe', href: '/country/europe/' },
  { label: 'Australia', href: '/country/australia/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <!-- Open Graph Metadata -->
    <meta property="og:title" content="Korea Shoe Size Chart: Korean MM Sizing and Footwear Guide" />
    <meta property="og:description" content="Korea shoe size chart and Korean footwear guide. Convert Korean millimeter sizes (KR mm) to US, UK, EU, and CM with Musinsa and brand fit guides." />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Korea Shoe Size Chart and Korean Footwear Guide" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Korea Shoe Size Chart: Korean MM Sizing and Footwear Guide" />
    <meta name="twitter:description" content="Korea shoe size chart, foot size guide, and Korean brand sizing matrices for Fila Korea, Pro-Specs, and Musinsa." />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Countries', href: '/country/' },
      { label: 'South Korea' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Korean Mondopoint standard (KS M 6681 and millimeters)</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,46px)">Korea shoe size chart and sizing guide</h1>
        <p class="hero-sub body-lg">Convert Korean shoe sizes measured directly in millimeters (KR mm) to US, UK, EU, and centimeter measurements. Sizing follows KS M 6681 with uniform 5 millimeter intervals.</p>
        <div class="hero-badges">
          <span class="badge-trust">Millimeter sizing (Mondopoint standard)</span>
          <span class="badge-trust">5 mm incremental precision</span>
          <span class="badge-trust">Children shoe sizes in Korea</span>
          <span class="badge-trust">Fila Korea and Pro-Specs guides</span>
        </div>
      </div>
    </section>

    <!-- Interactive Korean Size Converter Tool -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated converter-inline">
          <div class="ci-header">
            <div>
              <p class="mono-eyebrow">Korean footwear conversion</p>
              <h2 class="heading-md">Convert Korea shoe sizes</h2>
            </div>
            <p class="body-sm text-mute">Select your Korean shoe size in millimeters to see international equivalents across US, UK, EU, CM, and Inches.</p>
          </div>

          <div class="ci-row">
            <div class="ci-field">
              <label class="step-label" for="kr-size">
                <span class="step-num">1</span> Korea Shoe Size (MM)
              </label>
              <select id="kr-size" class="form-select ci-size-select" aria-label="Korea shoe size">
                <option value="" disabled selected>Select Korea size (mm)</option>
                {SIZE_DATA.men.korea.map((s, i) => (
                  <option value={String(s)}>KR {s} mm ({SIZE_DATA.men.cm[i]} cm)</option>
                ))}
              </select>
            </div>
            <div class="ci-field">
              <label class="step-label" for="kr-gender">
                <span class="step-num">2</span> Category / Demographic
              </label>
              <select id="kr-gender" class="form-select ci-gender-select" aria-label="Gender">
                <option value="men" selected>Men's Footwear (Korea)</option>
                <option value="women">Women's Footwear (Korea)</option>
                <option value="kids">Childrens Shoe Sizes (Korea)</option>
              </select>
            </div>
          </div>

          <div class="ci-results" id="kr-results" aria-live="polite">
            <p class="ci-placeholder">Select a Korean shoe size to see conversions across US, UK, EU, CM, and Inches</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Reference Tables Section -->
    <section class="table-band">
      <div class="page-inner">
        <header class="section-heading">
          <p class="mono-eyebrow">Master reference charts</p>
          <h2 class="heading-lg">Comprehensive Korea footwear size charts</h2>
          <p class="body-md">Use these master tables to translate Korean millimetre measurements into American, British, European, and centimetre sizing systems.</p>
        </header>

        <!-- 1. Men's Korea Shoe Size Chart -->
        <div class="table-card">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Men Korea shoe size chart</h3>
              <p class="body-sm text-mute">Includes Korean millimetres (KR mm), centimetres (CM), US Men, UK Men, EU, and foot length in inches</p>
            </div>
            <span class="category-pill">Men KS M 6681 standard</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Men's Korea Shoe Size Chart">
              <thead>
                <tr>
                  <th>Korea Size (MM)</th>
                  <th>Foot Length (CM)</th>
                  <th>US Men</th>
                  <th>UK Men</th>
                  <th>EU Size</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {MEN_SIZE_ROWS.map((row) => (
                  <tr>
                    <td><strong>{row.korea ?? Math.round(row.cm * 10)} mm</strong></td>
                    <td>{row.cm.toFixed(1)} cm</td>
                    <td>US {row.us}</td>
                    <td>UK {row.uk}</td>
                    <td>EU {row.eu}</td>
                    <td>{row.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Women's Korea Shoe Size Chart -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Women Korea shoe size chart</h3>
              <p class="body-sm text-mute">Korean women shoe sizes in millimetres, centimetres, US Women, UK Women, and EU</p>
            </div>
            <span class="category-pill">Women KS M 6681 standard</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Women's Korea Shoe Size Chart">
              <thead>
                <tr>
                  <th>Korea Size (MM)</th>
                  <th>Foot Length (CM)</th>
                  <th>US Women</th>
                  <th>UK Women</th>
                  <th>EU Size</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {WOMEN_SIZE_ROWS.map((row) => (
                  <tr>
                    <td><strong>{row.korea ?? Math.round(row.cm * 10)} mm</strong></td>
                    <td>{row.cm.toFixed(1)} cm</td>
                    <td>US {row.us}</td>
                    <td>UK {row.uk}</td>
                    <td>EU {row.eu}</td>
                    <td>{row.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. Childrens Shoe Sizes in Korea Chart -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Children shoe sizes in Korea</h3>
              <p class="body-sm text-mute">From early walking stages (105 mm) through youth sizing (220 mm)</p>
            </div>
            <span class="category-pill">Kids and infant Mondopoint</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Childrens Shoe Sizes in Korea">
              <thead>
                <tr>
                  <th>Korea Size (MM)</th>
                  <th>Age Range Milestone</th>
                  <th>US Kids</th>
                  <th>UK Kids</th>
                  <th>EU Kids</th>
                  <th>Foot Length (CM)</th>
                </tr>
              </thead>
              <tbody>
                {KIDS_SIZE_ROWS.map((row) => (
                  <tr>
                    <td><strong>{Math.round(row.cm * 10)} mm</strong></td>
                    <td>{row.stage}</td>
                    <td>{row.us}</td>
                    <td>{row.uk}</td>
                    <td>{row.eu}</td>
                    <td>{row.cm.toFixed(1)} cm</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 4. Korean Brand Sizing Matrix -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Popular Korean footwear brand sizing guide</h3>
              <p class="body-sm text-mute">Fit advice for Fila Korea, Pro-Specs, MLB Korea, and Musinsa Standard lines</p>
            </div>
            <span class="category-pill">Brand fit guide</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Popular Korean Footwear Brand Sizing Guide">
              <thead>
                <tr>
                  <th>Brand and Style</th>
                  <th>Primary Sizing Used</th>
                  <th>Fit Characteristics</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><strong>Fila Korea (Disruptor / Ray Tracer)</strong></td><td>Korean Millimetres (KR mm)</td><td>Chunky platform silhouette fitting true to mm length. Size up 5 mm for thick socks.</td></tr>
                <tr><td><strong>Pro-Specs (Walking and Running)</strong></td><td>Korean Millimetres (KR mm)</td><td>Engineered for East Asian foot anatomy; provides generous ball width and arch support.</td></tr>
                <tr><td><strong>MLB Korea (Big Ball Chunky)</strong></td><td>Korean Millimetres (KR mm)</td><td>Street sneaker fitting true to size with secure heel collar containment.</td></tr>
                <tr><td><strong>New Balance Korea (Licensed Lines)</strong></td><td>Korean Millimetres (KR mm)</td><td>Matches standard New Balance US and millimeter sizing with regional colorways.</td></tr>
                <tr><td><strong>Musinsa Standard Footwear</strong></td><td>Korean Millimetres (KR mm)</td><td>Dress shoes and loafers fitting true to measured foot length in millimeters.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial prose content -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">Korean footwear architecture</p>
            <h2 class="prose-main-title">Korean shoe size standards and conversion rules</h2>
            <p class="prose-lead">Shoppers browsing retail stores in Seoul or ordering from platforms like Musinsa and Coupang encounter footwear labeled in millimeters. Korean shoe sizing measures anatomical foot length directly under national standard KS M 6681.</p>
          </header>

          <div class="content-prose">
            <h3 class="heading-sm">Metric foot length under Korean standard KS M 6681</h3>
            <p>The metric system defines each shoe size by millimeter foot length. A shoe marked 270 fits a foot measuring 270 millimeters (27.0 centimeters) from the back of the heel to the tip of the longest toe. The scale has no half sizes. Korean shoe sizes advance in regular increments: 250, 255, 260, 265, and 270 mm.</p>
            <p>Nominal footbed length remains unisex. A size 250 shoe provides 250 millimeters of interior length in men or women models. Women shoes incorporate narrower heel cups, lower instep girths, and slimmer ball widths than men footwear of the same millimeter designation.</p>

            <h3 class="heading-sm">Converting Korean sizes to international systems</h3>
            <p>Converting Korean millimeter sizing to Western systems requires separate calculation formulas for adult men and adult women under ISO/TS 19407:2015 tables. Subtracting 180 from the millimeter measurement and dividing by 10 yields the approximate US men size. For example, a Korean 260 mm shoe corresponds to US Men 8.0, 265 mm corresponds to US Men 8.5, and 270 mm corresponds to US Men 9.0. Under ISO/TS 19407:2015, a Korean 270 mm shoe corresponds to UK 8.5 and EU 42.0.</p>
            <p>Women sizing uses a different offset. Subtracting 170 from the millimeter length and dividing by 10 produces the US women shoe size. Under this formula, Korean size 230 mm converts to US Women 6.0, 235 mm converts to US Women 6.5, 240 mm converts to US Women 7.0, and 250 mm converts to US Women 8.0. Converting between Korean and Japanese sizing is direct: Korean size 270 mm equals Japanese size 27.0 cm. Both nations use the Mondopoint standard.</p>

            <h3 class="heading-sm">Children sizing in South Korea</h3>
            <p>Korean children footwear uses the same continuous millimeter scale as adult footwear without resetting numbers between infant and youth categories. Infant sizes cover 105 mm to 135 mm, matching US Kids 2.5C to 6C and EU 18 to 22. Toddler shoes span 140 mm to 175 mm. Youth models span 180 mm to 220 mm, matching US Kids 12C through youth 3.5Y and EU 29 to 35.</p>

            <h3 class="heading-sm">Fit characteristics of major Korean footwear brands</h3>
            <p>Korean footwear manufacturers shape their production lasts to match East Asian foot morphology, which presents wider forefoot dimensions and higher insteps than standard European footwear lasts. Kukje Corporation founded Pro-Specs in 1981 in Seoul, engineering athletic shoes with wider ball girths that fit true to measured millimeter foot length.</p>
            <p>Fila Korea acquired the global Fila brand in 2007. Its Disruptor II sneaker fits snug across the instep, prompting wearers with wider feet to select shoes 5 mm larger than their measured foot length. Musinsa Standard footwear follows strict millimeter lasts. Shoppers determine their Korean shoe size with paper, a pencil, and a millimeter ruler. Place paper on a hard floor against a flat wall, stand barefoot on the paper with heels touching the wall, and mark the longest toe tip. Measure from the edge to the mark in millimeters. Korean shoemakers recommend adding 5 to 10 millimeters of space beyond the longest toe for natural forward foot movement.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <div class="faq-card">
          <p class="mono-eyebrow">Frequently asked questions</p>
          <h2 class="heading-lg" style="margin-bottom:24px">Korea footwear and shoe sizing questions</h2>
          <div class="faq-list">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="faq-a"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Related Internal Links -->
    <section class="related-band">
      <div class="page-inner">
        <RelatedLinks
          title="Popular Asian and metric size conversions"
          links={conversionLinks}
        />
        <div style="margin-top:32px">
          <RelatedLinks
            title="Other regional sizing systems"
            links={countryLinks}
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 64px 24px 40px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1), transparent 60%);
    border-bottom: 1px solid var(--v-hairline);
  }
  .page-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-sub {
    max-width: 720px;
    margin: 16px auto 24px;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .badge-trust {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-body);
  }

  /* Converter Band */
  .converter-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .converter-inline {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: var(--v-shadow-whisper);
  }
  .ci-header {
    margin-bottom: 24px;
  }
  .ci-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  .ci-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ci-results {
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    padding: 20px;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ci-placeholder {
    color: var(--v-mute);
    font-size: 14px;
    margin: 0;
    text-align: center;
  }

  /* Tables band */
  .table-band {
    padding: 48px 24px;
  }
  .section-heading {
    margin-bottom: 32px;
  }
  .table-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    overflow: hidden;
    box-shadow: var(--v-shadow-whisper);
  }
  .table-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--v-hairline);
    background: var(--v-subtle);
  }
  .category-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 10px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-ink);
  }
  .scroll-x {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .size-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }
  .size-table th {
    background: var(--v-canvas);
    padding: 12px 18px;
    font-size: 12px;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--v-hairline);
    color: var(--v-body);
  }
  .size-table td {
    padding: 12px 18px;
    border-bottom: 1px solid var(--v-hairline);
    color: var(--v-ink);
  }
  .size-table tbody tr:last-child td {
    border-bottom: none;
  }
  .size-table tbody tr:hover {
    background: var(--v-subtle);
  }

  /* Prose Article Band */
  .content-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .prose-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 48px;
    box-shadow: var(--v-shadow-whisper);
  }
  .prose-header {
    margin-bottom: 36px;
    border-bottom: 1px solid var(--v-hairline);
    padding-bottom: 28px;
  }
  .prose-main-title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    color: var(--v-ink);
    margin: 12px 0 16px;
    line-height: 1.25;
  }
  .prose-lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--v-body);
  }
  .content-prose h3 {
    margin: 36px 0 14px;
    color: var(--v-ink);
  }
  .content-prose p {
    margin-bottom: 18px;
    line-height: 1.7;
    color: var(--v-body);
    font-size: 15px;
  }
  .content-prose ul, .content-prose ol {
    margin: 0 0 24px 20px;
    color: var(--v-body);
    line-height: 1.7;
    font-size: 15px;
  }
  .content-prose li {
    margin-bottom: 10px;
  }
  .content-prose strong {
    color: var(--v-ink);
  }

  /* FAQs */
  .faq-band {
    padding: 48px 24px;
  }
  .faq-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 40px;
    box-shadow: var(--v-shadow-whisper);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    background: var(--v-canvas);
    transition: all 0.15s ease;
  }
  .faq-item[open] {
    background: var(--v-subtle);
  }
  .faq-q {
    padding: 18px 20px;
    font-weight: 600;
    font-size: 15px;
    color: var(--v-ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.2s ease;
    color: var(--v-mute);
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-a {
    padding: 0 20px 20px;
    color: var(--v-body);
    font-size: 14px;
    line-height: 1.6;
  }
  .faq-a p {
    margin: 0;
  }

  /* Related */
  .related-band {
    padding: 48px 24px 64px;
    background: var(--v-canvas);
  }

  @media (max-width: 768px) {
    .ci-row {
      grid-template-columns: 1fr;
    }
    .prose-card {
      padding: 24px;
    }
    .faq-card {
      padding: 24px;
    }
  }
</style>

<script>
  import { SIZE_DATA } from '../../data/shoe-sizes';

  const sizeSelect = document.getElementById('kr-size') as HTMLSelectElement | null;
  const genderSelect = document.getElementById('kr-gender') as HTMLSelectElement | null;
  const resultsContainer = document.getElementById('kr-results');

  function updateSizes() {
    if (!genderSelect || !sizeSelect) return;
    const gender = (genderSelect.value || 'men') as 'men' | 'women' | 'kids';
    const sizes = SIZE_DATA[gender]?.korea || [];
    const cmSizes = SIZE_DATA[gender]?.cm || [];
    const currentVal = sizeSelect.value;

    sizeSelect.innerHTML = '<option value="" disabled selected>Select Korea size (mm)</option>';
    const seen = new Set();
    sizes.forEach((s, idx) => {
      const val = String(s);
      if (!seen.has(val)) {
        seen.add(val);
        const opt = document.createElement('option');
        opt.value = val;
        const cm = cmSizes[idx] ? ` (${cmSizes[idx]} cm)` : '';
        opt.textContent = `KR ${val} mm${cm}`;
        sizeSelect.appendChild(opt);
      }
    });

    if (currentVal && seen.has(currentVal)) {
      sizeSelect.value = currentVal;
    }
    renderResults();
  }

  function renderResults() {
    if (!resultsContainer || !sizeSelect) return;
    const size = sizeSelect.value;
    if (!size) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Select a Korean shoe size to see instant conversions across US, UK, EU, CM, and Inches</p>';
      return;
    }

    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const data = SIZE_DATA[gender];
    const idx = data.korea?.findIndex(s => String(s) === size);

    if (idx === undefined || idx === -1) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Size not found in database</p>';
      return;
    }

    const us = data.us?.[idx] ?? '-';
    const uk = data.uk?.[idx] ?? '-';
    const eu = data.eu?.[idx] ?? '-';
    const cm = data.cm?.[idx] ?? `${Number(size) / 10}`;
    const inches = data.inches?.[idx] ?? '-';

    resultsContainer.innerHTML = `
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:12px; width:100%;">
        <div style="background:var(--v-elevated); border:1px solid var(--v-link); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-link);">KR Selected</span>
          <div style="font-size:20px; font-weight:700; color:var(--v-ink); margin-top:2px;">KR ${size} mm</div>
          <span style="font-size:11px; color:var(--v-mute); font-family:var(--font-mono);">${cm} cm</span>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">US Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">US ${us}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">UK Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">UK ${uk}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">EU Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">EU ${eu}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Centimetres</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${cm} cm</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Inches</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${inches}"</div>
        </div>
      </div>
    `;
  }

  genderSelect?.addEventListener('change', updateSizes);
  sizeSelect?.addEventListener('change', renderResults);
</script>
