const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'How does a Korea shoe size work?',
    a: 'In South Korea, shoe size is based directly on anatomical foot length measured in millimetres (MM) according to national standard KS M 6681. For example, a Korea shoe size of 260 means the shoe is engineered for a foot measuring exactly 260 millimetres (26.0 centimetres). Sizes increase in standard 5 mm increments (e.g., 250, 255, 260, 265, 270 mm).'
  },
  {
    q: 'What is foot size in Korea compared to US shoe sizes?',
    a: 'For men, a Korea shoe size of 260 converts to US Men\'s 8.0, 265 equals US Men\'s 8.5, 270 equals US Men\'s 9.0, and 280 equals US Men\'s 10.0. For women, a Korea size 230 converts to US Women\'s 6.0, 235 equals US Women\'s 6.5, 240 equals US Women\'s 7.0, and 250 equals US Women\'s 8.0.'
  },
  {
    q: 'How do you convert Korea shoe sizes to Japanese or centimetre sizes?',
    a: 'Converting between Korean and Japanese shoe sizing is effortless because both follow metric Mondopoint standards. South Korea measures in millimetres, while Japan measures in centimetres. Simply divide the Korean millimetre size by 10 to obtain the Japanese/centimetre size: KR 270 mm = JP 27.0 cm; KR 240 mm = JP 24.0 cm.'
  },
  {
    q: 'How do childrens shoe sizes work in Korea?',
    a: 'Childrens shoe sizes in South Korea follow the exact same metric millimetre system as adult footwear. Infant first-walker sizes begin at 110 mm (11.0 cm), toddler sizes run from 120 mm to 150 mm (12.0 to 15.0 cm), and young youth sizes span from 160 mm to 220 mm (16.0 to 22.0 cm). Parents simply measure their child\'s foot in millimetres to find their exact size.'
  },
  {
    q: 'How do popular Korean footwear brands like Fila Korea, Pro-Specs, and MLB Korea fit?',
    a: 'Fila Korea chunky lifestyle sneakers (such as the Disruptor and Ray Tracer) fit true to Korean millimetre length, though wearers with wider feet frequently choose a half-size up (5 mm larger) for thicker sock comfort. Pro-Specs athletic shoes are designed specifically for East Asian foot shapes with generous forefoot room and secure heel lock.'
  },
  {
    q: 'Are Korean shoe sizes unisex in length?',
    a: 'Yes, nominal length in Korean shoe sizing is gender-neutral because a millimetre is an absolute physical unit: a size 250 shoe represents a 250 mm footbed whether in men\'s or women\'s styles. However, women\'s models are lasted with narrower heel cups and slimmer midfoot girths than men\'s models of the identical millimetre number.'
  },
  {
    q: 'What is the most common foot size in Korea for men and women?',
    a: 'For adult women in South Korea, the most commonly purchased sizes on platforms like Musinsa and ZigZag are 235 mm, 240 mm, and 245 mm. For adult men, the most common sizes sold across retail stores in Seoul are 265 mm, 270 mm, and 275 mm.'
  },
  {
    q: 'How do I perform an accurate foot size conversion at home for Korean footwear?',
    a: 'To measure your foot for Korean sizing: tape a sheet of paper to a hard floor flush against a flat wall. Stand upright with your heel touching the wall. Mark the tip of your longest toe with a vertical pen. Measure the distance from the paper edge to your pencil mark in millimetres. That exact millimetre figure is your base Korean shoe size.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
