---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/china/`;
const pageTitle = 'China Shoe Size Chart — Chinese to US, UK & EU Sizing Guide';
const pageDescription = 'China shoe size chart for men, women, and kids. Convert Chinese shoe sizes (EU Paris Points & GB/T Mondopoint mm) to US, UK, and CM with brand guides.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'How do shoe sizes work in China?',
    a: 'China officially uses two complementary sizing systems. The everyday commercial standard (China Type 1) mirrors European Paris Point sizing (e.g., China 36 = EU 36, China 42 = EU 42). The official national manufacturing standard (China Type 2, codified under GB/T 3293.1-1998) is based on the metric Mondopoint system measured in millimetres (e.g., a China size 260 represents an anatomical foot length of 260 mm or 26.0 cm).'
  },
  {
    q: 'What is a 36 shoe size in China?',
    a: 'A 36 shoe size in China (or China size 36) corresponds to an anatomical foot length of approximately 230 millimetres (23.0 centimetres). In international women\'s sizing, China 36 translates to a US Women\'s 5.5 to 6.0, a British UK 3.5, an EU 36, and a Japanese JP 23.0 cm.'
  },
  {
    q: 'How does Chinese shoe size conversion work for men and women to US sizes?',
    a: 'Because China Type 1 sizes match European sizes: for men, subtract roughly 33 to find the US equivalent (e.g., China 42 ≈ US Men\'s 8.5 to 9.0; China 43 ≈ US Men\'s 9.5; China 44 ≈ US Men\'s 10.0 to 10.5). For women, subtract roughly 31 (e.g., China 36 ≈ US Women\'s 5.5 to 6.0; China 37 ≈ US Women\'s 6.5; China 38 ≈ US Women\'s 7.5; China 39 ≈ US Women\'s 8.0 to 8.5).'
  },
  {
    q: 'Why do shoes from AliExpress, Shein, and Temu often feel smaller than Western sizes?',
    a: 'Many cross-border online retailers from China use factory lasts designed around East Asian anthropometric profiles, which tend to have a flatter instep and narrower heel proportion. Furthermore, fast-fashion shoe manufacturers often trim interior allowances, making their footwear feel 0.5 to 1 size smaller than Western equivalents. Checking the measured foot length in millimetres (CM/MM) is always recommended.'
  },
  {
    q: 'What does a shoe tag marking like "260 (2.5)" mean on Chinese shoes?',
    a: 'Under the Chinese GB/T 3293.1-1998 standard, "260" denotes your bare foot length in millimetres (260 mm or 26.0 cm), while "(2.5)" denotes the width fitting or ball girth type. Type 1 is narrow, Type 2 and 2.5 are standard regular widths, and Type 3 to 4 represent wide and extra-wide fittings.'
  },
  {
    q: 'How do famous Chinese footwear brands like Li-Ning, Anta, and Feiyue fit?',
    a: 'Performance brands like Li-Ning and Anta fit true to their metric centimetre/millimetre length with secure heel containment and supportive midfoot cages. Feiyue classic martial arts canvas shoes fit slightly roomy with minimal arch structure, while Warrior (Huili) retro canvas sneakers fit true to standard Chinese EU sizing.'
  },
  {
    q: 'What are the most common shoe sizes on a China men\'s shoes size chart?',
    a: 'On a China men\'s shoes size chart, the most common sizes span from China 39 (245 mm / US 6.5) up to China 45 (275 mm / US 11.5). The median sizes sold across Chinese department stores and platforms like Tmall and JD.com are sizes 41, 42, and 43.'
  },
  {
    q: 'How do I measure my foot in centimetres to find my correct Chinese shoe size?',
    a: 'To find your size on a China foot size chart: tape a blank paper sheet to a hard floor against a wall. Stand upright with your heel touching the wall. Mark the tip of your longest toe with a vertical pen. Measure the distance in millimetres from the paper edge to the mark. That number is your exact China Type 2 size (e.g., 240 mm = China 38 / US Women\'s 7.5).'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const conversionLinks = [
