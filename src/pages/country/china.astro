---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA, MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/china/`;
const pageTitle = 'China Shoe Size Chart: Chinese to US, UK and EU Sizing Guide';
const pageDescription = 'China shoe size chart for men, women, and kids. Convert Chinese shoe sizes (EU Paris Points and GB/T Mondopoint mm) to US, UK, and CM with brand guides.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'How do shoe sizes work in China?',
    a: 'China officially uses two complementary sizing systems. The commercial standard (China Type 1) mirrors European Paris Point sizing where China 42 equals EU 42. The national standard under GB/T 3293.1-1998 (China Type 2) uses Mondopoint millimeters, where China 260 represents an anatomical foot length of 260 millimeters or 26.0 centimeters.'
  },
  {
    q: 'What is a 36 shoe size in China?',
    a: 'A 36 shoe size in China corresponds to an anatomical foot length of 230 millimeters (23.0 centimeters). In international women sizing, China 36 translates to US Women 6.0, UK 4.0, EU 36.5, and Japan 23.0 cm.'
  },
  {
    q: 'How does Chinese shoe size conversion work for men and women to US sizes?',
    a: 'China Type 1 sizes match European sizes. For men, China 42 equals EU 42, which converts to US Men 9.0 and UK 8.5 under ISO/TS 19407. For women, China 36.5 equals EU 36.5, which converts to US Women 6.0 and UK 4.0.'
  },
  {
    q: 'Why do shoes from AliExpress, Shein, and Temu fit differently than Western sizes?',
    a: 'Cross-border retailers from China frequently use lasts designed for East Asian foot morphology, which has a flatter instep and different heel proportions. Fast-fashion manufacturers also use tighter lasting allowances. Checking the measured foot length in millimeters provides reliable fit.'
  },
  {
    q: 'What does a shoe tag marking like "260 (2.5)" mean on Chinese shoes?',
    a: 'Under the Chinese GB/T 3293.1-1998 standard, 260 denotes foot length in millimeters (260 mm or 26.0 cm). The number in parentheses, 2.5, designates the ball girth width type. Type 1 is narrow, Type 2 and 2.5 are standard regular widths, and Type 3 to 4 represent wide and extra-wide fittings.'
  },
  {
    q: 'How do Chinese footwear brands like Li-Ning, Anta, and Feiyue fit?',
    a: 'Performance brands like Li-Ning and Anta fit true to their metric millimeter length with secure midfoot containment. Feiyue classic canvas shoes fit slightly roomy with minimal arch structure, while Warrior retro canvas sneakers fit true to standard Chinese EU sizing.'
  },
  {
    q: 'What are the most common shoe sizes on a China men shoe size chart?',
    a: 'The most common sizes span from China 39 (245 mm / US 6.5) to China 45 (275 mm / US 11.5). The median sizes sold across Chinese department stores and platforms like Tmall and JD.com are sizes 41, 42, and 43.'
  },
  {
    q: 'How do I measure my foot in centimeters to find my Chinese shoe size?',
    a: 'Tape a blank sheet of paper to a hard floor against a wall. Stand upright with your heel touching the wall. Mark the tip of your longest toe with a vertical pen. Measure the distance in millimeters from the paper edge to the mark. That number is your exact China Type 2 size, where 240 millimeters equals China 38 or US Women 7.0.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const conversionLinks = [
  { label: 'Shoe Size in CM', href: '/shoe-size-in-cm/' },
  { label: 'Mondopoint Shoe Size Guide', href: '/mondopoint-shoe-size/' },
  { label: 'Shoe Size by Foot Length', href: '/shoe-size-by-foot-length/' },
  { label: 'US to EU Shoe Size', href: '/us-to-eu-shoe-size/' },
  { label: 'What Is My Shoe Size?', href: '/what-is-my-shoe-size/' },
  { label: 'Kids Shoe Size by Age', href: '/kids-shoe-size-by-age/' },
];

const countryLinks = [
  { label: 'Japan', href: '/country/japan/' },
  { label: 'South Korea', href: '/country/korea/' },
  { label: 'United States', href: '/country/us/' },
  { label: 'United Kingdom', href: '/country/uk/' },
  { label: 'Australia', href: '/country/australia/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <!-- Open Graph Metadata -->
    <meta property="og:title" content="China Shoe Size Chart: Chinese to US, UK and EU Sizing Guide" />
    <meta property="og:description" content="China shoe size chart and Chinese footwear guide. Convert Chinese sizes (EU Paris Points and GB/T Mondopoint mm) to US, UK, and CM with brand guides." />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="China Shoe Size Chart and Chinese Sizing Guide" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="China Shoe Size Chart: Chinese to US, UK and EU Sizing Guide" />
    <meta name="twitter:description" content="China shoe size chart, foot size chart, and Chinese brand sizing matrices for Li-Ning, Anta, and Feiyue." />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Countries', href: '/country/' },
      { label: 'China' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Chinese sizing standards (GB/T 3293.1 and continental European)</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,46px)">China shoe size chart and conversion guide</h1>
        <p class="hero-sub body-lg">Convert Chinese footwear sizes to US, UK, EU, and metric measurements. Learn the differences between China Type 1 (European Paris Points) and China Type 2 (GB/T 3293.1 Mondopoint millimeters), with verified tables for men, women, and children.</p>
        <div class="hero-badges">
          <span class="badge-trust">China Type 1 (EU Paris Points)</span>
          <span class="badge-trust">China Type 2 (GB/T Mondopoint mm)</span>
          <span class="badge-trust">China men shoe size chart</span>
          <span class="badge-trust">Li-Ning, Anta and Feiyue fit notes</span>
        </div>
      </div>
    </section>

    <!-- Interactive Chinese Size Converter Tool -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated converter-inline">
          <div class="ci-header">
            <div>
              <p class="mono-eyebrow">Chinese footwear conversion</p>
              <h2 class="heading-md">Convert China shoe sizes</h2>
            </div>
            <p class="body-sm text-mute">Select your Chinese shoe size to view international equivalents.</p>
          </div>

          <div class="ci-row">
            <div class="ci-field">
              <label class="step-label" for="cn-size">
                <span class="step-num">1</span> China Shoe Size
              </label>
              <select id="cn-size" class="form-select ci-size-select" aria-label="China shoe size">
                <option value="" disabled selected>Select China size</option>
                {SIZE_DATA.men.china.map((s, i) => (
                  <option value={String(s)}>China {s} ({SIZE_DATA.men.korea[i]} mm)</option>
                ))}
              </select>
            </div>
            <div class="ci-field">
              <label class="step-label" for="cn-gender">
                <span class="step-num">2</span> Category / Demographic
              </label>
              <select id="cn-gender" class="form-select ci-gender-select" aria-label="Gender">
                <option value="men" selected>Men's Footwear (China)</option>
                <option value="women">Women's Footwear (China)</option>
                <option value="kids">Kids &amp; Toddlers (China)</option>
              </select>
            </div>
          </div>

          <div class="ci-results" id="cn-results" aria-live="polite">
            <p class="ci-placeholder">Select a Chinese shoe size to see conversions across US, UK, EU, CM, and Inches</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Reference Tables Section -->
    <section class="table-band">
      <div class="page-inner">
        <header class="section-heading">
          <p class="mono-eyebrow">Master reference charts</p>
          <h2 class="heading-lg">Comprehensive China footwear size charts</h2>
          <p class="body-md">Use these master conversion tables to translate Chinese shoe sizes into American, British, European, and metric centimetre measurements.</p>
        </header>

        <!-- 1. Men's China Shoe Size Chart -->
        <div class="table-card">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">China men shoe size chart</h3>
              <p class="body-sm text-mute">Includes China Type 1 (EU), China Type 2 (GB/T Mondopoint mm), US Men, UK Men, and foot length</p>
            </div>
            <span class="category-pill">Men national standard</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="China Men Shoe Size Chart">
              <thead>
                <tr>
                  <th>China Size (Type 1)</th>
                  <th>GB/T Metric (Type 2)</th>
                  <th>US Men</th>
                  <th>UK Men</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {MEN_SIZE_ROWS.map((row) => (
                  <tr>
                    <td><strong>China {row.china}</strong></td>
                    <td>{row.korea} mm</td>
                    <td>US {row.us}</td>
                    <td>UK {row.uk}</td>
                    <td>EU {row.eu}</td>
                    <td>{row.cm.toFixed(1)} cm</td>
                    <td>{row.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Women's China Shoe Size Chart -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">China women shoe size chart</h3>
              <p class="body-sm text-mute">Highlights key sizes including China 36, US Women, UK, and metric dimensions</p>
            </div>
            <span class="category-pill">Women national standard</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="China Women Shoe Size Chart">
              <thead>
                <tr>
                  <th>China Size (Type 1)</th>
                  <th>GB/T Metric (Type 2)</th>
                  <th>US Women</th>
                  <th>UK Women</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {WOMEN_SIZE_ROWS.map((row) => (
                  <tr>
                    <td><strong>China {row.china}</strong></td>
                    <td>{row.korea} mm</td>
                    <td>US {row.us}</td>
                    <td>UK {row.uk}</td>
                    <td>EU {row.eu}</td>
                    <td>{row.cm.toFixed(1)} cm</td>
                    <td>{row.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. Kids & Toddler China Shoe Size Chart -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">China kids and toddler shoe size chart</h3>
              <p class="body-sm text-mute">From baby shoes (size 17 / 105 mm) through youth sizing (size 35 / 220 mm)</p>
            </div>
            <span class="category-pill">Infant, toddler and youth</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="China Kids Shoe Size Chart">
              <thead>
                <tr>
                  <th>China Size (Type 1)</th>
                  <th>GB/T Metric (mm)</th>
                  <th>Age Milestone</th>
                  <th>US Kids</th>
                  <th>UK Kids</th>
                  <th>Foot Length (CM)</th>
                </tr>
              </thead>
              <tbody>
                {KIDS_SIZE_ROWS.map((row) => (
                  <tr>
                    <td><strong>China {row.eu}</strong></td>
                    <td>{Math.round(row.cm * 10)} mm</td>
                    <td>{row.stage}</td>
                    <td>{row.us}</td>
                    <td>{row.uk}</td>
                    <td>{row.cm.toFixed(1)} cm</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 4. Chinese Footwear Brand Sizing Guide -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Chinese footwear brand sizing matrix</h3>
              <p class="body-sm text-mute">Fit recommendations for Li-Ning, Anta, Feiyue, Warrior (Huili), Xtep and 361 Degrees</p>
            </div>
            <span class="category-pill">Brand fit guide</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Chinese Footwear Brand Sizing Matrix">
              <thead>
                <tr>
                  <th>Brand and Style</th>
                  <th>Primary Sizing System</th>
                  <th>Fit Characteristics</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><strong>Li-Ning (Way of Wade / Yushuai)</strong></td><td>China / EU and Metric MM</td><td>True to size in length with snug basketball midfoot lockdown. Order true to measured centimeter length.</td></tr>
                <tr><td><strong>Anta (KT Series / Kyrie Line)</strong></td><td>China / EU and Metric MM</td><td>Accommodates wider feet with generous forefoot volume. True to size.</td></tr>
                <tr><td><strong>Feiyue (Classic Martial Arts Plimsolls)</strong></td><td>China Type 1 (EU)</td><td>Canvas upper with vulcanized rubber sole. Fits roomy; order one half size down for barefoot wear.</td></tr>
                <tr><td><strong>Warrior (Huili Heritage Sneakers)</strong></td><td>China Type 1 (EU)</td><td>Shanghai retro sneaker fitting true to China EU sizing with moderate arch support.</td></tr>
                <tr><td><strong>Xtep and 361 Degrees (Road Running)</strong></td><td>China Type 1 and Metric MM</td><td>Performance road marathon lasts where runners often select 0.5 size up for toe splay.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Deep-Dive SEO Editorial Prose Content -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">Chinese footwear standards</p>
            <h2 class="prose-main-title">China shoe size conversion for men, women, and children</h2>
            <p class="prose-lead">Shoe manufacturing in China uses two distinct measurement systems. Domestic consumer retail relies on European Paris Points, while national industrial production follows the metric Mondopoint standard codified in GB/T 3293.1-1998.</p>
          </header>

          <div class="content-prose">
            <h3 class="heading-sm">Chinese sizing standards: Type 1 and Type 2</h3>
            <p>Shoppers buying footwear from Chinese manufacturers encounter two numbering schemes:</p>
            <ul>
              <li>China Type 1 matches the continental European Paris Point standard, where each unit equals 6.67 millimeters. A Chinese size 42 shoe equals an EU 42 and fits a 27.0 centimeter foot. China size 36 matches an EU 36 and fits a 22.5 to 23.0 centimeter foot.</li>
              <li>China Type 2 is the national manufacturing standard established under GB/T 3293.1-1998. It measures bare foot length directly in millimeters with 5 millimeter intervals, such as 240, 245, 250, and 260 millimeters.</li>
            </ul>
            <p>Modern shoe tags often print both standards together. A label marked 260 (2.5) indicates a 260 millimeter foot length with a 2.5 width fitting, which represents a standard medium ball girth under the standard.</p>

            <h3 class="heading-sm">China size 36 and common conversion benchmarks</h3>
            <p>China size 36 is the most widely searched women size on international shopping platforms. The shoe accommodates an anatomical foot length of 230 millimeters, or 23.0 centimeters. Under ISO/TS 19407:2015 tables, China 36 corresponds to US Women 6.0, UK 4.0, and EU 36.5. For men footwear, median production centers on China 41, 42, and 43. China 42 measures 260 millimeters in footbed length and corresponds to US Men 8.5 to 9.0.</p>

            <h3 class="heading-sm">Cross-border shopping on AliExpress, Shein, and Temu</h3>
            <p>Online shoppers on platforms like AliExpress and Temu frequently report differences in shoe fit. Footwear lasts sculpted in Guangdong and Zhejiang factories are built for East Asian anthropometric profiles, which have lower insteps and flatter arches than Western lasts. Budget fashion footwear also uses tighter lasted allowances to reduce fabric waste. Checking the stated millimeter length in the product specification avoids sizing errors.</p>

            <h3 class="heading-sm">Fit notes for Chinese athletic and heritage shoe brands</h3>
            <p>Li-Ning operates in Beijing and designs basketball footwear with firm midfoot containment. The Way of Wade line fits true to its stated metric millimeter length. Anta manufactures shoes in Jinjiang with broader toe boxes to accommodate wide forefoot profiles. Feiyue produces vulcanized martial arts canvas shoes in Shanghai, running slightly wide with minimal arch padding. Warrior began producing canvas sneakers in Shanghai in 1927 and builds shoes on standard European lasts that fit true to labeled size.</p>

            <h3 class="heading-sm">Measuring foot length for Chinese shoe sizes</h3>
            <p>To measure foot length at home, place a sheet of paper against a vertical baseboard. Stand with your heel against the wall and mark the outermost edge of your longest toe with a vertical pencil. Measure the distance in millimeters with a ruler. A foot length of 255 millimeters corresponds to China 41 for men or China 40.5 for women.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <div class="faq-card">
          <p class="mono-eyebrow">Frequently asked questions</p>
          <h2 class="heading-lg" style="margin-bottom:24px">China footwear shoe sizing frequently asked questions</h2>
          <div class="faq-list">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="faq-a"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Related Internal Links -->
    <section class="related-band">
      <div class="page-inner">
        <RelatedLinks
          title="Popular Asian and metric size conversions"
          links={conversionLinks}
        />
        <div style="margin-top:32px">
          <RelatedLinks
            title="Explore other regional sizing systems"
            links={countryLinks}
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 64px 24px 40px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1), transparent 60%);
    border-bottom: 1px solid var(--v-hairline);
  }
  .page-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-sub {
    max-width: 720px;
    margin: 16px auto 24px;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .badge-trust {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-body);
  }

  /* Converter Band */
  .converter-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .converter-inline {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: var(--v-shadow-whisper);
  }
  .ci-header {
    margin-bottom: 24px;
  }
  .ci-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  .ci-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ci-results {
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    padding: 20px;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ci-placeholder {
    color: var(--v-mute);
    font-size: 14px;
    margin: 0;
    text-align: center;
  }

  /* Tables band */
  .table-band {
    padding: 48px 24px;
  }
  .section-heading {
    margin-bottom: 32px;
  }
  .table-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    overflow: hidden;
    box-shadow: var(--v-shadow-whisper);
  }
  .table-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--v-hairline);
    background: var(--v-subtle);
  }
  .category-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 10px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-ink);
  }
  .scroll-x {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .size-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }
  .size-table th {
    background: var(--v-canvas);
    padding: 12px 18px;
    font-size: 12px;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--v-hairline);
    color: var(--v-body);
  }
  .size-table td {
    padding: 12px 18px;
    border-bottom: 1px solid var(--v-hairline);
    color: var(--v-ink);
  }
  .size-table tbody tr:last-child td {
    border-bottom: none;
  }
  .size-table tbody tr:hover {
    background: var(--v-subtle);
  }

  /* Prose Article Band */
  .content-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .prose-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 48px;
    box-shadow: var(--v-shadow-whisper);
  }
  .prose-header {
    margin-bottom: 36px;
    border-bottom: 1px solid var(--v-hairline);
    padding-bottom: 28px;
  }
  .prose-main-title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    color: var(--v-ink);
    margin: 12px 0 16px;
    line-height: 1.25;
  }
  .prose-lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--v-body);
  }
  .content-prose h3 {
    margin: 36px 0 14px;
    color: var(--v-ink);
  }
  .content-prose p {
    margin-bottom: 18px;
    line-height: 1.7;
    color: var(--v-body);
    font-size: 15px;
  }
  .content-prose ul, .content-prose ol {
    margin: 0 0 24px 20px;
    color: var(--v-body);
    line-height: 1.7;
    font-size: 15px;
  }
  .content-prose li {
    margin-bottom: 10px;
  }
  .content-prose strong {
    color: var(--v-ink);
  }

  /* FAQs */
  .faq-band {
    padding: 48px 24px;
  }
  .faq-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 40px;
    box-shadow: var(--v-shadow-whisper);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    background: var(--v-canvas);
    transition: all 0.15s ease;
  }
  .faq-item[open] {
    background: var(--v-subtle);
  }
  .faq-q {
    padding: 18px 20px;
    font-weight: 600;
    font-size: 15px;
    color: var(--v-ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.2s ease;
    color: var(--v-mute);
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-a {
    padding: 0 20px 20px;
    color: var(--v-body);
    font-size: 14px;
    line-height: 1.6;
  }
  .faq-a p {
    margin: 0;
  }

  /* Related */
  .related-band {
    padding: 48px 24px 64px;
    background: var(--v-canvas);
  }

  @media (max-width: 768px) {
    .ci-row {
      grid-template-columns: 1fr;
    }
    .prose-card {
      padding: 24px;
    }
    .faq-card {
      padding: 24px;
    }
  }
</style>

<script>
  import { SIZE_DATA } from '../../data/shoe-sizes';

  const sizeSelect = document.getElementById('cn-size') as HTMLSelectElement | null;
  const genderSelect = document.getElementById('cn-gender') as HTMLSelectElement | null;
  const resultsContainer = document.getElementById('cn-results');

  function updateSizes() {
    if (!genderSelect || !sizeSelect) return;
    const gender = (genderSelect.value || 'men') as 'men' | 'women' | 'kids';
    const sizes = SIZE_DATA[gender]?.china || [];
    const mmSizes = SIZE_DATA[gender]?.korea || [];
    const currentVal = sizeSelect.value;

    sizeSelect.innerHTML = '<option value="" disabled selected>Select China size</option>';
    const seen = new Set();
    sizes.forEach((s, idx) => {
      const val = String(s);
      if (!seen.has(val)) {
        seen.add(val);
        const opt = document.createElement('option');
        opt.value = val;
        const mm = mmSizes[idx] ? ` (${mmSizes[idx]} mm)` : '';
        opt.textContent = `China ${val}${mm}`;
        sizeSelect.appendChild(opt);
      }
    });

    if (currentVal && seen.has(currentVal)) {
      sizeSelect.value = currentVal;
    }
    renderResults();
  }

  function renderResults() {
    if (!resultsContainer || !sizeSelect) return;
    const size = sizeSelect.value;
    if (!size) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Select a Chinese shoe size to see instant conversions across US, UK, EU, CM, and Inches</p>';
      return;
    }

    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const data = SIZE_DATA[gender];
    const idx = data.china?.findIndex(s => String(s) === size);

    if (idx === undefined || idx === -1) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Size not found in database</p>';
      return;
    }

    const us = data.us?.[idx] ?? '-';
    const uk = data.uk?.[idx] ?? '-';
    const eu = data.eu?.[idx] ?? size;
    const cm = data.cm?.[idx] ?? '-';
    const inches = data.inches?.[idx] ?? '-';
    const mm = data.korea?.[idx] ?? `${Number(cm) * 10}`;

    resultsContainer.innerHTML = `
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:12px; width:100%;">
        <div style="background:var(--v-elevated); border:1px solid var(--v-link); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-link);">China Selected</span>
          <div style="font-size:20px; font-weight:700; color:var(--v-ink); margin-top:2px;">China ${size}</div>
          <span style="font-size:11px; color:var(--v-mute); font-family:var(--font-mono);">${mm} mm</span>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">US Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">US ${us}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">UK Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">UK ${uk}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">EU Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">EU ${eu}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Centimetres</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${cm} cm</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Inches</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${inches}"</div>
        </div>
      </div>
    `;
  }

  genderSelect?.addEventListener('change', updateSizes);
  sizeSelect?.addEventListener('change', renderResults);
</script>
