---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import CountrySystemGraph from '../../components/CountrySystemGraph.astro';
import { COUNTRIES, MEN_SIZE_ROWS } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/`;
const pageTitle = 'Shoe Size by Country: International Size Charts';
const pageDescription = 'Compare shoe sizes by country across US, UK, EU, India, Japan, Australia, China, Korea, and Mexico with international conversion charts and guides.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'Which countries share the same shoe sizing system?',
    a: 'Several countries share identical or near-identical footwear sizing systems. The United Kingdom and India both use the British barleycorn scale. Australia uses UK sizing for men and US sizing for women. China has officially adopted European (EU/Paris Point) sizing. The United States and Canada use the identical US sizing system.'
  },
  {
    q: 'What is the most universal shoe sizing standard?',
    a: 'Mondopoint (ISO 9407:2019), which measures anatomical foot length directly in centimeters (used in Japan) or millimeters (used in South Korea and global ski boots), is the most objective and universal standard. Unlike imperial or continental systems, it represents actual foot length rather than arbitrary numbers.'
  },
  {
    q: 'How do European (EU) sizes compare to US and UK sizes?',
    a: 'European sizing is unisex and steps by Paris Points (2/3 cm per size). Under ISO/TS 19407:2015 tables for men, EU 42 corresponds to US Men 9.0 and UK 8.5. For women, EU 39 corresponds to US Women 8.0 and UK 6.0.'
  },
  {
    q: 'Why do Indian shoe sizes follow UK sizing?',
    a: 'Historically, footwear manufacturing standards in India adopted the British imperial barleycorn sizing system. Under IS 1638:1969, India uses a 1:1 length match with UK sizing. In 2022, CSIR-CLRI completed a 3D foot scan survey of 100,000 participants to formulate the Bha sizing standard for Indian foot morphology.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const tableRows = MEN_SIZE_ROWS.filter(r => [7.0, 8.0, 9.0, 10.0, 11.0, 12.0].includes(Number(r.us)));
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content="Shoe Size by Country: International Size Charts" />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Countries' },
    ]} />

    <!-- Hero -->
    <section class="country-hero">
      <div class="hero-inner">
        <p class="mono-eyebrow">Global footwear standards directory</p>
        <h1 class="display-xl">Shoe size by country</h1>
        <p class="hero-lead">
          Explore official footwear sizing systems across nine major regions. Compare international standards, conversion offsets, and localized last specifications.
        </p>
      </div>
    </section>

    <!-- Technical System Topology Network Graph -->
    <CountrySystemGraph />

    <!-- Country Directory -->
    <section class="directory-section">
      <div class="section-inner">
        <h2 class="section-heading">All countries</h2>
        <div class="country-list">
          {COUNTRIES.map(c => (
            <a href={`/country/${c.slug}/`} class="country-row">
              <div class="country-left">
                <span class="country-code">{c.slug.toUpperCase()}</span>
                <div class="country-info">
                  <h3 class="country-name">{c.name}</h3>
                  <span class="country-system">{c.systemLabel} standard</span>
                </div>
              </div>
              <p class="country-desc">{c.description}</p>
              <span class="row-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Global Cross-Comparison Table -->
    <section class="table-section">
      <div class="section-inner">
        <h2 class="section-heading">Quick comparison for men</h2>
        <p class="table-sub">Common adult sizes across primary global standards.</p>
        <div class="table-container">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>US</th>
                <th>UK</th>
                <th>EU</th>
                <th>India</th>
                <th>Japan</th>
                <th>Australia</th>
                <th>Mexico</th>
                <th>CM</th>
                <th>Inches</th>
              </tr>
            </thead>
            <tbody>
              {tableRows.map(r => (
                <tr>
                  <td class="primary-cell">{r.us}</td>
                  <td>{r.uk}</td>
                  <td>{r.eu}</td>
                  <td>{r.india}</td>
                  <td>{r.jp ?? r.cm}</td>
                  <td>{r.australia ?? r.uk}</td>
                  <td>{r.mexico ?? r.uk}</td>
                  <td>{r.cm.toFixed(1)}</td>
                  <td>{r.inch}"</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Sizing Systems Guide -->
    <section class="guide-section">
      <div class="section-inner">
        <article class="guide-content">
          <h2 class="section-heading">How sizing systems work</h2>
          <div class="systems-list">
            <div class="system-item">
              <h3>Barleycorn system</h3>
              <p class="system-countries">US, UK, Australia, India</p>
              <p>Each full size equals 1/3 inch (8.46 mm). Half sizes are 1/6 inch (4.23 mm). Different countries use different starting points, which is why US 9 does not equal UK 9.</p>
            </div>
            <div class="system-item">
              <h3>Paris Point system</h3>
              <p class="system-countries">Europe, China</p>
              <p>Each size equals 2/3 cm (6.67 mm). Sizes are unisex: EU 42 indicates 27.0 cm for men and women.</p>
            </div>
            <div class="system-item">
              <h3>Mondopoint system</h3>
              <p class="system-countries">Japan, Korea, Ski Boots</p>
              <p>Shoe size equals actual foot length in centimeters (Japan) or millimeters (Korea). The international standard is ISO 9407:2019.</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="section-inner">
        <h2 class="section-heading">Frequently asked questions</h2>
        <div class="faq-list">
          {faqs.map(f => (
            <details class="faq-item">
              <summary class="faq-q">{f.q}</summary>
              <div class="faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Hero */
  .country-hero {
    padding: 56px 24px 40px;
    text-align: center;
    border-bottom: 1px solid var(--v-hairline);
  }
  .hero-inner {
    max-width: 640px;
    margin: 0 auto;
  }
  .hero-lead {
    font-size: 15px;
    color: var(--v-body);
    line-height: 24px;
    margin-top: 12px;
  }

  /* Sections */
  .directory-section,
  .table-section,
  .guide-section,
  .faq-section {
    padding: 56px 24px;
    border-bottom: 1px solid var(--v-hairline);
  }
  .table-section { background: var(--v-elevated); }
  .faq-section { background: var(--v-elevated); }

  .section-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .section-heading {
    font-size: 20px;
    font-weight: 700;
    color: var(--v-ink);
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  /* Country List */
  .country-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    overflow: hidden;
    background: var(--v-elevated);
  }
  .country-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    text-decoration: none;
    border-bottom: 1px solid var(--v-hairline);
    transition: background 0.12s ease;
  }
  .country-row:last-child {
    border-bottom: none;
  }
  .country-row:hover {
    background: var(--v-table-hover, rgba(0,0,0,0.02));
  }
  .country-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    min-width: 200px;
  }
  .country-code {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--v-link);
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: 4px;
    padding: 3px 6px;
    line-height: 1;
  }
  .country-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .country-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--v-ink);
    margin: 0;
  }
  .country-system {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--v-mute);
    letter-spacing: 0.02em;
  }
  .country-desc {
    flex: 1;
    font-size: 13px;
    color: var(--v-body);
    line-height: 19px;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .row-arrow {
    flex-shrink: 0;
    color: var(--v-mute);
    transition: color 0.12s ease, transform 0.12s ease;
  }
  .country-row:hover .row-arrow {
    color: var(--v-link);
    transform: translateX(2px);
  }

  /* Table */
  .table-sub {
    font-size: 13px;
    color: var(--v-mute);
    margin: -14px 0 20px;
  }
  .table-container {
    overflow-x: auto;
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    background: var(--v-canvas);
  }
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }
  .comparison-table th {
    background: var(--v-table-head);
    color: var(--v-table-head-text);
    padding: 10px 14px;
    font-weight: 600;
    white-space: nowrap;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .comparison-table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--v-hairline);
    color: var(--v-ink);
    white-space: nowrap;
  }
  .comparison-table tr:last-child td {
    border-bottom: none;
  }
  .comparison-table tr:hover td {
    background: var(--v-table-hover);
  }
  .primary-cell {
    font-weight: 600;
    color: var(--v-link);
  }

  /* Systems Guide */
  .systems-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .system-item {
    padding: 20px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
  }
  .system-item h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--v-ink);
    margin: 0 0 4px;
  }
  .system-countries {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--v-mute);
    margin: 0 0 10px;
    letter-spacing: 0.02em;
  }
  .system-item p:last-child {
    font-size: 13.5px;
    color: var(--v-body);
    line-height: 21px;
    margin: 0;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    overflow: hidden;
    background: var(--v-canvas);
  }
  .faq-item {
    border-bottom: 1px solid var(--v-hairline);
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-q {
    padding: 14px 20px;
    font-size: 14px;
    font-weight: 600;
    color: var(--v-ink);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: '+';
    font-size: 16px;
    font-weight: 400;
    color: var(--v-mute);
    flex-shrink: 0;
    margin-left: 12px;
  }
  .faq-item[open] .faq-q::after {
    content: '−';
  }
  .faq-a {
    padding: 0 20px 14px;
    font-size: 13.5px;
    color: var(--v-body);
    line-height: 21px;
  }
  .faq-a p { margin: 0; }

  /* Responsive */
  @media (max-width: 768px) {
    .country-row {
      flex-wrap: wrap;
      gap: 8px;
    }
    .country-left {
      min-width: unset;
    }
    .country-desc {
      width: 100%;
      padding-left: 36px;
      -webkit-line-clamp: 2;
    }
    .row-arrow {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
    }
    .country-row {
      position: relative;
      padding-right: 44px;
    }
  }
  @media (max-width: 600px) {
    .country-hero { padding: 40px 16px 28px; }
    .directory-section,
    .table-section,
    .guide-section,
    .faq-section { padding: 40px 16px; }
    .section-heading { font-size: 18px; }
  }
</style>
