const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'Are Australian shoe sizes the same as US or UK shoe sizes?',
    a: 'Australian shoe sizing features a unique dual standard. For men, Australian shoe sizes align directly with British sizing (AU Men = UK Men, which is approximately 0.5 to 1 size smaller than US Men). For women, modern Australian retail predominantly aligns with American sizing (AU Women = US Women, which is 2 sizes larger than UK). However, traditional Australian heritage brands may still use UK sizing for women, so always check the centimetre (CM) measurement.'
  },
  {
    q: 'What is a European shoe size 38 in Australia?',
    a: 'An EU 38 in Australia converts to an Australian Women\'s size 7 to 7.5, or an Australian Men\'s size 5. It represents a foot length of approximately 24.0 centimetres (9.4 inches).'
  },
  {
    q: 'What is a European shoe size 40 or 41 in Australia?',
    a: 'An EU 40 shoe in Australia translates to an Australian Women\'s size 9 to 9.5 or an Australian Men\'s size 7 (approx. 25.4 cm). An EU 41 converts to an Australian Women\'s size 10 or an Australian Men\'s size 7.5 to 8 (approx. 25.8 to 26.0 cm).'
  },
  {
    q: 'What is a European shoe size 44 in Australia?',
    a: 'An EU 44 shoe in Australia corresponds to an Australian Men\'s size 9.5 to 10 (US Men\'s 10.5, UK 9.5 to 10), fitting a foot length of approximately 28.0 centimetres (11.0 inches).'
  },
  {
    q: 'How does US shoe sizing convert to Australian shoe sizes for men and women?',
    a: 'For men, Australian sizes are roughly 0.5 to 1 size smaller than American sizes: a US Men\'s 7 is an AU 6 to 6.5, US 8.5 is an AU 7.5 to 8, US 9.5 is an AU 8.5 to 9, US 10.5 is an AU 9.5 to 10, and US 12 is an AU 11 to 11.5. For women in modern Australian retail, sizes are 1:1 with the US: a US Women\'s 7 is an AU Women\'s 7, and a US 8.5 is an AU 8.5.'
  },
  {
    q: 'How does Crocs sizing work in Australia?',
    a: 'Crocs footwear is stamped with US unisex sizing on the sole (indicated by "M" for Men and "W" for Women). Because Australian women\'s sizes match US women\'s sizing, an Australian woman wearing size 8 takes a Crocs W8. For Australian men, because AU matches UK sizing, you must size up by 1 when reading the US "M" stamp: an AU Men\'s size 8 takes a Crocs M9.'
  },
  {
    q: 'How do Blundstone and R.M. Williams boots fit compared to Australian sizes?',
    a: 'Both Blundstone and R.M. Williams manufacture boots using traditional Australian/UK Men\'s sizing. Crucially for Blundstone, half sizes do not add sole length—they only add extra leather width and volume across the instep. For R.M. Williams, boots are crafted in specific width fittings, with "G" representing standard regular fit and "H" denoting wide fit.'
  },
  {
    q: 'What does a 27 cm foot length correspond to in Australian shoe size?',
    a: 'A 27 cm foot length corresponds to an Australian Men\'s size 8.5 to 9 (US Men\'s 9.5 to 10, EU 43) or an Australian Women\'s size 10.5 to 11 (US Women\'s 10.5 to 11).'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
