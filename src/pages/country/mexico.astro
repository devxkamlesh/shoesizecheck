---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA, MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/mexico/`;
const pageTitle = 'Mexico Shoe Size Chart: Mexican Punto and Footwear Guide';
const pageDescription = 'Mexico shoe size chart for men, women, and kids. Convert Mexican Punto Calzado (CM) to US, UK, and EU with León boot fit guides.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'How do shoe sizes work in Mexico (Punto Calzado)?',
    a: 'In Mexico, footwear sizing is based directly on foot length in centimeters, traditionally known as Puntos or Punto Calzado. For instance, a Mexican size 26 means the shoe fits a 26.0 centimeter foot. In daily conversation, clerks drop the leading number 2, referring to size 26 as talla 6.'
  },
  {
    q: 'What does "size 8 en Mexico" mean in footwear?',
    a: '"Size 8 en Mexico" (or talla 8) represents a shoe crafted for a 28 centimeter foot (Punto 28). In international footwear sizing, an adult Mexican men size 8 (28 cm) corresponds to US Men 10.0, UK 9.5, and EU 44.0 under ISO/TS 19407:2015 tables.'
  },
  {
    q: 'What is a 24.5 or 25.5 Mexico shoe size?',
    a: 'A 24.5 Mexico shoe size (Punto 24.5, or talla 4.5) corresponds to an anatomical foot length of 24.5 centimeters. In adult women sizing, it translates to US Women 7.5, UK 5.5, and EU 38.0. A 25.5 Mexico shoe size (Punto 25.5, or talla 5.5) represents 25.5 cm of foot length, mapping to US Women 8.5, US Men 7.5, UK 6.5, and EU 40.5.'
  },
  {
    q: 'What is a 2.5 Mexico shoe size?',
    a: 'A 2.5 Mexico shoe size (Punto 22.5, or talla 2.5) designates a foot measuring 22.5 centimeters. In adult women footwear, it translates to US Women 5.5, UK 3.5, and EU 36.0.'
  },
  {
    q: 'What do Mexican shoe width terms like "Horma Normal" and "Horma Amplia" mean?',
    a: 'In Mexican shoemaking, width is designated by the last (horma). Horma normal represents standard medium width, while horma amplia designates a wide fitting equivalent to an American EE or EEE width. Horma recia provides additional instep volume for work boots.'
  },
  {
    q: 'How do famous Mexican shoe brands like Flexi, Cuadra, and traditional huaraches fit?',
    a: 'Flexi footwear fits true to Mexican centimeter puntos with cushioned insoles. Cuadra western boots fit snug across the instep initially, but vegetable-tanned leather moulds to your arch after break-in. Traditional Mexican huaraches stretch up to 0.5 centimeters, so they should fit comfortably snug when new.'
  },
  {
    q: 'What is a 29.5 Mexico shoe size?',
    a: 'A 29.5 Mexico shoe size (Punto 29.5, or talla 9.5) represents an anatomical foot length of 29.5 centimeters. In men sizing, it corresponds to US Men 11.5, UK 11.0, and EU 45.5.'
  },
  {
    q: 'How do I measure my foot in centimetres to find my shoe size in Mexico?',
    a: 'To determine your Mexican shoe size: place a blank sheet of paper flat on the floor against a vertical wall. Stand barefoot with your heel against the wall. Mark the tip of your longest toe on the paper. Measure the distance in centimeters from the paper edge to your pencil mark. Your measurement in centimeters directly equals your Mexican shoe size in Punto Calzado.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const conversionLinks = [
  { label: 'US to Mexico Shoe Size Converter', href: '/us-to-mexico-shoe-size/' },
  { label: 'Shoe Size in CM', href: '/shoe-size-in-cm/' },
  { label: 'Mondopoint Shoe Size Guide', href: '/mondopoint-shoe-size/' },
  { label: 'Shoe Size by Foot Length', href: '/shoe-size-by-foot-length/' },
  { label: 'What Is My Shoe Size?', href: '/what-is-my-shoe-size/' },
  { label: 'Kids Shoe Size by Age', href: '/kids-shoe-size-by-age/' },
  { label: 'Shoe Size in Inches', href: '/shoe-size-in-inches/' },
];

const countryLinks = [
  { label: 'United States', href: '/country/us/' },
  { label: 'United Kingdom', href: '/country/uk/' },
  { label: 'Europe', href: '/country/europe/' },
  { label: 'Japan', href: '/country/japan/' },
  { label: 'Australia', href: '/country/australia/' },
  { label: 'India', href: '/country/india/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <!-- Open Graph Metadata -->
    <meta property="og:title" content="Mexico Shoe Size Chart: Mexican Punto and Footwear Guide" />
    <meta property="og:description" content="Mexico shoe size chart and conversion guide. Understand Mexican Punto Calzado (CM), León leather boot sizing, Flexi, and Cuadra fits." />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Mexico Shoe Size Chart and Mexican Footwear Guide" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Mexico Shoe Size Chart: Mexican Punto and Footwear Guide" />
    <meta name="twitter:description" content="Comprehensive Mexico shoe size chart, Punto Calzado guidelines, and Mexican boot fitting matrices." />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Countries', href: '/country/' },
      { label: 'Mexico' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Mexican sizing standard</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,46px)">Mexico shoe size chart and Mexican sizing guide</h1>
        <p class="hero-sub body-lg">Mexican footwear sizing uses the metric Punto Calzado system, where each size corresponds to foot length in centimeters. Use this guide to convert Mexican shoe sizes to US, UK, and European standards for men, women, and children.</p>
        <div class="hero-badges">
          <span class="badge-trust">Punto Calzado (Centimeter Sizing)</span>
          <span class="badge-trust">Dual Notation (Talla 27 and Talla 7)</span>
          <span class="badge-trust">Women and Men Reference Charts</span>
          <span class="badge-trust">León Leather Brands</span>
        </div>
      </div>
    </section>

    <!-- Interactive Mexican Size Converter Tool -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated converter-inline">
          <div class="ci-header">
            <div>
              <p class="mono-eyebrow">Instant Mexican footwear conversion</p>
              <h2 class="heading-md">Convert Mexico shoe sizes in real time</h2>
            </div>
            <p class="body-sm text-mute">Select your Mexican shoe size (in centimeter puntos or short notation) and category to view international equivalents.</p>
          </div>

          <div class="ci-row">
            <div class="ci-field">
              <label class="step-label" for="mx-size">
                <span class="step-num">1</span> Mexico Shoe Size (Punto / CM)
              </label>
              <select id="mx-size" class="form-select ci-size-select" aria-label="Mexico shoe size">
                <option value="" disabled selected>Select Mexican size</option>
                {SIZE_DATA.men.mexico.map(s => <option value={String(s)}>MX {s} ({Number(s) >= 20 ? Number(s) - 20 : s})</option>)}
              </select>
            </div>
            <div class="ci-field">
              <label class="step-label" for="mx-gender">
                <span class="step-num">2</span> Category / Demographic
              </label>
              <select id="mx-gender" class="form-select ci-gender-select" aria-label="Gender">
                <option value="men" selected>Men's Footwear (MX)</option>
                <option value="women">Women's Footwear (MX)</option>
                <option value="kids">Kids &amp; Toddlers (MX)</option>
              </select>
            </div>
          </div>

          <div class="ci-results" id="mx-results" aria-live="polite">
            <p class="ci-placeholder">Select a Mexican shoe size to see conversions across US, UK, EU, CM, and Inches</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Reference Tables Section -->
    <section class="table-band">
      <div class="page-inner">
        <header class="section-heading">
          <p class="mono-eyebrow">Master reference charts</p>
          <h2 class="heading-lg">Comprehensive Mexico footwear size charts</h2>
          <p class="body-md">Use these conversion tables to translate Mexican Punto Calzado into international footwear sizes and foot measurements.</p>
        </header>

        <!-- 1. Men's Mexico Shoe Size Chart -->
        <div class="table-card">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Men shoe sizes in Mexico</h3>
              <p class="body-sm text-mute">Mexican Puntos (centimeters), colloquial notation, US Men, UK, EU, and foot length in inches</p>
            </div>
            <span class="category-pill">Men Punto Calzado</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Men shoe size chart for Mexico">
              <thead>
                <tr>
                  <th>Puntos (CM)</th>
                  <th>Colloquial Notation</th>
                  <th>US Men</th>
                  <th>UK Men</th>
                  <th>EU Size</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {MEN_SIZE_ROWS.map(row => {
                  const shortVal = row.mexico != null ? Number(row.mexico).toFixed(1) : (row.cm - 20).toFixed(1);
                  return (
                    <tr>
                      <td><strong>{row.cm.toFixed(1)} cm</strong></td>
                      <td>Talla {shortVal}</td>
                      <td>{row.us}</td>
                      <td>{row.uk}</td>
                      <td>{row.eu}</td>
                      <td>{row.inch}"</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Mexico Shoe Size Chart Women's -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Women shoe sizes in Mexico</h3>
              <p class="body-sm text-mute">Mexican women shoe sizes in Puntos, colloquial notation, US Women, UK, EU, and foot length</p>
            </div>
            <span class="category-pill">Women Punto Calzado</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Women shoe size chart for Mexico">
              <thead>
                <tr>
                  <th>Puntos (CM)</th>
                  <th>Colloquial Notation</th>
                  <th>US Women</th>
                  <th>UK Women</th>
                  <th>EU Size</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {WOMEN_SIZE_ROWS.map(row => {
                  const shortVal = row.mexico != null ? Number(row.mexico).toFixed(1) : (row.cm - 20).toFixed(1);
                  return (
                    <tr>
                      <td><strong>{row.cm.toFixed(1)} cm</strong></td>
                      <td>Talla {shortVal}</td>
                      <td>{row.us}</td>
                      <td>{row.uk}</td>
                      <td>{row.eu}</td>
                      <td>{row.inch}"</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. Kids & Infant Mexico Shoe Size Chart -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Kids and toddler shoe sizes in Mexico</h3>
              <p class="body-sm text-mute">From first steps (10.5 cm) through primary school youth sizing (22.0 cm)</p>
            </div>
            <span class="category-pill">Kids Punto Calzado</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Kids shoe size chart for Mexico">
              <thead>
                <tr>
                  <th>Punto Calzado (CM)</th>
                  <th>Category</th>
                  <th>US Kids</th>
                  <th>UK Kids</th>
                  <th>EU Kids</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {KIDS_SIZE_ROWS.map(row => (
                  <tr>
                    <td><strong>{row.cm.toFixed(1)} cm</strong></td>
                    <td>{row.stage ?? 'Kids'}</td>
                    <td>{row.us}</td>
                    <td>{row.uk}</td>
                    <td>{row.eu}</td>
                    <td>{row.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 4. Mexican Boot & Leather Footwear Fit Guide -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Mexican leather footwear and boot sizing</h3>
              <p class="body-sm text-mute">Fit recommendations for León handcrafted boots, Flexi comfort shoes, and artisanal huaraches</p>
            </div>
            <span class="category-pill">León craftsmanship</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Mexican leather footwear sizing guide">
              <thead>
                <tr>
                  <th>Category or Brand</th>
                  <th>Primary Sizing Used</th>
                  <th>Fit Nuance and Recommendation</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><strong>Flexi comfort shoes</strong></td><td>Mexican Puntos (CM)</td><td>Fits true to size in centimeter puntos with generous ergonomic toe boxes.</td></tr>
                <tr><td><strong>Cuadra western boots</strong></td><td>Mexican Puntos (CM)</td><td>Snug across the instep initially; vegetable-tanned leathers mould after break-in.</td></tr>
                <tr><td><strong>Artisanal huaraches</strong></td><td>Mexican Puntos (CM)</td><td>Woven cowhide stretches up to 0.5 centimeters; choose a snug initial fit.</td></tr>
                <tr><td><strong>Horma amplia (wide last)</strong></td><td>EE or EEE equivalent</td><td>Engineered for high insteps and broad ball girth common in regional lasts.</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial prose content -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">Mexican footwear heritage</p>
            <h2 class="prose-main-title">Mexican shoe size standards and conversion rules</h2>
            <p class="prose-lead">Shoemakers in León, Guanajuato produce more than 70 percent of Mexican footwear under national labeling standard NOM-020-SCFI-1997. Mexican footwear sizing uses foot length in centimeters, known locally as Punto Calzado.</p>
          </header>

          <div class="content-prose">
            <h3 class="heading-sm">The metric basis of the Punto Calzado system</h3>
            <p>Mexican shoe sizes correspond directly to anatomical foot length measured in centimeters. Under Mexican national trade standard NOM-020-SCFI-1997, a shoe labeled Punto 27 accommodates an anatomical foot measuring exactly 27.0 centimeters from the back of the heel to the tip of the longest toe. The scale advances in half-centimeter steps. These include 26.0, 26.5, 27.0, and 27.5 cm. This metric framework matches Japanese sizing. Shoppers frequently encounter colloquial shorthand numbering across Mexican retail markets, department stores, and open-air plazas. Clerks drop the leading number two when speaking. A customer asking for talla 7 refers to Punto 27 cm. Under international conversion standard ISO/TS 19407:2015 tables, talla 8 corresponds to Punto 28 cm, which represents US Men 10.0, UK 9.5, and European size 44.0. Half sizes follow this pattern: talla 4.5 designates a 24.5 cm shoe.</p>

            <h3 class="heading-sm">Converting Mexican sizes to US and European scales</h3>
            <p>Translating Mexican sizes to international scales requires separate evaluations for men and women styles. For adult men, a Punto 26 shoe corresponds to US Men 8.0, UK 7.5, and EU 41.0. Punto 27 translates to US Men 9.0, UK 8.5, and EU 42.0. Punto 28 corresponds to US Men 10.0, UK 9.5, and EU 44.0. Women sizing uses a different offset. A Punto 23 shoe corresponds to US Women 6.0, UK 4.0, and EU 36.5, whereas Punto 24 maps to US Women 7.0, UK 5.0, and EU 37.5. Punto 25 converts to US Women 8.0, UK 6.0, and EU 38.5. Mexican shoe lengths remain unisex. A 25 cm footbed measures 25 centimeters in men or women models. Women lasts incorporate narrower heel counters, slimmer ball widths, and lower instep volume than men models of matching length.</p>

            <h3 class="heading-sm">Handcrafted footwear from León and regional brand fits</h3>
            <p>The city of León, Guanajuato has operated as Mexico's footwear center since 1645. Roberto Plasencia Saldaña founded Flexi in León in 1935, creating shoes built on metric lasts with polyurethane sole cushioning that fit true to centimeter puntos. Francisco Cuadra founded Cuadra in León in 1991. The company manufactures western boots and traditional equestrian charro footwear using durable Goodyear welt construction. Charro boots require a snug fit across the instep during first wear because thick cowhide leather relaxes and conforms to the arch after several days of regular walking. Huaraches stretch during initial wear. Artisanal huaraches from Michoacán and Jalisco use woven cowhide strips without synthetic lining, stretching up to 0.5 centimeters during initial wear.</p>

            <h3 class="heading-sm">Width designations in Mexican shoemaking</h3>
            <p>Mexican cobblers define width by last shape. Horma normal designates standard medium width, corresponding to American D width for men and B width for women. Horma amplia designates a wider last with extra room across the metatarsal heads, matching an American EE or EEE width. Horma recia provides additional vertical clearance over the instep for heavy work boots.</p>

            <h3 class="heading-sm">Measuring foot length for Mexican footwear</h3>
            <p>Shoppers determine their size at home. Place a sheet of paper on a hard floor flush against a flat wall, stand barefoot with your heel touching the wall, and mark the longest toe tip. Measure the distance from the edge to your mark in centimeters: a foot measuring 26.8 cm aligns with Mexican Punto 27.0.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <div class="faq-card">
          <p class="mono-eyebrow">Frequently asked questions</p>
          <h2 class="heading-lg" style="margin-bottom:24px">Mexico footwear and shoe sizing questions</h2>
          <div class="faq-list">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="faq-a"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Related Internal Links -->
    <section class="related-band">
      <div class="page-inner">
        <RelatedLinks
          title="Metric and foot length guides"
          links={conversionLinks}
        />
        <div style="margin-top:32px">
          <RelatedLinks
            title="Other regional sizing systems"
            links={countryLinks}
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 64px 24px 40px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1), transparent 60%);
    border-bottom: 1px solid var(--v-hairline);
  }
  .page-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-sub {
    max-width: 720px;
    margin: 16px auto 24px;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .badge-trust {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-body);
  }

  /* Converter Band */
  .converter-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .converter-inline {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: var(--v-shadow-whisper);
  }
  .ci-header {
    margin-bottom: 24px;
  }
  .ci-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  .ci-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ci-results {
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    padding: 20px;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ci-placeholder {
    color: var(--v-mute);
    font-size: 14px;
    margin: 0;
    text-align: center;
  }

  /* Tables band */
  .table-band {
    padding: 48px 24px;
  }
  .section-heading {
    margin-bottom: 32px;
  }
  .table-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    overflow: hidden;
    box-shadow: var(--v-shadow-whisper);
  }
  .table-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--v-hairline);
    background: var(--v-subtle);
  }
  .category-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 10px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-ink);
  }
  .scroll-x {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .size-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }
  .size-table th {
    background: var(--v-canvas);
    padding: 12px 18px;
    font-size: 12px;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--v-hairline);
    color: var(--v-body);
  }
  .size-table td {
    padding: 12px 18px;
    border-bottom: 1px solid var(--v-hairline);
    color: var(--v-ink);
  }
  .size-table tbody tr:last-child td {
    border-bottom: none;
  }
  .size-table tbody tr:hover {
    background: var(--v-subtle);
  }

  /* Prose Article Band */
  .content-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .prose-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 48px;
    box-shadow: var(--v-shadow-whisper);
  }
  .prose-header {
    margin-bottom: 36px;
    border-bottom: 1px solid var(--v-hairline);
    padding-bottom: 28px;
  }
  .prose-main-title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    color: var(--v-ink);
    margin: 12px 0 16px;
    line-height: 1.25;
  }
  .prose-lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--v-body);
  }
  .content-prose h3 {
    margin: 36px 0 14px;
    color: var(--v-ink);
  }
  .content-prose p {
    margin-bottom: 18px;
    line-height: 1.7;
    color: var(--v-body);
    font-size: 15px;
  }
  .content-prose ul, .content-prose ol {
    margin: 0 0 24px 20px;
    color: var(--v-body);
    line-height: 1.7;
    font-size: 15px;
  }
  .content-prose li {
    margin-bottom: 10px;
  }
  .content-prose strong {
    color: var(--v-ink);
  }

  /* FAQs */
  .faq-band {
    padding: 48px 24px;
  }
  .faq-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 40px;
    box-shadow: var(--v-shadow-whisper);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    background: var(--v-canvas);
    transition: all 0.15s ease;
  }
  .faq-item[open] {
    background: var(--v-subtle);
  }
  .faq-q {
    padding: 18px 20px;
    font-weight: 600;
    font-size: 15px;
    color: var(--v-ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.2s ease;
    color: var(--v-mute);
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-a {
    padding: 0 20px 20px;
    color: var(--v-body);
    font-size: 14px;
    line-height: 1.6;
  }
  .faq-a p {
    margin: 0;
  }

  /* Related */
  .related-band {
    padding: 48px 24px 64px;
    background: var(--v-canvas);
  }

  @media (max-width: 768px) {
    .ci-row {
      grid-template-columns: 1fr;
    }
    .prose-card {
      padding: 24px;
    }
    .faq-card {
      padding: 24px;
    }
  }
</style>

<script>
  import { SIZE_DATA } from '../../data/shoe-sizes';

  const sizeSelect = document.getElementById('mx-size') as HTMLSelectElement | null;
  const genderSelect = document.getElementById('mx-gender') as HTMLSelectElement | null;
  const resultsContainer = document.getElementById('mx-results');

  function updateSizes() {
    if (!genderSelect || !sizeSelect) return;
    const gender = (genderSelect.value || 'men') as 'men' | 'women' | 'kids';
    const sizes = SIZE_DATA[gender]?.mexico || [];
    const currentVal = sizeSelect.value;

    sizeSelect.innerHTML = '<option value="" disabled selected>Select Mexican size</option>';
    const seen = new Set();
    sizes.forEach(s => {
      const val = String(s);
      if (!seen.has(val)) {
        seen.add(val);
        const opt = document.createElement('option');
        opt.value = val;
        const num = Number(val);
        const shortVal = num >= 20 ? num - 20 : num;
        opt.textContent = `MX ${val} (Talla ${shortVal})`;
        sizeSelect.appendChild(opt);
      }
    });

    if (currentVal && seen.has(currentVal)) {
      sizeSelect.value = currentVal;
    }
    renderResults();
  }

  function renderResults() {
    if (!resultsContainer || !sizeSelect) return;
    const size = sizeSelect.value;
    if (!size) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Select a Mexican shoe size to see instant conversions across US, UK, EU, CM, and Inches</p>';
      return;
    }

    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const data = SIZE_DATA[gender];
    const idx = data.mexico?.findIndex(s => String(s) === size);

    if (idx === undefined || idx === -1) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Size not found in database</p>';
      return;
    }

    const us = data.us?.[idx] ?? '-';
    const uk = data.uk?.[idx] ?? '-';
    const eu = data.eu?.[idx] ?? '-';
    const cm = data.cm?.[idx] ?? size;
    const inches = data.inches?.[idx] ?? '-';
    const num = Number(size);
    const shortVal = num >= 20 ? num - 20 : num;

    resultsContainer.innerHTML = `
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:12px; width:100%;">
        <div style="background:var(--v-elevated); border:1px solid var(--v-link); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-link);">MX Punto</span>
          <div style="font-size:20px; font-weight:700; color:var(--v-ink); margin-top:2px;">MX ${size} (${shortVal})</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">US Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">US ${us}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">EU Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">EU ${eu}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">UK Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">UK ${uk}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Centimetres</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${cm} cm</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Inches</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${inches}"</div>
        </div>
      </div>
    `;
  }

  genderSelect?.addEventListener('change', updateSizes);
  sizeSelect?.addEventListener('change', renderResults);
</script>
