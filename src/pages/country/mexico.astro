const pageDescription = 'Comprehensive Mexico shoe size chart for men, women, and kids. Understand Mexican Punto Calzado (CM), León leather boot sizing, Flexi, and Cuadra.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'How do shoe sizes work in Mexico (Punto Calzado)?',
    a: 'In Mexico, footwear sizing is based directly on foot length in centimetres, traditionally known as "Puntos" or "Punto Calzado". For instance, a Mexican size 26 means the shoe is built for a 26.0 centimetre foot. In daily conversation and retail, Mexicans often drop the leading digit "2", so a size 26 is colloquially referred to as "talla 6".'
  },
  {
    q: 'What does "size 8 en Mexico" mean in footwear?',
    a: '"Size 8 en Mexico" (or talla 8 mexicana) represents a shoe crafted for a 28 centimetre foot (Punto 28). In international footwear sizing, an adult Mexican men\'s size 8 (28 cm) corresponds to an American US Men\'s 9.5 to 10.0, a British UK 9.0 to 9.5, and a European EU 43.'
  },
  {
    q: 'What is a 24.5 or 25.5 Mexico shoe size?',
    a: 'A 24.5 Mexico shoe size (Punto 24.5, or talla 4.5) corresponds to an anatomical foot length of 24.5 centimetres. In adult women\'s sizing, it translates to US Women\'s 7.5 to 8.0, UK 5.5, and EU 38.5 to 39.0. A 25.5 Mexico shoe size (Punto 25.5, or talla 5.5) represents 25.5 cm of foot length, mapping to US Women\'s 8.5 to 9.0, US Men\'s 7.5, UK 6.5 to 7.0, and EU 40.5.'
  },
  {
    q: 'What is a 2.5 Mexico shoe size?',
    a: 'A 2.5 Mexico shoe size (Punto 22.5, or talla 2.5) designates a foot measuring 22.5 centimetres. In adult women\'s footwear, it translates to a petite US Women\'s 5.0 to 5.5, UK 3.5, and EU 35.5 to 36.0. In children\'s footwear, "talla 2.5" may refer to infant sizing depending on the brand catalogue.'
  },
  {
    q: 'What do Mexican shoe width terms like "Horma Normal" and "Horma Amplia" mean?',
    a: 'In Mexican shoemaking, width is designated by the last (*horma*). "Horma Normal" represents a standard medium width, while "Horma Amplia" designates a wide fitting (equivalent to an American EE or EEE width). Many traditional Mexican leather boots naturally feature a slightly broader ball girth than slim European shoes.'
  },
  {
    q: 'How do famous Mexican shoe brands like Flexi, Cuadra, and traditional huaraches fit?',
    a: 'Flexi footwear fits true to Mexican centimetre puntos with cushioned, ergonomic insoles. Cuadra western boots (botas vaqueras) fit snug across the instep (*empeine*) and heel initially, but genuine leather relaxes and moulds to your foot shape after breaking in. Traditional Mexican huaraches (woven leather sandals) stretch significantly—often up to half a centimetre—so they should fit comfortably snug when brand new.'
  },
  {
    q: 'What is a 29.5 Mexico shoe size?',
    a: 'A 29.5 Mexico shoe size (Punto 29.5, or talla 9.5) represents an anatomical foot length of 29.5 centimetres. In men\'s sizing, it corresponds to a large US Men\'s 11.5, UK 11.0, and EU 45.5 to 46.0.'
  },
  {
    q: 'How do I measure my foot in centimetres to find my shoe size in Mexico?',
    a: 'To determine your Mexican shoe size: place a blank sheet of paper flat on the floor against a vertical wall. Stand barefoot or with light socks, resting your heel against the wall. Mark the tip of your longest toe on the paper. Measure the distance in centimetres from the paper edge to your pencil mark. Your measurement in centimetres directly equals your Mexican shoe size (Punto Calzado).'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
