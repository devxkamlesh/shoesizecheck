---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA, MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/us/`;
const pageTitle = 'US Shoe Size Chart: Men, Women and Kids Size Guide';
const pageDescription = 'US shoe size chart and footwear conversion guide. Convert US sizes for men, women, and kids to UK, EU, India, and centimeters.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'Is a US size 8 a 38 or 39?',
    a: 'In women footwear, a US size 8 corresponds to EU 38.5 to 39 (25.0 cm foot length). In men footwear, a US Men size 8 corresponds to EU 41.0 (26.0 cm foot length). Confirm whether the footwear tag refers to men or women sizing before purchasing.'
  },
  {
    q: 'Is US 7 size 40?',
    a: 'On a men shoe chart, a US Men 7 equals EU 40.0 (25.0 cm foot length and UK 6.5). In women footwear, a US Women 7 corresponds to EU 37.5 (24.0 cm foot length).'
  },
  {
    q: 'What is 42 in US shoe size?',
    a: 'An EU 42 corresponds to a US Men size 9.0 (UK 8.5, India 8.5, 27.0 cm foot length). In women footwear, an EU 42 corresponds to US Women 10.5.'
  },
  {
    q: 'What is US size 8 in India?',
    a: 'India footwear sizing follows the UK scale with a 1:1 length ratio. A US Men size 8 corresponds to an India size 7.5. A US Women size 8 converts to an India size 6.0.'
  },
  {
    q: 'What is a 36 shoe size in US women\'s?',
    a: 'An EU 36 corresponds to a US Women size 5.5 to 6.0 (UK 3.5 to 4.0, 22.5 to 23.0 cm foot length).'
  },
  {
    q: 'How do women and men shoe size compare in the US?',
    a: 'In US footwear sizing, women sizes run 1.5 sizes larger numerically than men sizes for the same physical length. A US Men 8 fits the same foot length as a US Women 9.5. Men shoes are built on a standard D width last, while women shoes are built on a narrower B width last.'
  },
  {
    q: 'How does a children shoe size chart work in the US?',
    a: 'A children shoe size chart in the US is split into two numbered series: Child (C) from infant 0C to little kid 13.5C, followed by Youth (Y) from 1Y to 7Y. A youth 7Y transitions directly into adult US Men 7.'
  },
  {
    q: 'How do I find my true US shoe size?',
    a: 'Stand with your heel against a flat wall, mark your longest toe on paper, and measure the distance in centimeters. Compare your measurement against the reference chart, adding 10 to 12 mm of toe room for walking clearance.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const conversionLinks = [
  { label: 'US to EU Shoe Size', href: '/us-to-eu-shoe-size/' },
  { label: 'US to UK Shoe Size', href: '/us-to-uk-shoe-size/' },
  { label: 'US to India Shoe Size', href: '/us-to-india-shoe-size/' },
  { label: 'US to Japan Shoe Size', href: '/us-to-japan-shoe-size/' },
  { label: 'US to CM Shoe Size', href: '/us-to-cm-shoe-size/' },
];

const countryLinks = [
  { label: 'United Kingdom', href: '/country/uk/' },
  { label: 'Europe', href: '/country/europe/' },
  { label: 'India', href: '/country/india/' },
  { label: 'Japan', href: '/country/japan/' },
  { label: 'Australia', href: '/country/australia/' },
  { label: 'Mexico', href: '/country/mexico/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <!-- Open Graph Metadata -->
    <meta property="og:title" content="US Shoe Size Chart: Men, Women and Kids Size Guide" />
    <meta property="og:description" content="US shoe size chart and conversion tool for men, women, and kids." />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="US Shoe Size Chart and Conversion Guide" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="US Shoe Size Chart: Men, Women and Kids Size Guide" />
    <meta name="twitter:description" content="US shoe size chart for men, women, and kids." />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Countries', href: '/country/' },
      { label: 'United States (US)' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Official sizing guide</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,46px)">US shoe size chart and conversion guide</h1>
        <p class="hero-sub body-lg">Convert American footwear measurements to UK, EU, India, Japan, centimeters, and inches using standardized data.</p>
        <div class="hero-badges">
          <span class="badge-trust">Men footwear chart</span>
          <span class="badge-trust">Women footwear chart</span>
          <span class="badge-trust">Kids footwear chart</span>
          <span class="badge-trust">Foot length in centimeters</span>
        </div>
      </div>
    </section>

    <!-- Interactive Converter Tool -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated converter-inline">
          <div class="ci-header">
            <div>
              <p class="mono-eyebrow">Instant footwear size conversion</p>
              <h2 class="heading-md">Convert US shoe sizes in real time</h2>
            </div>
            <p class="body-sm text-mute">Select your US size and gender to generate international conversions.</p>
          </div>

          <div class="ci-row">
            <div class="ci-field">
              <label class="step-label" for="us-size">
                <span class="step-num">1</span> US shoe size
              </label>
              <select id="us-size" class="form-select ci-size-select" aria-label="US shoe size">
                <option value="" disabled selected>Select US size</option>
                {SIZE_DATA.men.us.map(s => <option value={String(s)}>US {s}</option>)}
              </select>
            </div>
            <div class="ci-field">
              <label class="step-label" for="us-gender">
                <span class="step-num">2</span> Category / gender
              </label>
              <select id="us-gender" class="form-select ci-gender-select" aria-label="Gender">
                <option value="men" selected>Men footwear</option>
                <option value="women">Women footwear</option>
                <option value="kids">Kids footwear</option>
              </select>
            </div>
          </div>

          <div class="ci-results" id="us-results" aria-live="polite">
            <p class="ci-placeholder">Select a size to see instant conversions across UK, EU, India, Japan, CM, and Inches</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Detailed Charts Section -->
    <section class="table-band">
      <div class="page-inner">
        <header class="section-heading">
          <p class="mono-eyebrow">Reference charts</p>
          <h2 class="heading-lg">Comprehensive US shoe size conversion charts</h2>
          <p class="body-md">Use these master charts to convert between US shoe sizes, foot length, and international sizing standards.</p>
        </header>

        <!-- 1. Men Shoe Size Chart -->
        <div class="table-card">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Men shoe size chart: US men footwear</h3>
              <p class="body-sm text-mute">International conversions and foot length measurements</p>
            </div>
            <span class="category-pill">Men standard D width</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Men shoe size chart">
              <thead>
                <tr>
                  <th>US Men</th>
                  <th>UK Size</th>
                  <th>EU Size</th>
                  <th>India Size</th>
                  <th>Japan (CM)</th>
                  <th>Foot Length (CM)</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {MEN_SIZE_ROWS.map(r => (
                  <tr>
                    <td><strong>{typeof r.us === 'number' ? r.us.toFixed(1) : r.us}</strong></td>
                    <td>{r.uk}</td>
                    <td>{r.eu}</td>
                    <td>{r.india}</td>
                    <td>{r.jp ?? r.cm}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Female Shoe Size Chart -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Women shoe size chart: US women footwear</h3>
              <p class="body-sm text-mute">Includes EU, UK, India, and metric length</p>
            </div>
            <span class="category-pill">Women standard B width</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Women shoe size chart">
              <thead>
                <tr>
                  <th>US Women</th>
                  <th>UK Size</th>
                  <th>EU Size</th>
                  <th>India Size</th>
                  <th>Japan (CM)</th>
                  <th>Foot Length (CM)</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {WOMEN_SIZE_ROWS.map(r => (
                  <tr>
                    <td><strong>{typeof r.us === 'number' ? r.us.toFixed(1) : r.us}</strong></td>
                    <td>{r.uk}</td>
                    <td>{r.eu}</td>
                    <td>{r.india}</td>
                    <td>{r.jp ?? r.cm}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. Childs Shoe Size Chart -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Kids shoe size chart: US youth and toddler footwear</h3>
              <p class="body-sm text-mute">From toddler through youth progression</p>
            </div>
            <span class="category-pill">Toddler and youth</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Kids shoe size chart">
              <thead>
                <tr>
                  <th>US Kids Size</th>
                  <th>Category</th>
                  <th>UK Child</th>
                  <th>EU Kids</th>
                  <th>Foot Length (CM)</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {KIDS_SIZE_ROWS.map(r => (
                  <tr>
                    <td><strong>{r.us}</strong></td>
                    <td>{r.stage}</td>
                    <td>{r.uk}</td>
                    <td>{r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- In-Depth SEO Prose Content -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">Sizing guide</p>
            <h2 class="prose-main-title">Understanding the US shoe size chart and footwear conversion</h2>
            <p class="prose-lead">Finding correct American footwear requires understanding the Brannock device scale, demographic offsets, and last width ratings.</p>
          </header>

          <div class="content-prose">
            <h3 class="heading-sm">How the US shoe size system works: the Brannock standard</h3>
            <p>The standard American shoe size system relies on the Brannock Device, developed by Charles F. Brannock in 1927 in Syracuse, New York. The scale uses the English barleycorn increment of 8.46 mm (1/3 inch) per full size and 4.23 mm (1/6 inch) per half size. Men and women numbering scales start from different baseline offsets. A foot measuring 26.0 cm fits a US Men 8.0, whereas that same length corresponds to a US Women 9.5.</p>

            <h3 class="heading-sm">Women and men shoe size: the 1.5 size offset and width mechanics</h3>
            <p>Converting between US men and women models follows a 1.5 size difference in length:</p>
            <ul>
              <li>Men to women: Add 1.5 to the men size (US Men 9.0 plus 1.5 equals US Women 10.5).</li>
              <li>Women to men: Subtract 1.5 from the women size (US Women 8.5 minus 1.5 equals US Men 7.0).</li>
            </ul>
            <p>Width profiles also differ between categories. Standard men shoes use a D width last, while standard women shoes use a narrower B width last. A woman buying a men sneaker will experience a wider heel cup and midfoot chamber. A man purchasing a women sneaker will experience a narrower fit that often requires a half size increase in length.</p>

            <h3 class="heading-sm">Decoding the 36 shoe size in US women's</h3>
            <p>An EU 36 corresponds to a US Women 5.5 to 6.0, UK 3.5, and 22.5 to 23.0 cm foot length. Footwear built on European lasts runs true to unisex metric lengths. When wearing athletic or winter socks, selecting US Women 6.0 provides adequate space across the toe box.</p>

            <h3 class="heading-sm">How to measure your foot using a feet size chart</h3>
            <p>Follow four steps to measure your feet accurately:</p>
            <ol>
              <li>Measure late in the day: Feet expand slightly after daily walking and standing. Measuring in the afternoon ensures comfortable fit.</li>
              <li>Place paper against a flat wall: Tape a blank sheet to a firm floor flush against the baseboard.</li>
              <li>Stand with weight evenly distributed: Stand upright with your heel touching the wall. Have a partner mark the outermost tip of your longest toe.</li>
              <li>Measure the distance: Measure from the paper edge to the mark in millimeters, then check the reference chart. Measure both feet and size your footwear to fit the larger foot, because most individuals have slight size differences between their left and right feet.</li>
            </ol>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <div class="faq-card">
          <p class="mono-eyebrow">Frequently asked questions</p>
          <h2 class="heading-lg" style="margin-bottom:24px">US shoe size conversion questions</h2>
          <div class="faq-list">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="faq-a"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Related Internal Links -->
    <section class="related-band">
      <div class="page-inner">
        <RelatedLinks
          title="Popular US shoe size conversions"
          links={conversionLinks}
        />
        <div style="margin-top:32px">
          <RelatedLinks
            title="Explore other regional sizing systems"
            links={countryLinks}
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 64px 24px 40px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1), transparent 60%);
    border-bottom: 1px solid var(--v-hairline);
  }
  .page-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-sub {
    max-width: 720px;
    margin: 16px auto 24px;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .badge-trust {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-body);
  }

  /* Converter Band */
  .converter-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .converter-inline {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: var(--v-shadow-whisper);
  }
  .ci-header {
    margin-bottom: 24px;
  }
  .ci-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  .ci-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ci-results {
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    padding: 20px;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ci-placeholder {
    color: var(--v-mute);
    font-size: 14px;
    margin: 0;
    text-align: center;
  }

  /* Tables band */
  .table-band {
    padding: 48px 24px;
  }
  .section-heading {
    margin-bottom: 32px;
  }
  .table-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    overflow: hidden;
  }
  .table-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--v-hairline);
    background: var(--v-canvas);
    flex-wrap: wrap;
    gap: 12px;
  }
  .category-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: var(--v-r-full);
    background: var(--v-hairline-soft);
    color: var(--v-body);
  }
  .highlight-row {
    background-color: var(--v-link-soft) !important;
    font-weight: 500;
  }

  /* Prose band */
  .content-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .prose-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 40px;
  }
  .prose-header {
    border-bottom: 1px solid var(--v-hairline);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }
  .prose-main-title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--v-ink);
    margin: 8px 0 12px;
  }
  .prose-lead {
    font-size: 16px;
    line-height: 26px;
    color: var(--v-body);
    margin: 0;
  }
  .content-prose h3 {
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .content-prose p, .content-prose ul, .content-prose ol {
    margin-bottom: 16px;
    line-height: 24px;
    color: var(--v-body);
  }
  .content-prose ul, .content-prose ol {
    padding-left: 20px;
  }
  .content-prose li {
    margin-bottom: 8px;
  }

  /* FAQ */
  .faq-band {
    padding: 48px 24px;
  }
  .faq-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 36px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-sm);
    overflow: hidden;
    background: var(--v-canvas);
    transition: border-color 0.15s ease;
  }
  .faq-item[open] {
    border-color: var(--v-link);
  }
  .faq-q {
    padding: 16px 20px;
    font-weight: 600;
    font-size: 15px;
    color: var(--v-ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }
  .faq-chevron {
    transition: transform 0.2s ease;
    color: var(--v-mute);
    flex-shrink: 0;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--v-link);
  }
  .faq-a {
    padding: 0 20px 16px;
    color: var(--v-body);
    font-size: 14px;
    line-height: 22px;
  }
  .faq-a p { margin: 0; }

  .related-band {
    padding: 16px 24px 80px;
  }

  @media (max-width: 768px) {
    .ci-row { grid-template-columns: 1fr; }
    .prose-card, .converter-inline, .faq-card { padding: 24px 16px; }
  }
</style>

<script>
  import { SIZE_DATA } from '../../data/shoe-sizes';

  const sizeSelect = document.getElementById('us-size') as HTMLSelectElement;
  const genderSelect = document.getElementById('us-gender') as HTMLSelectElement;
  const resultsContainer = document.getElementById('us-results');

  function updateSizes() {
    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const currentVal = sizeSelect?.value;
    const sizes = SIZE_DATA[gender]?.us || [];

    if (sizeSelect) {
      sizeSelect.innerHTML = '<option value="" disabled selected>Select US size</option>';
      sizes.forEach(s => {
        const opt = document.createElement('option');
        opt.value = String(s);
        opt.textContent = `US ${s}`;
        sizeSelect.appendChild(opt);
      });
      if (currentVal && sizes.map(String).includes(currentVal)) {
        sizeSelect.value = currentVal;
      }
    }
    renderResults();
  }

  function renderResults() {
    if (!resultsContainer || !sizeSelect) return;
    const size = sizeSelect.value;
    if (!size) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Select a size to see instant conversions across UK, EU, India, Japan, CM, and Inches</p>';
      return;
    }

    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const data = SIZE_DATA[gender];
    const idx = data.us?.findIndex(s => String(s) === size);

    if (idx === undefined || idx === -1) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Size not found in database</p>';
      return;
    }

    const uk = data.uk?.[idx] ?? '-';
    const eu = data.eu?.[idx] ?? '-';
    const india = data.india?.[idx] ?? '-';
    const cm = data.cm?.[idx] ?? '-';
    const inches = data.inches?.[idx] ?? '-';

    resultsContainer.innerHTML = `
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:12px; width:100%;">
        <div style="background:var(--v-elevated); border:1px solid var(--v-link); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-link);">US Selected</span>
          <div style="font-size:20px; font-weight:700; color:var(--v-ink); margin-top:2px;">US ${size}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">UK Size</span>
