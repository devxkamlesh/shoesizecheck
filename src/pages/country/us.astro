---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/us/`;
const pageTitle = 'US Shoe Size Chart — Men, Women & Kids Footwear Conversion | AllShoeSizeConverter';
const pageDescription = 'Complete US shoe size chart and footwear size conversion guide. Instant shoes size conversion for men shoe size chart, female shoe size chart, and childs shoe size chart with feet size chart in cm & inches.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'Is a US size 8 a 38 or 39?',
    a: 'In female shoe size charts, a US size 8 corresponds to an EU 38.5 to 39 (approx. 24.5 to 25.0 cm foot length). In a men\'s shoe chart, a US Men\'s size 8 corresponds to an EU 41. Always confirm whether the footwear tag refers to men\'s or women\'s sizing before purchasing.'
  },
  {
    q: 'Is US 7 size 40?',
    a: 'Yes, on a men foot size chart, a US Men\'s 7 equals EU 40 (approx. 25.0 cm foot length / UK 6.5). However, in women and men shoe size comparisons, a US Women\'s 7 corresponds to EU 37.5 to 38 (approx. 23.8 cm).'
  },
  {
    q: 'What is 42 in US shoe size?',
    a: 'An EU 42 corresponds to a US Men\'s size 8.5 to 9 (UK 8, India 8, approx. 27.0 cm foot length). On a female shoe size chart, an EU 42 is roughly a US Women\'s 10 to 10.5.'
  },
  {
    q: 'What is US size 8 in India?',
    a: 'India footwear size conversion follows the UK standard. A US Men\'s size 8 is equivalent to an India size 7.5 (or India 7 in snug dress shoes). A US Women\'s size 8 converts to an India size 6.'
  },
  {
    q: 'What is a 36 shoe size in US women\'s?',
    a: 'An EU 36 shoe size in US women\'s is equivalent to a US Women\'s size 5.5 to 6 (UK 3.5, India 3.5, approx. 22.5 to 23.0 cm foot length). It is one of the most common standard European women\'s sizes.'
  },
  {
    q: 'How do women and men shoe size compare in the US?',
    a: 'In US footwear size conversion, female shoe sizes run exactly 1.5 sizes larger numerically than men\'s shoe sizes for the same physical length. For example, a US Men\'s 8 fits the same foot length as a US Women\'s 9.5. Additionally, men\'s shoes default to a wider "D" width, while women\'s shoes default to a narrower "B" width.'
  },
  {
    q: 'How does a child\'s shoe size chart work in the US?',
    a: 'A child\'s shoe size chart in the US is split into two numbered series: Child ("C") from infant 0C to little kid 13.5C, followed by Youth ("Y") from 1Y to 7Y. A youth 7Y transitions directly into adult US Men\'s 7 or Women\'s 8.5.'
  },
  {
    q: 'How do I use a feet size chart to find my true US shoe size?',
    a: 'Stand with your heel against a flat wall, mark your longest toe on paper, and measure the distance in centimeters or inches. Compare your measurement against our feet size chart, adding approximately 10 to 12 mm (about half an inch) of wiggle room for normal walking clearance.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${domain}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "US Shoe Size Chart",
      "item": pageCanonical
    }
  ]
});

const conversionLinks = [
  { label: 'US to EU Shoe Size', href: '/us-to-eu-shoe-size/' },
  { label: 'US to UK Shoe Size', href: '/us-to-uk-shoe-size/' },
  { label: 'US to India Shoe Size', href: '/us-to-india-shoe-size/' },
  { label: 'US to Japan Shoe Size', href: '/us-to-japan-shoe-size/' },
  { label: 'US to CM Shoe Size', href: '/us-to-cm-shoe-size/' },
];

const countryLinks = [
