<script>
  import { SIZE_DATA } from '../../data/shoe-sizes';

  const sizeSelect = document.getElementById('us-size') as HTMLSelectElement;
  const genderSelect = document.getElementById('us-gender') as HTMLSelectElement;
  const resultsContainer = document.getElementById('us-results');

  function updateSizes() {
    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const currentVal = sizeSelect?.value;
    const sizes = SIZE_DATA[gender]?.us || [];

    if (sizeSelect) {
      sizeSelect.innerHTML = '<option value="" disabled selected>Select US size</option>';
      sizes.forEach(s => {
        const opt = document.createElement('option');
        opt.value = String(s);
        opt.textContent = `US ${s}`;
        sizeSelect.appendChild(opt);
      });
      if (currentVal && sizes.map(String).includes(currentVal)) {
        sizeSelect.value = currentVal;
      }
    }
    renderResults();
  }

  function renderResults() {
    if (!resultsContainer || !sizeSelect) return;
    const size = sizeSelect.value;
    if (!size) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Select a size to see instant conversions across UK, EU, India, Japan, CM, and Inches</p>';
      return;
    }

    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const data = SIZE_DATA[gender];
    const idx = data.us?.findIndex(s => String(s) === size);

    if (idx === undefined || idx === -1) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Size not found in database</p>';
      return;
    }

    const uk = data.uk?.[idx] ?? '—';
    const eu = data.eu?.[idx] ?? '—';
    const india = data.india?.[idx] ?? '—';
    const jp = data.jp?.[idx] ?? '—';
    const cm = data.cm?.[idx] ?? '—';
    const inches = data.inches?.[idx] ?? '—';

    resultsContainer.innerHTML = `
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:12px; width:100%;">
        <div style="background:var(--v-elevated); border:1px solid var(--v-link); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-link);">US Selected</span>
          <div style="font-size:20px; font-weight:700; color:var(--v-ink); margin-top:2px;">US ${size}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-mute);">UK Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${uk}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-mute);">EU Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${eu}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-mute);">India Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${india}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-mute);">Foot CM</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${cm} cm</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-mute);">Inches</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${inches}"</div>
        </div>
      </div>
    `;
  }

  genderSelect?.addEventListener('change', updateSizes);
  sizeSelect?.addEventListener('change', renderResults);
</script>
