---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA, MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/japan/`;
const pageTitle = 'Japan Shoe Size Chart: JP to US, EU and CM Sizing Guide';
const pageDescription = 'Japan shoe size chart for men, women, and kids. Convert Japanese centimeter sizes to US, UK, and EU with JIS width standards (E to 4E) and brand sizing guides.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'How do Japanese shoe sizes work?',
    a: 'Japanese shoe sizes are based directly on foot length in centimeters according to JIS S 5037. A Japan size 26.0 means the shoe accommodates a foot length of 26.0 centimeters (260 millimeters). Shoemakers incorporate 10 to 15 millimeters of toe clearance into the last.'
  },
  {
    q: 'What is a Japan shoe size 25, 26, or 27 in US sizes?',
    a: 'Under ISO/TS 19407:2015 tables for men, Japan 25.0 cm corresponds to US Men 7.0, Japan 26.0 cm equals US Men 8.0, Japan 26.5 cm equals US Men 8.5, and Japan 27.0 cm equals US Men 9.0. For women, Japan 23.5 cm equals US Women 6.5, Japan 24.0 cm equals US Women 7.0, and Japan 25.0 cm equals US Women 8.0.'
  },
  {
    q: 'What is a 23.5 cm shoe size in Japan?',
    a: 'A 23.5 cm shoe size in Japan represents a foot that measures 23.5 centimeters from the heel to the longest toe. In international sizing, JP 23.5 converts to US Women 6.5, US Men 5.5, EU 37.0, UK 4.5, and South Korea 235 mm.'
  },
  {
    q: 'What is the difference between Japanese shoe sizes (cm) and Korean shoe sizes (mm)?',
    a: 'Japanese and Korean shoe sizes follow the metric Mondopoint framework. Japan expresses shoe sizes in centimeters with 0.5 cm increments, whereas South Korea expresses shoe sizes in millimeters with 5 mm increments. A Japanese 27.0 cm size equals a Korean 270 mm size.'
  },
  {
    q: 'What do E, 2E, 3E, and 4E width markings mean on Japanese footwear?',
    a: 'Width in Japan is codified under JIS S 5037 based on ball girth. Rating 2E is standard medium width for Japanese men, and E is standard medium for Japanese women. Ratings 3E and 4E designate wide and extra-wide cuts designed for higher insteps.'
  },
  {
    q: 'How do Japanese running shoes like Asics and Mizuno fit?',
    a: 'Asics and Mizuno manufacture running shoes true to Japanese centimeter footbed length. For marathon racing, runners often select a half size up (0.5 cm larger) to accommodate forefoot expansion during distance running.'
  },
  {
    q: 'How do I measure my foot in centimeters for Japanese shoes?',
    a: 'Place a sheet of paper against a vertical wall on a hard floor. Stand upright with your heel touching the wall. Mark the tip of your longest toe on the paper with a vertical pencil. Measure the distance from the wall to the mark in centimeters. That length is your Japanese shoe size.'
  },
  {
    q: 'Are Japanese shoe sizes unisex?',
    a: 'Physical length in centimeters is unisex: a 25.0 cm foot requires a 25.0 cm shoe in men or women models. Men and women models differ in ball girth: standard men shoes use a 2E last, whereas women models use an E last.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const conversionLinks = [
  { label: 'US to Japan Shoe Size', href: '/us-to-japan-shoe-size/' },
  { label: 'Shoe Size in CM', href: '/shoe-size-in-cm/' },
  { label: 'Mondopoint Shoe Size Guide', href: '/mondopoint-shoe-size/' },
  { label: 'Shoe Size by Foot Length', href: '/shoe-size-by-foot-length/' },
  { label: 'What Is My Shoe Size?', href: '/what-is-my-shoe-size/' },
  { label: 'US to EU Shoe Size', href: '/us-to-eu-shoe-size/' },
];

const countryLinks = [
  { label: 'United States', href: '/country/us/' },
  { label: 'United Kingdom', href: '/country/uk/' },
  { label: 'Europe', href: '/country/europe/' },
  { label: 'India', href: '/country/india/' },
  { label: 'Australia', href: '/country/australia/' },
  { label: 'Mexico', href: '/country/mexico/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <!-- Open Graph Metadata -->
    <meta property="og:title" content="Japan Shoe Size Chart: JP to US, EU and CM Sizing Guide" />
    <meta property="og:description" content="Japan shoe size chart for men, women, and kids. Convert Japanese centimeter sizes to US, UK, EU, and explore JIS width standards and Asics sizing." />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Japan Shoe Size Chart and Conversion Guide" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Japan Shoe Size Chart: JP to US, EU and CM Sizing Guide" />
    <meta name="twitter:description" content="Japan shoe size chart, feet size chart, and JIS width fitting guide for footwear shoppers." />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Countries', href: '/country/' },
      { label: 'Japan' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Japanese Mondopoint standard (JIS S 5037)</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,46px)">Japan shoe size chart and conversion guide</h1>
        <p class="hero-sub body-lg">Convert Japanese footwear sizes to US, UK, and European standards. Shoes in Japan use physical centimeter measurements codified under JIS S 5037, with width classifications from E to 4E.</p>
        <div class="hero-badges">
          <span class="badge-trust">Men and women centimeter charts</span>
          <span class="badge-trust">JIS width standards (E, 2E, 3E, 4E)</span>
          <span class="badge-trust">Kids shoe size chart Japan</span>
          <span class="badge-trust">Asics and Mizuno brand guidance</span>
        </div>
      </div>
    </section>

    <!-- Interactive Japan Size Converter Tool -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated converter-inline">
          <div class="ci-header">
            <div>
              <p class="mono-eyebrow">Japanese footwear conversion</p>
              <h2 class="heading-md">Convert Japan shoe sizes</h2>
            </div>
            <p class="body-sm text-mute">Select your Japanese shoe size and category to see international equivalents.</p>
          </div>

          <div class="ci-row">
            <div class="ci-field">
              <label class="step-label" for="jp-size">
                <span class="step-num">1</span> Japan Shoe Size (JP / CM)
              </label>
              <select id="jp-size" class="form-select ci-size-select" aria-label="Japan shoe size">
                <option value="" disabled selected>Select JP size (cm)</option>
                {SIZE_DATA.men.jp.map(s => <option value={String(s)}>JP {s} cm</option>)}
              </select>
            </div>
            <div class="ci-field">
              <label class="step-label" for="jp-gender">
                <span class="step-num">2</span> Category / Demographic
              </label>
              <select id="jp-gender" class="form-select ci-gender-select" aria-label="Gender">
                <option value="men" selected>Men's Shoe Chart (JP)</option>
                <option value="women">Women's Shoe Chart (JP)</option>
                <option value="kids">Kids &amp; Toddler Shoe Chart (JP)</option>
              </select>
            </div>
          </div>

          <div class="ci-results" id="jp-results" aria-live="polite">
            <p class="ci-placeholder">Select a Japanese size to see conversions across US, EU, UK, India, CM, and Inches</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Reference Tables Section -->
    <section class="table-band">
      <div class="page-inner">
        <header class="section-heading">
          <p class="mono-eyebrow">Master reference charts</p>
          <h2 class="heading-lg">Comprehensive Japan footwear size charts</h2>
          <p class="body-md">Use these official conversion tables to translate Japanese shoe sizes into US, UK, and European standards.</p>
        </header>

        <!-- 1. Men's Japan Shoe Size Chart -->
        <div class="table-card">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Japan men shoe size chart</h3>
              <p class="body-sm text-mute">Includes JP (cm), Mondopoint (mm), US Men, UK, EU, and foot length in inches</p>
            </div>
            <span class="category-pill">Men JIS standard</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Japan Men Shoe Size Chart">
              <thead>
                <tr>
                  <th>Japan Size (CM)</th>
                  <th>Mondopoint (MM)</th>
                  <th>US Men</th>
                  <th>UK Men</th>
                  <th>EU Size</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {MEN_SIZE_ROWS.map((row) => (
                  <tr>
                    <td><strong>{(row.jp ?? row.cm).toFixed(1)} cm</strong></td>
                    <td>{row.korea ?? Math.round(row.cm * 10)} mm</td>
                    <td>US {row.us}</td>
                    <td>UK {row.uk}</td>
                    <td>EU {row.eu}</td>
                    <td>{row.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Women's Japan Shoe Size Chart -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Japan women shoe size chart</h3>
              <p class="body-sm text-mute">Conversion for women Japanese footwear to US, UK, and European sizes</p>
            </div>
            <span class="category-pill">Women JIS standard</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Japan Shoe Size Chart Women">
              <thead>
                <tr>
                  <th>Japan Size (CM)</th>
                  <th>Mondopoint (MM)</th>
                  <th>US Women</th>
                  <th>UK Women</th>
                  <th>EU Size</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {WOMEN_SIZE_ROWS.map((row) => (
                  <tr>
                    <td><strong>{(row.jp ?? row.cm).toFixed(1)} cm</strong></td>
                    <td>{row.korea ?? Math.round(row.cm * 10)} mm</td>
                    <td>US {row.us}</td>
                    <td>UK {row.uk}</td>
                    <td>EU {row.eu}</td>
                    <td>{row.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. Kids & Toddler Japan Shoe Size Chart -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Japan kids and toddler shoe size chart</h3>
              <p class="body-sm text-mute">From early walking stages (10.5 cm) through youth footwear (22.0 cm)</p>
            </div>
            <span class="category-pill">Infant, toddler and youth</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Japan Kids Shoe Size Chart">
              <thead>
                <tr>
                  <th>Japan Size (CM)</th>
                  <th>Age Range Milestone</th>
                  <th>US Kids</th>
                  <th>UK Kids</th>
                  <th>EU Kids</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {KIDS_SIZE_ROWS.map((row) => (
                  <tr>
                    <td><strong>{row.cm.toFixed(1)} cm</strong></td>
                    <td>{row.stage}</td>
                    <td>{row.us}</td>
                    <td>{row.uk}</td>
                    <td>{row.eu}</td>
                    <td>{row.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 4. Japanese JIS Width Fitting Standards -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Japanese JIS footwear width standards (JIS S 5037)</h3>
              <p class="body-sm text-mute">Forefoot ball girth ratings from narrow A fittings to wide 4E and F cuts</p>
            </div>
            <span class="category-pill">JIS S 5037 width matrix</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Japanese JIS Shoe Width Standards">
              <thead>
                <tr>
                  <th>JIS Width Code</th>
                  <th>Classification</th>
                  <th>Relative Profile</th>
                  <th>Typical Population Match</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><strong>A, B, C</strong></td><td>Very narrow to slim</td><td>Slender instep, low volume</td><td>Rare in domestic lines; slim international feet</td></tr>
                <tr><td><strong>D</strong></td><td>Narrow for men, medium for women</td><td>Fitted forefoot, snug arch</td><td>Standard western medium; narrow in Japan</td></tr>
                <tr><td><strong>E</strong></td><td>Slim for men, standard for women</td><td>Balanced anatomical width</td><td>Standard baseline for Japanese women</td></tr>
                <tr><td><strong>2E (EE)</strong></td><td>Standard medium for men, wide for women</td><td>Moderate ball girth, comfortable splay</td><td>Standard baseline for Japanese men (60 percent share)</td></tr>
                <tr><td><strong>3E (EEE)</strong></td><td>Wide fit</td><td>Broad metatarsal spread, high instep</td><td>Recommended for wide feet or marathon swelling</td></tr>
                <tr><td><strong>4E (EEEE)</strong></td><td>Extra wide fit</td><td>Generous toe box, high vertical volume</td><td>Athletes with bunions or pronounced flat arches</td></tr>
                <tr><td><strong>F, G</strong></td><td>Super extra wide</td><td>Maximum forefoot room available</td><td>Specialty therapeutic or wide commercial lasts</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Deep-Dive SEO Editorial Prose Content -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">Japanese footwear engineering</p>
            <h2 class="prose-main-title">Japanese shoe size conversion and JIS width standards</h2>
            <p class="prose-lead">Japanese footwear sizing uses physical foot length in centimeters. Regulated under JIS S 5037, the system eliminates arbitrary numbering offsets and connects directly with the international metric Mondopoint standard.</p>
          </header>

          <div class="content-prose">
            <h3 class="heading-sm">Metric shoe sizing under JIS S 5037</h3>
            <p>Japanese shoe sizing operates without historical barleycorn units. A shoe marked 26.5 cm fits a foot measuring 26.5 centimeters from the heel to the tip of the longest toe. South Korea uses the same metric footbed length in millimeters, making Japan 26.5 cm identical to Korea 265 mm.</p>
            <p>Shoe lasts sculpted in Tokyo workshops incorporate 10 to 15 millimeters of toe clearance, known as sute-sun. Wearers measuring 260 millimeters in foot length select size 26.0 cm without adding extra numbers manually.</p>

            <h3 class="heading-sm">Converting Japanese shoe sizes to US, UK, and European standards</h3>
            <p>Converting Japanese shoe sizes to Western numbers depends on whether the wearer requires men or women footwear:</p>
            <ul>
              <li>For men shoes, Japanese centimeter sizes convert using standard ISO/TS 19407:2015 tables. A Japanese 26.0 cm corresponds to US Men 8.0 and UK 7.5. Japan 27.0 cm equals US Men 9.0, UK 8.5, and EU 42.0. Japan 28.0 cm maps to US Men 10.0, UK 9.5, and EU 44.0.</li>
              <li>For women shoes, US labels run two sizes higher than UK labels for the same length. Japan 23.5 cm corresponds to US Women 6.5, UK 4.5, and EU 37.0. Japan 24.5 cm corresponds to US Women 8.0, UK 6.0, and EU 39.0. Japan 25.0 cm maps to US Women 8.5, UK 6.5, and EU 40.0.</li>
            </ul>

            <h3 class="heading-sm">Width classifications under JIS S 5037</h3>
            <p>Footwear width in Japan is standardized across eight ball girth ratings. Western D width is standard medium in North America, but Japanese shoe manufacturers classify D as narrow. Japanese men footwear uses 2E as the standard baseline, covering roughly 60 percent of adult male lasts. Japanese women footwear uses E as standard baseline. Runners with broad metatarsal heads can select dedicated 3E wide or 4E super-wide options from brands like Asics and Mizuno.</p>

            <h3 class="heading-sm">Fit notes for Asics, Mizuno, and Onitsuka Tiger</h3>
            <p>Asics designs performance road running shoes in Kobe with firm heel counters and room for toe splay. Marathon runners training for 42 kilometer distances often choose a half size up (0.5 cm larger) to accommodate natural swelling over long mileage. Mizuno manufactures athletic shoes in Osaka featuring the Wave Plate system with square toe boxes. Onitsuka Tiger produces retro lifestyle sneakers like the Mexico 66 on slender vintage lasts, where buyers with wide feet frequently go up 0.5 cm for daily comfort.</p>

            <h3 class="heading-sm">Measuring foot length for Japanese footwear</h3>
            <p>To measure foot length accurately, tape a blank sheet of paper to a hard floor against a flat wall. Stand with your heel against the wall and mark the outermost edge of your longest toe with a vertical pencil. Measure the distance in centimeters with a ruler. A measurement of 26.5 centimeters corresponds to Japan 26.5 cm for men (US Men 8.5) or Japan 26.5 cm for women (US Women 10.0).</p>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <div class="faq-card">
          <p class="mono-eyebrow">Frequently asked questions</p>
          <h2 class="heading-lg" style="margin-bottom:24px">Japan footwear shoe sizing frequently asked questions</h2>
          <div class="faq-list">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="faq-a"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Related Internal Links -->
    <section class="related-band">
      <div class="page-inner">
        <RelatedLinks
          title="Popular Japan shoe size conversions"
          links={conversionLinks}
        />
        <div style="margin-top:32px">
          <RelatedLinks
            title="Explore other regional sizing systems"
            links={countryLinks}
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 64px 24px 40px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1), transparent 60%);
    border-bottom: 1px solid var(--v-hairline);
  }
  .page-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-sub {
    max-width: 720px;
    margin: 16px auto 24px;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .badge-trust {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-body);
  }

  /* Converter Band */
  .converter-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .converter-inline {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: var(--v-shadow-whisper);
  }
  .ci-header {
    margin-bottom: 24px;
  }
  .ci-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  .ci-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ci-results {
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    padding: 20px;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ci-placeholder {
    color: var(--v-mute);
    font-size: 14px;
    margin: 0;
    text-align: center;
  }

  /* Tables band */
  .table-band {
    padding: 48px 24px;
  }
  .section-heading {
    margin-bottom: 32px;
  }
  .table-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    overflow: hidden;
    box-shadow: var(--v-shadow-whisper);
  }
  .table-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--v-hairline);
    background: var(--v-subtle);
  }
  .category-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 10px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-ink);
  }
  .scroll-x {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .size-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }
  .size-table th {
    background: var(--v-canvas);
    padding: 12px 18px;
    font-size: 12px;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--v-hairline);
    color: var(--v-body);
  }
  .size-table td {
    padding: 12px 18px;
    border-bottom: 1px solid var(--v-hairline);
    color: var(--v-ink);
  }
  .size-table tbody tr:last-child td {
    border-bottom: none;
  }
  .size-table tbody tr:hover {
    background: var(--v-subtle);
  }

  /* Prose Article Band */
  .content-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .prose-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 48px;
    box-shadow: var(--v-shadow-whisper);
  }
  .prose-header {
    margin-bottom: 36px;
    border-bottom: 1px solid var(--v-hairline);
    padding-bottom: 28px;
  }
  .prose-main-title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    color: var(--v-ink);
    margin: 12px 0 16px;
    line-height: 1.25;
  }
  .prose-lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--v-body);
  }
  .content-prose h3 {
    margin: 36px 0 14px;
    color: var(--v-ink);
  }
  .content-prose p {
    margin-bottom: 18px;
    line-height: 1.7;
    color: var(--v-body);
    font-size: 15px;
  }
  .content-prose ul, .content-prose ol {
    margin: 0 0 24px 20px;
    color: var(--v-body);
    line-height: 1.7;
    font-size: 15px;
  }
  .content-prose li {
    margin-bottom: 10px;
  }
  .content-prose strong {
    color: var(--v-ink);
  }

  /* FAQs */
  .faq-band {
    padding: 48px 24px;
  }
  .faq-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 40px;
    box-shadow: var(--v-shadow-whisper);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    background: var(--v-canvas);
    transition: all 0.15s ease;
  }
  .faq-item[open] {
    background: var(--v-subtle);
  }
  .faq-q {
    padding: 18px 20px;
    font-weight: 600;
    font-size: 15px;
    color: var(--v-ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.2s ease;
    color: var(--v-mute);
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-a {
    padding: 0 20px 20px;
    color: var(--v-body);
    font-size: 14px;
    line-height: 1.6;
  }
  .faq-a p {
    margin: 0;
  }

  /* Related */
  .related-band {
    padding: 48px 24px 64px;
    background: var(--v-canvas);
  }

  @media (max-width: 768px) {
    .ci-row {
      grid-template-columns: 1fr;
    }
    .prose-card {
      padding: 24px;
    }
    .faq-card {
      padding: 24px;
    }
  }
</style>

<script>
  import { SIZE_DATA } from '../../data/shoe-sizes';

  const sizeSelect = document.getElementById('jp-size') as HTMLSelectElement | null;
  const genderSelect = document.getElementById('jp-gender') as HTMLSelectElement | null;
  const resultsContainer = document.getElementById('jp-results');

  function updateSizes() {
    if (!genderSelect || !sizeSelect) return;
    const gender = (genderSelect.value || 'men') as 'men' | 'women' | 'kids';
    const sizes = SIZE_DATA[gender]?.jp || [];
    const currentVal = sizeSelect.value;

    sizeSelect.innerHTML = '<option value="" disabled selected>Select JP size (cm)</option>';
    const seen = new Set();
    sizes.forEach(s => {
      const val = String(s);
      if (!seen.has(val)) {
        seen.add(val);
        const opt = document.createElement('option');
        opt.value = val;
        opt.textContent = `JP ${val} cm`;
        sizeSelect.appendChild(opt);
      }
    });

    if (currentVal && seen.has(currentVal)) {
      sizeSelect.value = currentVal;
    }
    renderResults();
  }

  function renderResults() {
    if (!resultsContainer || !sizeSelect) return;
    const size = sizeSelect.value;
    if (!size) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Select a Japanese size to see instant conversions across US, EU, UK, India, CM, and Inches</p>';
      return;
    }

    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const data = SIZE_DATA[gender];
    const idx = data.jp?.findIndex(s => String(s) === size);

    if (idx === undefined || idx === -1) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Size not found in database</p>';
      return;
    }

    const us = data.us?.[idx] ?? '-';
    const eu = data.eu?.[idx] ?? '-';
    const uk = data.uk?.[idx] ?? '-';
    const india = data.india?.[idx] ?? '-';
    const cm = data.cm?.[idx] ?? size;
    const inches = data.inches?.[idx] ?? '-';

    resultsContainer.innerHTML = `
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:12px; width:100%;">
        <div style="background:var(--v-elevated); border:1px solid var(--v-link); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-link);">JP Selected</span>
          <div style="font-size:20px; font-weight:700; color:var(--v-ink); margin-top:2px;">JP ${size} cm</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">US Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">US ${us}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">EU Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">EU ${eu}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">UK Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">UK ${uk}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">India Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">IND ${india}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Inches</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${inches}"</div>
        </div>
      </div>
    `;
  }

  genderSelect?.addEventListener('change', updateSizes);
  sizeSelect?.addEventListener('change', renderResults);
</script>
