---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/japan/`;
const pageTitle = 'Japan Shoe Size Chart — JP to US, EU & CM Sizing Guide';
const pageDescription = 'Japan shoe size chart for men, women, and kids. Convert Japanese centimeter sizes to US, UK, and EU with JIS width standards (E to 4E) and brand sizing guides.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'How do Japanese shoe sizes work?',
    a: 'Japanese shoe sizes (JP size shoes) are based directly on your foot length in centimetres (CM) or millimetres (MM) according to the JIS S 5037 national standard. For example, a Japan size 26 means the shoe is precision-engineered for an anatomical foot length of exactly 26.0 centimetres (260 mm). Unlike US or UK sizing systems, which rely on historical imperial barleycorns, the Japanese system has zero arbitrary numbering offsets.'
  },
  {
    q: 'What is a Japan shoe size 24, 25, 26, or 27 in US sizes?',
    a: 'For men, a Japan shoe size 25 converts to US Men\'s 7, a Japan 26 equals US Men\'s 8, a Japan 27 equals US Men\'s 9, and a Japan 28 equals US Men\'s 10. For women, Japanese shoe sizes map differently because American women\'s sizing runs approximately 1.5 to 2 sizes higher than men\'s: a Japan 23.5 equals US Women\'s 6.5 to 7, a Japan 24 equals US Women\'s 7.5, and a Japan 25 equals US Women\'s 8.5 to 9.'
  },
  {
    q: 'What is a 23.5 cm shoe size in Japan?',
    a: 'A 23.5 cm shoe size in Japan (JP 23.5) represents a foot that measures 23.5 centimetres from the heel to the longest toe. In international sizing, JP 23.5 converts to an American US Women\'s 6.5 to 7, a US Men\'s 5.5, a European EU 37 to 37.5, a British UK 4.5, and a South Korean KR 235 mm.'
  },
  {
    q: 'What is the difference between Japanese shoe sizes (cm) and Korean shoe sizes (mm)?',
    a: 'Japanese and Korean shoe sizes follow the exact same metric Mondopoint philosophy, but use different units of measurement. Japan expresses shoe sizes in centimetres with 0.5 cm increments (e.g., JP 27 or 27.5 cm), whereas South Korea expresses shoe sizes in millimetres with 5 mm increments (e.g., KR 270 or 275 mm). To convert from Japanese to Korean sizing, simply multiply the centimetre value by 10 (27 cm × 10 = 270 mm).'
  },
  {
    q: 'What do E, 2E, 3E, and 4E width markings mean on Japanese footwear?',
    a: 'In Japan, width is codified under the Japanese Industrial Standard (JIS S 5037) ranging from narrow (A, B, C, D) to standard and wide (E, 2E, 3E, 4E, F, G). Because East Asian anatomical foot profiles frequently feature a wider forefoot and flatter instep, 2E (EE) is considered the standard medium width for Japanese men, and E is standard for Japanese women. Shoes marked 3E or 4E represent wide and extra-wide cuts designed for generous forefoot volume.'
  },
  {
    q: 'How do Japanese running shoes like Asics and Mizuno fit?',
    a: 'Japanese athletic brands such as Asics and Mizuno are renowned for anatomical heel lock, stable midfoot support, and generous forefoot toe boxes. For casual wear, they fit true to Japanese centimetre measurements. However, for distance running or marathon training, podiatrists recommend choosing a half-size up (0.5 cm larger, such as moving from JP 27.0 to JP 27.5) to accommodate natural foot swelling and prevent runner\'s toe impact.'
  },
  {
    q: 'How do I measure my foot in centimetres for Japanese shoes?',
    a: 'To measure your foot for Japanese sizing: place a blank sheet of paper against a flat vertical wall on a hard floor. Stand upright with your heel touching the wall, wearing your typical socks. Mark the tip of your longest toe on the paper with a vertical pencil. Measure the distance from the wall edge to the mark in centimetres. Your measured foot length is your exact Japan shoe size; you do not need to manually add extra clearance because Japanese shoemakers already build in 10 to 15 mm of toe room (sute-sun).'
  },
  {
    q: 'Are Japanese shoe sizes unisex?',
    a: 'Nominally, yes. Because Japanese shoe sizes represent physical foot length in centimetres, a JP 25.0 cm corresponds to a 25.0 cm foot whether designed for men or women. However, men\'s and women\'s Japanese shoes differ in interior volume and width: standard Japanese men\'s models are typically built on a 2E last, whereas women\'s models are shaped on a narrower E or D last.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const conversionLinks = [
  { label: 'US to Japan Shoe Size', href: '/us-to-japan-shoe-size/' },
  { label: 'Shoe Size in CM', href: '/shoe-size-in-cm/' },
  { label: 'Mondopoint Shoe Size Guide', href: '/mondopoint-shoe-size/' },
  { label: 'Shoe Size by Foot Length', href: '/shoe-size-by-foot-length/' },
  { label: 'What Is My Shoe Size?', href: '/what-is-my-shoe-size/' },
  { label: 'US to EU Shoe Size', href: '/us-to-eu-shoe-size/' },
];

const countryLinks = [
  { label: '🇺🇸 United States', href: '/country/us/' },
  { label: '🇬🇧 United Kingdom', href: '/country/uk/' },
  { label: '🇪🇺 Europe', href: '/country/europe/' },
