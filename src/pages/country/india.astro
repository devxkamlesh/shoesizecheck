const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/india/`;
const pageTitle = 'India Shoe Size Chart — Men, Women (Female), Kids & Bha Size Guide | AllShoeSizeConverter';
const pageDescription = 'Comprehensive India shoe size chart & conversion guide. Explore shoe size chart india female, shoe size chart men, kids shoe size chart, and Indian shoe size chart tables.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'Which shoe size chart is used in India?',
    a: '<p>In India, footwear sizing officially follows the British (UK) sizing standard, meaning an Indian size 8 is identical in length to a UK size 8 (approx. US Men\'s 8.5 to 9, EU 42). Heritage brands like Bata India, Woodland, Liberty, Metro, and Red Chief all designate footwear using UK/India numbers. In addition, the Bureau of Indian Standards (BIS) and CSIR-CLRI have developed the groundbreaking "Bha" (भा) Indian sizing standard based on 3D scans of over 100,000 citizens to better accommodate naturally broader Indian forefoots.</p>'
  },
  {
    q: 'Shoe size chart: How to measure your feet accurately at home?',
    a: '<p>To measure your foot length using our shoe size chart how to measure method: tape a blank sheet of paper to an uncarpeted floor flush against a skirting board or flat wall. Stand upright with your heel resting lightly against the wall wearing the socks you plan to pair with your footwear. Have someone mark the furthest tip of your longest toe on the paper. Measure the distance from the edge of the paper to the pencil mark in centimetres. Consult our feet size chart and add 10 mm (roughly half an inch) of toe room for natural walking stride expansion.</p>'
  },
  {
    q: 'What size is a men\'s shoe in a women\'s shoe size chart?',
    a: '<p>In international sizing, a men\'s shoe is longer and wider than a women\'s shoe of the same numerical label. On an American chart, women\'s size equals men\'s size plus 1.5 (a US Men\'s 7 is a US Women\'s 8.5). In India and the UK, men\'s and women\'s footwear share the same length increments, but a men\'s size 7 is approximately equivalent to a women\'s size 8 in physical length. Furthermore, men\'s shoes are constructed on a standard "D" width last, whereas women\'s shoes are built on a narrower "B" last.</p>'
  },
  {
    q: 'What does CM mean on an Indian shoe size chart?',
    a: '<p>On any shoe size chart india, "CM" stands for centimetres and specifies either the bare anatomical foot length the shoe was sculpted for, or the internal footbed dimension. Unlike arbitrary numerical systems such as UK barleycorns or European Paris Points, centimetres provide an absolute physical metric. When ordering sneakers from global brands like Nike, Adidas, Puma, or Asics on Indian marketplaces like Myntra, Flipkart, or Ajio, matching your foot length directly in centimetres guarantees an exact fit.</p>'
  },
  {
    q: 'How to read and use a shoe size chart correctly?',
    a: '<p>To read and use an indian shoe size chart effectively, follow this four-step sequence: 1) Anchor on physical foot length in centimetres (e.g., 25.5 cm); 2) Trace horizontally across the conversion matrix to locate your corresponding Indian/UK size; 3) Verify your category—confirm whether you are consulting the shoe size chart men, shoe size chart women, or kids shoe size chart; and 4) Check forefoot width ratings, especially if you have broad feet or a high instep.</p>'
  },
  {
    q: 'How should shoes properly fit according to an Indian shoe size chart?',
    a: '<p>To ensure a correct fit based on our how to fit my shoe size chart guidelines, your footwear must satisfy three clinical requirements: 1) Toe Clearance: There should be approximately 10 to 12 mm (the width of an adult thumb) of clearance between your longest toe and the front tip of the shoe; 2) Heel Lock: The heel counter must grip your heel securely without vertical slippage when stepping forward; and 3) Ball Alignment: The widest part of your foot (the first metatarsal joint) must align naturally with the widest flex point of the sole without bulging or side pressure.</p>'
  },
  {
    q: 'How does a shoe size width chart work for Indian footwear?',
    a: '<p>Footwear width is classified using alphabetical letters rather than numbers. Standard men\'s width is "D" (Medium) and standard women\'s width is "B" (Medium). Because anthropological studies show Indian feet are naturally broader across the ball and toes, standard European or American footwear can often feel tight across the sides. If your shoes pinch at the pinky toe despite having adequate front room, consult a shoe size width chart and select a Wide (E or EE) fitting instead of sizing up in length.</p>'
  },
  {
    q: 'How do kids and toddler shoe sizes correspond to age in India?',
    a: '<p>On a toddler shoe size chart by age in India: newborns and babies wear Indian sizes 0 to 2 (0 to 9 months); early walkers wear sizes 3 to 5 (9 to 24 months); older toddlers wear sizes 6 to 9 (2 to 4 years); and preschool children wear sizes 10 to 13.5 (4 to 7 years). Once a child outgrows size 13.5, Indian sizing resets back to Junior/Adult size 1 through 6 (ages 7 to 12+). Children\'s feet expand rapidly, so checking measurements every 3 to 4 months is recommended.</p>'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
