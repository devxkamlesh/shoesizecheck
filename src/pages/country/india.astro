---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA, MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/india/`;
const pageTitle = 'India Shoe Size Chart: Men, Women and Kids Size Guide';
const pageDescription = 'India shoe size chart for men, women, and kids. Convert Indian shoe sizes to US, UK, and EU using BIS and ISO standards.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'Which shoe size chart is used in India?',
    a: '<p>In India, footwear sizing follows the British (UK) sizing standard, meaning an Indian size 8 equals a UK size 8 (US Men 8.5, EU 41.5, 26.5 cm foot length; or US Men 9 in many athletic sneakers). Domestic footwear brands like Bata India, Woodland, Liberty, Metro, and Red Chief designate footwear using UK and India numbers. The Bureau of Indian Standards (BIS) and CSIR-Central Leather Research Institute (CLRI) published survey findings in 2022 to introduce the Bha (भा) Indian sizing standard based on 3D scans of over 100,000 citizens to accommodate broader Indian forefoot dimensions.</p>'
  },
  {
    q: 'How to measure foot length at home?',
    a: '<p>Tape a blank sheet of paper to an uncarpeted floor flush against a flat wall. Stand upright with your heel resting against the wall wearing your regular socks. Mark the furthest tip of your longest toe on the paper. Measure the distance from the edge of the paper to the mark in centimeters. Check the chart and allow 10 mm of toe room for walking clearance.</p>'
  },
  {
    q: 'What size is a men\'s shoe in a women\'s shoe size chart?',
    a: '<p>In international sizing, a men\'s shoe has a longer length and wider volume than a women\'s shoe of the same number. On an American chart, women\'s size equals men\'s size plus 1.5. A US Men 7 equals a US Women 8.5. In India and the UK, men\'s and women\'s footwear use the same numbering scale, but men\'s shoes are built on a standard D width last, whereas women\'s shoes are built on a narrower B last.</p>'
  },
  {
    q: 'What does CM mean on an Indian shoe size chart?',
    a: '<p>On an Indian shoe size chart, CM stands for centimeters and specifies anatomical foot length. Centimeters provide an objective metric across brands. When ordering sneakers from Nike, Adidas, Puma, or Asics on Indian platforms like Myntra, Flipkart, or Ajio, matching your foot length in centimeters provides the most reliable fit.</p>'
  },
  {
    q: 'How to read and use a shoe size chart correctly?',
    a: '<p>To read an Indian shoe size chart, first determine your foot length in centimeters. Trace across the conversion row to find your Indian and UK size. Confirm whether you are reading the men\'s, women\'s, or kids\' chart. Check width ratings if you require wider fitting footwear.</p>'
  },
  {
    q: 'How should shoes fit according to an Indian shoe size chart?',
    a: '<p>Shoes must satisfy three fit criteria: 1) Toe room: Allow 10 to 12 mm of space between your longest toe and the shoe tip; 2) Heel lock: The heel cup must hold your heel without vertical slipping; 3) Ball alignment: The widest part of your foot must sit at the widest flex point of the sole without lateral pressure.</p>'
  },
  {
    q: 'How does a shoe size width chart work for Indian footwear?',
    a: '<p>Footwear width uses alphabetical letters. Standard men\'s width is D and standard women\'s width is B. If shoes feel tight across the metatarsals despite having adequate length, select a wide E or EE fitting rather than buying a larger length size.</p>'
  },
  {
    q: 'How do kids and toddler shoe sizes correspond to age in India?',
    a: '<p>On an Indian kids size chart: babies wear sizes 0 to 2 (0 to 12 months); toddlers wear sizes 3 to 5 (1 to 2 years); older toddlers wear sizes 6 to 9 (2 to 4 years); and children wear sizes 10 to 13.5 (4 to 7 years). Above size 13.5, the scale resets to adult sizes 1 through 6 for children aged 7 and older.</p>'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
});

const conversionLinks = [
  { label: 'India to US Shoe Size', href: '/india-to-us-shoe-size/' },
  { label: 'India to UK Shoe Size', href: '/india-to-uk-shoe-size/' },
  { label: 'India to EU Shoe Size', href: '/india-to-eu-shoe-size/' },
  { label: 'US to India Shoe Size', href: '/us-to-india-shoe-size/' },
  { label: 'Shoe Size in CM', href: '/shoe-size-in-cm/' },
];

const countryLinks = [
  { label: 'United States', href: '/country/us/' },
  { label: 'United Kingdom', href: '/country/uk/' },
  { label: 'Europe', href: '/country/europe/' },
  { label: 'Japan', href: '/country/japan/' },
  { label: 'Australia', href: '/country/australia/' },
  { label: 'Mexico', href: '/country/mexico/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <!-- Open Graph Metadata -->
    <meta property="og:title" content="India Shoe Size Chart: Men, Women and Kids Footwear Guide" />
    <meta property="og:description" content="Complete India shoe size chart and conversion guide for men, women, and kids." />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="India Shoe Size Chart and Conversion Guide" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="India Shoe Size Chart: Indian Men, Women and Kids Sizing" />
    <meta name="twitter:description" content="Accurate Indian shoe size chart for men, women, and kids." />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Countries', href: '/country/' },
      { label: 'India' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Indian Sizing Standard and BIS Bha System</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,46px)">India shoe size chart and conversion guide</h1>
        <p class="hero-sub body-lg">Convert Indian footwear sizes to US, UK, EU, and centimeters for men, women, and children with official reference data.</p>
        <div class="hero-badges">
          <span class="badge-trust">Men and women adult charts</span>
          <span class="badge-trust">Women footwear matrix</span>
          <span class="badge-trust">Kids shoe size chart</span>
          <span class="badge-trust">BIS Bha footwear standard</span>
        </div>
      </div>
    </section>

    <!-- Interactive India Size Converter Tool -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated converter-inline">
          <div class="ci-header">
            <div>
              <p class="mono-eyebrow">Instant Indian footwear conversion</p>
              <h2 class="heading-md">Convert Indian shoe sizes in real time</h2>
            </div>
            <p class="body-sm text-mute">Select your Indian shoe size and demographic to view international equivalents.</p>
          </div>

          <div class="ci-row">
            <div class="ci-field">
              <label class="step-label" for="india-size">
                <span class="step-num">1</span> Indian shoe size
              </label>
              <select id="india-size" class="form-select ci-size-select" aria-label="Indian shoe size">
                <option value="" disabled selected>Select India size</option>
                {SIZE_DATA.men.india.map(s => <option value={String(s)}>India {s}</option>)}
              </select>
            </div>
            <div class="ci-field">
              <label class="step-label" for="india-gender">
                <span class="step-num">2</span> Category / demographic
              </label>
              <select id="india-gender" class="form-select ci-gender-select" aria-label="Gender">
                <option value="men" selected>Men footwear</option>
                <option value="women">Women footwear</option>
                <option value="kids">Kids and toddler footwear</option>
              </select>
            </div>
          </div>

          <div class="ci-results" id="india-results" aria-live="polite">
            <p class="ci-placeholder">Select an Indian shoe size to see conversions across US, UK, EU, Japan, CM, and Inches</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Reference Tables Section -->
    <section class="table-band">
      <div class="page-inner">
        <header class="section-heading">
          <p class="mono-eyebrow">Master reference charts</p>
          <h2 class="heading-lg">Comprehensive Indian footwear size charts</h2>
          <p class="body-md">Use these master tables to translate Indian footwear sizes into international systems and foot lengths.</p>
        </header>

        <!-- 1. Adult Men Shoe Size Chart -->
        <div class="table-card">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Shoe size chart men: India and UK standard</h3>
              <p class="body-sm text-mute">Includes US Men conversions, EU Paris Points, and foot length in CM and Inches</p>
            </div>
            <span class="category-pill">Men footwear matrix</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Shoe size chart men India">
              <thead>
                <tr>
                  <th>India Size</th>
                  <th>UK Size</th>
                  <th>US Men</th>
                  <th>EU Size</th>
                  <th>Japan (CM)</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {MEN_SIZE_ROWS.map(r => (
                  <tr>
                    <td><strong>India {r.india}</strong></td>
                    <td>{r.uk}</td>
                    <td>{typeof r.us === 'number' ? r.us.toFixed(1) : r.us}</td>
                    <td>{r.eu}</td>
                    <td>{r.jp ?? r.cm}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Shoe Size Chart India Female (Women) -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Shoe size chart India female: women footwear</h3>
              <p class="body-sm text-mute">Dedicated conversion guide for women heels, flats, ethnic juttis, and sneakers</p>
            </div>
            <span class="category-pill">Women footwear matrix</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Shoe size chart india female">
              <thead>
                <tr>
                  <th>India Female Size</th>
                  <th>UK Women</th>
                  <th>US Women</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {WOMEN_SIZE_ROWS.map(r => (
                  <tr>
                    <td><strong>India {r.india}</strong></td>
                    <td>UK {r.uk}</td>
                    <td>US {typeof r.us === 'number' ? r.us.toFixed(1) : r.us}</td>
                    <td>{r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. Kids Shoe Size Chart & Toddler by Age -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Kids shoe size chart and toddler shoe size chart by age</h3>
              <p class="body-sm text-mute">From baby footwear through junior school footwear</p>
            </div>
            <span class="category-pill">Kids progression</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Kids shoe size chart India">
              <thead>
                <tr>
                  <th>India Kids Size</th>
                  <th>Category</th>
                  <th>UK Kids</th>
                  <th>US Kids</th>
                  <th>EU Kids</th>
                  <th>Foot Length (CM)</th>
                </tr>
              </thead>
              <tbody>
                {KIDS_SIZE_ROWS.map(r => (
                  <tr>
                    <td><strong>India {r.india}</strong></td>
                    <td>{r.stage}</td>
                    <td>UK {r.uk}</td>
                    <td>{r.us}</td>
                    <td>{r.eu}</td>
                    <td>{r.cm} cm</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Deep-Dive SEO Prose Content -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">Indian footwear guide</p>
            <h2 class="prose-main-title">Understanding the India shoe size chart, regional standards, and the Bha system</h2>
            <p class="prose-lead">Indian footwear links heritage British numbering, modern metric manufacturing, and the national Bha standard developed by research institutions in Chennai.</p>
          </header>

          <div class="content-prose">
            <h3 class="heading-sm">The foundation of the India shoe size chart: British heritage and modern retail</h3>
            <p>The standard Indian footwear scale shares its origins with the British shoe trade. In the twentieth century, commercial tanneries and manufacturing centers in Kanpur, Agra, and Kolkata adopted the English barleycorn system, where one full size increment measures exactly 8.46 millimeters (1/3 inch). Domestic companies including Bata India, Woodland, Liberty, Paragon, and Metro label their shoes using these numbers. Indian size 8 matches UK size 8 in length. On international conversion charts, an Indian men size 8 corresponds to US Men 8.5 and EU 41.5, with an internal length of 26.5 cm.</p>

            <h3 class="heading-sm">The Bureau of Indian Standards Bha footwear sizing system</h3>
            <p>In 2022, the CSIR-Central Leather Research Institute in Chennai submitted a comprehensive anthropometric report to the Bureau of Indian Standards. The team measured over 100,000 subjects across India using 3D digital scanners. The survey recorded that Indian feet are wider across the first and fifth metatarsal heads relative to foot length. The Bureau established the Bha (भा) standard to define lasts that match these proportions without requiring buyers to purchase oversized shoes for lateral comfort.</p>

            <h3 class="heading-sm">Shoe size chart India female: sizing heels, flats, sneakers, and ethnic footwear</h3>
            <p>Women footwear sold through platforms like Myntra, Nykaa, and Ajio aligns with British sizing conventions. India female size 4 matches UK 4 and US Women 6.0 for a 23.0 cm foot length. India female size 5 matches UK 5 and US Women 7.0 for a 24.0 cm length. India female size 6 matches UK 6 and US Women 8.0 for a 25.0 cm length. Traditional leather footwear such as mojaris from Jaipur and Kolhapuri chappals from Maharashtra use raw vegetable-tanned leather. Because these handcrafted shoes contain no synthetic foam liners, selecting a half size larger gives room for initial leather molding.</p>

            <h3 class="heading-sm">Navigating the kids shoe size chart and toddler shoe size chart by age</h3>
            <p>Indian children footwear follows two sequential number series. The infant and child range begins at size 0 and runs through size 13.5. Above size 13.5, the scale restarts at size 1 for primary school students. This transition means an adult size 1 is larger than a child size 13. Checking foot length in centimeters prevents confusion between toddler and junior school sizing.</p>

            <h3 class="heading-sm">How to measure your foot using a feet size chart at home</h3>
            <p>Follow four steps to record foot dimensions accurately at home:</p>
            <ol>
              <li>Measure late in the day when normal standing has settled the arch.</li>
              <li>Tape an A4 paper sheet flush against a baseboard on a hard floor.</li>
              <li>Stand on the sheet with your heel against the wall and weight distributed evenly across both feet.</li>
              <li>Mark the furthest tip of your longest toe and measure the distance from the paper edge in millimeters.</li>
            </ol>
            <p>Allow 10 to 12 mm of clearance beyond your longest toe to ensure the foot can flex comfortably during walking stride transitions.</p>

            <h3 class="heading-sm">How to read and use a shoe size chart correctly</h3>
            <p>Foot length in centimeters provides the primary anchor for all conversions. Identify your metric length first, then read horizontally to find the matching Indian number. Confirm whether the column indicates men, women, or kids sizing. If your foot feels constrained at the first metatarsal joint despite proper toe clearance, select a wide fitting last instead of buying a longer shoe.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <div class="faq-card">
          <p class="mono-eyebrow">Frequently asked questions</p>
          <h2 class="heading-lg" style="margin-bottom:24px">Indian footwear and size guide questions</h2>
          <div class="faq-list">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="faq-a" set:html={item.a} />
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Related Internal Links -->
    <section class="related-band">
      <div class="page-inner">
        <RelatedLinks
          title="Popular Indian shoe size conversions"
          links={conversionLinks}
        />
        <div style="margin-top:32px">
          <RelatedLinks
            title="Explore other regional sizing systems"
            links={countryLinks}
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 64px 24px 40px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1), transparent 60%);
    border-bottom: 1px solid var(--v-hairline);
  }
  .page-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-sub {
    max-width: 720px;
    margin: 16px auto 24px;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .badge-trust {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-body);
  }

  /* Converter Band */
  .converter-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .converter-inline {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: var(--v-shadow-whisper);
  }
  .ci-header {
    margin-bottom: 24px;
  }
  .ci-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  .ci-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ci-results {
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    padding: 20px;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ci-placeholder {
    color: var(--v-mute);
    font-size: 14px;
    margin: 0;
    text-align: center;
  }

  /* Tables band */
  .table-band {
    padding: 48px 24px;
  }
  .section-heading {
    margin-bottom: 32px;
  }
  .table-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    overflow: hidden;
  }
  .table-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--v-hairline);
    background: var(--v-canvas);
    flex-wrap: wrap;
    gap: 12px;
  }
  .category-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: var(--v-r-full);
    background: var(--v-hairline-soft);
    color: var(--v-body);
  }

  /* Prose band */
  .content-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .prose-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 40px;
  }
  .prose-header {
    border-bottom: 1px solid var(--v-hairline);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }
  .prose-main-title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--v-ink);
    margin: 8px 0 12px;
  }
  .prose-lead {
    font-size: 16px;
    line-height: 26px;
    color: var(--v-body);
    margin: 0;
  }
  .content-prose h3 {
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .content-prose p, .content-prose ul, .content-prose ol {
    margin-bottom: 16px;
    line-height: 24px;
    color: var(--v-body);
  }
  .content-prose ul, .content-prose ol {
    padding-left: 20px;
  }
  .content-prose li {
    margin-bottom: 8px;
  }

  /* FAQ */
  .faq-band {
    padding: 48px 24px;
  }
  .faq-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 36px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-sm);
    overflow: hidden;
    background: var(--v-canvas);
    transition: border-color 0.15s ease;
  }
  .faq-item[open] {
    border-color: var(--v-link);
  }
  .faq-q {
    padding: 16px 20px;
    font-weight: 600;
    font-size: 15px;
    color: var(--v-ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }
  .faq-chevron {
    transition: transform 0.2s ease;
    color: var(--v-mute);
    flex-shrink: 0;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--v-link);
  }
  .faq-a {
    padding: 0 20px 16px;
    color: var(--v-body);
    font-size: 14px;
    line-height: 22px;
  }
  .faq-a p { margin: 0; }

  .related-band {
    padding: 16px 24px 80px;
  }

  @media (max-width: 768px) {
    .ci-row { grid-template-columns: 1fr; }
    .prose-card, .converter-inline, .faq-card { padding: 24px 16px; }
  }
</style>

<script>
  import { SIZE_DATA } from '../../data/shoe-sizes';

  const sizeSelect = document.getElementById('india-size') as HTMLSelectElement;
  const genderSelect = document.getElementById('india-gender') as HTMLSelectElement;
  const resultsContainer = document.getElementById('india-results');

  function updateSizes() {
    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const currentVal = sizeSelect?.value;
    const sizes = SIZE_DATA[gender]?.india || [];

    if (sizeSelect) {
      sizeSelect.innerHTML = '<option value="" disabled selected>Select India size</option>';
      sizes.forEach(s => {
        const opt = document.createElement('option');
        opt.value = String(s);
        opt.textContent = `India ${s}`;
        sizeSelect.appendChild(opt);
      });
      if (currentVal && sizes.map(String).includes(currentVal)) {
        sizeSelect.value = currentVal;
      }
    }
    renderResults();
  }

  function renderResults() {
    if (!resultsContainer || !sizeSelect) return;
    const size = sizeSelect.value;
    if (!size) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Select an Indian shoe size to see instant conversions across US, UK, EU, Japan, CM, and Inches</p>';
      return;
    }

    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const data = SIZE_DATA[gender];
    const idx = data.india?.findIndex(s => String(s) === size);

    if (idx === undefined || idx === -1) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Size not found in database</p>';
      return;
    }

    const us = data.us?.[idx] ?? '-';
    const uk = data.uk?.[idx] ?? '-';
    const eu = data.eu?.[idx] ?? '-';
    const cm = data.cm?.[idx] ?? '-';
    const inches = data.inches?.[idx] ?? '-';

    resultsContainer.innerHTML = `
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:12px; width:100%;">
        <div style="background:var(--v-elevated); border:1px solid var(--v-link); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-link);">India Selected</span>
          <div style="font-size:20px; font-weight:700; color:var(--v-ink); margin-top:2px;">India ${size}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">US Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">US ${us}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">UK Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">UK ${uk}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">EU Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${eu}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Foot CM</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${cm} cm</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Inches</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${inches}"</div>
        </div>
      </div>
    `;
  }

  genderSelect?.addEventListener('change', updateSizes);
  sizeSelect?.addEventListener('change', renderResults);
</script>
