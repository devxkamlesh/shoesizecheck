---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA, MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/uk/`;
const pageTitle = 'UK Shoe Size Chart: British Sizing and Clarks Guide';
const pageDescription = 'UK shoe size chart for British men, women, and kids. Convert UK sizes to US, EU, and CM with Clarks width fittings and toddler guides.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'How to measure your feet accurately at home?',
    a: 'Stand upright with your heel lightly resting against a flat wall on top of a sheet of plain paper taped to a hard floor. Wearing the socks you plan to pair with your shoes, mark the furthest tip of your longest toe. Measure the distance from the edge of the paper to your mark in millimeters. Refer to our reference chart and add 10 mm of walking clearance to find your British shoe size.'
  },
  {
    q: 'How do I read a shoe size chart to find my correct UK size?',
    a: 'First locate your anatomical foot length in centimeters or millimeters. Next, trace horizontally to find your corresponding UK adult or child size. If you fall between two half sizes, round up to allow natural foot expansion during walking. Check whether the brand lists a width fitting letter such as Clarks D, E, F, G, or H to ensure proper forefoot volume.'
  },
  {
    q: 'What is a Chinese shoe size chart and how does it convert to UK sizes?',
    a: 'China uses two footwear measurement systems. The traditional China Type 1 system matches European Paris Points (China size 42 corresponds directly to EU 42 and UK size 8.5). The modern China Type 2 national standard (GB/T 3293.1-1998) is based on metric Mondopoint millimeters (China 260 indicates a foot length of 260 mm, converting to UK 7.5). When buying from Chinese online retailers, check whether the label displays metric millimeters or continental EU numbers.'
  },
  {
    q: 'How should properly fitted shoes feel?',
    a: 'Footwear must satisfy three criteria: 1) Toe room: Allow 10 to 12 mm between your longest toe and the front tip; 2) Heel grip: The heel counter should hug your calcaneus snugly with no vertical slipping when stepping forward; and 3) Flex point: The ball of your foot must align cleanly with the widest flex groove of the sole without lateral pressure.'
  },
  {
    q: 'How does a shoe size width chart work for Clarks and British footwear?',
    a: 'In British shoemaking, width is designated by alphabetical letters. On a Clarks width chart: D signifies narrow fit, E is slim or narrow for men and standard for women, F is the standard medium fit worn by most British adults, G is wide fit, and H is extra wide. Selecting the correct width fitting prevents buying an oversized shoe just to accommodate wide toes or a high instep.'
  },
  {
    q: 'What does CM mean on a shoe size chart?',
    a: 'On a shoe size chart, CM stands for centimeters and denotes anatomical foot length or internal footbed length. Centimeters provide an objective metric across brands. Knowing your foot length in centimeters allows you to bypass brand inconsistencies and achieve an exact conversion across global manufacturers.'
  },
  {
    q: 'How do UK toddler and children\'s shoe sizes correspond to age?',
    a: 'On a British children chart: babies wear UK 0 to 1 (0 to 6 months); infants wear UK 2 to 4 (6 to 18 months); toddlers wear UK 5 to 8 (18 months to 3.5 years); and children wear UK 9 to 13.5 (3.5 to 7 years). Once a child outgrows UK 13.5, the British child scale resets to UK 1 (Junior 1) through UK 6 (ages 8 to 12).'
  },
  {
    q: 'How do UK adult shoe sizes compare with US and European footwear?',
    a: 'For men, a UK shoe size is 0.5 size smaller than an American US Men size (UK 8.5 equals US Men 9.0 and EU 42.0). For women, a UK shoe size is 2 sizes smaller than a US Women size (UK 5.0 equals US Women 7.0 and EU 37.5). European Paris point sizing is unisex, providing a stable bridge when converting between British and international footwear.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const conversionLinks = [
  { label: 'UK to US Shoe Size', href: '/uk-to-us-shoe-size/' },
  { label: 'UK to EU Shoe Size', href: '/uk-to-eu-shoe-size/' },
  { label: 'UK to India Shoe Size', href: '/uk-to-india-shoe-size/' },
  { label: 'US to UK Shoe Size', href: '/us-to-uk-shoe-size/' },
  { label: 'Shoe Size in CM', href: '/shoe-size-in-cm/' },
];

const countryLinks = [
  { label: 'United States', href: '/country/us/' },
  { label: 'Europe', href: '/country/europe/' },
  { label: 'India', href: '/country/india/' },
  { label: 'Japan', href: '/country/japan/' },
  { label: 'Australia', href: '/country/australia/' },
  { label: 'Mexico', href: '/country/mexico/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <!-- Open Graph Metadata -->
    <meta property="og:title" content="UK Shoe Size Chart: British Sizing and Clarks Guide" />
    <meta property="og:description" content="UK shoe size chart and conversion guide for men, women, and kids with Clarks width fittings." />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="UK Shoe Size Chart and Conversion Guide" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="UK Shoe Size Chart: British Sizing and Clarks Guide" />
    <meta name="twitter:description" content="Accurate UK shoe size chart and Clarks width fitting matrix." />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Countries', href: '/country/' },
      { label: 'United Kingdom (UK)' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">British sizing standard</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,46px)">UK shoe size chart and conversion guide</h1>
        <p class="hero-sub body-lg">Convert British footwear sizes to US, EU, India, and centimeters, or check Clarks width fittings.</p>
        <div class="hero-badges">
          <span class="badge-trust">Men and women adult charts</span>
          <span class="badge-trust">Kids shoe size chart UK</span>
          <span class="badge-trust">Toddler shoe size chart</span>
          <span class="badge-trust">Clarks width fittings (D, E, F, G, H)</span>
        </div>
      </div>
    </section>

    <!-- Interactive UK Size Converter Tool -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated converter-inline">
          <div class="ci-header">
            <div>
              <p class="mono-eyebrow">Instant British footwear conversion</p>
              <h2 class="heading-md">Convert UK shoe sizes in real time</h2>
            </div>
            <p class="body-sm text-mute">Select your British shoe size and gender to view international equivalents.</p>
          </div>

          <div class="ci-row">
            <div class="ci-field">
              <label class="step-label" for="uk-size">
                <span class="step-num">1</span> UK Shoe Size
              </label>
              <select id="uk-size" class="form-select ci-size-select" aria-label="UK shoe size">
                <option value="" disabled selected>Select UK size</option>
                {SIZE_DATA.men.uk.map(s => <option value={String(s)}>UK {s}</option>)}
              </select>
            </div>
            <div class="ci-field">
              <label class="step-label" for="uk-gender">
                <span class="step-num">2</span> Category / Demographic
              </label>
              <select id="uk-gender" class="form-select ci-gender-select" aria-label="Gender">
                <option value="men" selected>Men's Shoe Chart</option>
                <option value="women">Women's Shoe Chart</option>
                <option value="kids">Kids &amp; Toddler Shoe Size Chart</option>
              </select>
            </div>
          </div>

          <div class="ci-results" id="uk-results" aria-live="polite">
            <p class="ci-placeholder">Select a UK size to see conversions across US, EU, India, Japan, CM, and Inches</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Reference Tables Section -->
    <section class="table-band">
      <div class="page-inner">
        <header class="section-heading">
          <p class="mono-eyebrow">Master Reference Charts</p>
          <h2 class="heading-lg">Comprehensive UK Footwear Size Charts</h2>
          <p class="body-md">Use these master tables to translate British footwear sizes into international systems and exact foot lengths.</p>
        </header>

        <!-- 1. Adult Men & Women Shoe Size Chart -->
        <div class="table-card">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Adult UK shoe size chart: men and women</h3>
              <p class="body-sm text-mute">Includes US conversions, EU Paris Points, India sizes, and foot length in CM</p>
            </div>
            <span class="category-pill">Adult barleycorn standard</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Adult UK shoe size chart">
              <thead>
                <tr>
                  <th>UK Size</th>
                  <th>US Men</th>
                  <th>US Women</th>
                  <th>EU Size</th>
                  <th>India Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {MEN_SIZE_ROWS.map(r => (
                  <tr>
                    <td><strong>{r.uk}</strong></td>
                    <td>{typeof r.us === 'number' ? r.us.toFixed(1) : r.us}</td>
                    <td>{typeof r.us === 'number' ? (r.us + 1.5).toFixed(1) : '-'}</td>
                    <td>{r.eu}</td>
                    <td>{r.india}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Kids & Toddler Shoe Size Chart UK (By Age) -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Kids shoe size chart UK and toddler shoe size chart by age</h3>
              <p class="body-sm text-mute">From baby footwear through junior school footwear</p>
            </div>
            <span class="category-pill">Infant, toddler and youth</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Kids shoe size chart uk">
              <thead>
                <tr>
                  <th>UK Kids Size</th>
                  <th>Category</th>
                  <th>US Kids</th>
                  <th>EU Kids</th>
                  <th>Foot Length (CM)</th>
                  <th>Foot Length (Inches)</th>
                </tr>
              </thead>
              <tbody>
                {KIDS_SIZE_ROWS.map(r => (
                  <tr>
                    <td><strong>UK {r.uk}</strong></td>
                    <td>{r.stage}</td>
                    <td>{r.us}</td>
                    <td>{r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. Clarks Width Fitting Guide -->
        <div class="table-card" style="margin-top:36px">
          <div class="table-card-head">
            <div>
              <h3 class="heading-sm">Clarks shoe size chart and width fitting matrix</h3>
              <p class="body-sm text-mute">British footwear width standard used by Clarks and retailers</p>
            </div>
            <span class="category-pill">Clarks width standards</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Clarks shoe size chart width fitting">
              <thead>
                <tr>
                  <th>Clarks Width Code</th>
                  <th>Fitting Classification</th>
                  <th>Target Foot Shape</th>
                  <th>Fitting Recommendation</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><strong>D Fitting</strong></td><td>Narrow Fit</td><td>Slim instep, slender heel, narrow ball</td><td>Wearers whose heels slip in standard shoes</td></tr>
                <tr><td><strong>E Fitting</strong></td><td>Slim or Standard Women Fit</td><td>Standard width for women, narrow for men</td><td>Average women feet and slender boys feet</td></tr>
                <tr><td><strong>F Fitting</strong></td><td>Standard Regular Fit</td><td>Medium width</td><td>Standard foot proportions with no side pressure</td></tr>
                <tr><td><strong>G Fitting</strong></td><td>Wide Fit</td><td>Broad ball of the foot, higher instep volume</td><td>Shoppers whose toes feel squeezed in F fittings</td></tr>
                <tr><td><strong>H Fitting</strong></td><td>Extra Wide Fit</td><td>Substantially broad feet, high arches</td><td>Maximum interior volume across forefoot</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Deep-Dive SEO Prose Content -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">British footwear guide</p>
            <h2 class="prose-main-title">Understanding the UK shoe size chart, sizing standards, and Clarks fittings</h2>
            <p class="prose-lead">British footwear sizing links historical measurement increments with modern manufacturing systems and width grading standards.</p>
          </header>

          <div class="content-prose">
            <h3 class="heading-sm">The origin of the UK shoe size chart: the barleycorn system</h3>
            <p>The British footwear measuring system dates to 1324 under King Edward II, who formalized three dried barleycorn grains laid end-to-end as one inch. English shoemakers adopted one barleycorn (8.46 mm or 1/3 inch) as the increment between each full shoe size. A half size represents 4.23 mm (1/6 inch). While American sizing also uses barleycorn increments, it begins from a zero-point offset that is 0.5 to 1 full size ahead of British numbering. A British man wearing a UK 8.5 takes a US Men 9.0, whereas a British woman wearing a UK 5.0 takes a US Women 7.0.</p>

            <h3 class="heading-sm">Clarks shoe size chart: children footwear and width fittings</h3>
            <p>Clarks has manufactured footwear in Somerset since 1825 and remains the benchmark for British children shoes. The company divides juvenile footwear into two functional groups:</p>
            <ul>
              <li>Infant and first shoes (UK 0 to UK 9.5) with flexible soles for early walking development.</li>
              <li>Junior and school shoes (UK 10 to adult UK 2.5) with reinforced heel counters for playground wear.</li>
            </ul>
            <p>Clarks utilizes distinct width grades designated by letters D, E, F, G, and H. Most shoe brands offer only a single medium width. If a child experiences tightness across the fifth metatarsal, choosing a wide G fitting resolves the pressure without buying a longer size that causes tripping.</p>

            <h3 class="heading-sm">Navigating the kids shoe size chart UK and toddler shoe size chart by age</h3>
            <p>British children footwear uses a scale that restarts after size 13.5:</p>
            <ul>
              <li>Infant and child sizes span UK 0 through UK 13.5.</li>
              <li>Above UK 13.5, the scale restarts at UK 1 for junior school students.</li>
              <li>An adult UK 1 is larger than a child UK 13.5.</li>
            </ul>
            <p>Checking foot length in centimeters prevents buying nursery footwear when shopping for older children.</p>

            <h3 class="heading-sm">Chinese shoe sizing compared to UK footwear</h3>
            <p>Footwear imported from China follows one of two numbering standards:</p>
            <ul>
              <li>China Type 1 mirrors continental European Paris Points, where size 42 equals UK 8.5.</li>
              <li>China Type 2 follows GB/T 3293.1-1998 using Mondopoint millimeters, where label 260 indicates a 260 mm foot length.</li>
            </ul>

            <h3 class="heading-sm">How to measure your foot using a feet size chart</h3>
            <p>Follow four steps to measure your feet accurately:</p>
            <ol>
              <li>Measure late in the day: Feet expand slightly by afternoon after normal walking and standing.</li>
              <li>Place paper against a skirting board: Tape a blank paper sheet to a hard floor flush against the wall.</li>
              <li>Stand tall: Stand upright on the paper with your heel touching the wall. Have a partner mark the furthest tip of your longest toe.</li>
              <li>Measure in millimeters: Measure from the edge of the paper to your mark, then check the reference chart.</li>
            </ol>
            <p>Maintain 10 to 12 mm of space between your longest toe and the front tip of the shoe to allow the foot to slide forward naturally during walking stride transitions.</p>

            <h3 class="heading-sm">How to read a shoe size chart correctly</h3>
            <p>To identify your proper size, start with your foot length in centimeters. Trace horizontally across the conversion table to the UK column. Confirm whether you are reading men, women, or kids charts. Cross-reference width codes when buying from Clarks or traditional British cordwainers to accommodate your forefoot volume without increasing shoe length.</p>

            <h3 class="heading-sm">How to ensure your shoes fit properly</h3>
            <p>Check these three indicators when testing new footwear:</p>
            <ol>
              <li>Forefoot freedom: Your toes should lie flat with room to wiggle slightly without lateral pressure.</li>
              <li>Heel security: The heel counter must grip your heel firmly with less than 5 mm of vertical slipping.</li>
              <li>Metatarsal alignment: The widest part of your foot must align with the widest flex line of the sole.</li>
            </ol>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <div class="faq-card">
          <p class="mono-eyebrow">Frequently asked questions</p>
          <h2 class="heading-lg" style="margin-bottom:24px">UK footwear and size guide questions</h2>
          <div class="faq-list">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="faq-a"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Related Internal Links -->
    <section class="related-band">
      <div class="page-inner">
        <RelatedLinks
          title="Popular UK shoe size conversions"
          links={conversionLinks}
        />
        <div style="margin-top:32px">
          <RelatedLinks
            title="Explore other regional sizing systems"
            links={countryLinks}
          />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 64px 24px 40px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1), transparent 60%);
    border-bottom: 1px solid var(--v-hairline);
  }
  .page-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-sub {
    max-width: 720px;
    margin: 16px auto 24px;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .badge-trust {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-body);
  }

  /* Converter Band */
  .converter-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .converter-inline {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: var(--v-shadow-whisper);
  }
  .ci-header {
    margin-bottom: 24px;
  }
  .ci-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }
  .ci-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ci-results {
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    padding: 20px;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ci-placeholder {
    color: var(--v-mute);
    font-size: 14px;
    margin: 0;
    text-align: center;
  }

  /* Tables band */
  .table-band {
    padding: 48px 24px;
  }
  .section-heading {
    margin-bottom: 32px;
  }
  .table-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    overflow: hidden;
  }
  .table-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--v-hairline);
    background: var(--v-canvas);
    flex-wrap: wrap;
    gap: 12px;
  }
  .category-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: var(--v-r-full);
    background: var(--v-hairline-soft);
    color: var(--v-body);
  }

  /* Prose band */
  .content-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .prose-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 40px;
  }
  .prose-header {
    border-bottom: 1px solid var(--v-hairline);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }
  .prose-main-title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--v-ink);
    margin: 8px 0 12px;
  }
  .prose-lead {
    font-size: 16px;
    line-height: 26px;
    color: var(--v-body);
    margin: 0;
  }
  .content-prose h3 {
    margin-top: 32px;
    margin-bottom: 12px;
  }
  .content-prose p, .content-prose ul, .content-prose ol {
    margin-bottom: 16px;
    line-height: 24px;
    color: var(--v-body);
  }
  .content-prose ul, .content-prose ol {
    padding-left: 20px;
  }
  .content-prose li {
    margin-bottom: 8px;
  }

  /* FAQ */
  .faq-band {
    padding: 48px 24px;
  }
  .faq-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 36px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-sm);
    overflow: hidden;
    background: var(--v-canvas);
    transition: border-color 0.15s ease;
  }
  .faq-item[open] {
    border-color: var(--v-link);
  }
  .faq-q {
    padding: 16px 20px;
    font-weight: 600;
    font-size: 15px;
    color: var(--v-ink);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }
  .faq-chevron {
    transition: transform 0.2s ease;
    color: var(--v-mute);
    flex-shrink: 0;
  }
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--v-link);
  }
  .faq-a {
    padding: 0 20px 16px;
    color: var(--v-body);
    font-size: 14px;
    line-height: 22px;
  }
  .faq-a p { margin: 0; }

  .related-band {
    padding: 16px 24px 80px;
  }

  @media (max-width: 768px) {
    .ci-row { grid-template-columns: 1fr; }
    .prose-card, .converter-inline, .faq-card { padding: 24px 16px; }
  }
</style>

<script>
  import { SIZE_DATA } from '../../data/shoe-sizes';

  const sizeSelect = document.getElementById('uk-size') as HTMLSelectElement;
  const genderSelect = document.getElementById('uk-gender') as HTMLSelectElement;
  const resultsContainer = document.getElementById('uk-results');

  function updateSizes() {
    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const currentVal = sizeSelect?.value;
    const sizes = SIZE_DATA[gender]?.uk || [];

    if (sizeSelect) {
      sizeSelect.innerHTML = '<option value="" disabled selected>Select UK size</option>';
      sizes.forEach(s => {
        const opt = document.createElement('option');
        opt.value = String(s);
        opt.textContent = `UK ${s}`;
        sizeSelect.appendChild(opt);
      });
      if (currentVal && sizes.map(String).includes(currentVal)) {
        sizeSelect.value = currentVal;
      }
    }
    renderResults();
  }

  function renderResults() {
    if (!resultsContainer || !sizeSelect) return;
    const size = sizeSelect.value;
    if (!size) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Select a UK size to see instant conversions across US, EU, India, Japan, CM, and Inches</p>';
      return;
    }

    const gender = (genderSelect?.value || 'men') as 'men' | 'women' | 'kids';
    const data = SIZE_DATA[gender];
    const idx = data.uk?.findIndex(s => String(s) === size);

    if (idx === undefined || idx === -1) {
      resultsContainer.innerHTML = '<p class="ci-placeholder">Size not found in database</p>';
      return;
    }

    const us = data.us?.[idx] ?? '-';
    const eu = data.eu?.[idx] ?? '-';
    const india = data.india?.[idx] ?? '-';
    const cm = data.cm?.[idx] ?? '-';
    const inches = data.inches?.[idx] ?? '-';

    resultsContainer.innerHTML = `
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:12px; width:100%;">
        <div style="background:var(--v-elevated); border:1px solid var(--v-link); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase; color:var(--v-link);">UK Selected</span>
          <div style="font-size:20px; font-weight:700; color:var(--v-ink); margin-top:2px;">UK ${size}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">US Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">US ${us}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">EU Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${eu}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">India Size</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${india}</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Foot CM</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${cm} cm</div>
        </div>
        <div style="background:var(--v-elevated); border:1px solid var(--v-hairline); padding:12px; border-radius:8px; text-align:center;">
          <span style="font-family:var(--font-mono); font-size:11px; font-weight:600; text-transform:uppercase; color:var(--v-body);">Inches</span>
          <div style="font-size:18px; font-weight:600; color:var(--v-ink); margin-top:2px;">${inches}"</div>
        </div>
      </div>
    `;
  }

  genderSelect?.addEventListener('change', updateSizes);
  sizeSelect?.addEventListener('change', renderResults);
</script>
