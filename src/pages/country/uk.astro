---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Footer from '../../components/Footer.astro';
import { SIZE_DATA } from '../../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/country/uk/`;
const pageTitle = 'UK Shoe Size Chart — British Sizing & Clarks Guide';
const pageDescription = 'Comprehensive UK shoe size chart for British men, women, and kids. Convert UK sizes to US, EU, and CM with Clarks width fittings and toddler guides.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'Shoe size chart: How to measure your feet accurately at home?',
    a: 'To measure your feet using a shoe size chart how to measure technique: stand upright with your heel lightly resting against a flat wall on top of a sheet of plain paper taped to a hard floor. Wearing the socks you plan to pair with your shoes, mark the furthest tip of your longest toe (which may be your second toe). Measure the distance from the edge of the paper to your mark in millimetres. Refer to our feet size chart and add 10 mm (approx. 0.4 inches) of walking clearance to find your true British shoe size.'
  },
  {
    q: 'How do I read a shoe size chart to find my correct UK size?',
    a: 'To read a shoe size chart effectively: first locate your anatomical foot length in the centimetres (CM) or millimetres column rather than guessing from old footwear. Next, trace across horizontally to find your corresponding UK adult or child size. If you fall between two half-sizes, round up to allow natural foot expansion during walking. Finally, check whether the brand lists a width fitting letter (such as Clarks D, E, F, G, or H) to ensure the forefoot width matches your foot volume.'
  },
  {
    q: 'What is a Chinese shoe size chart and how does it convert to UK sizes?',
    a: 'China utilises two footwear measurement systems. The traditional China Type 1 system matches European Paris Points (e.g., a China size 42 corresponds directly to an EU 42 and UK size 8). The modern China Type 2 national standard (GB/T 3293.1-1998) is based on metric Mondopoint millimetres (e.g., China 260 indicates a foot length of 260 mm / 26.0 cm, which converts to UK 7.5 to 8). When buying from Chinese online retailers, check whether the label displays metric millimetres or continental EU numbers.'
  },
  {
    q: 'How to fit my shoe size chart: How should properly fitted shoes feel?',
    a: 'To verify proper fit using our how to fit my shoe size chart criteria, your footwear must satisfy three clinical requirements: 1) Toe Clearance: There must be 10 to 12 mm (roughly a thumb width) between your longest toe and the front tip; 2) Heel Lock: The heel counter should hug your calcaneus snugly with no vertical slipping when you step forward; and 3) Flex Point: The ball of your foot (first metatarsal joint) must align cleanly with the widest part and natural flex groove of the sole without bulging or side pressure.'
  },
  {
    q: 'How does a shoe size width chart work for Clarks and British footwear?',
    a: 'In British shoemaking, width is designated by alphabetical letters rather than numerical sizes. On a Clarks shoe size width chart: "D" signifies narrow fit (women/girls), "E" is slim/narrow for men or standard for women, "F" is the standard medium fit (worn by approximately 75% of the British population), "G" is wide fit, and "H" is extra wide. Selecting the correct width fitting prevents the common mistake of buying an oversized shoe just to accommodate wide toes or a high instep.'
  },
  {
    q: 'What does CM mean on a shoe size chart and why is it the most reliable measurement?',
    a: 'On any size guide shoes, "CM" stands for centimetres and denotes either the bare foot length the shoe was sculpted for, or the internal footbed length. Unlike UK sizes (calculated in barleycorns of 1/3 inch) or European sizes (calculated in Paris Points of 2/3 cm), centimetres represent an unskewed physical metric. Knowing your foot length in centimetres allows you to bypass brand inconsistencies and achieve an exact conversion across global manufacturers.'
  },
  {
    q: 'How do UK toddler and children\'s shoe sizes correspond to age?',
    a: 'On a toddler shoe size chart by age in Great Britain: babies wear UK 0 to 1 (0–6 months); infants wear UK 2 to 4 (6–18 months); toddlers wear UK 5 to 8 (18 months to 3.5 years); and little kids wear UK 9 to 13.5 (3.5 to 7 years). Once a child outgrows UK 13.5, the British childs shoe size chart resets back to UK 1 (Junior/Adult 1) through UK 6 (ages 8 to 12+).'
  },
  {
    q: 'How do UK adult shoe sizes compare with US and European footwear?',
    a: 'For men, a UK shoe size is roughly 0.5 to 1 size smaller than an American US Men\'s size (for example, UK 9 = US 9.5 to 10 = EU 43). For women, a UK shoe size is 2 sizes smaller than a US Women\'s size (for example, UK 5 = US Women\'s 7 = EU 38). European Paris point sizing is gender-neutral, making it a reliable bridge when converting between British and international footwear.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const conversionLinks = [
  { label: 'UK to US Shoe Size', href: '/uk-to-us-shoe-size/' },
  { label: 'UK to EU Shoe Size', href: '/uk-to-eu-shoe-size/' },
  { label: 'UK to India Shoe Size', href: '/uk-to-india-shoe-size/' },
  { label: 'US to UK Shoe Size', href: '/us-to-uk-shoe-size/' },
  { label: 'Shoe Size in CM', href: '/shoe-size-in-cm/' },
];

const countryLinks = [
  { label: '🇺🇸 United States', href: '/country/us/' },
  { label: '🇪🇺 Europe', href: '/country/europe/' },
  { label: '🇮🇳 India', href: '/country/india/' },
  { label: '🇯🇵 Japan', href: '/country/japan/' },
  { label: '🇦🇺 Australia', href: '/country/australia/' },
  { label: '🇲🇽 Mexico', href: '/country/mexico/' },
];
