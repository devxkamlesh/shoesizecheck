---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/india-to-uk-shoe-size/`;
const pageTitle = 'India to UK shoe size: Indian size chart and converter';
const pageDescription = 'Indian shoe size to UK conversion chart for men, women, and kids. India and UK sizes match 1:1, with CM, US, and EU equivalents.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'Is Indian shoe size the same as UK shoe size?',
    a: 'Indian shoe sizes and UK shoe sizes are numerically identical (1:1 equivalence) in length. If you wear an Indian size 8, you wear a UK size 8. Both systems trace their origins to the British imperial barleycorn measurement of one-third of an inch per size increment.'
  },
  {
    q: 'What is India 8 in UK shoe size?',
    a: 'India size 8 is UK size 8. Both correspond to an anatomical foot length of 27.0 centimeters. In international sizing, this equals US Men\'s 9 and EU 42.'
  },
  {
    q: 'What is India size 7 in UK footwear?',
    a: 'India size 7 is directly equivalent to UK size 7. It fits a foot length of 26.0 centimeters, which matches US Men\'s 8 and EU 41.'
  },
  {
    q: 'How do Indian women\'s shoe sizes convert to UK sizes?',
    a: 'Indian women\'s shoe sizes follow the UK scale directly on a 1:1 basis. For example, an Indian women\'s size 5 equals a UK women\'s size 5 (24.0 cm, EU 38, US Women\'s 7).'
  },
  {
    q: 'Do British shoes run narrower than Indian shoes?',
    a: 'British heritage brands such as Clarks, Dr. Martens, Church\'s, and Loake construct standard footwear on medium F width lasts. Research by the CSIR-Central Leather Research Institute (CSIR-CLRI) indicates that Indian feet have a wider ball girth and higher instep, so choosing a wide fitting (G or H) or half a size up is common for formal British leather footwear.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'UK to India Shoe Size Converter', href: '/uk-to-india-shoe-size/' },
  { label: 'India to EU Shoe Size Converter', href: '/india-to-eu-shoe-size/' },
  { label: 'EU to India Shoe Size Converter', href: '/eu-to-india-shoe-size/' },
  { label: 'India Shoe Sizing Guide', href: '/country/india/' },
  { label: 'United Kingdom Shoe Sizing Guide', href: '/country/uk/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'India to UK Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Direct 1:1 imperial barleycorn alignment</p>
        <h1 class="display-xl">India to UK shoe size converter</h1>
        <p class="hero-sub body-lg">
          Convert Indian shoe sizes to British (UK) sizes. Verify the 1:1 length correspondence, explore width differences between Indian lasts and British brands like Clarks, and review the full conversion table.
        </p>
        <p class="hero-answer"><strong>Direct answer:</strong> Indian size 9 is usually UK size 9. Indian and UK adult sizes generally use the same numeric scale, but check the brand&apos;s CM measurement for the best fit.</p>

        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Length Equivalence:</span>
            <span class="badge-val">1:1 (India = UK)</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Measurement Standard:</span>
            <span class="badge-val">Barleycorn (1/3 in)</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Fit Consideration:</span>
            <span class="badge-val">Forefoot Width &amp; Instep</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert Indian (IND / Bata) to British (UK) Size</h2>
            <p class="conv-card-sub">Select your gender and Indian shoe size to determine the corresponding UK shoe size and anatomical footbed length.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> Indian (IND / Bata) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select Indian shoe size">
                <option value="" disabled>Select India size</option>
                {menSizes.map(s => <option value={String(s.india)} selected={s.india === 8.0 ? true : undefined}>{s.india} India</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">India (IND / Bata)</span>
                <span class="conv-val" id="res-in">8</span>
                <span class="conv-note" id="res-in-sub">Domestic Indian Size</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">United Kingdom (UK)</span>
                <span class="conv-val" id="res-uk">8</span>
                <span class="conv-note" id="res-uk-sub">Identical 1:1 Length</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed Length</span>
                <span class="conv-val-sm" id="res-cm">27.0 cm</span>
                <span class="conv-note" id="res-in-meas">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Common India to UK Shoe Size Benchmarks</h2>
        <p class="section-sub">Quick reference for the most widely shopped adult sizes when converting Indian footwear to British sizing.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">India 7 → UK 7</span>
              <span class="snap-detail">Foot length: 26.0 cm · EU 41 · US 8</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">India 8 → UK 8</span>
              <span class="snap-detail">Foot length: 27.0 cm · EU 42 · US 9</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">India 9 → UK 9</span>
              <span class="snap-detail">Foot length: 28.0 cm · EU 43 · US 10</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">India 4 → UK 4</span>
              <span class="snap-detail">Foot length: 23.0 cm · EU 36.5 · US 6</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">India 5 → UK 5</span>
              <span class="snap-detail">Foot length: 24.0 cm · EU 38 · US 7</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">India 6 → UK 6</span>
              <span class="snap-detail">Foot length: 25.0 cm · EU 39 · US 8</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Comprehensive Conversion Tables -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">Complete India to UK Shoe Size Conversion Charts</h2>
        <p class="section-sub">Comprehensive sizing tables across men's, women's, and children's categories including international equivalents.</p>

        <!-- Tabs -->
        <div class="table-tabs" role="tablist" aria-label="Footwear Category Tables">
          <button class="tab-btn active" role="tab" aria-selected="true" data-target="panel-men">Men's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-women">Women's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-kids">Kids' Sizes</button>
        </div>

        <!-- Men's Panel -->
        <div id="panel-men" class="table-panel active" role="tabpanel">
          <h3 class="table-heading">Men's India to UK Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>India (IND / Bata)</th>
                  <th>UK Size</th>
                  <th>US Men</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>India {r.india}</strong></td>
                    <td class="highlight-cell"><strong>UK {r.uk}</strong></td>
                    <td>US {r.us}</td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}″</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Panel -->
        <div id="panel-women" class="table-panel" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Women's India to UK Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>India (IND / Bata)</th>
                  <th>UK Size</th>
                  <th>US Women</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>India {r.india}</strong></td>
                    <td class="highlight-cell"><strong>UK {r.uk}</strong></td>
                    <td>US {r.us}</td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}″</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Panel -->
        <div id="panel-kids" class="table-panel" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Kids' India to UK Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>India Size</th>
                  <th>UK Size</th>
                  <th>Footbed (CM)</th>
                  <th>Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>India {r.india}</strong></td>
                    <td class="highlight-cell"><strong>UK {r.uk}</strong></td>
                    <td>{r.cm} cm</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- Editorial Guide -->
    <article class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">India to UK shoe sizing guide: sizing equivalence, width nuances, and brand tips</h2>

        <p class="lead-paragraph">
          Whether you are an Indian consumer shopping online on British retail portals like ASOS, Clarks, and Next, or traveling in the United Kingdom, converting Indian shoe sizes to British sizes is straightforward. In footbed length, Indian and British shoe sizes share a 1:1 equivalence. An Indian size 8 translates directly into a UK size 8. However, differences in last shapes and width fittings can affect fit across brands.
        </p>

        <h3>1. Why Indian and UK shoe sizes are identical in length</h3>
        <p>
          The 1:1 numerical sizing between India and the United Kingdom is historical. Modern industrial footwear manufacturing in India began during the British colonial period. Major early manufacturers, including Bata India in the 1930s, built manufacturing lasts using the British imperial system under Indian standard IS 1638:1969.
        </p>
        <p>
          Both countries use the barleycorn scale, where each full shoe size represents one-third of an inch (8.46 millimeters), and each half size represents one-sixth of an inch (4.23 mm). Full details on imperial units appear in our <a href="/shoe-size-in-inches/">shoe size in inches guide</a>.
        </p>
        <ul>
          <li>India 7 equals UK 7 (26.0 cm foot length, EU 41, US Men 8.0).</li>
          <li>India 8 equals UK 8 (27.0 cm foot length, EU 42, US Men 9.0).</li>
          <li>India 9 equals UK 9 (28.0 cm foot length, EU 44, US Men 10.0).</li>
          <li>India 10 equals UK 10 (29.0 cm foot length, EU 45, US Men 11.0).</li>
        </ul>
        <p>
          This holds true across Indian manufacturers such as Bata India, Red Tape, Liberty, and Relaxo. If your Bata shoes are marked size 8, your baseline size in British footwear is size 8.
        </p>

        <h3>2. Women's shoe size comparisons: India and UK</h3>
        <p>
          Unlike the United States, where women's sizing is offset from men's by 2 full numbers, the British and Indian systems maintain identical length calibrations for women's shoes:
        </p>
        <ul>
          <li>An Indian women's size 4 corresponds directly to a UK women's size 4 (23.0 cm footbed, EU 36.5, US Women 6.0).</li>
          <li>An Indian women's size 5 corresponds to a UK women's size 5 (24.0 cm footbed, EU 38, US Women 7.0).</li>
          <li>An Indian women's size 6 equals a UK women's size 6 (25.0 cm footbed, EU 39, US Women 8.0).</li>
          <li>An Indian women's size 7 corresponds to a UK women's size 7 (26.0 cm footbed, EU 40.5, US Women 9.0).</li>
        </ul>

        <h3>3. Width variations: Indian feet and British shoe lasts</h3>
        <p>
          While length matches, width and internal volume often differ. British heritage footwear brands like Clarks, Church's, and Loake construct standard footwear on an F width last (standard British medium).
        </p>
        <p>
          An anthropometric foot survey conducted by the CSIR-Central Leather Research Institute (CSIR-CLRI), published in their 2022 survey report, documented that Indian feet show broader metatarsal ball girth and higher dorsal instep measurements relative to European lasts.
        </p>
        <p>
          When buying British leather boots or Goodyear-welted dress shoes, an Indian buyer who wears a standard India 8 might find a standard UK 8 F fitting snug across the forefoot. Choosing a wide fitting (G or H) or moving up a half size offers additional room.
        </p>

        <h3>4. Decoding British width fitting standards</h3>
        <p>
          British footwear websites list alphabetical width designations:
        </p>
        <ul>
          <li>E fitting is narrow, designed for slender feet.</li>
          <li>F fitting is standard medium, common on British casual shoes.</li>
          <li>G fitting offers wide volume across the forefoot and instep.</li>
          <li>H fitting is extra wide, providing maximum interior room.</li>
        </ul>

        <h3>5. The BIS Bha standard: India's footwear framework</h3>
        <p>
          To create footwear tailored to Indian anatomy, the Bureau of Indian Standards and CSIR-CLRI developed the Bha sizing standard. By categorizing Indian feet across eight life stages, Bha aims to replace the legacy UK-derived standard in domestic production. Until manufacturers update tooling across retail lines, domestic footwear continues to use the UK scale as its primary reference.
        </p>

        <h3>6. Practical buying checklist for Indian shoppers</h3>
        <ul>
          <li>Order your exact Indian size for casual sneakers and running shoes: an Indian size 8 translates to UK 8.</li>
          <li>Account for sock thickness when buying winter boots by choosing a half size larger.</li>
          <li>Look for Clarks G fittings if you have broader feet.</li>
          <li>Measure your barefoot length in centimeters following our <a href="/shoe-size-by-foot-length/">shoe size by foot length guide</a>. A 27.0 cm footbed matches UK 8 and India 8.</li>
        </ul>
      </div>
    </article>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Answers to common questions about converting Indian shoe sizes to UK sizes.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0 ? true : undefined}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resIn = document.getElementById('res-in');
    const resInSub = document.getElementById('res-in-sub');
    const resUk = document.getElementById('res-uk');
    const resUkSub = document.getElementById('res-uk-sub');
    const resCm = document.getElementById('res-cm');
    const resInMeas = document.getElementById('res-in-meas');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.india);
        opt.textContent = `${item.india} India`;
        if (gender === 'men' && item.india === 8.0) opt.selected = true;
        if (gender === 'women' && item.india === 5.0) opt.selected = true;
        if (gender === 'kids' && item.india === '9.5C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      if (gender === 'women') list = WOMEN;
      if (gender === 'kids') list = KIDS;

      const match = list.find(item => String(item.india) === String(val));
      if (!match) return;

      if (resIn) resIn.textContent = String(match.india);
      if (resInSub) resInSub.textContent = "Domestic Indian Size";
      if (resUk) resUk.textContent = String(match.uk);
      if (resUkSub) resUkSub.textContent = "Identical 1:1 Length";
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resInMeas) resInMeas.textContent = match.inch ? `${match.inch} inches` : `${match.stage || 'Metric'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Hero */
  .page-hero {
    padding: 56px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .page-inner { max-width: 960px; margin: 0 auto; }
  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    color: var(--v-ink);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .hero-sub { font-size: 16px; color: var(--v-body); line-height: 26px; max-width: 680px; margin: 0 auto 24px; }
  .hero-answer { max-width: 680px; margin: 0 auto 24px; padding: 12px 16px; border-left: 3px solid var(--v-link); background: var(--v-link-soft); color: var(--v-body); font-size: 15px; line-height: 24px; text-align: left; }

  /* Quick Stat Badges */
  .quick-stat-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    font-size: 12.5px;
    box-shadow: var(--v-shadow-whisper);
  }
  .badge-label { color: var(--v-mute); }
  .badge-val { font-family: var(--font-mono); font-weight: 700; color: var(--v-ink); }

  /* Converter Band */
  .converter-band { padding: 40px 24px 56px; background: var(--v-canvas); }
  .conv-card {
    padding: 32px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    box-shadow: var(--v-shadow-floating);
  }
