  { eu: 40.5, cm: 26.0, inch: 10.2, us: 9.0, uk: 7.0 },
  { eu: 41.0, cm: 26.5, inch: 10.4, us: 9.5, uk: 7.5 },
  { eu: 42.0, cm: 27.0, inch: 10.6, us: 10.0, uk: 8.0 },
