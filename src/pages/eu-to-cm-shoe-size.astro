    </div>

    <!-- Hero Section -->
    <section class="hero-band">
      <div class="page-inner hero-content">
        <span class="badge-pill">Metric Footwear Conversion</span>
        <h1 class="hero-title">EU to CM Shoe Size Converter</h1>
        <p class="hero-sub">Convert European shoe sizes to centimeters (CM) and millimeters instantly. Check accurate men's, women's, and children's charts with American feet size conversions, Paris Point formulas, and insole guides.</p>
        
        <div class="hero-stats">
          <div class="stat-pill">
            <span class="stat-label">Paris Point</span>
            <span class="stat-val">1 EU = 2/3 cm (6.67 mm)</span>
          </div>
          <div class="stat-pill">
            <span class="stat-label">Most Common Men</span>
            <span class="stat-val">EU 42 = 27.0 cm</span>
          </div>
          <div class="stat-pill">
            <span class="stat-label">Most Common Women</span>
            <span class="stat-val">EU 38 = 24.0 cm</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert Shoe Size EU to CM</h2>
            <p class="conv-card-sub">Select your gender and European (EU) footwear size to compute your exact footbed length in centimeters, inches, and corresponding US/UK sizes.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> European (EU) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select EU shoe size">
                <option value="" disabled>Select EU size</option>
                {menSizes.map(s => <option value={String(s.eu)} selected={s.eu === 42.0 ? true : undefined}>{s.eu.toFixed(1)} EU</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">European Size (EU)</span>
                <span class="conv-val" id="res-eu">42.0</span>
                <span class="conv-note" id="res-eu-sub">Paris Point Unisex</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
