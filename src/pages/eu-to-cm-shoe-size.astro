---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/eu-to-cm-shoe-size/`;
const pageTitle = 'EU to CM shoe size converter: European size in CM chart';
const pageDescription = 'Convert EU shoe sizes to centimeters (CM). Accurate European to CM shoe size charts for men, women, and kids with formula guides.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'How do I convert European (EU) shoe size to centimeters (CM)?',
    a: 'To convert shoe size EU to CM, reference our calibrated chart or use the Paris Point calculation. Under the European system, each EU size equals two-thirds of a centimeter (6.67 mm). After factoring in last allowance, an EU 42 fits a 27.0 cm foot length and an EU 38.5 fits a 25.0 cm foot length.'
  },
  {
    q: 'What is a 10.5 size in European shoe sizing?',
    a: 'An American Men\'s US 10.5 equals European EU 44.5 (fitting a 28.5 cm foot length). An American Women\'s US 10.5 equals European EU 42.0 (fitting a 27.5 cm foot length). An anatomical foot length of 10.5 inches (26.7 cm) corresponds to European EU 41.5 to 42.'
  },
  {
    q: 'How do EU sizes convert to US shoe sizes?',
    a: 'When translating EU shoe sizes to US footwear, men subtract 33 from the European number (EU 42 − 33 = US Men 9.0), while women subtract 30.5 (EU 38.5 − 30.5 = US Women 8.0).'
  },
  {
    q: 'Why are centimeters (CM) more accurate than European shoe sizes?',
    a: 'Centimeters provide a metric measurement of your foot from heel to longest toe. While numerical sizes can vary between manufacturers, centimeters reflect the physical footbed space inside the shoe.'
  },
  {
    q: 'How does the European Paris Point system work for footwear length?',
    a: 'European sizing uses the Paris Point, where 1 Paris Point equals 2/3 of a centimeter (6.67 millimeters). A shoe labeled EU 42 has a last length of 28.0 cm (42 × 2/3 cm), accommodating a foot length of 27.0 cm with 1.0 cm of toe clearance.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'EU 40 to AU Shoe Size', href: '/eu-40-to-au-shoe-size/' },
  { label: 'US to CM Shoe Size Converter', href: '/us-to-cm-shoe-size/' },
  { label: 'Shoe Size in Centimeters (CM) Guide', href: '/shoe-size-in-cm/' },
  { label: 'EU to US Shoe Size Converter', href: '/eu-to-us-shoe-size/' },
  { label: 'US to EU Shoe Size Converter', href: '/us-to-eu-shoe-size/' },
  { label: 'EU to UK Shoe Size Converter', href: '/eu-to-uk-shoe-size/' },
  { label: 'EU to India Shoe Size Converter', href: '/eu-to-india-shoe-size/' },
  { label: 'Mondopoint Shoe Size Guide', href: '/mondopoint-shoe-size/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <!-- Breadcrumbs -->
    <div class="page-inner pt-4">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Converters', href: '/converters/' },
        { label: 'EU to CM', href: '/eu-to-cm-shoe-size/' }
      ]} />
    </div>

    <!-- Hero Section -->
    <section class="hero-band">
      <div class="page-inner hero-content">
        <span class="badge-pill">Metric Footwear Conversion</span>
        <h1 class="hero-title">EU to CM Shoe Size Converter</h1>
        <p class="hero-sub">Convert European shoe sizes to centimeters (CM) and millimeters instantly. Check accurate men's, women's, and children's charts with American feet size conversions, Paris Point formulas, and insole guides.</p>
        
        <div class="hero-stats">
          <div class="stat-pill">
            <span class="stat-label">Paris Point</span>
            <span class="stat-val">1 EU = 2/3 cm (6.67 mm)</span>
          </div>
          <div class="stat-pill">
            <span class="stat-label">Most Common Men</span>
            <span class="stat-val">EU 42 = 27.0 cm</span>
          </div>
          <div class="stat-pill">
            <span class="stat-label">Most Common Women</span>
            <span class="stat-val">EU 38 = 24.0 cm</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert Shoe Size EU to CM</h2>
            <p class="conv-card-sub">Select your gender and European (EU) footwear size to compute your exact footbed length in centimeters, inches, and corresponding US/UK sizes.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> European (EU) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select EU shoe size">
                <option value="" disabled>Select EU size</option>
                {menSizes.map(s => <option value={String(s.eu)} selected={s.eu === 42.0 ? true : undefined}>{s.eu.toFixed(1)} EU</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">European Size (EU)</span>
                <span class="conv-val" id="res-eu">42.0</span>
                <span class="conv-note" id="res-eu-sub">Paris Point Unisex</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">Foot Length (CM)</span>
                <span class="conv-val" id="res-cm">27.0 cm</span>
                <span class="conv-note" id="res-mm">270 mm (Mondopoint)</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">American & UK Equiv.</span>
                <span class="conv-val-sm" id="res-aux">US 9.0 · UK 8.5</span>
                <span class="conv-note" id="res-inch">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Popular EU to Centimeter Benchmarks</h2>
        <p class="section-sub">Quick reference for the most widely searched European shoe sizes and their metric equivalents.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 42 → 27.0 cm</span>
              <span class="snap-detail">Foot length: 270 mm · US Men 9.0 · UK 8.5 · 10.6 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 38 → 24.0 cm</span>
              <span class="snap-detail">Foot length: 240 mm · US Women 7.0 · UK 5.0 · 9.4 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">US to EU Query</span>
            <div class="snap-body">
              <span class="snap-main">10.5 Feet Size in European → EU 44</span>
              <span class="snap-detail">US Men 10.5 = EU 44.0 (28.5 cm) · US Women 10.5 = EU 42.5 (27.5 cm)</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 41 → 26.0 cm</span>
              <span class="snap-detail">Foot length: 260 mm · US Men 8.0 · US Women 9.0 · 10.2 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 39 → 25.0 cm</span>
              <span class="snap-detail">Foot length: 250 mm · US Women 8.0 · US Men 7.0 · 9.8 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 44 → 28.5 cm</span>
              <span class="snap-detail">Foot length: 285 mm · US Men 10.5 · UK 10.0 · 11.2 inches</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Charts Section -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">Comprehensive EU to CM Shoe Size Chart</h2>
        <p class="section-sub">Cross-comparison tables showing exact correlations between European sizes, foot lengths in centimeters, millimeters, inches, and American sizes.</p>

        <div class="table-tabs" role="tablist">
          <button class="tab-btn active" data-target="tab-men" role="tab" aria-selected="true">Men's EU to CM Chart</button>
          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's EU to CM Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' EU to CM Chart</button>
        </div>

        <!-- Men's Table -->
        <div class="table-panel active" id="tab-men" role="tabpanel">
          <h3 class="table-heading">Men's European to Centimeter Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Men EU to CM shoe size chart">
              <thead>
                <tr>
                  <th>EU Shoe Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Millimeters (MM)</th>
                  <th>Inches</th>
                  <th>US Men Size</th>
                  <th>UK Men Size</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>EU {r.eu.toFixed(1)}</strong></td>
                    <td class="highlight-cell"><strong>{r.cm.toFixed(1)} cm</strong></td>
                    <td>{Math.round(r.cm * 10)} mm</td>
                    <td>{r.inch.toFixed(1)}"</td>
                    <td>US {r.us.toFixed(1)}</td>
                    <td>UK {r.uk.toFixed(1)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Table -->
        <div class="table-panel" id="tab-women" role="tabpanel">
          <h3 class="table-heading">Women's European to Centimeter Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Women EU to CM shoe size chart">
              <thead>
                <tr>
                  <th>EU Shoe Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Millimeters (MM)</th>
                  <th>Inches</th>
                  <th>US Women Size</th>
                  <th>UK Women Size</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>EU {r.eu.toFixed(1)}</strong></td>
                    <td class="highlight-cell"><strong>{r.cm.toFixed(1)} cm</strong></td>
                    <td>{Math.round(r.cm * 10)} mm</td>
                    <td>{r.inch.toFixed(1)}"</td>
                    <td>US {r.us.toFixed(1)}</td>
                    <td>UK {r.uk.toFixed(1)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div class="table-panel" id="tab-kids" role="tabpanel">
          <h3 class="table-heading">Kids' European and centimeter size chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Kids EU to CM shoe size chart">
              <thead>
                <tr>
                  <th>EU Kids Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Millimeters (MM)</th>
                  <th>Inches</th>
                  <th>US Kids Size</th>
                  <th>UK Kids Size</th>
                  <th>Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>EU {r.eu}</strong></td>
                    <td class="highlight-cell"><strong>{r.cm} cm</strong></td>
                    <td>{Math.round(r.cm * 10)} mm</td>
                    <td>{r.inch}"</td>
                    <td>US {r.us}</td>
                    <td>UK {r.uk}</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial SEO Prose Section -->
    <article class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">How to convert EU shoe size to centimeters: sizing guide</h2>
        
        <p class="lead-paragraph">
          Comparing European shoes across brands requires converting European numbers to anatomical centimeter measurements. Understanding how metric Paris Points relate to bare foot length eliminates sizing errors.
        </p>

        <h3>European sizing: Paris points and centimeters</h3>
        <p>
          Unlike the American and British shoe systems based on the barleycorn (1/3 of an inch), European footwear is grounded in the metric Paris Point system. One Paris Point equals two-thirds of a centimeter (6.67 millimeters). Read our guide on <a href="/shoe-size-in-inches/">shoe sizes in inches and barleycorn measurements</a> for comparison.
        </p>
        <p>
          To calculate the shoe last length from a European shoe number, multiply the EU size by 2/3. For example, a shoe stamped EU 42 has an internal last length of 28.0 centimeters (42 × 2/3 = 28.0 cm). Accounting for 1.0 cm of toe clearance, an EU 42 fits a 27.0 cm anatomical foot length.
        </p>

        <h3>Converting European sizes to US sizes</h3>
        <p>
          Standard offsets convert European sizes to American sizes:
        </p>
        <ul>
          <li>For men: subtract 33 from the European size (EU 42 − 33 = US Men 9.0 for a 27.0 cm foot length; EU 44 − 33 = US Men 11.0 for 29.0 cm).</li>
          <li>For women: subtract 30.5 from the European size (EU 38.5 − 30.5 = US Women 8.0 for 25.0 cm).</li>
          <li>In reverse, men add 33 to their US size (US 9.0 + 33 = EU 42), while women add 30.5 (US 8.0 + 30.5 = EU 38.5).</li>
        </ul>

        <h3>Understanding 10.5 in European sizing</h3>
        <p>
          The number 10.5 can refer to distinct sizing metrics:
        </p>
        <ul>
          <li>An American Men's US 10.5 corresponds to EU 44.5 (28.5 cm foot length).</li>
          <li>An American Women's US 10.5 corresponds to EU 42.0 (27.5 cm foot length).</li>
          <li>A British UK 10.5 corresponds to EU 45.0 (29.0 cm foot length).</li>
          <li>A foot length of 10.5 inches (26.7 cm) corresponds to EU 41.5 to 42.0.</li>
        </ul>

        <h3>Centimeter measurements across footwear brands</h3>
        <p>
          Nominal European sizes can vary between brands. Italian leather shoes from formal makers frequently use generous lasts, while French and German athletic models use closer fittings.
        </p>
        <p>
          Referencing foot length in centimeters provides a consistent baseline across manufacturers. Footwear boxes often print this metric as the Japanese (JP) or Mondopoint number.
        </p>

        <h3>Measuring foot length</h3>
        <p>
          To measure your foot length accurately in centimeters, measure both feet from heel to longest toe. See our step-by-step instructions on <a href="/shoe-size-by-foot-length/">measuring shoe size by foot length</a>. A foot measuring 27.0 cm corresponds to EU 42.
        </p>
      </div>
    </article>

    <!-- FAQ Accordion Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Expert answers to common queries regarding European shoe sizes, centimeter foot lengths, and American translations.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Links Band -->
    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resEu = document.getElementById('res-eu');
    const resEuSub = document.getElementById('res-eu-sub');
    const resCm = document.getElementById('res-cm');
    const resMm = document.getElementById('res-mm');
    const resAux = document.getElementById('res-aux');
    const resInch = document.getElementById('res-inch');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.eu);
        opt.textContent = `${item.eu.toFixed(1)} EU`;
        if (gender === 'men' && item.eu === 42.0) opt.selected = true;
        if (gender === 'women' && item.eu === 38.0) opt.selected = true;
        if (gender === 'kids' && item.eu === 27.0) opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "Men's Paris Point";
      if (gender === 'women') { list = WOMEN; label = "Women's Paris Point"; }
      if (gender === 'kids') { list = KIDS; label = "Kids' Paris Point"; }

      const match = list.find(item => String(item.eu) === String(val));
      if (!match) return;

      const mm = Math.round(match.cm * 10);

      if (resEu) resEu.textContent = match.eu.toFixed(1);
      if (resEuSub) resEuSub.textContent = label;
      if (resCm) resCm.textContent = `${match.cm.toFixed(1)} cm`;
      if (resMm) resMm.textContent = `${mm} mm (Mondopoint)`;
      if (resAux) {
        if (gender === 'kids') {
          resAux.textContent = `US ${match.us} · UK ${match.uk}`;
        } else {
          resAux.textContent = `US ${match.us.toFixed(1)} · UK ${match.uk.toFixed(1)}`;
        }
      }
      if (resInch) {
        resInch.textContent = `${match.inch.toFixed(1)} inches`;
      }
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.classList.add('active');
          } else {
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Layout tokens */
  .page-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .pt-4 { padding-top: 16px; }

  /* Hero Band */
  .hero-band {
    padding: 48px 24px 36px;
    background: linear-gradient(180deg, var(--v-elevated) 0%, var(--v-canvas) 100%);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 820px;
    margin: 0 auto;
  }
  .badge-pill {
    display: inline-block;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: var(--v-r-full);
    background: var(--v-badge-bg);
    color: var(--v-link-deep);
    margin-bottom: 16px;
  }
  .hero-title {
    font-size: clamp(30px, 4.5vw, 42px);
    font-weight: 800;
    line-height: 1.15;
    color: var(--v-ink);
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .hero-sub {
    font-size: 16px;
    line-height: 26px;
    color: var(--v-body);
    margin: 0 0 28px;
    max-width: 720px;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    width: 100%;
  }
  .stat-pill {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    padding: 10px 18px;
    border-radius: var(--v-r-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 140px;
  }
  .stat-label {
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--v-mute);
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }
  .stat-val {
    font-size: 15px;
    font-weight: 800;
    color: var(--v-ink);
  }

  /* Converter Band */
  .converter-band {
    padding: 40px 24px;
    background: var(--v-canvas);
  }
  .conv-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }
  .conv-card-header {
    margin-bottom: 24px;
    text-align: center;
  }
  .heading-md {
    font-size: 22px;
