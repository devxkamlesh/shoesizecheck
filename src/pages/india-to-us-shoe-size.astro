---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/india-to-us-shoe-size/`;
const pageTitle = 'India to US shoe size chart: Indian and US converter';
const pageDescription = 'Convert Indian shoe sizes to US sizes with charts for men, women, and kids. See India 8 and 9 in US, plus CM and EU equivalents.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'What is UK size 8 in India, and how does it convert to US sizing?',
    a: 'In Indian footwear retail under IS 1638:1969, UK size 8 and Indian size 8 are identical in length. When converting an Indian size 8 to American footwear, it translates to US Men\'s size 8.5 on the standard scale (fitting a 26.5 cm footbed, EU 41.5). Under sneaker brand charts, India 8 maps to US Men\'s 9.0 (27.0 cm footbed, EU 42.5).'
  },
  {
    q: 'How do I convert an Indian shoe size to US size for men and women?',
    a: 'To convert an Indian shoe size to US, add 0.5 to 1 size for men (US Men = India + 0.5 under ISO standard; US Men = India + 1 for sneaker brands). For women, add 2 full sizes (US = India + 2; for example, India 5 becomes US Women 7, and India 6 becomes US Women 8).'
  },
  {
    q: 'What is shoe size 38 or 42 in India when converting to US sizes?',
    a: 'Shoe sizes 38 and 42 refer to European (EU) sizing. A shoe size 38 in India corresponds to Indian women\'s size 5.5 (24.5 cm foot length), converting to US Women 7.5. An EU 42 corresponds to Indian size 8.5 for men (27.0 cm foot length), which converts to US Men 9.0.'
  },
  {
    q: 'What does EU 36, 37, 39, 43, 44, or 45 shoe size mean in India?',
    a: 'These represent standard European sizing benchmarks: EU 36 corresponds to Indian 3.5 (22.5 cm, US Women 5.5); EU 37 is Indian 4.5 (23.5 cm, US Women 6.5); EU 39 is Indian 6.0 (24.5 cm, US Women 8.0); EU 43 is Indian 9.0 (27.5 cm, US Men 9.5); EU 44 is Indian 9.5 (28.0 cm, US Men 10.0); and EU 45 is Indian 10.5 (29.0 cm, US Men 11.0).'
  },
  {
    q: 'How does Indian foot width compare to American shoe width?',
    a: 'The CSIR-Central Leather Research Institute (CSIR-CLRI) published an anthropometric survey report in 2022 documenting that Indian feet have broader ball girth and higher instep measurements relative to European and standard American lasts. When buying US footwear, individuals with broad forefeet often choose wide fittings or a half size up.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'US to India Shoe Size Converter', href: '/us-to-india-shoe-size/' },
  { label: 'India to UK Shoe Size Converter', href: '/india-to-uk-shoe-size/' },
  { label: 'India to EU Shoe Size Converter', href: '/india-to-eu-shoe-size/' },
  { label: 'UK to US Shoe Size Converter', href: '/uk-to-us-shoe-size/' },
  { label: 'EU to US Shoe Size Converter', href: '/eu-to-us-shoe-size/' },
  { label: 'India Shoe Sizing Guide', href: '/country/india/' },
  { label: 'United States Shoe Sizing Guide', href: '/country/us/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <!-- Breadcrumbs -->
    <div class="page-inner pt-4">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Converters', href: '/converters/' },
        { label: 'India to US', href: '/india-to-us-shoe-size/' }
      ]} />
    </div>

    <!-- Hero Section -->
    <section class="hero-band">
      <div class="page-inner hero-content">
        <span class="badge-pill">International Footwear Converter</span>
        <h1 class="hero-title">India to US Shoe Size Converter</h1>
        <p class="hero-sub">Convert Indian shoe sizes to American (US) sizes effortlessly. Compare detailed men's, women's, and kids' conversion charts with Bata equivalents, European benchmarks, and anatomical footbed measurements in centimetres.</p>
        <p class="hero-answer"><strong>Direct answer:</strong> Indian men&apos;s size 8 is usually US men&apos;s 9, and Indian men&apos;s size 9 is US men&apos;s 10. For women&apos;s shoes, Indian size 5 is usually US women&apos;s 7. Check the CM measurement because brand fits vary.</p>
        
        <div class="hero-stats">
          <div class="stat-pill">
            <span class="stat-label">Men's Formula</span>
            <span class="stat-val">US = India + 1</span>
          </div>
          <div class="stat-pill">
            <span class="stat-label">Women's Formula</span>
            <span class="stat-val">US = India + 2</span>
          </div>
          <div class="stat-pill">
            <span class="stat-label">Reference System</span>
            <span class="stat-val">UK English Barleycorn</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert India to US Shoe Size</h2>
            <p class="conv-card-sub">Select your gender and Indian (IND / UK) footwear size to compute your exact American (US) size, European sizing, and footbed length in centimetres.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> Indian (IND / UK) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select Indian shoe size">
                <option value="" disabled>Select Indian size</option>
                {menSizes.map(s => <option value={String(s.india)} selected={s.india === 8.0 ? true : undefined}>{s.india} India</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">India (IND / UK)</span>
                <span class="conv-val" id="res-in">8.0</span>
                <span class="conv-note" id="res-in-sub">Men's Standard</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">United States (US)</span>
                <span class="conv-val" id="res-us">9.0</span>
                <span class="conv-note" id="res-us-sub">US Men's Equivalent</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed & European</span>
                <span class="conv-val-sm" id="res-cm">27.0 cm · EU 42</span>
                <span class="conv-note" id="res-in-meas">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Common Indian to US shoe size benchmarks</h2>
        <p class="section-sub">Quick reference for the most commonly searched Indian and UK sizes when converting to American footwear.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">India 8 Men → US 9.0</span>
              <span class="snap-detail">Foot length: 27.0 cm · EU 42 · uk size 8 in india · 42 foot size</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">India 7 Men → US 8.0</span>
              <span class="snap-detail">Foot length: 26.0 cm · EU 41 · shoe size 41 in india</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">India 9 Men → US 10.0</span>
              <span class="snap-detail">Foot length: 28.0 cm · EU 43 · 43 shoe size india</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">India 5 Women → US 7.0</span>
              <span class="snap-detail">Foot length: 24.0 cm · EU 38 · 38 foot size in india · shoe size 38</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">India 4 Women → US 6.0</span>
              <span class="snap-detail">Foot length: 23.0 cm · EU 36.5 · 36 shoe size / 37 size in shoes</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">India 6 Women → US 8.0</span>
              <span class="snap-detail">Foot length: 25.0 cm · EU 39 · 39 eu size in india</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Charts Section -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">Indian to US footwear size chart</h2>
        <p class="section-sub">Comparison tables for Indian (IND), UK, US, EU, and foot-length measurements.</p>

        <div class="table-tabs" role="tablist">
          <button class="tab-btn active" data-target="tab-men" role="tab" aria-selected="true">Men's India to US Chart</button>
          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's India to US Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' India to US Chart</button>
        </div>

        <!-- Men's Table -->
        <div class="table-panel active" id="tab-men" role="tabpanel">
          <h3 class="table-heading">Men's Indian to US Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Men Indian to US shoe size chart">
              <thead>
                <tr>
                  <th>India Size (UK)</th>
                  <th>US Men Size</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>India {r.india.toFixed(1)}</strong></td>
                    <td class="highlight-cell"><strong>US {r.us.toFixed(1)}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm.toFixed(1)} cm</td>
                    <td>{r.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Table -->
        <div class="table-panel" id="tab-women" role="tabpanel">
          <h3 class="table-heading">Women's Indian to US Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Women Indian to US shoe size chart">
              <thead>
                <tr>
                  <th>India Size (UK)</th>
                  <th>US Women Size</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>India {r.india.toFixed(1)}</strong></td>
                    <td class="highlight-cell"><strong>US {r.us.toFixed(1)}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm.toFixed(1)} cm</td>
                    <td>{r.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div class="table-panel" id="tab-kids" role="tabpanel">
          <h3 class="table-heading">Kids' & Youth Indian to US Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Kids Indian to US shoe size chart">
              <thead>
                <tr>
                  <th>India Kids Size</th>
                  <th>US Kids Size</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Age Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>India {r.india}</strong></td>
                    <td class="highlight-cell"><strong>US {r.us}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm.toFixed(1)} cm</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial SEO Prose Section -->
    <article class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">Guide to Indian shoe sizes and converting to US footwear</h2>
        
        <p class="lead-paragraph">
          Shoppers purchasing footwear from American online retailers like Nike, Amazon, or Nordstrom need accurate translations of Indian sizes. Indian shoe sizing has a historical origin rooted in the British imperial scale, but international purchases require comparison against American and European measurements. This guide explains how the Indian shoe size chart works and how to convert sizes accurately.
        </p>

        <h3>How an Indian shoe size chart works</h3>
        <p>
          Shoe manufacturing across India adopted the British imperial scale under Indian standard IS 1638:1969. In this system, shoe sizes increment by one barleycorn (1/3 inch, or 8.46 mm) per full size, and 1/6 inch (4.23 mm) for half sizes. Because of this heritage, Indian size numbers match United Kingdom sizes in length. Background on barleycorn units is covered in our <a href="/shoe-size-in-inches/">shoe size in inches guide</a>.
        </p>
        <p>
          An Indian size 8 refers to an anatomical foot length of 26.5 cm (EU 41.5, US Men 8.5 on the standard scale, or US Men 9 on sneaker charts). Because the United States system starts from a different zero point, converting sizes is necessary before ordering American shoes.
        </p>

        <h3>Core formulas: converting Indian shoe sizes to US sizes</h3>
        <p>
          Converting from an Indian size to an American US size depends on footwear category:
        </p>
        <ul>
          <li>For adult men, the standard ISO formula adds 0.5 (US Men = India + 0.5), meaning India 8.5 converts to US Men 9.0 (27.0 cm foot length). Athletic sneaker brands add 1 full size (US Men = India + 1).</li>
          <li>For women, American sizes run 2 full numbers larger (US Women = India + 2). An Indian size 5 in sandals or pumps converts to US Women 7.0 (24.0 cm, EU 38), and Indian size 6 converts to US Women 8.0 (25.0 cm, EU 39).</li>
          <li>Indian children's footwear corresponds to British youth sizing, which is 0.5 to 1 size smaller than American children's numbering (for example, India 9.5C child equals US 10C, measuring 16.5 cm).</li>
        </ul>

        <h3>European sizing queries in India</h3>
        <p>
          Shoppers in India frequently encounter European numbers on multi-brand platforms like Myntra, Ajio, and Nykaa:
        </p>
        <ul>
          <li>European 36 corresponds to Indian size 3.5 for women (22.5 cm foot length, US Women 5.5).</li>
          <li>European 37 matches Indian size 4.5 (23.5 cm foot length, US Women 6.5).</li>
          <li>European 38 matches Indian size 5.5 for women (24.5 cm foot length, US Women 7.5).</li>
          <li>European 40 corresponds to Indian size 6.5 for men (25.0 cm foot length, US Men 7.0).</li>
          <li>European 42 matches Indian size 8.5 for men (27.0 cm foot length, US Men 9.0).</li>
          <li>European 44 corresponds to Indian size 9.5 for men (28.0 cm foot length, US Men 10.0).</li>
        </ul>

        <h3>Foot width and the Indian Bha sizing standard</h3>
        <p>
          When converting from an Indian size to an American shoe, width is a significant factor. The CSIR-Central Leather Research Institute (CSIR-CLRI) completed an anthropometric foot survey across India, published in their 2022 survey report. The report documented that Indian feet show broader metatarsal ball girth and higher dorsal instep measurements relative to European lasts.
        </p>
        <p>
          To address this, the Bureau of Indian Standards formulated the Bha standard. Standard American shoes use D width for men and B width for women. Shoppers with broad forefeet often choose wide fittings (EE for men, D for women) or order a half size larger.
        </p>

        <h3>Measuring foot length in centimeters</h3>
        <p>
          Before ordering footwear from overseas, determine your physical foot length in centimeters following our <a href="/shoe-size-by-foot-length/">shoe size by foot length guide</a>. A 27.0 cm foot length corresponds to Indian size 8.5 and US Men 9.0.
        </p>
      </div>
    </article>

    <!-- FAQ Accordion Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions: India to US sizing</h2>
        <p class="section-sub">Direct answers to common questions about converting Indian shoe sizes to American standards.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Links Band -->
    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resIn = document.getElementById('res-in');
    const resInSub = document.getElementById('res-in-sub');
    const resUs = document.getElementById('res-us');
    const resUsSub = document.getElementById('res-us-sub');
    const resCm = document.getElementById('res-cm');
    const resInMeas = document.getElementById('res-in-meas');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.india);
        opt.textContent = `${item.india} India`;
        if (gender === 'men' && item.india === 8.0) opt.selected = true;
        if (gender === 'women' && item.india === 5.0) opt.selected = true;
        if (gender === 'kids' && item.india === '9.5C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "US Men's Size";
      if (gender === 'women') { list = WOMEN; label = "US Women's Size"; }
      if (gender === 'kids') { list = KIDS; label = "US Kids' Size"; }

      const match = list.find(item => String(item.india) === String(val));
      if (!match) return;

      if (resIn) resIn.textContent = String(match.india);
      if (resInSub) resInSub.textContent = gender === 'kids' ? "India Kids' Size" : (gender === 'women' ? "India Women's Size" : "India Men's Size");
      if (resUs) resUs.textContent = String(match.us);
      if (resUsSub) resUsSub.textContent = label;
      if (resCm) resCm.textContent = `${match.cm.toFixed(1)} cm · EU ${match.eu}`;
      if (resInMeas) resInMeas.textContent = match.inch ? `${match.inch.toFixed(1)} inches` : `${match.stage || 'Metric'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.classList.add('active');
          } else {
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Layout tokens */
  .page-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .pt-4 { padding-top: 16px; }

  /* Hero Band */
