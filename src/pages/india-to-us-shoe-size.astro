    padding: 48px 24px 36px;
    background: linear-gradient(180deg, var(--v-elevated) 0%, var(--v-canvas) 100%);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 820px;
    margin: 0 auto;
  }
  .badge-pill {
    display: inline-block;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: var(--v-r-full);
    background: var(--v-badge-bg);
    color: var(--v-link-deep);
    margin-bottom: 16px;
  }
  .hero-title {
    font-size: clamp(30px, 4.5vw, 42px);
    font-weight: 800;
    line-height: 1.15;
    color: var(--v-ink);
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .hero-sub {
    font-size: 16px;
    line-height: 26px;
    color: var(--v-body);
    margin: 0 0 28px;
    max-width: 720px;
  }
  .hero-answer { max-width: 720px; margin: 0 0 28px; padding: 12px 16px; border-left: 3px solid var(--v-link); background: var(--v-link-soft); color: var(--v-body); font-size: 15px; line-height: 24px; text-align: left; }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    width: 100%;
  }
  .stat-pill {
    background: var(--v-elevated);
