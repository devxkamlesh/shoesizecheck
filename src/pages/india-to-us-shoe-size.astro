<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resIn = document.getElementById('res-in');
    const resInSub = document.getElementById('res-in-sub');
    const resUs = document.getElementById('res-us');
    const resUsSub = document.getElementById('res-us-sub');
    const resCm = document.getElementById('res-cm');
    const resInMeas = document.getElementById('res-in-meas');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.india);
        opt.textContent = `${item.india} India`;
        if (gender === 'men' && item.india === 8.0) opt.selected = true;
        if (gender === 'women' && item.india === 5.0) opt.selected = true;
        if (gender === 'kids' && item.india === '9.5C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "US Men's Size";
      if (gender === 'women') { list = WOMEN; label = "US Women's Size"; }
      if (gender === 'kids') { list = KIDS; label = "US Kids' Size"; }

      const match = list.find(item => String(item.india) === String(val));
      if (!match) return;

      if (resIn) resIn.textContent = String(match.india);
      if (resInSub) resInSub.textContent = gender === 'kids' ? "India Kids' Size" : (gender === 'women' ? "India Women's Size" : "India Men's Size");
      if (resUs) resUs.textContent = String(match.us);
      if (resUsSub) resUsSub.textContent = label;
      if (resCm) resCm.textContent = `${match.cm.toFixed(1)} cm · EU ${match.eu}`;
      if (resInMeas) resInMeas.textContent = match.inch ? `${match.inch.toFixed(1)} inches` : `${match.stage || 'Metric'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.classList.add('active');
          } else {
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

