  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content="indian shoe size chart, indian size chart shoes, india foot size, india footwear size, indian shoe size chart women, foot size chart india, uk size 8 in india, shoe size of us and india, shoe size us and india, 36 shoe size in india, 37 size in shoes in india, 38 foot size in india, shoe size 38 in india, 39 eu size in india, shoe size 41 in india, 42 foot size in india, 43 shoe size india, shoe size 44 in india, 45 shoe size in india" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <!-- Breadcrumbs -->
