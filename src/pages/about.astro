---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/about/`;
const pageTitle = 'About Us — Precision Footwear Sizing & Standards';
const pageDescription = 'Learn about AllShoeSizeConverter: our mission to eliminate footwear sizing confusion with mathematically verified international size charts and guides.';
const ogImage = `${domain}/og-image.png`;

const aboutPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About AllShoeSizeConverter",
  "description": pageDescription,
  "url": pageCanonical,
  "mainEntity": {
    "@type": "Organization",
    "name": "AllShoeSizeConverter",
    "url": domain,
    "logo": `${domain}/favicon.svg`,
    "description": "Global shoe size conversion platform providing mathematical accuracy across US, UK, EU, India, Japan, and Mondopoint sizing standards."
  }
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={aboutPageSchema} />
  </Fragment>

  <Header />

  <main id="main-content" class="about-page">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'About Us' },
    ]} />

    <section class="about-hero">
      <div class="about-inner">
        <p class="mono-eyebrow">Our Mission &amp; Methodology</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,44px)">About AllShoeSizeConverter</h1>
        <p class="hero-sub body-lg">Eliminating international footwear sizing confusion with mathematical precision and podiatric clarity.</p>
      </div>
    </section>

    <section class="about-body-band">
      <div class="about-inner">
        
        <!-- Story Card -->
        <article class="about-card card-elevated">
          <h2 class="heading-md">Why We Built AllShoeSizeConverter</h2>
          <p class="lead-text">
            In modern global e-commerce, purchasing footwear has never been more accessible—yet finding the correct shoe size remains surprisingly frustrating. Across international online retail, <strong>over 30% of all shoes ordered online are returned</strong>, and uncomfortable fit or incorrect sizing accounts for more than two-thirds of those returns.
          </p>
          <p>
            A consumer ordering running sneakers from Japan, leather oxfords from the United Kingdom, winter ski boots from Austria, or casual flats on Indian marketplaces encounters conflicting numbering systems. A US Men's size 9 is not a UK 9, and neither matches a European 42 without knowing the underlying cobbling formula.
          </p>
          <p>
            <strong>AllShoeSizeConverter</strong> was created to solve this challenge once and for all. We built a fast, free, client-side conversion engine grounded in official international cobbling standards, enabling shoppers, parents, and athletes to convert footwear measurements accurately in real time.
          </p>
        </article>

        <!-- Pillars Grid -->
        <div class="pillars-grid" style="margin-top:32px">
          <div class="pillar-card card-elevated">
            <h3 class="heading-sm">Mathematical Precision</h3>
            <p class="body-sm">We don't rely on guesses. Our conversion matrices map historical barleycorn increments (8.46 mm), European Paris Points (6.67 mm), and metric Mondopoint millimetres directly to anatomical foot length.</p>
          </div>
          <div class="pillar-card card-elevated">
            <h3 class="heading-sm">Global Regional Depth</h3>
            <p class="body-sm">Dedicated conversion models covering the United States (Brannock), United Kingdom, European Union, India (including the BIS "Bha" standard), Japan, China, Australia, and Mexico.</p>
          </div>
          <div class="pillar-card card-elevated">
            <h3 class="heading-sm">Private &amp; Instant</h3>
            <p class="body-sm">Zero accounts, zero trackers, and zero server storage of your personal foot dimensions. Calculations execute instantly inside your browser with clean, lightweight efficiency.</p>
          </div>
        </div>

        <!-- Deep Methodology -->
        <article class="about-card card-elevated" style="margin-top:32px">
          <h2 class="heading-md">The Science Behind Our Sizing Standards</h2>
          <p>To provide dependable conversion advice, our engine reconciles the primary global footwear construction standards:</p>

          <div class="standards-list">
            <div class="standard-item">
              <span class="standard-badge">US &amp; UK Barleycorn Standard</span>
              <p>Dating back to the British decree of 1324 and formalized by Charles Brannock in 1927, full shoe sizes increment by exactly <strong>1/3 of an inch (8.46 mm)</strong>, and half sizes by <strong>1/6 of an inch (4.23 mm)</strong>. The offset between US and UK scales arises from different baseline zero-points, which our converter accounts for dynamically.</p>
            </div>

            <div class="standard-item">
              <span class="standard-badge">European Paris Point System</span>
              <p>Continental European shoemakers construct lasts according to the <strong>Paris Point (2/3 of a centimetre, or 6.67 mm)</strong>. Importantly, European sizing is gender-neutral: an EU 42 represents identical internal footbed space whether tailored for men or women.</p>
            </div>

            <div class="standard-item">
              <span class="standard-badge">ISO 9407 Mondopoint Metric System</span>
              <p>Used worldwide for alpine ski boots, snowboard boots, and tactical combat boots, the <strong>Mondopoint standard</strong> measures physical foot length and width in millimetres and centimetres. It represents the gold standard for zero-margin performance footwear.</p>
            </div>

            <div class="standard-item">
              <span class="standard-badge">India &amp; The BIS "Bha" (भा) Initiative</span>
              <p>While traditional Indian footwear follows UK linear sizing, Indian feet are anatomically broader across the metatarsal joints. We actively cover both standard Indian conversions and the Bureau of Indian Standards (BIS) "Bha" framework developed by CSIR-CLRI from 100,000+ 3D foot scans.</p>
            </div>
          </div>
        </article>

        <!-- Editorial Integrity & Feedback -->
        <article class="about-card card-elevated" style="margin-top:32px">
          <h2 class="heading-md">Editorial Integrity &amp; Continuous Verification</h2>
          <p>
            Footwear brands often modify their lasts depending on the shoe's intended use—from tight-fitting track spikes to voluminous steel-toe work boots. We continuously cross-reference manufacturer specification sheets, podiatric literature, and real-world customer fit feedback to maintain the most reliable size conversion database on the web.
          </p>
          <p>
            Have feedback on a specific brand's sizing idiosyncrasies? We welcome contributions from footwear designers, podiatrists, and everyday shoppers. Connect with us on our <a href="/contact/">Contact Us</a> page.
          </p>
        </article>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about-page {
    background: var(--v-canvas);
    min-height: 80vh;
  }
  .about-hero {
    padding: 56px 24px 32px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1), transparent 60%);
    border-bottom: 1px solid var(--v-hairline);
  }
  .about-inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .hero-sub {
    color: var(--v-mute);
    margin-top: 12px;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }
  .about-body-band {
    padding: 48px 24px 80px;
  }
  .about-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 40px;
    box-shadow: var(--v-shadow-whisper);
  }
  .lead-text {
    font-size: 16px;
    line-height: 26px;
    color: var(--v-ink);
    margin-bottom: 16px;
  }
  .about-card p {
    color: var(--v-body);
    line-height: 26px;
    margin-bottom: 14px;
  }
  .about-card a {
    color: var(--v-link);
    text-decoration: underline;
  }

  /* Pillars */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .pillar-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 24px;
  }
  .pillar-card h3 {
    color: var(--v-ink);
    margin-bottom: 8px;
  }
  .pillar-card p {
    color: var(--v-body);
    line-height: 22px;
    margin: 0;
  }

  /* Standards */
  .standards-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 20px;
  }
  .standard-item {
    padding: 18px 20px;
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
  }
  .standard-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--v-link);
    background: var(--v-hairline-soft);
    padding: 3px 10px;
    border-radius: var(--v-r-full);
    margin-bottom: 8px;
  }
  .standard-item p {
    margin: 0;
    font-size: 14px;
    line-height: 22px;
  }

  @media (max-width: 768px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
    .about-card {
      padding: 24px 18px;
    }
  }
</style>
