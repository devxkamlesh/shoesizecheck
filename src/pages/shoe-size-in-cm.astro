            { cm: 25, usM: 7, usW: 8.5, uk: 6.5, eu: 40 },
            { cm: 26, usM: 8, usW: 9.5, uk: 7.5, eu: 41 },
            { cm: 27, usM: 9, usW: 10.5, uk: 8.5, eu: 42 },
            { cm: 28, usM: 10, usW: 11.5, uk: 9.5, eu: 43 },
            { cm: 29, usM: 11, usW: 12.5, uk: 10.5, eu: 44 }
