---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/shoe-size-in-cm/`;
const pageTitle = 'Shoe size in CM: centimeters to shoe size chart';
const pageDescription = 'Convert foot length in centimeters to shoe size. CM to UK, US, EU, and India charts for men, women, and kids with UK shoe sizes in cm.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'What does CM mean in shoe size?',
    a: 'CM stands for centimeters and measures your bare foot length from the back of the heel to the tip of your longest toe. In Japanese and Mondopoint sizing, the shoe size is literally your foot measurement in centimeters; a JP 26 is engineered for a 26 cm foot.'
  },
  {
    q: 'How to measure shoe size in CM?',
    a: 'Stand barefoot with your heel against a flat wall on a sheet of paper. Mark the tip of your longest toe with a pen held completely vertical. Use a ruler to measure the distance in centimeters from the edge of the paper to the mark. Always measure both feet in the late afternoon and use the larger number.'
  },
  {
    q: 'How much is half a shoe size in CM?',
    a: 'In the US and UK shoe sizing systems, half a shoe size equals approximately 0.42 cm (4.23 mm or 1/6 inch). In the European Paris Point system, each full size equals 0.67 cm (6.67 mm).'
  },
  {
    q: 'What is 24 cm in shoe size?',
    a: 'A 24 cm foot equals US Men\'s 6, US Women\'s 7.5, UK 5.5, EU 38, India 5.5, and Japan 24.'
  },
  {
    q: 'What is 24.5 cm in shoe size?',
    a: 'A 24.5 cm foot corresponds to US Men\'s 6.5, US Women\'s 8, UK 6, EU 38.5, India 6, and Japan 24.5.'
  },
  {
    q: 'What is 25 cm in shoe size?',
    a: 'A 25 cm foot equals US Men\'s 7, US Women\'s 8.5, UK 6.5, EU 40, India 6.5, and Japan 25.'
  },
  {
    q: 'What size shoe width is considered wide in CM?',
    a: 'Shoe width is measured across the ball of the foot. For an adult foot around 26 cm long, standard medium width (D for men, B for women) is roughly 9.5 to 10.0 cm across. Any foot width above 10.4 cm falls into wide categories (EE or EEEE in men, D or EE in women).'
  },
  {
    q: 'What is UK shoe size in CM for children?',
    a: 'For UK child shoe sizes, UK 3 to 4 child is ~11.5 to 12.5 cm (toddler), UK 6 to 7 child is ~14.2 to 15.0 cm, UK 9 to 10 child is ~16.7 to 17.5 cm, and UK 12 to 13 child is ~19.2 to 20.0 cm. Always add 10 to 12 mm for healthy growing room.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

const benchmarkRows = [
  { cm: 24, usM: 6, usW: 7.5, uk: 5.5, eu: 38 },
  { cm: 25, usM: 7, usW: 8.5, uk: 6.5, eu: 40 },
  { cm: 26, usM: 8, usW: 9.5, uk: 7.5, eu: 41 },
  { cm: 27, usM: 9, usW: 10.5, uk: 8.5, eu: 42 },
  { cm: 28, usM: 10, usW: 11.5, uk: 9.5, eu: 43 },
  { cm: 29, usM: 11, usW: 12.5, uk: 10.5, eu: 44.5 }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />
  <main id="main-content">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Shoe Size in CM' }]} />

    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Centimeters to Shoe Size</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,48px)">Shoe size in CM</h1>
        <p class="hero-sub body-lg">Convert centimeters to shoe sizes across US, UK, EU, India, and Japan. Includes tables for men, women, and children with UK shoe sizes in cm.</p>
        <div class="hero-badges">
          <span class="badge-trust">21 to 33 cm Range</span>
          <span class="badge-trust">Men, Women and Kids</span>
          <span class="badge-trust">Unified Metric System</span>
        </div>
      </div>
    </section>

    <!-- Quick Conversion Cards -->
    <section class="quick-band">
      <div class="page-inner">
        <h2 class="heading-md" style="margin-bottom:16px">Popular foot length benchmarks</h2>
        <div class="cm-grid">
          {benchmarkRows.map(item => (
            <div class="card cm-stat-card">
              <div class="cm-val">{item.cm} cm</div>
              <div class="cm-meta">
                <span>US Men: <strong>{item.usM}</strong></span>
                <span>US Women: <strong>{item.usW}</strong></span>
                <span>UK: <strong>{item.uk}</strong></span>
                <span>EU: <strong>{item.eu}</strong></span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Size Tables -->
    <section class="table-band">
      <div class="page-inner">
        <h2 class="heading-md">Men's shoe size in CM and UK equivalents</h2>
        <div class="scroll-x">
          <table class="size-table" aria-label="Men shoe size in centimeters">
            <thead><tr><th>CM</th><th>UK</th><th>US Men</th><th>EU</th><th>India</th><th>Japan</th><th>Inches</th></tr></thead>
            <tbody>
              {MEN_SIZE_ROWS.map(r => (
                <tr>
                  <td><strong>{r.cm.toFixed(1)}</strong></td>
                  <td>UK {r.uk}</td>
                  <td>US {r.us}</td>
                  <td>EU {r.eu}</td>
                  <td>India {r.india}</td>
                  <td>{r.cm.toFixed(1)}</td>
                  <td>{r.inch.toFixed(1)}″</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="heading-md" style="margin-top:48px">Women's shoe size in CM</h2>
        <div class="scroll-x">
          <table class="size-table" aria-label="Women shoe size in centimeters">
            <thead><tr><th>CM</th><th>UK</th><th>US Women</th><th>EU</th><th>India</th><th>Japan</th><th>Inches</th></tr></thead>
            <tbody>
              {WOMEN_SIZE_ROWS.map(r => (
                <tr>
                  <td><strong>{r.cm.toFixed(1)}</strong></td>
                  <td>UK {r.uk}</td>
                  <td>US {r.us}</td>
                  <td>EU {r.eu}</td>
                  <td>India {r.india}</td>
                  <td>{r.cm.toFixed(1)}</td>
                  <td>{r.inch.toFixed(1)}″</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="heading-md" style="margin-top:48px">Kids' and child UK shoe size in CM</h2>
        <div class="scroll-x">
          <table class="size-table" aria-label="Kids and child UK shoe size in centimeters">
            <thead><tr><th>CM</th><th>UK Child</th><th>US Kids</th><th>EU Kids</th><th>India</th><th>Inches</th></tr></thead>
            <tbody>
              {KIDS_SIZE_ROWS.map(r => (
                <tr>
                  <td><strong>{r.cm}</strong></td>
                  <td>UK {r.uk}</td>
                  <td>US {r.us}</td>
                  <td>EU {r.eu}</td>
                  <td>India {r.india}</td>
                  <td>{r.inch}″</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="cta-box">
          <h2 class="heading-md">Need to convert live?</h2>
          <p class="body-lg">Use our interactive converter to switch between any country and length instantly.</p>
          <a href="/#converter" class="btn-primary">Open Interactive Converter</a>
        </div>
      </div>
    </section>

    <!-- Comprehensive Guide to Shoe Sizing in CM -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">Metric Footwear Guide</p>
            <h2 class="prose-main-title">Understanding centimeter (CM) and Mondopoint shoe sizing</h2>
            <p class="prose-lead">Centimeter-based shoe sizing specifies footwear sizes using actual foot dimensions rather than arbitrary numbers.</p>
          </header>

          <div class="content-prose">
            <p>Centimeter-based shoe sizing provides a consistent footwear standard. Formalized by the International Organization for Standardization as the Mondopoint system (ISO 9407:2019), it specifies shoe sizes using actual foot dimensions. While the United States and the United Kingdom rely on historic imperial barleycorn increments, countries like Japan and South Korea base shoe sizing directly on foot length in centimeters or millimeters.</p>

            <h3 class="heading-md">Why UK shoe sizes and centimeters do not convert evenly</h3>
            <p>Converting between the British (UK) system and centimeters requires rounding. The UK shoe system steps by 1/3 inch (approx. 8.46 mm) per full size and 1/6 inch (approx. 4.23 mm) per half size. Because these imperial fractions do not align with clean decimal numbers, conversions involve slight rounding:</p>
            <ul>
              <li>UK Men's 6 fits a foot length of approximately 24.5 cm (9.6 inches).</li>
              <li>UK Men's 7 fits a foot length of approximately 25.5 cm (10.0 inches).</li>
              <li>UK Men's 8 fits a foot length of approximately 26.5 cm (10.4 inches).</li>
              <li>UK Men's 8.5 fits a foot length of approximately 27.0 cm (10.6 inches).</li>
            </ul>
            <p>If your foot measures 27.0 cm, a UK 8.5 provides the recommended fit.</p>

            <h3 class="heading-md">UK child shoe sizes in CM: a parent's guide</h3>
            <p>The UK children's shoe scale resets mid-childhood. It starts with infant size 0 (approx. 9.5 cm) and runs through child size 13.5 (approx. 20.5 cm), after which adult sizing begins again at size 1 (approx. 21.0 cm):</p>
            <ul>
              <li>UK Child 3 to 4 fits toddler feet measuring 11.5 to 12.5 cm.</li>
              <li>UK Child 6 to 7 fits toddler feet measuring 14.2 to 15.0 cm.</li>
              <li>UK Child 9 to 10 fits children with feet measuring 16.7 to 17.5 cm.</li>
              <li>UK Child 12 to 13 fits children with feet measuring 19.2 to 20.0 cm.</li>
            </ul>
            <p>When shopping for growing kids, measure their feet every 8 to 12 weeks. Always choose a shoe size that provides 10 to 12 mm of space in front of the longest toe.</p>

            <h3 class="heading-md">How to use the CM tongue tag when buying sneakers</h3>
            <p>When buying athletic sneakers from brands like Nike, Adidas, Asics, and New Balance, note that US-to-EU charts can differ. For example, a Nike US 9 is labeled as EU 42.5 on shoe tags, whereas standard ISO 19407 maps US 9 to EU 42.</p>

            <div class="prose-callout">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <p>Look at the JP or CM measurement printed on the inner tongue label. A 27.0 CM shoe provides consistent length across almost every brand worldwide.</p>
            </div>

            <p>A 27.0 cm foot fits comfortably in a 27.0 CM shoe across athletic brands, regardless of how the manufacturer translates that size into US or European figures.</p>

            <h3 class="heading-md">Measuring foot width in centimeters</h3>
            <p>Foot length is only half of the sizing calculation. Foot width is measured across the first and fifth metatarsal joints (the ball of the foot). For an adult foot measuring 26.0 cm in length, a standard medium width (D width for men, B width for women) measures between 9.5 and 10.0 cm flat across the ball. If your measurement exceeds 10.4 cm, you will likely find standard footwear tight across the sides, and should look for wide (2E) or extra-wide (4E) options rather than simply buying a longer shoe.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="faq-band" id="faq">
      <div class="page-inner">
        <p class="mono-eyebrow">FAQ</p>
        <h2 class="heading-md">Frequently asked questions</h2>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <div class="faq-item">
              <button class="faq-trigger" aria-expanded="false" id={`cmfaq-${i}`} aria-controls={`cmfaq-c-${i}`}>
                <span>{f.q}</span>
                <span class="faq-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                  </svg>
                </span>
              </button>
              <div class="faq-content" id={`cmfaq-c-${i}`} role="region" aria-labelledby={`cmfaq-${i}`}>
                <div class="faq-inner">{f.a}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero { padding: 48px 24px 40px; background: var(--v-canvas); }
  .page-inner { max-width: 900px; margin: 0 auto; }
  .hero-sub { margin: 12px 0 20px; max-width: 600px; }
  .hero-badges { display: flex; flex-wrap: wrap; gap: 8px; }

  .quick-band { padding: 0 24px 48px; background: var(--v-canvas); }
  .cm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .cm-stat-card { display: flex; flex-direction: column; gap: 8px; padding: 16px 20px; }
  .cm-val { font-size: 20px; font-weight: 600; color: var(--v-ink); font-family: var(--font-display); }
  .cm-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; font-size: 13px; color: var(--v-body); }
  .cm-meta strong { color: var(--v-ink); }

  .table-band { padding: 64px 24px; background: var(--v-canvas); border-top: 1px solid var(--v-hairline); }

  .cta-box { margin-top: 48px; text-align: center; padding: 48px 32px; background: var(--v-elevated); border: 1px solid var(--v-hairline); border-radius: var(--v-r-lg); }
  .cta-box h2 { margin: 0 0 8px; }
  .cta-box p { margin: 0 0 20px; }

  @media (max-width: 640px) {
    .page-hero { padding: 32px 16px; }
    .quick-band { padding: 0 16px 36px; }
    .table-band { padding: 48px 16px; }
    .cm-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll('.faq-trigger').forEach(t => {
    t.addEventListener('click', () => {
      const exp = t.getAttribute('aria-expanded') === 'true';
      t.setAttribute('aria-expanded', String(!exp));
      t.nextElementSibling?.classList.toggle('open', !exp);
    });
  });
</script>
