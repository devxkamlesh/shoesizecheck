    </section>

    <!-- Quick Conversion Cards -->
    <section class="quick-band">
      <div class="page-inner">
        <h2 class="heading-md" style="margin-bottom:16px">Popular Foot Length Benchmarks</h2>
        <div class="cm-grid">
