              <div class="cm-meta">
                <span>US Men: <strong>{item.usM}</strong></span>
                <span>US Women: <strong>{item.usW}</strong></span>
                <span>UK: <strong>{item.uk}</strong></span>
                <span>EU: <strong>{item.eu}</strong></span>
