              <tr><td>24.5</td><td>6</td><td>6.5</td><td>39</td><td>5.5</td><td>24.5</td><td>9.6"</td></tr>
              <tr><td>25.0</td><td>6.5</td><td>7</td><td>40</td><td>6</td><td>25</td><td>9.8"</td></tr>
              <tr><td>25.5</td><td>7</td><td>7.5</td><td>40</td><td>6.5</td><td>25.5</td><td>10.0"</td></tr>
