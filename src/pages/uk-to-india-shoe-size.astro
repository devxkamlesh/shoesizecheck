                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>UK {r.uk}</strong></td>
                    <td class="highlight-cell"><strong>India {r.india}</strong></td>
                    <td>US {r.us}</td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
