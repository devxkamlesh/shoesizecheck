---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/uk-to-india-shoe-size/`;
const pageTitle = 'UK to India shoe size converter: British to Indian chart';
const pageDescription = 'Convert UK shoe sizes to Indian sizes. Detailed UK to India comparison chart for men, women, and kids with 1:1 sizing data and width guidelines.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'Is UK shoe size same as India shoe size?',
    a: 'In terms of footbed length, UK and Indian shoe sizes match with 1:1 equivalence. A UK size 8 equals an Indian size 8 for men, and a UK size 5 equals an Indian size 5 for women. Both systems trace their origins to the British barleycorn measurement of one-third of an inch.'
  },
  {
    q: 'What is UK 8 in India shoe size?',
    a: 'UK size 8 equals Indian size 8 directly. Both sizes fit a foot length of 27.0 centimeters and correspond to US Men\'s 9 and EU 42.'
  },
  {
    q: 'What is UK 7 in Indian shoe size?',
    a: 'UK size 7 is identical to Indian size 7, designed for a foot measuring 26.0 centimeters. In American sizing, this equals US Men\'s 8, and in European sizing it corresponds to EU 41.'
  },
  {
    q: 'Do British brands fit the same as Indian brands?',
    a: 'While the length is identical, width fittings can vary. British heritage brands like Clarks often offer specific width fittings (F for standard, G for wide, H for extra wide). Indian feet often require a roomier forefoot.'
  },
  {
    q: 'What is the Indian Bha sizing standard compared to UK?',
    a: 'The Bureau of Indian Standards (BIS) and CSIR-CLRI developed the Bha standard to address Indian foot proportions. Until footwear brands complete new tooling, the commercial footwear market continues to use the UK scale.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'India to UK Shoe Size Converter', href: '/india-to-uk-shoe-size/' },
  { label: 'UK to EU Shoe Size Converter', href: '/uk-to-eu-shoe-size/' },
  { label: 'India to EU Shoe Size Converter', href: '/india-to-eu-shoe-size/' },
  { label: 'India Shoe Sizing Guide', href: '/country/india/' },
  { label: 'United Kingdom Shoe Sizing Guide', href: '/country/uk/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'UK to India Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Direct 1:1 barleycorn scale comparison</p>
        <h1 class="display-xl">UK to India shoe size converter</h1>
        <p class="hero-sub body-lg">
          Compare British (UK) and Indian shoe sizes. Understand the 1:1 length relationship, brand width differences between Clarks and Bata, and the upcoming BIS Bha standard.
        </p>

        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Length Equivalence:</span>
            <span class="badge-val">1:1 (UK = India)</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Shared Base Unit:</span>
            <span class="badge-val">Barleycorn (1/3 in)</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Width Distinction:</span>
            <span class="badge-val">Indian Foot Width Profiles</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert UK to India Shoe Size</h2>
            <p class="conv-card-sub">Select your gender and UK shoe size to verify the corresponding Indian size and anatomical footbed length.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> British (UK) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select UK shoe size">
                <option value="" disabled>Select UK size</option>
                {menSizes.map(s => <option value={String(s.uk)} selected={s.uk === 8.0 ? true : undefined}>{s.uk} UK</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">United Kingdom (UK)</span>
                <span class="conv-val" id="res-uk">8</span>
                <span class="conv-note" id="res-uk-sub">British Barleycorn</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">India (IND / Bata)</span>
                <span class="conv-val" id="res-in">8</span>
                <span class="conv-note" id="res-in-sub">Identical 1:1 Length</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed Length</span>
                <span class="conv-val-sm" id="res-cm">27.0 cm</span>
                <span class="conv-note" id="res-in-meas">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Popular UK to Indian Shoe Size Benchmarks</h2>
        <p class="section-sub">Quick reference for the most commonly searched adult sizes in British and Indian footwear.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 7 → India 7</span>
              <span class="snap-detail">Foot length: 26.0 cm · EU 41 · US 8</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 8 → India 8</span>
              <span class="snap-detail">Foot length: 27.0 cm · EU 42 · US 9</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 9 → India 9</span>
              <span class="snap-detail">Foot length: 28.0 cm · EU 43 · US 10</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 4 → India 4</span>
              <span class="snap-detail">Foot length: 23.0 cm · EU 36.5 · US 6</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 5 → India 5</span>
              <span class="snap-detail">Foot length: 24.0 cm · EU 38 · US 7</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 6 → India 6</span>
              <span class="snap-detail">Foot length: 25.0 cm · EU 39 · US 8</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Charts Section -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">UK to Indian Shoe Size Chart</h2>
        <p class="section-sub">Complete comparison tables demonstrating the 1:1 length correlation between British and Indian footwear scales.</p>

        <div class="table-tabs" role="tablist">
          <button class="tab-btn active" data-target="tab-men" role="tab" aria-selected="true">Men's UK to India Chart</button>
          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's UK to India Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' UK to India Chart</button>
        </div>

        <!-- Men's Table -->
        <div class="table-panel active" id="tab-men" role="tabpanel">
          <h3 class="table-heading">Men's UK to Indian Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Men UK to India shoe size chart">
              <thead>
                <tr>
                  <th>UK Size</th>
                  <th>India Size</th>
                  <th>US Size</th>
                  <th>EU Size</th>
                  <th>Footbed (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>UK {r.uk}</strong></td>
                    <td class="highlight-cell"><strong>India {r.india}</strong></td>
                    <td>US {r.us}</td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Table -->
        <div class="table-panel" id="tab-women" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Women's UK to Indian Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Women UK to India shoe size chart">
              <thead>
                <tr>
                  <th>UK Size</th>
                  <th>India Size</th>
                  <th>US Size</th>
                  <th>EU Size</th>
                  <th>Footbed (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>UK {r.uk}</strong></td>
                    <td class="highlight-cell"><strong>India {r.india}</strong></td>
                    <td>US {r.us}</td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div class="table-panel" id="tab-kids" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Kids' UK to Indian Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Kids UK to India shoe size chart">
              <thead>
                <tr>
                  <th>UK Size</th>
                  <th>India Size</th>
                  <th>Footbed (CM)</th>
                  <th>Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>UK {r.uk}</strong></td>
                    <td class="highlight-cell"><strong>India {r.india}</strong></td>
                    <td>{r.cm} cm</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial Guide -->
    <article class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">Are UK and Indian shoe sizes the same? Sizing and fit analysis</h2>

        <p class="lead-paragraph">
          Shoppers purchasing footwear in India or ordering from British retailers often ask whether UK and Indian shoe sizes match. In footbed length, UK and Indian sizes share a 1:1 equivalence. An Indian size 8 equals a British UK size 8. While lengths are identical, differences in last contours and foot morphology affect fit.
        </p>

        <h3>1. Shared heritage of the barleycorn scale</h3>
        <p>
          Indian footwear manufacturing adopted the British imperial barleycorn sizing system under Indian standard IS 1638:1969. In this system, each full shoe size represents one-third of an inch (8.46 millimeters). A men's UK size 8 corresponds directly to an Indian size 8 (27.0 cm foot length, EU 42, US Men 9). Similarly, UK 7 is India 7 (26.0 cm, EU 41), UK 9 equals Indian size 9 (28.0 cm, EU 44), and UK 10 equals Indian size 10 (29.0 cm, EU 44.5). For background on barleycorn measurements, visit our <a href="/shoe-size-in-inches/">shoe size in inches guide</a>.
        </p>

        <h3>2. Women's and kids' UK to India sizing comparisons</h3>
        <p>
          The 1:1 length parity applies to both women's and children's categories:
        </p>
        <ul>
          <li>A UK women's size 5 corresponds to an Indian women's size 5 (24.0 cm footbed, EU 38, US Women 7.0). UK 4 equals India 4 (23.0 cm, EU 36.5), and UK 6 equals India 6 (25.0 cm, EU 39).</li>
          <li>British children's sizes align directly with Indian children's sizes. For example, UK 8C matches Indian 8C (15.5 cm foot length), and UK 1Y matches Indian 1Y (20.5 cm).</li>
        </ul>

        <h3>3. Anatomical width differences between UK and Indian footwear</h3>
        <p>
          The CSIR-Central Leather Research Institute (CSIR-CLRI) completed an anthropometric survey across India, published in their 2022 survey report. The report documented that Indian feet show broader metatarsal ball girth and higher dorsal instep measurements relative to European lasts.
        </p>
        <p>
          British brands like Clarks, Church's, and Loake construct standard shoes on medium F width lasts. For broad feet, choosing a British G fitting or sizing up by half a size provides additional forefoot width.
        </p>

        <h3>4. Bureau of Indian Standards (BIS) Bha sizing project</h3>
        <p>
          To address regional foot morphology, the Bureau of Indian Standards and CSIR-CLRI developed the Bha footwear sizing standard. The system defines lasts tailored to Indian foot measurements across eight life stages. Until footwear brands complete new tooling, commercial footwear in India continues to use the UK scale.
        </p>

        <h3>5. Comparing domestic brands and British imports</h3>
        <p>
          Domestic manufacturers such as Bata India, Relaxo, Campus, and Liberty build shoes using UK numbering with generous forefoot width. In Clarks shoes, standard UK sizing fits true to length, though broad feet may benefit from a wide fitting. Dr. Martens boots are built without half sizes; an Indian size 8.5 wearer should select UK 9.
        </p>

        <h3>6. Measuring foot length in centimeters</h3>
        <p>
          To find your shoe size, measure barefoot length in centimeters following our <a href="/shoe-size-by-foot-length/">shoe size by foot length guide</a>. A 27.0 cm foot length corresponds to UK 8 and India 8.
        </p>
      </div>
    </article>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Direct answers to common questions regarding UK and Indian shoe sizing.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0 ? true : undefined}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resUk = document.getElementById('res-uk');
    const resUkSub = document.getElementById('res-uk-sub');
    const resIn = document.getElementById('res-in');
    const resInSub = document.getElementById('res-in-sub');
    const resCm = document.getElementById('res-cm');
    const resInMeas = document.getElementById('res-in-meas');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.uk);
        opt.textContent = `${item.uk} UK`;
        if (gender === 'men' && item.uk === 8.0) opt.selected = true;
        if (gender === 'women' && item.uk === 5.0) opt.selected = true;
        if (gender === 'kids' && item.uk === '9.5C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "Men's Standard";
      if (gender === 'women') { list = WOMEN; label = "Women's Standard"; }
      if (gender === 'kids') { list = KIDS; label = "Kids' Standard"; }

      const match = list.find(item => String(item.uk) === String(val));
      if (!match) return;

      if (resUk) resUk.textContent = String(match.uk);
      if (resUkSub) resUkSub.textContent = "British Barleycorn";
      if (resIn) resIn.textContent = String(match.india);
      if (resInSub) resInSub.textContent = "Identical 1:1 Length";
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resInMeas) resInMeas.textContent = match.inch ? `${match.inch} inches` : `${match.stage || 'Metric'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Hero */
  .page-hero {
    padding: 56px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .page-inner { max-width: 960px; margin: 0 auto; }
  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    color: var(--v-ink);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .hero-sub { font-size: 16px; color: var(--v-body); line-height: 26px; max-width: 680px; margin: 0 auto 24px; }

  /* Quick Stat Badges */
  .quick-stat-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    font-size: 12.5px;
    box-shadow: var(--v-shadow-whisper);
  }
  .badge-label { color: var(--v-mute); }
  .badge-val { font-family: var(--font-mono); font-weight: 700; color: var(--v-ink); }

  /* Converter Band */
  .converter-band { padding: 40px 24px 56px; background: var(--v-canvas); }
  .conv-card {
    padding: 32px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    box-shadow: var(--v-shadow-floating);
  }
  .conv-card-header { margin-bottom: 24px; }
  .heading-md { font-size: 22px; font-weight: 700; color: var(--v-ink); letter-spacing: -0.02em; margin: 0 0 6px; }
  .conv-card-sub { font-size: 14px; color: var(--v-mute); margin: 0; }

  .conv-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  .step-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--v-ink);
    margin-bottom: 8px;
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--v-link);
    color: #ffffff;
    font-size: 11px;
    font-family: var(--font-mono);
    border-radius: var(--v-r-full);
  }
  .form-select {
    width: 100%;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--v-ink);
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    outline: none;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .form-select:focus { border-color: var(--v-link); box-shadow: 0 0 0 3px var(--v-link-soft); }

  /* Result Output Card */
  .conv-result-box {
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    padding: 24px 28px;
  }
  .conv-result-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .conv-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex: 1;
