// Kids' table data (UK, India, CM)
const kidsSizes = [
  { uk: '2C', india: '2C', cm: 11.5, stage: 'Toddler' },
  { uk: '4C', india: '4C', cm: 12.5, stage: 'Toddler' },
  { uk: '6C', india: '6C', cm: 14.0, stage: 'Toddler' },
  { uk: '8C', india: '8C', cm: 15.5, stage: 'Little Kid' },
  { uk: '9.5C', india: '9.5C', cm: 16.5, stage: 'Little Kid' },
