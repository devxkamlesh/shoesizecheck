  { uk: 5.0, india: 5.0, us: 7.0, eu: 38.0, cm: 24.0, inch: 9.4 },
  { uk: 5.5, india: 5.5, us: 7.5, eu: 38.5, cm: 24.5, inch: 9.6 },
