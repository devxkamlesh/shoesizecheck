// Women's table data (UK, India, US, EU, CM, Inches)
const womenSizes = [
  { uk: 2.5, india: 2.5, us: 4.5, eu: 35.0, cm: 21.5, inch: 8.5 },
  { uk: 3.0, india: 3.0, us: 5.0, eu: 35.5, cm: 22.0, inch: 8.7 },
