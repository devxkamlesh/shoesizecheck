const faqs = [
  {
    q: 'Is UK shoe size same as India shoe size?',
    a: 'Yes, in terms of footbed length, UK and Indian shoe sizes are identical (1:1 equivalence). A UK size 8 equals an Indian size 8 for men, and a UK size 5 equals an Indian size 5 for women. Both systems trace their roots to the British barleycorn measurement (1/3 inch).'
  },
  {
    q: 'What is UK 8 in India shoe size?',
    a: 'UK size 8 equals Indian size 8 directly. Both sizes fit an anatomical foot length of approximately 27.0 centimeters (10.6 inches) and correspond to US Men\'s 9 or European EU 42.'
  },
  {
    q: 'What is UK 7 in Indian shoe size?',
    a: 'UK size 7 is identical to Indian size 7, designed for a foot measuring approximately 26.0 centimeters. In American sizing, this equals US Men\'s 8, and in European sizing it corresponds to EU 41.'
  },
  {
    q: 'Do British brands like Clarks fit the same as Indian brands like Bata?',
    a: 'While the length is identical, width fittings can vary. British heritage brands like Clarks often offer specific width fittings (F for standard, G for wide, H for extra wide). Indian feet typically require a roomier forefoot and higher instep clearance.'
  },
  {
    q: 'What is the Indian "Bha" sizing standard compared to UK?',
    a: 'The Bureau of Indian Standards (BIS) and CSIR-CLRI have introduced "Bha" (an indigenous Indian footwear sizing system) to address the broader forefoot morphology of Indian citizens. However, until full adoption, the commercial Indian footwear market continues to use the UK scale.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'India to UK Shoe Size Converter', href: '/india-to-uk-shoe-size/' },
  { label: 'UK to EU Shoe Size Converter', href: '/uk-to-eu-shoe-size/' },
  { label: 'India to EU Shoe Size Converter', href: '/india-to-eu-shoe-size/' },
  { label: 'India Shoe Sizing Guide', href: '/country/india/' },
  { label: 'United Kingdom Shoe Sizing Guide', href: '/country/uk/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
