<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resEu = document.getElementById('res-eu');
    const resEuSub = document.getElementById('res-eu-sub');
    const resIn = document.getElementById('res-in');
    const resInSub = document.getElementById('res-in-sub');
    const resCm = document.getElementById('res-cm');
    const resInMeas = document.getElementById('res-in-meas');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.eu);
        opt.textContent = `${item.eu} EU`;
        if (gender === 'men' && item.eu === 42) opt.selected = true;
        if (gender === 'women' && item.eu === 38) opt.selected = true;
        if (gender === 'kids' && item.eu === 27) opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "Men's Standard";
      if (gender === 'women') { list = WOMEN; label = "Women's Standard"; }
      if (gender === 'kids') { list = KIDS; label = "Kids' Standard"; }

      const match = list.find(item => String(item.eu) === String(val));
      if (!match) return;

      if (resEu) resEu.textContent = String(match.eu);
      if (resEuSub) resEuSub.textContent = "Paris Point Unisex";
      if (resIn) resIn.textContent = String(match.india);
      if (resInSub) resInSub.textContent = label;
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resInMeas) resInMeas.textContent = match.inch ? `${match.inch} inches` : `${match.stage || 'Metric'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

