            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 42 → India 8</span>
              <span class="snap-detail">Foot length: 27.0 cm · US 9.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 43 → India 9</span>
              <span class="snap-detail">Foot length: 28.0 cm · US 10.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 37 → India 4.5</span>
              <span class="snap-detail">Foot length: 23.5 cm · US 6.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 38 → India 5</span>
              <span class="snap-detail">Foot length: 24.0 cm · US 7.0</span>
            </div>
