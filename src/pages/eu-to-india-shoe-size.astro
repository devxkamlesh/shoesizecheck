---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/eu-to-india-shoe-size/`;
const pageTitle = 'EU to India shoe size chart: EU 40, 41, and 42';
const pageDescription = 'Convert European shoe sizes to Indian sizes with men\'s, women\'s, and kids\' charts. See EU 40, 41, and 42 in India, plus CM and US equivalents.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'What is EU 42 in Indian shoe size?',
    a: 'An EU 42 corresponds to Indian size 8.5 for men under ISO standards, fitting a 27.0 cm foot length. On sneaker tags like Nike, EU 42 corresponds to India 8.0 (26.5 cm).'
  },
  {
    q: 'Is EU shoe size the same as Indian shoe size?',
    a: 'No, European and Indian shoe sizes use different measurement units. EU sizes use Paris Points (2/3 cm per increment), while Indian sizing follows IS 1638:1969 using imperial barleycorns.'
  },
  {
    q: 'What is EU 40 in Indian shoe size?',
    a: 'An EU 40 translates to Indian size 6.5 for men (25.0 cm foot length). For women, EU 40 corresponds to Indian size 7.0 (26.0 cm).'
  },
  {
    q: 'Why do brands on Myntra, Flipkart, and Ajio show EU shoe sizes?',
    a: 'International brands sold in India, including Zara, H&M, Adidas, and Puma, use European sizing on product labels. Always verify whether a product listing displays EU or UK/India sizes before ordering.'
  },
  {
    q: 'How do I convert European women\'s shoe sizes to Indian sizes?',
    a: 'To convert an EU women\'s shoe size to Indian sizing, subtract approximately 32.5 to 33 from the European size (for example, EU 38.5 − 32.5 = India 6).'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'India to EU Shoe Size Converter', href: '/india-to-eu-shoe-size/' },
  { label: 'UK to India Shoe Size Converter', href: '/uk-to-india-shoe-size/' },
  { label: 'India to UK Shoe Size Converter', href: '/india-to-uk-shoe-size/' },
  { label: 'India Shoe Sizing Guide', href: '/country/india/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'EU to India Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Continental Paris Point to Indian / UK Standard</p>
        <h1 class="display-xl">EU to India Shoe Size Converter</h1>
        <p class="hero-sub body-lg">
          Convert European shoe sizes to Indian footwear sizes instantly. Tailored for online shopping on Myntra, Flipkart, Amazon India, and Ajio across men's, women's, and kids' collections.
        </p>
        <p class="hero-answer"><strong>Direct answer:</strong> EU 40 is usually Indian size 6 for men, EU 41 is Indian size 7, and EU 42 is Indian size 8. Women&apos;s conversions can differ, so compare the CM measurement and select the correct category.</p>

        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men Rule:</span>
            <span class="badge-val">India ≈ EU − 34</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women Rule:</span>
            <span class="badge-val">India ≈ EU − 33</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Indian Standard:</span>
            <span class="badge-val">Aligns with UK Scale</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert EU to India Shoe Size</h2>
            <p class="conv-card-sub">Select your gender and European (EU) size to calculate the exact Indian footwear size and footbed length in centimeters.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> European (EU) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select EU shoe size">
                <option value="" disabled>Select EU size</option>
                {menSizes.map(s => <option value={String(s.eu)} selected={s.eu === 42 ? true : undefined}>{s.eu} EU</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">European Union (EU)</span>
                <span class="conv-val" id="res-eu">42</span>
                <span class="conv-note" id="res-eu-sub">Paris Point Unisex</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">India (IND / UK)</span>
                <span class="conv-val" id="res-in">8</span>
                <span class="conv-note" id="res-in-sub">Men's Standard</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed Length</span>
                <span class="conv-val-sm" id="res-cm">27.0 cm</span>
                <span class="conv-note" id="res-in-meas">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Common European to Indian shoe size benchmarks</h2>
        <p class="section-sub">Quick reference for the most commonly searched EU shoe sizes on Indian e-commerce platforms.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 41 → India 7</span>
              <span class="snap-detail">Foot length: 26.0 cm · US 8.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 42 → India 8</span>
              <span class="snap-detail">Foot length: 27.0 cm · US 9.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 43 → India 9</span>
              <span class="snap-detail">Foot length: 28.0 cm · US 10.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 37 → India 4.5</span>
              <span class="snap-detail">Foot length: 23.5 cm · US 6.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 38 → India 5</span>
              <span class="snap-detail">Foot length: 24.0 cm · US 7.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 39 → India 6</span>
              <span class="snap-detail">Foot length: 25.0 cm · US 8.0</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Charts Section -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">EU to Indian Shoe Size Chart</h2>
        <p class="section-sub">Cross-comparison tables showing exact correlations between European, Indian, British, and metric footbed lengths.</p>

        <div class="table-tabs" role="tablist">
          <button class="tab-btn active" data-target="tab-men" role="tab" aria-selected="true">Men's EU to India Chart</button>
          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's EU to India Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' EU to India Chart</button>
        </div>

        <!-- Men's Table -->
        <div class="table-panel active" id="tab-men" role="tabpanel">
          <h3 class="table-heading">Men's European to Indian Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Men EU to India shoe size chart">
              <thead>
                <tr>
                  <th>EU Size</th>
                  <th>India Size (UK)</th>
                  <th>US Size</th>
                  <th>Footbed (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>EU {r.eu}</strong></td>
                    <td class="highlight-cell"><strong>India {r.india}</strong></td>
                    <td>US {r.us}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Table -->
        <div class="table-panel" id="tab-women" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Women's European to Indian Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Women EU to India shoe size chart">
              <thead>
                <tr>
                  <th>EU Size</th>
                  <th>India Size (UK)</th>
                  <th>US Size</th>
                  <th>Footbed (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>EU {r.eu}</strong></td>
                    <td class="highlight-cell"><strong>India {r.india}</strong></td>
                    <td>US {r.us}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div class="table-panel" id="tab-kids" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Kids' European to Indian Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Kids EU to India shoe size chart">
              <thead>
                <tr>
                  <th>EU Size</th>
                  <th>India Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>EU {r.eu}</strong></td>
                    <td class="highlight-cell"><strong>India {r.india}</strong></td>
                    <td>{r.cm} cm</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- Editorial SEO Prose Guide -->
    <article class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">European to Indian shoe size conversion: shopping and fit guide</h2>

        <p class="lead-paragraph">
          Footwear listings on portals such as Myntra, Flipkart, and Ajio frequently display continental European (EU) sizes. Because Indian shoemaking follows the British barleycorn measurement standard under IS 1638:1969, converting European sizing requires understanding how metric Paris Points correlate with Indian sizes.
        </p>

        <h3>1. Metric Paris point and Indian barleycorn units</h3>
        <p>
          European footwear sizing uses the Paris Point, defined as 2/3 of a centimeter (6.67 millimeters). Indian shoe sizing follows IS 1638:1969, using the imperial barleycorn of 1/3 inch (8.46 millimeters). For the full history and math behind imperial sizing, read our guide on <a href="/shoe-size-in-inches/">shoe sizes in inches and barleycorn measurements</a>.
        </p>

        <h3>2. Conversion formulas</h3>
        <p>
          To calculate Indian sizes from European numbers:
        </p>
        <ul>
          <li>For men: subtract 33.5 to 34 from the European size. EU 42 corresponds to Indian size 8.5 (27.0 cm foot length), EU 41.5 corresponds to Indian size 8 (26.5 cm), and EU 40.5 corresponds to Indian size 7 (25.5 cm).</li>
          <li>For women: subtract 32.5 to 33 from the European size. EU 38.5 corresponds to Indian size 6 (25.0 cm), and EU 37.5 corresponds to Indian size 5 (24.0 cm).</li>
          <li>For kids: cross-reference foot length in centimeters against our table. EU 27 equals Indian 9.5C (16.5 cm), and EU 33 equals Indian youth 1Y (20.5 cm).</li>
        </ul>

        <h3>3. European sizes commonly searched in India</h3>
        <p>
          Standard European shoe numbers translate to domestic Indian sizes as follows:
        </p>
        <ul>
          <li>EU 36 represents Indian women's size 3.5 (22.5 cm foot length).</li>
          <li>EU 37.5 represents Indian women's size 5.0 (24.0 cm foot length).</li>
          <li>EU 38.5 represents Indian women's size 6.0 (25.0 cm foot length).</li>
          <li>EU 40.5 represents Indian men's size 7.0 (25.5 cm foot length).</li>
          <li>EU 41.5 represents Indian men's size 8.0 (26.5 cm foot length).</li>
          <li>EU 42.0 represents Indian men's size 8.5 (27.0 cm foot length).</li>
          <li>EU 44.0 represents Indian men's size 9.5 (28.0 cm foot length).</li>
        </ul>

        <h3>4. Why branded shoes in India use European sizing</h3>
        <p>
          European apparel brands (including Zara, H&M, and Mango) and sportswear companies (Adidas and Puma) manufacture footwear on European lasts. When ordering from these brands, confirm whether the sizing selector displays EU or UK/India numbers.
        </p>
        <p>
          Domestic manufacturers like Bata India, Red Tape, Liberty, and Woodland build lasts according to Indian and UK standards.
        </p>

        <h3>5. Indian foot morphology and width</h3>
        <p>
          An anthropometric foot survey conducted by the CSIR-Central Leather Research Institute (CSIR-CLRI), published in their 2022 survey report, documented that Indian feet show broader metatarsal ball girth and higher dorsal instep measurements relative to European lasts. When buying European formal dress shoes or fashion boots with narrow, tapered lasts, selecting a half size larger prevents pinching across the ball of the foot.
        </p>

        <h3>6. Measuring foot length</h3>
        <p>
          To verify your size before ordering, measure your bare foot length from heel to longest toe in centimeters. See our step-by-step instructions on <a href="/shoe-size-by-foot-length/">measuring shoe size by foot length</a>. A foot length of 27.0 cm corresponds to Indian size 8.5 and European size 42.
        </p>
      </div>
    </article>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Direct answers to the most common questions regarding European to Indian shoe sizing.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0 ? true : undefined}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resEu = document.getElementById('res-eu');
    const resEuSub = document.getElementById('res-eu-sub');
    const resIn = document.getElementById('res-in');
    const resInSub = document.getElementById('res-in-sub');
    const resCm = document.getElementById('res-cm');
    const resInMeas = document.getElementById('res-in-meas');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.eu);
        opt.textContent = `${item.eu} EU`;
        if (gender === 'men' && item.eu === 42) opt.selected = true;
        if (gender === 'women' && item.eu === 38) opt.selected = true;
        if (gender === 'kids' && item.eu === 27) opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "Men's Standard";
      if (gender === 'women') { list = WOMEN; label = "Women's Standard"; }
      if (gender === 'kids') { list = KIDS; label = "Kids' Standard"; }

      const match = list.find(item => String(item.eu) === String(val));
      if (!match) return;

      if (resEu) resEu.textContent = String(match.eu);
      if (resEuSub) resEuSub.textContent = "Paris Point Unisex";
      if (resIn) resIn.textContent = String(match.india);
      if (resInSub) resInSub.textContent = label;
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resInMeas) resInMeas.textContent = match.inch ? `${match.inch} inches` : `${match.stage || 'Metric'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Hero */
  .page-hero {
    padding: 56px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .page-inner {
    max-width: 960px;
    margin: 0 auto;
  }
  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    color: var(--v-ink);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .hero-sub {
    font-size: 16px;
    color: var(--v-body);
    line-height: 26px;
    max-width: 680px;
    margin: 0 auto 24px;
  }
  .hero-answer { max-width: 680px; margin: 0 auto 24px; padding: 12px 16px; border-left: 3px solid var(--v-link); background: var(--v-link-soft); color: var(--v-body); font-size: 15px; line-height: 24px; text-align: left; }

  /* Quick Stat Badges */
  .quick-stat-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    font-size: 12.5px;
    box-shadow: var(--v-shadow-whisper);
  }
  .badge-label { color: var(--v-mute); }
  .badge-val { font-family: var(--font-mono); font-weight: 700; color: var(--v-ink); }

  /* Converter Band */
  .converter-band {
    padding: 40px 24px 56px;
    background: var(--v-canvas);
  }
  .conv-card {
    padding: 32px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    box-shadow: var(--v-shadow-floating);
  }
  .conv-card-header { margin-bottom: 24px; }
  .heading-md {
    font-size: 22px;
    font-weight: 700;
    color: var(--v-ink);
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  .conv-card-sub { font-size: 14px; color: var(--v-mute); margin: 0; }

  .conv-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  .step-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--v-ink);
    margin-bottom: 8px;
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--v-link);
    color: #ffffff;
    font-size: 11px;
    font-family: var(--font-mono);
    border-radius: var(--v-r-full);
  }
  .form-select {
    width: 100%;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--v-ink);
    background: var(--v-canvas);
