---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/eu-to-india-shoe-size/`;
const pageTitle = 'EU to India Shoe Size Converter — European to Indian Chart';
const pageDescription = 'Convert EU shoe sizes to Indian sizes instantly. Men\'s, women\'s, and kids\' European to India conversion charts for shopping on Myntra, Flipkart & Amazon.';
const ogImage = `${domain}/og-image.png`;

// Men's table data (EU, India, UK, US, CM, Inches)
const menSizes = [
  { eu: 39, india: 5.5, uk: 5.5, us: 6.5, cm: 24.5, inch: 9.6 },
  { eu: 40, india: 6.0, uk: 6.0, us: 7.0, cm: 25.0, inch: 9.8 },
  { eu: 40.5, india: 6.5, uk: 6.5, us: 7.5, cm: 25.5, inch: 10.0 },
  { eu: 41, india: 7.0, uk: 7.0, us: 8.0, cm: 26.0, inch: 10.2 },
  { eu: 41.5, india: 7.5, uk: 7.5, us: 8.5, cm: 26.5, inch: 10.4 },
  { eu: 42, india: 8.0, uk: 8.0, us: 9.0, cm: 27.0, inch: 10.6 },
  { eu: 42.5, india: 8.5, uk: 8.5, us: 9.5, cm: 27.5, inch: 10.8 },
  { eu: 43, india: 9.0, uk: 9.0, us: 10.0, cm: 28.0, inch: 11.0 },
  { eu: 44, india: 9.5, uk: 9.5, us: 10.5, cm: 28.5, inch: 11.2 },
  { eu: 44.5, india: 10.0, uk: 10.0, us: 11.0, cm: 29.0, inch: 11.4 },
  { eu: 45, india: 10.5, uk: 10.5, us: 11.5, cm: 29.5, inch: 11.6 },
  { eu: 46, india: 11.0, uk: 11.0, us: 12.0, cm: 30.0, inch: 11.8 },
  { eu: 47, india: 12.0, uk: 12.0, us: 13.0, cm: 31.0, inch: 12.2 },
];

// Women's table data (EU, India, UK, US, CM, Inches)
const womenSizes = [
  { eu: 35, india: 2.5, uk: 2.5, us: 4.5, cm: 21.5, inch: 8.5 },
  { eu: 36, india: 3.5, uk: 3.5, us: 5.5, cm: 22.5, inch: 8.9 },
  { eu: 37, india: 4.5, uk: 4.5, us: 6.5, cm: 23.5, inch: 9.3 },
  { eu: 38, india: 5.0, uk: 5.0, us: 7.0, cm: 24.0, inch: 9.4 },
  { eu: 38.5, india: 5.5, uk: 5.5, us: 7.5, cm: 24.5, inch: 9.6 },
  { eu: 39, india: 6.0, uk: 6.0, us: 8.0, cm: 25.0, inch: 9.8 },
  { eu: 40, india: 6.5, uk: 6.5, us: 8.5, cm: 25.5, inch: 10.0 },
  { eu: 40.5, india: 7.0, uk: 7.0, us: 9.0, cm: 26.0, inch: 10.2 },
  { eu: 41, india: 7.5, uk: 7.5, us: 9.5, cm: 26.5, inch: 10.4 },
  { eu: 42, india: 8.0, uk: 8.0, us: 10.0, cm: 27.0, inch: 10.6 },
];

// Kids' table data (EU, India, CM)
const kidsSizes = [
  { eu: 19, india: '2C', cm: 11.5, stage: 'Toddler' },
  { eu: 21, india: '4C', cm: 12.5, stage: 'Toddler' },
  { eu: 23, india: '6C', cm: 14.0, stage: 'Toddler' },
  { eu: 25, india: '8C', cm: 15.5, stage: 'Little Kid' },
  { eu: 27, india: '9.5C', cm: 16.5, stage: 'Little Kid' },
  { eu: 29, india: '11C', cm: 17.5, stage: 'Little Kid' },
  { eu: 31, india: '12.5C', cm: 19.0, stage: 'Little Kid' },
  { eu: 33, india: '1Y', cm: 20.5, stage: 'Big Kid' },
  { eu: 35, india: '2.5Y', cm: 22.0, stage: 'Big Kid' },
];

const faqs = [
  {
    q: 'What is EU 42 in Indian shoe size?',
    a: 'An EU 42 corresponds to Indian size 8 for men (India 8 / UK 8), which fits an anatomical foot length of approximately 27.0 centimeters. For women, EU 42 translates to approximately Indian size 8 to 8.5.'
  },
  {
    q: 'Is EU shoe size the same as Indian shoe size?',
    a: 'No, European (EU) and Indian shoe sizes are completely different scales. EU sizes are based on metric Paris Points (2/3 cm per size) and run roughly 33 to 34 numbers higher than Indian sizes (e.g., EU 41 ≈ India 7, EU 42 ≈ India 8).'
  },
  {
    q: 'What is EU 40 in Indian shoe size?',
    a: 'An EU 40 translates to Indian size 6 to 6.5 for men (fitting a 25.0 to 25.5 cm foot). For women, EU 40 corresponds to Indian size 6.5 to 7.'
  },
  {
    q: 'Why do brands on Myntra, Flipkart, and Ajio show EU shoe sizes?',
    a: 'Many international brands sold in India—such as Zara, H&M, Adidas, Puma, and Mango—use European sizing as their primary manufacturing standard. Always verify whether a product page lists sizes in "EU" or "UK/India" before ordering.'
  },
  {
    q: 'How do I convert European women’s shoe sizes to Indian sizes?',
    a: 'To convert an EU women’s shoe size to Indian sizing, subtract approximately 33 from the European size (for example, EU 38 − 33 = India 5; EU 39 − 33 = India 6). For half sizes, cross-reference foot length in centimeters.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'India to EU Shoe Size Converter', href: '/india-to-eu-shoe-size/' },
  { label: 'UK to India Shoe Size Converter', href: '/uk-to-india-shoe-size/' },
  { label: 'India to UK Shoe Size Converter', href: '/india-to-uk-shoe-size/' },
  { label: 'India Shoe Sizing Guide', href: '/country/india/' },
  { label: 'European Shoe Sizing Guide', href: '/country/europe/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content="eu to india shoe size, european shoe size to india, eu shoe size in india, convert eu shoe size to india, eu size to india size shoes, eu 42 in india shoe size, eu 40 in indian shoe size, eu 41 shoe size in india, eu to indian size shoe chart, european to indian shoe size converter" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'EU to India Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Continental Paris Point to Indian / UK Standard</p>
        <h1 class="display-xl">EU to India Shoe Size Converter</h1>
        <p class="hero-sub body-lg">
          Convert European shoe sizes to Indian footwear sizes instantly. Tailored for online shopping on Myntra, Flipkart, Amazon India, and Ajio across men's, women's, and kids' collections.
        </p>

        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men Rule:</span>
            <span class="badge-val">India ≈ EU − 34</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women Rule:</span>
            <span class="badge-val">India ≈ EU − 33</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Indian Standard:</span>
            <span class="badge-val">Aligns with UK Scale</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert EU to India Shoe Size</h2>
            <p class="conv-card-sub">Select your gender and European (EU) size to calculate the exact Indian footwear size and footbed length in centimeters.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> European (EU) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select EU shoe size">
                <option value="" disabled>Select EU size</option>
                {menSizes.map(s => <option value={String(s.eu)} selected={s.eu === 42 ? true : undefined}>{s.eu} EU</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">European Union (EU)</span>
                <span class="conv-val" id="res-eu">42</span>
                <span class="conv-note" id="res-eu-sub">Paris Point Unisex</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">India (IND / UK)</span>
                <span class="conv-val" id="res-in">8</span>
                <span class="conv-note" id="res-in-sub">Men's Standard</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed Length</span>
                <span class="conv-val-sm" id="res-cm">27.0 cm</span>
                <span class="conv-note" id="res-in-meas">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Popular European to Indian Shoe Size Benchmarks</h2>
        <p class="section-sub">Quick reference for the most commonly searched EU shoe sizes on Indian e-commerce platforms.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 41 → India 7</span>
              <span class="snap-detail">Foot length: 26.0 cm · US 8.0</span>
            </div>
          </div>
