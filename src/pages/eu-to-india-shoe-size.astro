const faqs = [
  {
    q: 'What is EU 42 in Indian shoe size?',
    a: 'An EU 42 corresponds to Indian size 8 for men (India 8 / UK 8), which fits an anatomical foot length of approximately 27.0 centimeters. For women, EU 42 translates to approximately Indian size 8 to 8.5.'
  },
  {
    q: 'Is EU shoe size the same as Indian shoe size?',
    a: 'No, European (EU) and Indian shoe sizes are completely different scales. EU sizes are based on metric Paris Points (2/3 cm per size) and run roughly 33 to 34 numbers higher than Indian sizes (e.g., EU 41 ≈ India 7, EU 42 ≈ India 8).'
  },
  {
    q: 'What is EU 40 in Indian shoe size?',
    a: 'An EU 40 translates to Indian size 6 to 6.5 for men (fitting a 25.0 to 25.5 cm foot). For women, EU 40 corresponds to Indian size 6.5 to 7.'
