  }
  .res-advice p { margin: 0; }

  /* Tables section */
  .table-band {
    padding: 48px 24px;
  }
  .section-heading {
    margin-bottom: 32px;
  }
  .table-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
