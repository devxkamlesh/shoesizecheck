---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/kids-shoe-size-by-age/`;
const pageTitle = 'Kids shoe size by age: baby, toddler, and kids chart';
const pageDescription = 'Find baby, toddler, and kids shoe sizes by age with US, UK, EU, CM, and inch charts. Includes 1-year-old, 2T, 3T, and 5-year-old sizing.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'What shoe size is typical for a 1-year-old?',
    a: 'Most 1-year-old babies wear between a US size 3.5C and 4.5C, which corresponds to UK 2.5 to 3.5, EU 19 to 20, or a foot length of approximately 11.4 to 12.1 cm (4.5 to 4.75 inches). If your baby is learning to walk, choose soft-soled flexible shoes with about 1 cm of toe room.'
  },
  {
    q: 'What is the difference between toddler clothing sizes (2T/3T) and shoe sizes?',
    a: 'Toddler apparel labels like 2T, 3T, or 4T refer strictly to clothing height and weight, not shoe size. A 2-year-old wearing 2T clothes usually wears a US shoe size between 5C and 7C (EU 21 to 23). A 3-year-old in 3T clothes typically wears a US shoe size 7C to 9C (EU 23 to 26). Never order shoes by clothing tag size.'
  },
  {
    q: 'What do the "C" and "Y" mean on children\'s shoe labels?',
    a: '"C" stands for Child or Toddler sizes, spanning from 0C (newborn) up through 13.5C (around age 6-7). "Y" stands for Youth or Big Kids sizes, which resets back to 1Y and continues up to 7Y. Once a child outgrows 7Y, they transition directly into adult Men\'s 7 or Women\'s 8.5.'
  },
  {
    q: 'How much room should there be in the front of a toddler\'s shoe?',
    a: 'Always leave approximately 12 mm to 15 mm (about half an inch, or the width of an adult thumb) between your child\'s longest toe and the tip of the shoe. This space allows for natural toe splay, forward foot slide while walking, and healthy growth room without causing trips.'
  },
  {
    q: 'How fast do children\'s feet grow by age?',
    a: 'Between birth and age 2, children\'s feet grow about one half size every 2 to 3 months. Between ages 2 and 5, feet grow approximately one size every 3 to 4 months. After age 5, growth slows to one full size every 4 to 6 months until foot development stabilizes around puberty.'
  },
  {
    q: 'What shoe size is average for a 5-year-old?',
    a: 'A 5-year-old child typically wears between a US size 10.5C and 12C, corresponding to a foot length of 16.8 cm to 18.1 cm (6.6 to 7.1 inches), UK 9.5 to 11, and EU 28 to 30.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Kids Shoe Size by Age' },
    ]} />

    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Milestone Sizing Guide</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,46px)">Kids and toddler shoe size by age</h1>
        <p class="hero-sub body-lg">Compare estimated shoe-size ranges for babies, toddlers, little kids, and youth from birth through 12 years old. Use the age guide as a starting point, then measure the child's foot.</p>
        <p class="hero-answer"><strong>Direct answer:</strong> A 1-year-old may wear US 3.5C to 4.5C, while a 2-year-old may wear US 5C to 7C. Children's sizes vary widely. Measure both feet and follow the shoe manufacturer's chart before buying.</p>
        <div class="hero-badges">
          <span class="badge-trust">0 to 12 Years Milestones</span>
          <span class="badge-trust">US "C" and "Y" Standards</span>
          <span class="badge-trust">Centimeter and Inch Sizing</span>
          <span class="badge-trust">UK and EU Equivalent</span>
        </div>
      </div>
    </section>

    <!-- Interactive Child Age Calculator -->
    <section class="interactive-band">
      <div class="page-inner">
        <div class="age-calc-card">
          <div class="calc-header">
            <div>
              <p class="mono-eyebrow">Instant Age Converter</p>
              <h2 class="heading-lg">Find child shoe size by age or foot length</h2>
            </div>
            <p class="body-sm calc-header-hint">Select an age milestone or type your child's bare foot measurement.</p>
          </div>

          <div class="calc-inputs-grid">
            <div class="calc-field">
              <label class="step-label" for="child-age-select">
                <span class="step-num">1</span> Select Child's Age
              </label>
              <select id="child-age-select" class="form-select">
                <option value="0-3m">0 to 3 Months (Newborn)</option>
                <option value="3-6m">3 to 6 Months (Infant)</option>
                <option value="6-9m">6 to 9 Months (Infant)</option>
                <option value="9-12m" selected>9 to 12 Months (1 Year Old)</option>
                <option value="12-18m">12 to 18 Months (Early Walker)</option>
                <option value="18-24m">18 to 24 Months (2 Years Old)</option>
                <option value="2-3y">2 to 3 Years (Toddler 2T/3T)</option>
                <option value="3-4y">3 to 4 Years (Toddler 3T/4T)</option>
                <option value="4-5y">4 to 5 Years (Pre-School / 4T/5T)</option>
                <option value="5-6y">5 to 6 Years (Kindergarten / Little Kid)</option>
                <option value="6-7y">6 to 7 Years (Little Kid)</option>
                <option value="7-8y">7 to 8 Years (Little Kid)</option>
                <option value="8-9y">8 to 9 Years (Youth / Big Kid)</option>
                <option value="10-12y">10 to 12 Years (Youth / Big Kid)</option>
              </select>
            </div>

            <div class="calc-field">
              <label class="step-label" for="child-length-input">
                <span class="step-num">2</span> Or Foot Length (Optional)
              </label>
              <div class="input-unit-wrap">
                <input type="number" id="child-length-input" class="form-input" placeholder="e.g. 12" step="0.1" min="7" max="26" />
                <select id="child-length-unit" class="form-select unit-pill">
                  <option value="cm" selected>CM</option>
                  <option value="in">Inches</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Dynamic Output Display -->
          <div class="age-result-box" id="age-result-box">
            <div class="result-top">
              <div class="result-badge" id="res-stage-badge">Toddler (1 Year Old)</div>
              <div class="result-growth-note" id="res-growth-rate">Fast Growth: Checks every 2 to 3 months</div>
            </div>

            <div class="result-sizes-grid">
              <div class="res-stat-card primary-stat">
                <span class="res-label">US Kids</span>
                <span class="res-value" id="res-us-size">4C</span>
                <span class="res-sub">Child Sizing</span>
              </div>
              <div class="res-stat-card">
                <span class="res-label">UK Child</span>
                <span class="res-value" id="res-uk-size">3.5</span>
                <span class="res-sub">Standard</span>
              </div>
              <div class="res-stat-card">
                <span class="res-label">EU Kids</span>
                <span class="res-value" id="res-eu-size">19 to 20</span>
                <span class="res-sub">Paris Points</span>
              </div>
              <div class="res-stat-card">
                <span class="res-label">Avg Foot Length</span>
                <span class="res-value" id="res-length">11.7 cm</span>
                <span class="res-sub" id="res-inches">4.6 inches</span>
              </div>
            </div>

            <div class="res-advice" id="res-advice">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
              </svg>
              <p><strong>Fit Tip:</strong> For early walkers, prioritize lightweight, flexible soles that mimic barefoot walking. Leave about 12 mm space for natural toe flexion.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Milestone Tables Section -->
    <section class="table-band">
      <div class="page-inner">
        <header class="section-heading">
          <p class="mono-eyebrow">Age progression reference</p>
          <h2 class="heading-lg">Complete kids and toddler shoe size charts</h2>
          <p class="body-md">Children's shoe sizes follow four distinct life stages. Use these charts to check size progression from newborn to youth.</p>
        </header>

        <!-- 1. Baby & Infant (0-12 Months) -->
        <div class="table-card">
          <div class="table-card-head">
            <h3 class="heading-sm">1. Baby and infant shoe sizes (0 to 12 months)</h3>
            <span class="category-pill">Soft Soles and Pre-Walkers</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Baby and infant shoe size chart">
              <thead>
                <tr>
                  <th>Age Range</th>
                  <th>Foot Length (CM)</th>
                  <th>Foot Length (Inches)</th>
                  <th>US Size</th>
                  <th>UK Size</th>
                  <th>EU Size</th>
                  <th>Footwear Stage</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>0 to 3 Months</td><td>8.3 to 8.9 cm</td><td>3.25" to 3.5"</td><td>0C to 0.5C</td><td>0</td><td>15</td><td>Crib booties / socks</td></tr>
                <tr><td>3 to 6 Months</td><td>9.2 to 9.8 cm</td><td>3.6" to 3.85"</td><td>1C to 1.5C</td><td>0.5 to 1</td><td>16 to 17</td><td>Soft cotton booties</td></tr>
                <tr><td>6 to 9 Months</td><td>10.2 to 10.8 cm</td><td>4.0" to 4.25"</td><td>2C to 2.5C</td><td>1.5 to 2</td><td>17 to 18</td><td>Pre-walker leather sole</td></tr>
                <tr><td>9 to 12 Months</td><td>11.1 to 11.7 cm</td><td>4.35" to 4.6"</td><td>3C to 4C</td><td>2.5 to 3.5</td><td>19 to 20</td><td>Early walker flexible sole</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 2. Toddler Sizes (1-4 Years / 2T-5T) -->
        <div class="table-card" style="margin-top:32px">
          <div class="table-card-head">
            <h3 class="heading-sm">2. Toddler shoe sizes (1 to 4 years)</h3>
            <span class="category-pill">Active Walkers</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Toddler shoe size chart">
              <thead>
                <tr>
                  <th>Age Range</th>
                  <th>Typical Clothing</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                  <th>US Size</th>
                  <th>UK Size</th>
                  <th>EU Size</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>12 to 18 Months</td><td>12M to 18M</td><td>11.7 to 12.4 cm</td><td>4.6" to 4.9"</td><td>4.5C to 5C</td><td>4</td><td>20 to 21</td></tr>
                <tr><td>18 to 24 Months</td><td>18M to 24M / 2T</td><td>12.7 to 13.3 cm</td><td>5.0" to 5.25"</td><td>5.5C to 6C</td><td>4.5 to 5.5</td><td>21 to 22</td></tr>
                <tr><td>2 to 2.5 Years</td><td>2T</td><td>13.7 to 14.3 cm</td><td>5.4" to 5.6"</td><td>6.5C to 7C</td><td>6 to 6.5</td><td>23</td></tr>
                <tr><td>2.5 to 3 Years</td><td>3T</td><td>14.6 to 15.2 cm</td><td>5.75" to 6.0"</td><td>7.5C to 8C</td><td>7 to 7.5</td><td>24 to 25</td></tr>
                <tr><td>3 to 3.5 Years</td><td>3T / 4T</td><td>15.6 to 15.9 cm</td><td>6.1" to 6.25"</td><td>8.5C to 9C</td><td>8 to 8.5</td><td>25 to 26</td></tr>
                <tr><td>3.5 to 4 Years</td><td>4T / 5T</td><td>16.2 to 16.5 cm</td><td>6.4" to 6.5"</td><td>9.5C to 10C</td><td>9 to 9.5</td><td>26 to 27</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 3. Little Kids (4-8 Years) -->
        <div class="table-card" style="margin-top:32px">
          <div class="table-card-head">
            <h3 class="heading-sm">3. Little kids shoe sizes (4 to 8 years)</h3>
            <span class="category-pill">Preschool and Grade School</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Little kids shoe size chart">
              <thead>
                <tr>
                  <th>Age Range</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                  <th>US Size</th>
                  <th>UK Size</th>
                  <th>EU Size</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>4 to 4.5 Years</td><td>16.8 to 17.1 cm</td><td>6.6" to 6.75"</td><td>10.5C to 11C</td><td>10 to 10.5</td><td>28</td></tr>
                <tr><td>4.5 to 5 Years</td><td>17.5 to 17.8 cm</td><td>6.9" to 7.0"</td><td>11.5C to 12C</td><td>11 to 11.5</td><td>29 to 30</td></tr>
                <tr><td>5 to 6 Years</td><td>18.1 to 18.7 cm</td><td>7.1" to 7.35"</td><td>12.5C to 13C</td><td>12 to 12.5</td><td>30 to 31</td></tr>
                <tr><td>6 to 7 Years</td><td>19.1 to 19.7 cm</td><td>7.5" to 7.75"</td><td>13.5C to 1Y</td><td>13 to 13.5</td><td>31 to 32</td></tr>
                <tr><td>7 to 8 Years</td><td>20.0 to 20.6 cm</td><td>7.9" to 8.1"</td><td>1.5Y to 2.5Y</td><td>1 to 2</td><td>33 to 34</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- 4. Big Kids / Youth (8-12 Years) -->
        <div class="table-card" style="margin-top:32px">
          <div class="table-card-head">
            <h3 class="heading-sm">4. Big kids and youth shoe sizes (8 to 12+ years)</h3>
            <span class="category-pill">Transition to Adult</span>
          </div>
          <div class="scroll-x">
            <table class="size-table" aria-label="Big kids and youth shoe size chart">
              <thead>
                <tr>
                  <th>Age Range</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                  <th>US Youth Size</th>
                  <th>UK Size</th>
                  <th>EU Size</th>
                  <th>Equivalent Adult Size</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>8 to 9 Years</td><td>21.0 to 21.6 cm</td><td>8.25" to 8.5"</td><td>3Y to 3.5Y</td><td>2.5 to 3</td><td>34 to 35</td><td>Women's 4.5 to 5</td></tr>
                <tr><td>9 to 10 Years</td><td>21.9 to 22.5 cm</td><td>8.6" to 8.85"</td><td>4Y to 4.5Y</td><td>3.5 to 4</td><td>35 to 36</td><td>Women's 5.5 to 6</td></tr>
                <tr><td>10 to 11 Years</td><td>22.9 to 23.5 cm</td><td>9.0" to 9.25"</td><td>5Y to 5.5Y</td><td>4.5 to 5</td><td>37 to 38</td><td>Women's 6.5 to 7 / Men's 5</td></tr>
                <tr><td>11 to 12 Years</td><td>23.8 to 24.4 cm</td><td>9.4" to 9.6"</td><td>6Y to 6.5Y</td><td>5.5 to 6</td><td>38 to 39</td><td>Women's 7.5 to 8 / Men's 6</td></tr>
                <tr><td>12+ Years</td><td>24.8 to 25.4 cm</td><td>9.75" to 10.0"</td><td>7Y</td><td>6.5</td><td>40</td><td>Women's 8.5 / Men's 7</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Deep-Dive Guides -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">Parent's Field Guide</p>
            <h2 class="prose-main-title">How to measure and fit children's shoes</h2>
            <p class="prose-lead">Children's foot bones remain pliable during early childhood. A shoe that is too short can force toes into a curled position without causing noticeable pain to the child.</p>
          </header>

          <div class="content-prose">
            <h3 class="heading-sm">The 2T vs 3T shoe sizing confusion explained</h3>
            <p>A common mistake is searching for shoe size 2T or 3T. Labels like 2T, 3T, 4T, and 5T belong strictly to clothing lines for toddlers based on height and weight.</p>
            <p>Shoe manufacturers do not produce a 2T shoe. Toddlers wearing 2T clothes generally wear a shoe size between 5C and 7C, while toddlers in 3T apparel wear sizes 7C to 9C. Use bare foot measurement in centimeters rather than clothing tags to choose footwear.</p>

            <h3 class="heading-sm">Understanding C vs Y sizing labels</h3>
            <p>In the United States and Canada, children's shoe sizing runs on a two-tier scale:</p>
            <ul>
              <li>"C" covers child and toddler sizes from 0C through 13.5C.</li>
              <li>"Y" covers youth sizes starting from 1Y through 7Y.</li>
              <li>A youth size 7Y matches an adult Men's 7 or Women's 8.5 in length and width.</li>
            </ul>

            <h3 class="heading-sm">The 12 mm toe clearance rule</h3>
            <p>When trying shoes on a child, have them stand upright with weight evenly balanced. Press your thumb down across the front of the shoe in front of their longest toe:</p>
            <ul>
              <li>Allow approximately 12 mm (0.5 inch) of clearance between the longest toe and the inside tip of the shoe.</li>
              <li>Less than 6 mm means the shoe is tight and restricts foot movement.</li>
              <li>More than 18 mm means the shoe is oversized and can cause tripping.</li>
            </ul>

            <h3 class="heading-sm">How to measure a young child's foot at home</h3>
            <ol>
              <li>Place a piece of paper on a hard surface against a flat wall.</li>
              <li>Position your child standing on the paper with their heel resting against the wall. A seated child's foot measures smaller because foot arches flatten under body weight.</li>
              <li>Mark the tip of the longest toe on each foot. Measure the longer foot from the wall edge in millimeters.</li>
            </ol>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <div class="faq-card">
          <p class="mono-eyebrow">Common Questions</p>
          <h2 class="heading-lg" style="margin-bottom:24px">Frequently asked questions</h2>
          <div class="faq-list">
            {faqs.map(item => (
              <details class="faq-item">
                <summary class="faq-q">
                  <span>{item.q}</span>
                  <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="faq-a"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-hero {
    padding: 64px 24px 40px;
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1), transparent 60%);
    border-bottom: 1px solid var(--v-hairline);
  }
  .page-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-sub {
    max-width: 680px;
    margin: 16px auto 24px;
  }
  .hero-answer { max-width: 680px; margin: 0 auto 24px; padding: 12px 16px; border-left: 3px solid var(--v-link); background: var(--v-link-soft); color: var(--v-body); font-size: 15px; line-height: 24px; text-align: left; }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .badge-trust {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    color: var(--v-body);
  }

  /* Interactive band */
  .interactive-band {
    padding: 48px 24px;
    background: var(--v-canvas);
  }
  .age-calc-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: var(--v-shadow-whisper);
  }
  .calc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .calc-header-hint {
    color: var(--v-mute);
    max-width: 320px;
  }
  .calc-inputs-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 24px;
    margin-bottom: 28px;
  }
  .calc-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .input-unit-wrap {
    display: flex;
    gap: 8px;
  }
  .unit-pill {
    width: 90px;
    flex-shrink: 0;
  }

  /* Dynamic results */
  .age-result-box {
    background: var(--v-canvas);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-md);
    padding: 24px;
  }
  .result-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 12px;
  }
  .result-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--v-link-soft);
    color: var(--v-link);
    padding: 6px 14px;
    border-radius: var(--v-r-full);
  }
  .result-growth-note {
    font-size: 13px;
    font-weight: 500;
    color: var(--v-body);
  }
  .result-sizes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }
  .res-stat-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-sm);
    padding: 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .primary-stat {
    border-color: var(--v-link);
    background: linear-gradient(180deg, var(--v-elevated), var(--v-link-soft));
  }
  .res-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--v-mute);
  }
  .res-value {
    font-size: 24px;
    font-weight: 700;
    color: var(--v-ink);
    letter-spacing: -0.02em;
  }
  .res-sub {
    font-size: 11px;
