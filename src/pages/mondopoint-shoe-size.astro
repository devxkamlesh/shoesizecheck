<script>
  const lenInput = document.getElementById('mondo-length') as HTMLInputElement;
  const unitSelect = document.getElementById('mondo-unit') as HTMLSelectElement;
  const genderSelect = document.getElementById('mondo-gender') as HTMLSelectElement;
  const fitSelect = document.getElementById('mondo-fit') as HTMLSelectElement;
  const widthSelect = document.getElementById('mondo-width') as HTMLSelectElement;

  const mondoBadge = document.getElementById('res-mondo-badge');
  const shellNote = document.getElementById('res-shell-note');
  const mondoVal = document.getElementById('res-mondo-val');
  const usVal = document.getElementById('res-us-val');
  const euVal = document.getElementById('res-eu-val');
  const lastVal = document.getElementById('res-last-val');
  const lastMm = document.getElementById('res-last-mm');
  const adviceText = document.getElementById('res-advice-text');

  function calculateMondopoint() {
    const raw = parseFloat(lenInput?.value || '27');
    if (!raw || isNaN(raw)) return;

    const unit = unitSelect?.value || 'cm';
    let cm = raw;
    if (unit === 'mm') cm = raw / 10;
    if (unit === 'in') cm = raw * 2.54;

    const fit = fitSelect?.value || 'performance';
    const gender = genderSelect?.value || 'men';
    const width = widthSelect?.value || 'average';

    // Adjust cm according to fit style
    let fitAdjustedCm = cm;
    if (fit === 'comfort') fitAdjustedCm += 0.5;
    if (fit === 'race') fitAdjustedCm -= 0.5;

    // Round to nearest 0.5 Mondopoint
    let mondo = Math.round(fitAdjustedCm * 2) / 2;
    if (mondo < 15) mondo = 15;
    if (mondo > 34) mondo = 34;

    // Calculate approx BSL (Boot Sole Length)
    const bsl = Math.round((Math.floor(mondo) * 10) + 45);

    // Approximate US and EU conversions
    let us = '';
    let eu = '';

    if (gender === 'women') {
      const usWomen = ((mondo - 20) * 1.5 + 4.5).toFixed(1);
      us = `US W ${usWomen}`;
      eu = `${Math.round((mondo + 1.5) * 1.5)}`;
    } else if (gender === 'kids') {
      us = mondo <= 19 ? `US Kids ${Math.round((mondo - 10) * 1.2)}C` : `Youth ${Math.round((mondo - 19) * 1.2)}Y`;
      eu = `${Math.round(mondo * 1.5 + 1)}`;
    } else {
      const usMen = ((mondo - 22) * 1.15 + 4).toFixed(1);
      us = `US M ${usMen}`;
      eu = `${Math.round((mondo + 1.5) * 1.5 + 0.5)}`;
    }

    // Last width description
    let lastTitle = 'Mid Volume (MV)';
    let lastDetail = '100 mm Metatarsal Width';
    if (width === 'narrow') {
      lastTitle = 'Low Volume (LV)';
      lastDetail = '97 to 98 mm (Narrow Foot / Thin Heel)';
    } else if (width === 'wide') {
      lastTitle = 'High Volume (HV)';
      lastDetail = '102 to 104 mm+ (Wide Foot / High Instep)';
    }

    if (mondoBadge) mondoBadge.textContent = `Recommended Mondopoint: ${mondo.toFixed(1)}`;
    if (shellNote) shellNote.textContent = `Approx Boot Sole Length: ~${bsl} mm BSL`;
    if (mondoVal) mondoVal.textContent = mondo.toFixed(1);
    if (usVal) usVal.textContent = us;
    if (euVal) euVal.textContent = `EU ${eu}`;
    if (lastVal) lastVal.textContent = lastTitle;
    if (lastMm) lastMm.textContent = lastDetail;

    let advice = `<strong>Shell Sizing Insight:</strong> Mondopoint ${Math.floor(mondo)}.0 and ${(Math.floor(mondo) + 0.5).toFixed(1)} share the same outer plastic shell mold. Liners pack out by 15% to 20% after 4 to 6 days on snow.`;
    if (fit === 'comfort') {
      advice += ` Because you chose <em>Comfort Fit</em>, a thicker sock or custom insole will fill excess volume as the liner settles.`;
    } else if (fit === 'race') {
      advice += ` Because you chose <em>Race Fit</em>, you may require a bootfitter to punch the shell slightly at specific pressure points.`;
    }
    if (adviceText) adviceText.innerHTML = advice;
  }

  lenInput?.addEventListener('input', calculateMondopoint);
  unitSelect?.addEventListener('change', calculateMondopoint);
  genderSelect?.addEventListener('change', calculateMondopoint);
  fitSelect?.addEventListener('change', calculateMondopoint);
  widthSelect?.addEventListener('change', calculateMondopoint);

  // Initialize
  calculateMondopoint();
</script>
