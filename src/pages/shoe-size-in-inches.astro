              <tr><td>9.6"</td><td>24.4</td><td>7</td><td>6.5</td><td>40</td><td>6</td></tr>
              <tr><td>9.8"</td><td>24.9</td><td>7.5</td><td>7</td><td>40</td><td>6.5</td></tr>
