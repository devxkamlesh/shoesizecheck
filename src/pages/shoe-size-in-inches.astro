---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/shoe-size-in-inches/`;
const pageTitle = 'Shoe Size in Inches — Foot Length to Shoe Size Chart';
const pageDescription = 'Convert foot length in inches to shoe size. Full shoe size in inches charts for men, women, and kids covering US, UK, EU, and India sizes.';
const ogImage = `${domain}/og-image.png`;


const faqs = [
  {
    q: 'Is shoe size measured in inches?',
    a: 'Yes, historically and mathematically. Both US and UK shoe sizing originate from the English barleycorn system, where 1 size increment equals 1/3 of an inch (~8.46 mm). A half size equals 1/6 of an inch (~4.23 mm). While shoeboxes show whole numbers like 8 or 9.5, those numbers directly correspond to specific foot lengths measured in inches.'
  },
  {
    q: 'Is UK shoe size in inches?',
    a: 'Yes. Like the US standard, UK shoe sizing is built on the historic English barleycorn system, where every full size is exactly 1/3 of an inch (~8.46 mm). However, UK sizing uses a different starting point—men\'s UK sizes are 0.5 to 1 size smaller than US (US 9 = UK 8.5 for a 10.3-inch foot), and women\'s UK sizes are 2 sizes smaller (US Women\'s 9 = UK 7 for a 9.9-inch foot).'
  },
  {
    q: 'How many inches are in a shoe size?',
    a: 'Every full shoe size in US and UK sizing represents exactly 1/3 of an inch (approx. 0.33 inches or 8.46 mm). Every half size represents 1/6 of an inch (approx. 0.17 inches or 4.23 mm).'
  },
  {
    q: 'What is 10 inches in shoe size?',
    a: 'Exactly 10 inches equals 25.4 cm. For men, a 10-inch foot fits a US Men\'s 7.5 to 8, UK 7, or EU 40.5 to 41. For women, 10 inches fits a US Women\'s 9 to 9.5, UK 7, or EU 40.5.'
  },
  {
    q: 'How big is a size 9 shoe in inches?',
    a: 'A US Men\'s size 9 shoe fits a foot length of approximately 10.3 inches (26.2 cm). A US Women\'s size 9 shoe fits a foot measuring approximately 9.8 to 9.9 inches (25.0 cm).'
  },
  {
    q: 'How many inches in a size 6 shoe?',
    a: 'A US Men\'s size 6 fits a foot length of roughly 9.3 inches (23.6 cm). A US Women\'s size 6 fits a foot length of roughly 8.9 inches (22.6 cm). In UK sizing, a UK 6 fits an adult foot of about 9.6 inches (24.5 cm).'
  },
  {
    q: 'How to measure shoe size in inches at home?',
    a: 'Place a sheet of paper on a hard, uncarpeted floor against a wall. Stand with your bare heel touching the wall. Mark the tip of your longest toe with a pencil held straight. Measure the length with a ruler or measuring tape in inches, rounding up to the nearest 1/8 inch.'
  },
  {
    q: 'What is UK shoe size in inches compared to US?',
    a: 'UK shoe sizes use the identical 1/3-inch increment as the US, but with a different baseline. For men, UK sizing is 0.5 to 1 size smaller (US Men\'s 9 = UK 8.5 for a 10.3-inch foot). For women, UK sizing is approximately 2 sizes smaller (US Women\'s 9 = UK 7 for a 9.9-inch foot).'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content="shoe size in inches, women's shoe size in inches, kids shoe size in inches, uk shoe size in inches, shoe size in inches uk, is shoe size in inches, is uk shoe size in inches, what is 10 inches in shoe size, how many inches in a shoe size, how big is a size 9 shoe in inches" />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

