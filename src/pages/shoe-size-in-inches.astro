---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/shoe-size-in-inches/`;
const pageTitle = 'Shoe size in inches: foot length to shoe size chart';
const pageDescription = 'Convert foot length in inches to shoe size. Sizing charts for men, women, and kids covering US, UK, EU, and India sizes.';
const ogImage = `${domain}/og-image.png`;

const faqs = [
  {
    q: 'Is shoe size measured in inches?',
    a: 'Yes, historically and mathematically. Both US and UK shoe sizing originate from the English barleycorn system, where 1 size increment equals 1/3 of an inch (~8.46 mm). A half size equals 1/6 of an inch (~4.23 mm). While shoeboxes show whole numbers like 8 or 9.5, those numbers correspond to specific foot lengths measured in inches.'
  },
  {
    q: 'Is UK shoe size in inches?',
    a: 'Yes. Like the US standard, UK shoe sizing is built on the historic English barleycorn system, where every full size is 1/3 of an inch (~8.46 mm). However, UK sizing uses a different starting point: men\'s UK sizes are 0.5 to 1 size smaller than US (US 9 = UK 8.5 for a 10.6-inch foot), and women\'s UK sizes are 2 sizes smaller (US Women\'s 8 = UK 6 for a 9.8-inch foot).'
  },
  {
    q: 'How many inches are in a shoe size?',
    a: 'Every full shoe size in US and UK sizing represents exactly 1/3 of an inch (approx. 0.33 inches or 8.46 mm). Every half size represents 1/6 of an inch (approx. 0.17 inches or 4.23 mm).'
  },
  {
    q: 'What is 10 inches in shoe size?',
    a: 'Exactly 10 inches equals 25.4 cm. For men, a 10-inch foot fits a US Men\'s 7.5 to 8, UK 7, or EU 40.5 to 41. For women, 10 inches fits a US Women\'s 9 to 9.5, UK 7, or EU 40.5.'
  },
  {
    q: 'How big is a size 9 shoe in inches?',
    a: 'A US Men\'s size 9 shoe fits a foot length of approximately 10.6 inches (27.0 cm). A US Women\'s size 9 shoe fits a foot measuring approximately 10.2 inches (26.0 cm).'
  },
  {
    q: 'How many inches are in a size 6 shoe?',
    a: 'A US Men\'s size 6 fits a foot length of roughly 9.4 inches (24.0 cm). A US Women\'s size 6 fits a foot length of roughly 9.1 inches (23.0 cm). In UK sizing, a UK 6 fits an adult foot of about 9.8 inches (25.0 cm).'
  },
  {
    q: 'How to measure shoe size in inches at home?',
    a: 'Place a sheet of paper on a hard floor against a wall. Stand with your bare heel touching the wall. Mark the tip of your longest toe with a pencil held straight. Measure the length with a ruler or measuring tape in inches, rounding up to the nearest 1/8 inch.'
  },
  {
    q: 'What is UK shoe size in inches compared to US?',
    a: 'UK shoe sizes use the 1/3-inch increment as the US, but with a different baseline. For men, UK sizing is 0.5 to 1 size smaller (US Men\'s 9 = UK 8.5 for a 10.6-inch foot). For women, UK sizing is approximately 2 sizes smaller (US Women\'s 8 = UK 6 for a 9.8-inch foot).'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` },
  })),
});

// Prepare JSON data for client-side search
const clientData = {
  men: {
    inches: MEN_SIZE_ROWS.map(r => r.inch),
    us: MEN_SIZE_ROWS.map(r => r.us),
    uk: MEN_SIZE_ROWS.map(r => r.uk),
    eu: MEN_SIZE_ROWS.map(r => r.eu),
    india: MEN_SIZE_ROWS.map(r => r.india),
    cm: MEN_SIZE_ROWS.map(r => r.cm)
  },
  women: {
    inches: WOMEN_SIZE_ROWS.map(r => r.inch),
    us: WOMEN_SIZE_ROWS.map(r => r.us),
    uk: WOMEN_SIZE_ROWS.map(r => r.uk),
    eu: WOMEN_SIZE_ROWS.map(r => r.eu),
    india: WOMEN_SIZE_ROWS.map(r => r.india),
    cm: WOMEN_SIZE_ROWS.map(r => r.cm)
  },
  kids: {
    inches: KIDS_SIZE_ROWS.map(r => r.inch),
    us: KIDS_SIZE_ROWS.map(r => r.us),
    uk: KIDS_SIZE_ROWS.map(r => r.uk),
    eu: KIDS_SIZE_ROWS.map(r => r.eu),
    india: KIDS_SIZE_ROWS.map(r => r.india),
    cm: KIDS_SIZE_ROWS.map(r => r.cm)
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />
  <main id="main-content">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Shoe Size in Inches' }]} />

    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Foot Length in Inches</p>
        <h1 class="display-xl" style="font-size:clamp(28px,5vw,48px)">Shoe size in inches</h1>
        <p class="hero-sub body-lg">Convert your foot length in inches to shoe size. Find your US, UK, EU, and India size with our calculator and reference charts.</p>
        <div class="hero-badges">
          <span class="badge-trust">4" to 13" Range</span>
          <span class="badge-trust">Men, Women and Kids</span>
          <span class="badge-trust">Barleycorn Sizing Math</span>
        </div>
      </div>
    </section>

    <!-- Inline calculator -->
    <section class="calc-band">
      <div class="page-inner">
        <div class="card-elevated calc-card">
          <h2 class="heading-md">Inches to shoe size calculator</h2>
          <div class="calc-row">
            <div class="calc-field">
              <label class="step-label" for="inches-input"><span class="step-num">1</span> Foot Length (inches)</label>
              <input type="number" id="inches-input" class="form-input" placeholder="e.g. 10.5" min="4" max="14" step="0.1" aria-label="Foot length in inches"/>
            </div>
            <div class="calc-field">
              <label class="step-label" for="inches-gender"><span class="step-num">2</span> Category</label>
              <select id="inches-gender" class="form-select" aria-label="Gender or category">
                <option value="men">Men</option>
                <option value="women">Women</option>
                <option value="kids">Kids</option>
              </select>
            </div>
          </div>
          <div id="inches-result" class="calc-result" aria-live="polite">
            <p class="calc-placeholder">Enter your foot length in inches to see your shoe size</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Tables -->
    <section class="table-band">
      <div class="page-inner">
        <h2 class="heading-md">Men's shoe size in inches</h2>
        <div class="scroll-x">
          <table class="size-table" aria-label="Men shoe size in inches">
            <thead><tr><th>Inches</th><th>CM</th><th>US Men</th><th>UK</th><th>EU</th><th>India</th></tr></thead>
            <tbody>
              {MEN_SIZE_ROWS.map(r => (
                <tr>
                  <td><strong>{r.inch.toFixed(1)}″</strong></td>
                  <td>{r.cm.toFixed(1)}</td>
                  <td>US {r.us}</td>
                  <td>UK {r.uk}</td>
                  <td>EU {r.eu}</td>
                  <td>India {r.india}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="heading-md" style="margin-top:48px">Women's shoe size in inches</h2>
        <div class="scroll-x">
          <table class="size-table" aria-label="Women shoe size in inches">
            <thead><tr><th>Inches</th><th>CM</th><th>US Women</th><th>UK</th><th>EU</th><th>India</th></tr></thead>
            <tbody>
              {WOMEN_SIZE_ROWS.map(r => (
                <tr>
                  <td><strong>{r.inch.toFixed(1)}″</strong></td>
                  <td>{r.cm.toFixed(1)}</td>
                  <td>US {r.us}</td>
                  <td>UK {r.uk}</td>
                  <td>EU {r.eu}</td>
                  <td>India {r.india}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="heading-md" style="margin-top:48px">Kids' shoe size in inches</h2>
        <div class="scroll-x">
          <table class="size-table" aria-label="Kids shoe size in inches">
            <thead><tr><th>Inches</th><th>CM</th><th>US Kids</th><th>UK Child</th><th>EU Kids</th><th>India</th></tr></thead>
            <tbody>
              {KIDS_SIZE_ROWS.map(r => (
                <tr>
                  <td><strong>{r.inch}″</strong></td>
                  <td>{r.cm}</td>
                  <td>US {r.us}</td>
                  <td>UK {r.uk}</td>
                  <td>EU {r.eu}</td>
                  <td>India {r.india}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="cta-box">
          <h2 class="heading-md">Need an international conversion?</h2>
          <p class="body-lg">Convert directly between US, UK, EU, India, and Japan sizing with one click.</p>
          <a href="/#converter" class="btn-primary">Open Full Converter</a>
        </div>
      </div>
    </section>

    <!-- Comprehensive Guide to Shoe Sizing in Inches -->
    <section class="content-band">
      <div class="page-inner">
        <article class="prose-card">
          <header class="prose-header">
            <p class="mono-eyebrow">Imperial Footwear Guide</p>
            <h2 class="prose-main-title">The history of shoe sizes in inches: the barleycorn standard</h2>
            <p class="prose-lead">Shoe sizes step in 1/3-inch increments based on the English barleycorn system.</p>
          </header>

          <div class="content-prose">
            <p>In 1324, King Edward II of England standardized the inch as the length of three dried barleycorn grains laid end to end. Shoemakers adopted one barleycorn, exactly one-third of an inch (approx. 8.46 millimeters), as the increment between adult shoe sizes.</p>
            <p>Both United States and United Kingdom footwear scales remain anchored to this 1/3-inch increment. While shoeboxes display numbers like 8, 9, or 10, each step adds precisely one barleycorn in length to the lasting mold.</p>

            <h3 class="heading-md">How half sizes work in inches</h3>
            <p>In the late 19th century, American footwear manufacturers introduced half sizes to accommodate subtle differences in foot length. A half shoe size is half a barleycorn: one-sixth of an inch (approx. 0.169 inches or 4.23 mm).</p>
            <p>Four millimeters inside a structured shoe represents the difference between a natural walking stride and toe crowding. If you feel pressure against your longest toe when walking, moving up a half size provides that 1/6-inch of toe relief without making the heel cavity too wide.</p>

            <h3 class="heading-md">Converting tape measure fractions to shoe sizes</h3>
            <p>Household tape measures divide inches into eighths or sixteenths rather than thirds and sixths. When measuring your foot, use these fractional inch ranges to find your shoe size:</p>
            <ul>
              <li>A foot length of 8 7/8 to 9 inches (22.5 to 22.9 cm) fits US Women's 6 or US Men's 4.5.</li>
              <li>A foot length of 9 1/4 to 9 3/8 inches (23.5 to 23.8 cm) fits US Women's 7 or US Men's 5.5.</li>
              <li>A foot length of 9 5/8 to 9 3/4 inches (24.4 to 24.8 cm) fits US Women's 8 or US Men's 6.5.</li>
              <li>A foot length of 9 7/8 to 10 inches (25.1 to 25.4 cm) fits US Women's 9 or US Men's 7.5 to 8.</li>
              <li>A foot length of 10 1/4 to 10 3/8 inches (26.0 to 26.4 cm) fits US Women's 10 or US Men's 8.5 to 9.</li>
              <li>A foot length of 10 5/8 to 10 3/4 inches (27.0 to 27.3 cm) fits US Men's 9.5 to 10.</li>
              <li>A foot length of 11 inches (27.9 cm) fits US Men's 10.5 to 11.</li>
            </ul>

            <div class="prose-callout">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <p>When using a standard tape measure, round up to the nearest 1/8 inch mark if you fall between lines. Always leave 3/8 to 1/2 inch of toe allowance for walking comfort.</p>
            </div>

            <h3 class="heading-md">Why women's and men's sizes differ for the same inch measurement</h3>
            <p>A foot measuring 10 inches fits a US Men's 7.5 to 8, but an identical 10-inch foot requires a US Women's 9 to 9.5. This difference exists because the US women's scale was calibrated on an offset baseline.</p>
            <p>Women's shoes built to standard B width are narrower through the arch and heel cup than men's standard D width shoes. If a woman with a 10-inch foot buys a Men's 8 for forefoot room, the shoe will slip at the heel. If a man with a 9.5-inch foot buys a Women's 8, the shoe will feel tight across the ball of the foot.</p>

            <h3 class="heading-md">Kids' shoe sizing in inches and the size 13 reset</h3>
            <p>Children's shoe sizing resets mid-childhood. The American children's system begins with infant size 0C (approx. 3.25 inches) and progresses to children's size 13C (approx. 7.67 inches). Once a child outgrows 13C, the scale restarts at Youth 1Y (approx. 8.0 inches), which continues up to 7Y (approx. 9.75 inches). A youth size 7Y is identical in length to a Men's 7 or a Women's 8.5.</p>
            <p>When measuring a child's foot in inches, add between 3/8 inch and 1/2 inch of space in front of the toes. This ensures the child has room for forward foot slide during walking, while allowing 3 to 4 months of growth before needing the next size.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- FAQ Accordion -->
    <section class="faq-band" id="faq">
      <div class="page-inner">
        <p class="mono-eyebrow">FAQ</p>
        <h2 class="heading-md">Frequently asked questions</h2>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <div class="faq-item">
              <button class="faq-trigger" aria-expanded="false" id={`inchfaq-${i}`} aria-controls={`inchfaq-c-${i}`}>
                <span>{f.q}</span>
                <span class="faq-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                  </svg>
                </span>
              </button>
              <div class="faq-content" id={`inchfaq-c-${i}`} role="region" aria-labelledby={`inchfaq-${i}`}>
                <div class="faq-inner">{f.a}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero { padding: 48px 24px 40px; background: var(--v-canvas); }
  .page-inner { max-width: 900px; margin: 0 auto; }
  .hero-sub { margin: 12px 0 20px; max-width: 600px; }
  .hero-badges { display: flex; flex-wrap: wrap; gap: 8px; }

  .calc-band { padding: 0 24px 64px; background: var(--v-canvas); }
  .calc-card { padding: 24px; }
  .calc-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 16px 0 20px; }
  .calc-result { min-height: 50px; display: flex; align-items: center; }
  .calc-placeholder { color: var(--v-faint); font-size: 14px; margin: 0; }
  .result-row { display: flex; flex-wrap: wrap; gap: 8px; width: 100%; }
  .result-chip { padding: 6px 12px; background: var(--v-canvas); border: 1px solid var(--v-hairline); border-radius: var(--v-r-sm); font-size: 14px; color: var(--v-ink); }
  .result-chip span { font-weight: 600; }

  .table-band { padding: 64px 24px; background: var(--v-canvas); border-top: 1px solid var(--v-hairline); }
  .cta-box { margin-top: 48px; text-align: center; padding: 48px 32px; background: var(--v-elevated); border: 1px solid var(--v-hairline); border-radius: var(--v-r-lg); }
  .cta-box h2 { margin: 0 0 8px; }
  .cta-box p { margin: 0 0 20px; }

  @media (max-width: 640px) {
    .page-hero { padding: 32px 16px; }
    .calc-band { padding: 0 16px 48px; }
    .table-band { padding: 48px 16px; }
    .calc-row { grid-template-columns: 1fr; }
  }
</style>

<script is:inline define:vars={{ clientData }}>
  const inchesInput = document.getElementById('inches-input');
  const genderSelect = document.getElementById('inches-gender');
  const resultEl = document.getElementById('inches-result');
  const DATA = clientData;

  function findClosest(arr, val) {
    let idx = 0, m = Infinity;
    arr.forEach((v, i) => {
      const d = Math.abs(v - val);
      if (d < m) { m = d; idx = i; }
    });
    return idx;
  }

  function calc() {
    const val = parseFloat(inchesInput?.value);
    const g = genderSelect?.value || 'men';
    if (!val || isNaN(val)) {
      if (resultEl) resultEl.innerHTML = '<p class="calc-placeholder">Enter your foot length in inches to see your shoe size</p>';
      return;
    }
    const d = DATA[g];
    const idx = findClosest(d.inches, val);
    const cmVal = Math.round(val * 2.54 * 10) / 10;
    const catLabel = g === 'men' ? 'US Men' : g === 'women' ? 'US Women' : 'US Kids';

    if (resultEl) {
      resultEl.innerHTML = `<div class="result-row">
        <div class="result-chip">${catLabel}: <span>${d.us[idx]}</span></div>
        <div class="result-chip">UK: <span>${d.uk[idx]}</span></div>
        <div class="result-chip">EU: <span>${d.eu[idx]}</span></div>
        <div class="result-chip">India: <span>${d.india[idx]}</span></div>
        <div class="result-chip">CM: <span>≈${cmVal} cm</span></div>
      </div>`;
    }
  }

  inchesInput?.addEventListener('input', calc);
  genderSelect?.addEventListener('change', calc);

  // FAQ Accordion
  document.querySelectorAll('.faq-trigger').forEach(t => {
    t.addEventListener('click', () => {
      const exp = t.getAttribute('aria-expanded') === 'true';
      t.setAttribute('aria-expanded', String(!exp));
      t.nextElementSibling?.classList.toggle('open', !exp);
    });
  });
</script>
