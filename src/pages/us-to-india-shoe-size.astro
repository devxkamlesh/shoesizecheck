    font-size: 16px;
    line-height: 26px;
    color: var(--v-body);
    margin: 0 0 28px;
    max-width: 720px;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    width: 100%;
  }
  .stat-pill {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    padding: 10px 18px;
    border-radius: var(--v-r-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 140px;
  }
  .stat-label {
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--v-mute);
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }
  .stat-val {
    font-size: 15px;
    font-weight: 800;
    color: var(--v-ink);
  }

  /* Converter Band */
  .converter-band {
    padding: 40px 24px;
    background: var(--v-canvas);
  }
  .conv-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }
  .conv-card-header {
    margin-bottom: 24px;
    text-align: center;
  }
  .heading-md {
    font-size: 22px;
    font-weight: 800;
    color: var(--v-ink);
