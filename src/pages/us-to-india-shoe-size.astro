        <div class="table-tabs" role="tablist">
          <button class="tab-btn active" data-target="tab-men" role="tab" aria-selected="true">Men's US to India Chart</button>
          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's US to India Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' US to India Chart</button>
        </div>

