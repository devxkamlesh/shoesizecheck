---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/us-to-india-shoe-size/`;
const pageTitle = 'US to India shoe size converter: US to Indian chart';
const pageDescription = 'Convert US shoe sizes to Indian sizes. Complete US to India shoe size chart for men, women, and kids with brand sizing notes and centimetre measurements.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'What is US size 8 in Indian shoe size?',
    a: 'An American US size 8 for men equals Indian size 7.5 under standard conversion (26.0 cm foot length, EU 41). Athletic sneaker brands often label US 8 as India 7. For women, a US size 8 equals Indian size 6, which fits a 25.0 cm foot length (EU 38.5).'
  },
  {
    q: 'How do I convert US women\'s shoe sizes to Indian sizes?',
    a: 'To convert US women\'s shoe sizes to Indian footwear sizes, subtract 2 from your American size (India = US − 2). For instance, an American US 7 woman wears an Indian size 5 (24.0 cm), and a US 8 woman wears an Indian size 6 (25.0 cm).'
  },
  {
    q: 'Why do branded shoes in India list both US and UK/India sizes?',
    a: 'Global athletic footwear manufacturers, including Nike, Adidas, Puma, and Skechers, print international multi-system tongue labels on shoe boxes. Because India uses British UK length standards under IS 1638:1969, branded shoes in India display US, UK, EU, and CM measurements together.'
  },
  {
    q: 'What size is EU 40 or 42 shoe size in India when buying US branded shoes?',
    a: 'An EU 40 translates to Indian size 6.5 for men (US Men 7.0, 25.0 cm). An EU 42 corresponds to Indian size 8.5 for men (US Men 9.0, 27.0 cm) on the standard scale, or Indian size 8 under sneaker brand labeling.'
  },
  {
    q: 'How do Nike and sneaker brands fit compared to the standard Indian size table?',
    a: 'Under standard ISO sizing, an American US Men\'s 9 equals Indian size 8.5 (27.0 cm foot length). Sneaker manufacturers like Nike and Converse apply a 1-size offset, labeling US 9 as UK/India 8 on the box tag. When ordering sneakers, verify the physical centimetre (CM) measurement on the size tag.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'India to US Shoe Size Converter', href: '/india-to-us-shoe-size/' },
  { label: 'US to UK Shoe Size Converter', href: '/us-to-uk-shoe-size/' },
  { label: 'US to EU Shoe Size Converter', href: '/us-to-eu-shoe-size/' },
  { label: 'UK to India Shoe Size Converter', href: '/uk-to-india-shoe-size/' },
  { label: 'India to EU Shoe Size Converter', href: '/india-to-eu-shoe-size/' },
  { label: 'India Shoe Sizing Guide', href: '/country/india/' },
  { label: 'United States Shoe Sizing Guide', href: '/country/us/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <!-- Breadcrumbs -->
    <div class="page-inner pt-4">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Converters', href: '/converters/' },
        { label: 'US to India', href: '/us-to-india-shoe-size/' }
      ]} />
    </div>

    <!-- Hero Section -->
    <section class="hero-band">
      <div class="page-inner hero-content">
        <span class="badge-pill">International Footwear Converter</span>
        <h1 class="hero-title">US to India Shoe Size Converter</h1>
        <p class="hero-sub">Convert American shoe sizes to Indian footwear sizes accurately. Explore complete men's, women's, and children's charts with brand comparisons, Myntra guidelines, and anatomical centimetre foot lengths.</p>
        
        <div class="hero-stats">
          <div class="stat-pill">
            <span class="stat-label">Men's Formula</span>
            <span class="stat-val">India = US − 1</span>
          </div>
          <div class="stat-pill">
            <span class="stat-label">Women's Formula</span>
            <span class="stat-val">India = US − 2</span>
          </div>
          <div class="stat-pill">
            <span class="stat-label">Baseline Standard</span>
            <span class="stat-val">UK / BIS (Bha)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert US to India Shoe Size</h2>
            <p class="conv-card-sub">Select your gender and American (US) footwear size to calculate your exact Indian size, European equivalent, and footbed length in centimetres.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> American (US) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select US shoe size">
                <option value="" disabled>Select US size</option>
                {menSizes.map(s => <option value={String(s.us)} selected={s.us === 9.0 ? true : undefined}>{s.us} US</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">United States (US)</span>
                <span class="conv-val" id="res-us">9.0</span>
                <span class="conv-note" id="res-us-sub">Men's Standard</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">India (IND / UK)</span>
                <span class="conv-val" id="res-in">8.0</span>
                <span class="conv-note" id="res-in-sub">India Men's Equivalent</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed & European</span>
                <span class="conv-val-sm" id="res-cm">27.0 cm · EU 42</span>
                <span class="conv-note" id="res-in-meas">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Popular US to India Shoe Size Benchmarks</h2>
        <p class="section-sub">Quick reference for the most widely searched US and Indian footwear sizes on Myntra, Flipkart, Amazon India, and retail storefronts.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 8 Men → India 7</span>
              <span class="snap-detail">Foot length: 26.0 cm · EU 41 · us8 size in india</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 9 Men → India 8</span>
              <span class="snap-detail">Foot length: 27.0 cm · EU 42 · 42 size shoe in india</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 10 Men → India 9</span>
              <span class="snap-detail">Foot length: 28.0 cm · EU 43 · 43 shoe size in india</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 7 Women → India 5</span>
              <span class="snap-detail">Foot length: 24.0 cm · EU 38 · 38 size in india shoes</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 8 Women → India 6</span>
              <span class="snap-detail">Foot length: 25.0 cm · EU 39 · euro 37 to 39 range</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 8.5 Women → India 6.5</span>
              <span class="snap-detail">Foot length: 25.5 cm · EU 40 · 40 size in india shoes</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Charts Section -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">Comprehensive US to India Footwear Size Chart</h2>
        <p class="section-sub">Cross-comparison tables showing exact correlations between American US sizes, Indian (UK) sizes, European sizing, and metric footbed lengths.</p>

        <div class="table-tabs" role="tablist">
          <button class="tab-btn active" data-target="tab-men" role="tab" aria-selected="true">Men's US to India Chart</button>
          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's US to India Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' US to India Chart</button>
        </div>

        <!-- Men's Table -->
        <div class="table-panel active" id="tab-men" role="tabpanel">
          <h3 class="table-heading">Men's US to India Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Men US to India shoe size chart">
              <thead>
                <tr>
                  <th>US Men Size</th>
                  <th>India Size (UK)</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us.toFixed(1)}</strong></td>
                    <td class="highlight-cell"><strong>India {r.india.toFixed(1)}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm.toFixed(1)} cm</td>
                    <td>{r.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Table -->
        <div class="table-panel" id="tab-women" role="tabpanel">
          <h3 class="table-heading">Women's US to India Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Women US to India shoe size chart">
              <thead>
                <tr>
                  <th>US Women Size</th>
                  <th>India Size (UK)</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us.toFixed(1)}</strong></td>
                    <td class="highlight-cell"><strong>India {r.india.toFixed(1)}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm.toFixed(1)} cm</td>
                    <td>{r.inch.toFixed(1)}"</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Table -->
        <div class="table-panel" id="tab-kids" role="tabpanel">
          <h3 class="table-heading">Kids' & Youth US to India Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table" aria-label="Kids US to India shoe size chart">
              <thead>
                <tr>
                  <th>US Kids Size</th>
                  <th>India Kids Size</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Age Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>India {r.india}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm.toFixed(1)} cm</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial SEO Prose Section -->
    <article class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">How to convert US shoe size to India: sizing guide</h2>
        
        <p class="lead-paragraph">
          Navigating international footwear sizing is essential for shoppers ordering imported shoes or ordering from Indian marketplaces like Myntra, Tata CliQ, and Ajio. Because India adheres to the British UK sizing standard for length measurements, American shoe sizes do not correspond directly to Indian numbers. This guide breaks down conversion rules, brand variations, and centimetre measurements.
        </p>

        <h3>Core rules to convert US size to India</h3>
        <p>
          The conversion between the American scale and the Indian shoe size chart depends on gender:
        </p>
        <ul>
          <li>Under standard ISO/TS 19407 guidelines, American men's shoe sizes are 0.5 sizes larger than Indian sizes (US Men = India + 0.5). For example, US 9 corresponds to India 8.5 (27.0 cm foot length). Many global athletic sneaker brands apply a full 1-size offset, labeling US 9 as India 8.</li>
          <li>For women, American sizes are 2 full sizes larger than Indian sizes (India = US − 2). A woman wearing US 7 wears Indian size 5 (24.0 cm), and US 8 corresponds to Indian size 6 (25.0 cm).</li>
          <li>For children, American sizes run 0.5 to 1 size larger than Indian sizes (for example, US 10C child corresponds to Indian 9.5C, measuring 16.5 cm).</li>
        </ul>

        <h3>Understanding Indian footwear standards</h3>
        <p>
          The standard Indian footwear scale adopted the British imperial barleycorn sizing system under Indian standard IS 1638:1969. In 2022, the CSIR-Central Leather Research Institute (CSIR-CLRI) completed an anthropometric survey of Indian feet. Their survey report found that Indian feet show broader metatarsal ball girth relative to European lasts. In response, the Bureau of Indian Standards developed the Bha standard to offer wider forefoot proportions.
        </p>
        <p>
          When shopping online, checking foot length in centimetres provides the most reliable way to match sizes across domestic and imported brands.
        </p>

        <h3>Domestic brands and athletic sneaker sizing</h3>
        <p>
          Indian shoppers frequently encounter both domestic and international numbering:
        </p>
        <ul>
          <li>Domestic manufacturers like Bata India, Liberty, Relaxo, Campus, and Red Tape use Indian/UK numbering. In these brands, an Indian size 8.5 fits a 27.0 cm foot.</li>
          <li>Global athletic brands like Nike and Converse apply a 1-size offset, labeling US Men 9 as UK/India 8 on the tongue tag.</li>
          <li>For canvas sneakers with unisex sizing, verify the centimetre reading on the inner tongue tag before selecting a size.</li>
        </ul>

        <h3>European sizing translations in India</h3>
        <p>
          European fashion retailers operating in India use Continental Paris Point sizes:
        </p>
        <ul>
          <li>European 37 translates to Indian size 4.5 (23.5 cm foot length, US Women 6.5).</li>
          <li>European 38 translates to Indian women's size 5 (24.0 cm foot length, US Women 7.0).</li>
          <li>European 40 corresponds to Indian size 6.5 for men (25.0 cm foot length, US Men 7.0).</li>
          <li>European 42 corresponds to Indian size 8.5 for men (27.0 cm foot length, US Men 9.0) on the standard scale, or Indian size 8 under sneaker brand labeling.</li>
          <li>European 44 corresponds to Indian size 9.5 for men (28.0 cm foot length, US Men 10.0).</li>
        </ul>

        <h3>Measuring foot length in centimeters</h3>
        <p>
          To determine your foot size accurately, measure your barefoot length in centimeters following our <a href="/shoe-size-by-foot-length/">shoe size by foot length guide</a>. A 27.0 cm measurement corresponds to Indian size 8.5 and US Men 9.0 on the standard scale.
        </p>
      </div>
    </article>

    <!-- FAQ Accordion Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions: US to India sizing</h2>
        <p class="section-sub">Direct answers to common questions about shoe size conversions between the United States and India.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Links Band -->
    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resUs = document.getElementById('res-us');
    const resUsSub = document.getElementById('res-us-sub');
    const resIn = document.getElementById('res-in');
    const resInSub = document.getElementById('res-in-sub');
    const resCm = document.getElementById('res-cm');
    const resInMeas = document.getElementById('res-in-meas');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.us);
        opt.textContent = `${item.us} US`;
        if (gender === 'men' && item.us === 9.0) opt.selected = true;
        if (gender === 'women' && item.us === 8.0) opt.selected = true;
        if (gender === 'kids' && item.us === '10C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      let label = "Men's Indian Standard";
      if (gender === 'women') { list = WOMEN; label = "Women's Indian Standard"; }
      if (gender === 'kids') { list = KIDS; label = "Kids' Indian Standard"; }

      const match = list.find(item => String(item.us) === String(val));
      if (!match) return;

      if (resUs) resUs.textContent = String(match.us);
      if (resUsSub) resUsSub.textContent = gender === 'kids' ? 'US Kids Size' : (gender === 'women' ? "US Women's Size" : "US Men's Size");
      if (resIn) resIn.textContent = String(match.india);
      if (resInSub) resInSub.textContent = label;
      if (resCm) resCm.textContent = `${match.cm.toFixed(1)} cm · EU ${match.eu}`;
      if (resInMeas) resInMeas.textContent = match.inch ? `${match.inch.toFixed(1)} inches` : `${match.stage || 'Metric'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.classList.add('active');
          } else {
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Layout tokens */
  .page-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .pt-4 { padding-top: 16px; }

  /* Hero Band */
  .hero-band {
    padding: 48px 24px 36px;
    background: linear-gradient(180deg, var(--v-elevated) 0%, var(--v-canvas) 100%);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 820px;
    margin: 0 auto;
  }
  .badge-pill {
    display: inline-block;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: var(--v-r-full);
    background: var(--v-badge-bg);
