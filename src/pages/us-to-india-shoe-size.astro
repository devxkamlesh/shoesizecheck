        <p class="section-sub">Quick reference for the most widely searched US and Indian footwear sizes on Myntra, Flipkart, Amazon India, and retail storefronts.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 8 Men → India 7</span>
              <span class="snap-detail">Foot length: 26.0 cm · EU 41 · us8 size in india</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 9 Men → India 8</span>
              <span class="snap-detail">Foot length: 27.0 cm · EU 42 · 42 size shoe in india</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 10 Men → India 9</span>
              <span class="snap-detail">Foot length: 28.0 cm · EU 43 · 43 shoe size in india</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 7 Women → India 5</span>
              <span class="snap-detail">Foot length: 24.0 cm · EU 38 · 38 size in india shoes</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 8 Women → India 6</span>
              <span class="snap-detail">Foot length: 25.0 cm · EU 39 · euro 37 to 39 range</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">US 8.5 Women → India 6.5</span>
              <span class="snap-detail">Foot length: 25.5 cm · EU 40 · 40 size in india shoes</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Charts Section -->
