  { uk: '13.5C', us: '1Y', eu: 32, cm: 20.0, stage: 'Big Kid' },
  { uk: '1.5Y', us: '2Y', eu: 33, cm: 20.5, stage: 'Big Kid' },
  { uk: '2.5Y', us: '3Y', eu: 34.5, cm: 21.5, stage: 'Big Kid' },
