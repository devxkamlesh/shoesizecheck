---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content="uk to us shoe size, convert uk shoe size to us, convert uk to us shoe size, uk to american shoe size, uk foot size to us, uk size to us, uk size to us size shoes, uk to us size conversion, uk to us size guide, uk shoe size to us women, uk to us sizes women's, uk women's shoe size to us, uk men shoe size to us, uk to us men's shoe size, uk sneaker size to us, uk boot size to us, uk footwear size to us, uk to us boot size, feet size uk to us, shoe size guide uk to us, uk and us foot size, uk and us size chart, uk us size chart, uk shoe size to us shoe size, uk 8 to us size, uk 8 to us, uk 8 size to us, uk 8 is us size, uk 8 in us size shoes, uk size 8 in us size, uk size 8 in us shoes, uk size 10 in us, uk size 10 in us size, uk size 10 in us shoes, uk size ten in us, uk 10 in us size shoes, uk size 6 in us, uk size 6 in us shoes, uk 6 in us size shoes, uk size 7 in us, uk 7 shoes to us, uk size 9 in us, uk 9 to us, uk 9 shoe size to us, uk 9.5 to us, uk size 4 in us, uk size 4 in us size, uk size 4 in us shoes, uk 4 in us size shoes, uk size 5 in us, uk 5 to us shoe size, uk size 3 in us, uk 12 to us size, 4 uk size in us" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
