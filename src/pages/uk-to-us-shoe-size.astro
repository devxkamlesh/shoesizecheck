---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/uk-to-us-shoe-size/`;
const pageTitle = 'UK to US shoe size converter: British to American chart';
const pageDescription = 'Convert UK shoe sizes to US sizes. Comprehensive UK to US conversion charts for men, women, and kids with boots, sneakers, and sizing formulas.';
const ogImage = `${domain}/og-image.png`;

const menSizes = MEN_SIZE_ROWS;
const womenSizes = WOMEN_SIZE_ROWS;
const kidsSizes = KIDS_SIZE_ROWS;

const faqs = [
  {
    q: 'What is the shoe size conversion from UK to US?',
    a: 'To convert UK shoe size to US, add 0.5 to British men\'s sizes (US = UK + 0.5; for example, UK 8.5 Men = US 9). For British women\'s sizes, add 2 full sizes (US = UK + 2; for example, UK 6 Women = US 8). For children\'s footwear, US sizes are typically 0.5 to 1 size larger than UK.'
  },
  {
    q: 'What is the US shoe size equivalent to a UK women\'s size?',
    a: 'The American women\'s equivalent is 2 sizes larger than the British UK size. A UK Women\'s size 5 corresponds to a US Women\'s 7 (24.0 cm), UK Women\'s 6 equals US Women\'s 8 (25.0 cm), and UK Women\'s 7 translates to US Women\'s 9 (26.0 cm).'
  },
  {
    q: 'How does UK shoe sizing compare to US for men\'s dress shoes and boots?',
    a: 'British formal footwear and boots (such as Dr. Martens, Clarks, Loake, Church\'s, and Tricker\'s) use UK sizing. In addition to adding 0.5 in length for US men\'s sizing, consider width fittings: standard British F fitting corresponds to American D (medium), while British G is a wide fitting equivalent to American E or EE.'
  },
  {
    q: 'How do I convert UK kids\' shoe sizes to US sizing?',
    a: 'In children\'s footwear, British sizes run 0.5 to 1 size smaller than US sizes through toddler and little kid stages (such as UK 7.5C = US 8C). When transitioning into youth sizes, British 13.5C converts into US 1Y, and UK 1Y corresponds to US 2Y.'
  },
  {
    q: 'How can I measure my foot at home to confirm my exact US and UK size?',
    a: 'Measure the distance in centimeters from the wall to the tip of your longest toe. Add 0.5 cm of movement allowance, then reference our conversion table to find your UK and US sizes.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'US to UK Shoe Size Converter', href: '/us-to-uk-shoe-size/' },
  { label: 'UK to EU Shoe Size Converter', href: '/uk-to-eu-shoe-size/' },
  { label: 'UK to India Shoe Size Converter', href: '/uk-to-india-shoe-size/' },
  { label: 'United Kingdom Shoe Sizing Guide', href: '/country/uk/' },
  { label: 'United States Shoe Sizing Guide', href: '/country/us/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'UK to US Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">British Imperial to American Footwear Conversion</p>
        <h1 class="display-xl">UK to US Shoe Size Converter</h1>
        <p class="hero-sub body-lg">
          Convert British (UK) shoe sizes to American (US) sizes instantly. Calculate your exact US fit across men's, women's, and children's shoes, boots, and sneakers with our interactive calculator and conversion charts.
        </p>

        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men's Formula:</span>
            <span class="badge-val">US = UK + 0.5</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women's Formula:</span>
            <span class="badge-val">US = UK + 2.0</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Base Step:</span>
            <span class="badge-val">1/3 Inch (Barleycorn)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert British (UK) to American (US) Size</h2>
            <p class="conv-card-sub">Select your gender and UK size to calculate your corresponding US shoe size, EU size, and anatomical footbed length.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> British (UK) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select British shoe size">
                <option value="" disabled>Select UK size</option>
                {menSizes.map(s => <option value={String(s.uk)} selected={s.uk === 8.0 ? true : undefined}>{s.uk} UK Men</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">United Kingdom (UK)</span>
                <span class="conv-val" id="res-uk">8</span>
                <span class="conv-note" id="res-uk-sub">Men's Standard</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">United States (US)</span>
                <span class="conv-val" id="res-us">8.5</span>
                <span class="conv-note" id="res-us-sub">US = UK + 0.5</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed Length</span>
                <span class="conv-val-sm" id="res-cm">26.5 cm</span>
                <span class="conv-note" id="res-in-meas">10.4 inches · EU 41.5</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Popular UK to US Shoe Size Benchmarks</h2>
        <p class="section-sub">Quick reference for the most widely searched adult sizes in British footwear converting to US sizing.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 7 → US 7.5</span>
              <span class="snap-detail">Foot length: 25.5 cm · EU 40.5 · 10.0″</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 8 → US 8.5</span>
              <span class="snap-detail">Foot length: 26.5 cm · EU 41.5 · 10.4″</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 9 → US 9.5</span>
              <span class="snap-detail">Foot length: 27.5 cm · EU 42.5 · 10.8″</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 10 → US 10.5</span>
              <span class="snap-detail">Foot length: 28.5 cm · EU 44 · 11.2″</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 5 → US 7.0</span>
              <span class="snap-detail">Foot length: 24.0 cm · EU 37.5 · 9.4″</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">UK 6 → US 8.0</span>
              <span class="snap-detail">Foot length: 25.0 cm · EU 38.5 · 9.8″</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Comprehensive Conversion Tables -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">Complete UK to US Shoe Size Conversion Charts</h2>
        <p class="section-sub">Comprehensive UK to US size chart spanning men's, women's, and kids' footwear with European and centimetre metrics.</p>

        <!-- Tabs -->
        <div class="table-tabs" role="tablist" aria-label="Footwear Category Tables">
          <button class="tab-btn active" role="tab" aria-selected="true" data-target="panel-men">Men's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-women">Women's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-kids">Kids' Sizes</button>
        </div>

        <!-- Men's Panel -->
        <div id="panel-men" class="table-panel active" role="tabpanel">
          <h3 class="table-heading">Men's UK to US Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>UK Size</th>
                  <th>US Men Size</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>UK {r.uk}</strong></td>
                    <td class="highlight-cell"><strong>US {r.us}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}″</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Panel -->
        <div id="panel-women" class="table-panel" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Women's UK to US Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>UK Size</th>
                  <th>US Women Size</th>
                  <th>EU Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>UK {r.uk}</strong></td>
                    <td class="highlight-cell"><strong>US {r.us}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}″</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Panel -->
        <div id="panel-kids" class="table-panel" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Kids' UK to US Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>UK Kids Size</th>
                  <th>US Kids Size</th>
                  <th>EU Size</th>
                  <th>Footbed (CM)</th>
                  <th>Development Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>UK {r.uk}</strong></td>
                    <td class="highlight-cell"><strong>US {r.us}</strong></td>
                    <td>EU {r.eu}</td>
                    <td>{r.cm} cm</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- Editorial Guide -->
    <section class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">UK to US shoe size guide: conversion rules and brand fits</h2>

        <p class="lead-paragraph">
          British and American footwear sizing share the imperial barleycorn system. Because both scales use the same incremental step of one-third of an inch, conversions follow fixed numerical offsets between British and American lasts.
        </p>

        <h3>1. Geometry of the British barleycorn scale</h3>
        <p>
          Shoe sizing in the United Kingdom and North America traces to the 1324 statute establishing the barleycorn (one-third of an inch, or 8.46 millimeters) as a unit of measurement. A full size step equals 1/3 inch (8.46 mm), while a half size step equals 1/6 inch (4.23 mm). For historical background and formulas, consult our guide on <a href="/shoe-size-in-inches/">shoe sizes in inches and barleycorn measurements</a>.
        </p>

        <h3>2. Men's conversion: adding 0.5 to your British size</h3>
        <p>
          For men's footwear, calculate your American size by adding 0.5 to your British size. Standard benchmarks include:
        </p>
        <ul>
          <li>UK 6 = US Men's 6.5 (24.5 cm)</li>
          <li>UK 7 = US Men's 7.5 (25.5 cm)</li>
          <li>UK 8 = US Men's 8.5 (26.5 cm)</li>
          <li>UK 8.5 = US Men's 9.0 (27.0 cm)</li>
          <li>UK 9 = US Men's 9.5 (27.5 cm)</li>
          <li>UK 9.5 = US Men's 10.0 (28.0 cm)</li>
          <li>UK 10 = US Men's 10.5 (28.5 cm)</li>
          <li>UK 11 = US Men's 11.5 (29.5 cm)</li>
          <li>UK 12 = US Men's 12.5 (30.5 cm)</li>
        </ul>
        <p>
          Sneaker manufacturers such as Nike, New Balance, and Asics apply this half-size rule to their men's conversion tables.
        </p>

        <h3>3. Women's conversion: adding 2 sizes</h3>
        <p>
          In women's footwear, the offset between the two scales is two full sizes:
        </p>
        <ul>
          <li>UK 3 = US Women's 5.0 (22.0 cm)</li>
          <li>UK 4 = US Women's 6.0 (23.0 cm)</li>
          <li>UK 5 = US Women's 7.0 (24.0 cm)</li>
          <li>UK 6 = US Women's 8.0 (25.0 cm)</li>
          <li>UK 7 = US Women's 9.0 (26.0 cm)</li>
          <li>UK 8 = US Women's 10.0 (27.0 cm)</li>
        </ul>

        <h3>4. Boot and heritage sizing: Dr. Martens, Clarks, and Chelsea boots</h3>
        <p>
          Classic British bootmakers frequently manufacture in whole UK sizes without half sizes:
        </p>
        <ul>
          <li>Dr. Martens (AirWair): boots are sized in whole UK numbers. Buyers wearing US Men's 9.5 typically choose UK 9.</li>
          <li>Clarks Originals: Desert Boots and Wallabees use UK lasts with generous forefoot volume. A US Men's 10 corresponds to a UK 9.5.</li>
          <li>Goodyear-welted shoes: makers such as Loake and Church's use standard F width fitting, equivalent to American D. For wider feet, look for G or H fittings.</li>
        </ul>

        <h3>5. Centimeter and Mondopoint measurements</h3>
        <p>
          Footwear boxes print the Japanese (JP) or Mondopoint metric measurement in centimeters. A 27.0 cm footbed is identical whether marked as UK 8.5 or US 9.0. See our guide on <a href="/shoe-size-by-foot-length/">shoe sizing by foot length</a> to determine your exact foot measurements.
        </p>

        <h3>6. Checklist for British footwear buyers</h3>
        <p>
          When ordering British shoes or boots from international retailers, check these points:
        </p>
        <ul>
          <li>Verify whether the retailer lists native UK sizes or pre-converted US numbers.</li>
          <li>Account for sock thickness when selecting leather boots.</li>
          <li>Note width letter conventions: British F denotes medium width, while American medium is D.</li>
          <li>Consult the gender-specific conversion table to apply the correct size offset.</li>
        </ul>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Clear, expert answers to the most common questions about converting UK shoe sizes to US sizes.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0 ? true : undefined}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <RelatedLinks title="Related Shoe Size Converters & Regional Guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resUk = document.getElementById('res-uk');
    const resUkSub = document.getElementById('res-uk-sub');
    const resUs = document.getElementById('res-us');
    const resUsSub = document.getElementById('res-us-sub');
    const resCm = document.getElementById('res-cm');
    const resInMeas = document.getElementById('res-in-meas');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.uk);
        opt.textContent = `${item.uk} UK ${gender === 'men' ? 'Men' : gender === 'women' ? 'Women' : ''}`;
        if (gender === 'men' && item.uk === 8.0) opt.selected = true;
        if (gender === 'women' && item.uk === 6.0) opt.selected = true;
        if (gender === 'kids' && item.uk === '9.5C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      if (gender === 'women') list = WOMEN;
      if (gender === 'kids') list = KIDS;

      const match = list.find(item => String(item.uk) === String(val));
      if (!match) return;

      if (resUk) resUk.textContent = String(match.uk);
      if (resUkSub) resUkSub.textContent = gender === 'men' ? "UK Men's Standard" : gender === 'women' ? "UK Women's Standard" : "UK Kids' Standard";
      if (resUs) resUs.textContent = String(match.us);
      if (resUsSub) resUsSub.textContent = gender === 'men' ? "US = UK + 0.5" : gender === 'women' ? "US = UK + 2.0" : "American Children's";
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resInMeas) resInMeas.textContent = match.inch ? `${match.inch} inches · EU ${match.eu}` : `EU ${match.eu} · ${match.stage || 'Youth'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Hero */
  .page-hero {
    padding: 56px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .page-inner { max-width: 960px; margin: 0 auto; }
  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    color: var(--v-ink);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 16px;
  }
  .hero-sub { font-size: 16px; color: var(--v-body); line-height: 26px; max-width: 680px; margin: 0 auto 24px; }

  /* Quick Stat Badges */
  .quick-stat-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    font-size: 12.5px;
    box-shadow: var(--v-shadow-whisper);
  }
  .badge-label { color: var(--v-mute); }
  .badge-val { font-family: var(--font-mono); font-weight: 700; color: var(--v-ink); }

  /* Converter Band */
  .converter-band { padding: 40px 24px 56px; background: var(--v-canvas); }
  .conv-card {
    padding: 32px;
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    box-shadow: var(--v-shadow-floating);
  }
  .conv-card-header { margin-bottom: 24px; }
  .heading-md { font-size: 22px; font-weight: 700; color: var(--v-ink); letter-spacing: -0.02em; margin: 0 0 6px; }
  .conv-card-sub { font-size: 14px; color: var(--v-mute); margin: 0; }

  .conv-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  .step-label {
    display: flex;
    align-items: center;
    gap: 8px;
