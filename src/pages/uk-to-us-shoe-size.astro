const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/uk-to-us-shoe-size/`;
const pageTitle = 'UK to US Shoe Size Converter — British to American Chart';
const pageDescription = 'Convert UK shoe sizes to US sizes instantly. Comprehensive UK to US conversion chart for men, women, and kids with boots, sneakers, and sizing formulas.';
const ogImage = `${domain}/og-image.png`;

// Men's table data (UK, US, EU, CM, Inches)
const menSizes = [
  { uk: 5.5, us: 6.0, eu: 38.5, cm: 24.0, inch: 9.4 },
