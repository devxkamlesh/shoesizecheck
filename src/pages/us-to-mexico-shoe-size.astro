  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content="american shoe size to mexico, conversion shoe size mexico to us, size shoes us to mexico, convert shoe size us to mexico, mexican and us shoe sizes, mexican to us shoe sizes, mexico conversion shoe size, mexico shoe size to us size, mexico to us shoe conversion, shoe conversion mexico to us, shoe size from usa to mexico, shoe size in mexico, shoe size in us to mexico, shoes sizes mexico usa, size shoes us mexico" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'US to Mexico Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">American Imperial to Mexican Punto Calzado</p>
        <h1 class="display-xl">US to Mexico Shoe Size Converter</h1>
        <p class="hero-sub body-lg">
          Convert American (US) shoe sizes to Mexican sizes instantly. Calculate your exact Mexican fit across men's, women's, and children's shoes and boots with our interactive calculator, Punto Calzado tables, and sizing guide.
        </p>

        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men's Formula:</span>
            <span class="badge-val">Mexico ≈ US − 1.5</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women's Formula:</span>
            <span class="badge-val">Mexico ≈ US − 3.0</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Metric Basis:</span>
            <span class="badge-val">1 Punto = 1.0 CM</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert American (US) to Mexican (MX) Size</h2>
            <p class="conv-card-sub">Select your gender and American size to calculate your corresponding Mexican shoe size, Punto Calzado (CM), and international sizes.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> American (US) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select American shoe size">
                <option value="" disabled>Select US size</option>
                {menSizes.map(s => <option value={String(s.us)} selected={s.us === 9.5 ? true : undefined}>{s.us} US Men</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">United States (US)</span>
                <span class="conv-val" id="res-us">9.5</span>
                <span class="conv-note" id="res-us-sub">Men's Standard</span>
