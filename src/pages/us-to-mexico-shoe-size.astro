---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/us-to-mexico-shoe-size/`;
const pageTitle = 'US to Mexico shoe size converter: American to Mexican chart';
const pageDescription = 'Convert US shoe sizes to Mexican sizes. Complete US to Mexican conversion chart for men, women, and kids with Punto Calzado and boot sizing tips.';
const ogImage = `${domain}/og-image.png`;

// Mexican sizing helpers based on standard Punto Calzado (centimeters)
function getMexicoMen(us: number): string {
  const map: Record<number, string> = {
    6.0: '5.0', 6.5: '5.5', 7.0: '5.5', 7.5: '6.0',
    8.0: '6.5', 8.5: '7.0', 9.0: '7.5', 9.5: '8.0',
    10.0: '8.5', 10.5: '9.0', 11.0: '9.5', 11.5: '10.0',
    12.0: '10.5', 13.0: '11.5'
  };
  return map[us] || (us - 1.5).toFixed(1);
}

function getMexicoWomen(us: number): string {
  const map: Record<number, string> = {
    5.0: '2.0', 5.5: '2.5', 6.0: '3.0', 6.5: '3.5',
    7.0: '4.0', 7.5: '4.5', 8.0: '5.0', 8.5: '5.5',
    9.0: '6.0', 9.5: '6.5', 10.0: '7.0', 10.5: '7.5',
    11.0: '8.0'
  };
  return map[us] || (us - 3.0).toFixed(1);
}

// Derive table datasets from centralized single source of truth
const menSizes = MEN_SIZE_ROWS.map(r => ({
  us: r.us,
  mx: getMexicoMen(r.us),
  cm: r.cm,
  inch: r.inch,
  eu: r.eu,
  uk: r.uk,
}));

const womenSizes = WOMEN_SIZE_ROWS.map(r => ({
  us: r.us,
  mx: getMexicoWomen(r.us),
  cm: r.cm,
  inch: r.inch,
  eu: r.eu,
  uk: r.uk,
}));

const kidsSizes = KIDS_SIZE_ROWS.map(r => ({
  us: r.us,
  mx: String(r.cm),
  cm: r.cm,
  inch: r.inch,
  eu: r.eu,
  uk: r.uk,
  stage: r.stage,
}));

const faqs = [
  {
    q: 'How do US shoe sizes convert to Mexican shoe sizes?',
    a: 'To convert US shoe sizes to Mexico, subtract approximately 1.5 from American men\'s sizes (for example, US Men\'s 9.5 equals Mexico 8 / Punto 27.5 cm; US Men\'s 8 equals Mexico 6.5). For American women\'s sizes, subtract approximately 3.0 from your US size (for example, US Women\'s 8 equals Mexico 5 / Punto 25 cm). In Mexican retail, sizes are also designated by their full centimeter length (Puntos).'
  },
  {
    q: 'What does "Punto Calzado" mean in Mexican footwear sizing?',
    a: 'Punto Calzado (or Puntos) is the metric footwear sizing standard in Mexico. One punto equals one centimeter of foot length. A shoe marked Punto 27 is manufactured for a foot measuring 27.0 centimeters from heel to longest toe.'
  },
  {
    q: 'Why is size 28 in Mexico called "Talla 8"?',
    a: 'In everyday retail across Mexican shoe stores and markets, shopkeepers drop the leading digit 2. A Punto 28 (28.0 cm footbed) is referred to as Talla 8, a Punto 27 is called Talla 7, and a Punto 26.5 is called Talla 6.5.'
  },
  {
    q: 'How do Mexican cowboy boots and dress shoes fit compared to US sizes?',
    a: 'Handcrafted Mexican leather boots made in León, Guanajuato by makers like Cuadra, Flexi, and Los Altos use full-grain leather and Goodyear welts. Pointed western boots fit snug across the instep; buyers with wider feet often choose a half-size larger for comfort.'
  },
  {
    q: 'What is a Mexican women\'s size 5 in US shoe sizing?',
    a: 'A Mexican women\'s size 5 (Talla 5, or Punto 25.0 cm) corresponds to an American US Women\'s 8.0 (European EU 38.5, UK 6.0). It is designed for a foot length measuring 25.0 centimeters.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'Mexico Shoe Size Chart & Guide', href: '/country/mexico/' },
  { label: 'US to CM Shoe Size Converter', href: '/us-to-cm-shoe-size/' },
  { label: 'US to EU Shoe Size Converter', href: '/us-to-eu-shoe-size/' },
  { label: 'US to UK Shoe Size Converter', href: '/us-to-uk-shoe-size/' },
  { label: 'United States Sizing Guide', href: '/country/us/' },
  { label: 'Shoe Size in Centimeters (CM)', href: '/shoe-size-in-cm/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'US to Mexico Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">American Imperial to Mexican Punto Calzado</p>
        <h1 class="display-xl">US to Mexico shoe size converter</h1>
        <p class="hero-sub body-lg">
          Convert American (US) shoe sizes to Mexican sizes. Find your Mexican fit across men's, women's, and children's shoes with our calculator, Punto Calzado tables, and sizing guide.
        </p>
        <p class="hero-answer"><strong>Direct answer:</strong> Mexican sizes use centimeters (Punto Calzado). US Men's 9 equals Mexico 7.5 (27.0 cm), and US Women's 8 equals Mexico 5.0 (25.0 cm).</p>

        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men's US 9.0:</span>
            <span class="badge-val">Mexico 7.5 (Punto 27)</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women's US 8.0:</span>
            <span class="badge-val">Mexico 5.0 (Punto 25)</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Punto Scale:</span>
            <span class="badge-val">1 Punto = 1 CM</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert American (US) size to Mexico (MX)</h2>
            <p class="conv-card-sub">Select your category and US shoe size to view the Mexican size and centimeter measurement.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> American (US) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select American shoe size">
                <option value="" disabled>Select US size</option>
                {menSizes.map(s => <option value={String(s.us)} selected={s.us === 9.5 ? true : undefined}>{s.us} US Men</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">United States (US)</span>
                <span class="conv-val" id="res-us">9.5</span>
                <span class="conv-note" id="res-us-sub">Men's Standard</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">Mexico (MX)</span>
                <span class="conv-val" id="res-mx">8.0</span>
                <span class="conv-note" id="res-mx-sub">Talla 8.0 / Punto 27.5</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Footbed Length</span>
                <span class="conv-val-sm" id="res-cm">27.5 cm</span>
                <span class="conv-note" id="res-intl">10.8 inches · EU 42.5</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Common US to Mexico shoe size benchmarks</h2>
        <p class="section-sub">Standard adult conversions between American footwear and Mexican retail sizes.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 8 Men → Mexico 6.5</span>
              <span class="snap-detail">Punto 26.0 cm · EU 41 · UK 7.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 9 Men → Mexico 7.5</span>
              <span class="snap-detail">Punto 27.0 cm · EU 42 · UK 8.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 9.5 Men → Mexico 8.0</span>
              <span class="snap-detail">Punto 27.5 cm · EU 42.5 · UK 9.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 10 Men → Mexico 8.5</span>
              <span class="snap-detail">Punto 28.0 cm · EU 43 · UK 9.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 7 Women → Mexico 4.0</span>
              <span class="snap-detail">Punto 24.0 cm · EU 37.5 · UK 5.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 8 Women → Mexico 5.0</span>
              <span class="snap-detail">Punto 25.0 cm · EU 38.5 · UK 6.0</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Comprehensive Conversion Tables -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">US to Mexico shoe size conversion charts</h2>
        <p class="section-sub">Tables for men's, women's, and children's shoes with Punto Calzado, centimeter, and inch details.</p>

        <!-- Tabs -->
        <div class="table-tabs" role="tablist" aria-label="Footwear Category Tables">
          <button class="tab-btn active" role="tab" aria-selected="true" data-target="panel-men">Men's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-women">Women's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-kids">Kids' Sizes</button>
        </div>

        <!-- Men's Panel -->
        <div id="panel-men" class="table-panel active" role="tabpanel">
          <h3 class="table-heading">Men's US to Mexico shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>US Men Size</th>
                  <th>Mexico (Talla)</th>
                  <th>Punto (CM)</th>
                  <th>Inches</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>MX {r.mx}</strong></td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}″</td>
                    <td>EU {r.eu}</td>
                    <td>UK {r.uk}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Panel -->
        <div id="panel-women" class="table-panel" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Women's US to Mexico shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>US Women Size</th>
                  <th>Mexico (Talla)</th>
                  <th>Punto (CM)</th>
                  <th>Inches</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>MX {r.mx}</strong></td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}″</td>
                    <td>EU {r.eu}</td>
                    <td>UK {r.uk}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Panel -->
        <div id="panel-kids" class="table-panel" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Kids' US to Mexico shoe size chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>US Kids Size</th>
                  <th>Mexico (Talla)</th>
                  <th>Punto (CM)</th>
                  <th>Inches</th>
                  <th>EU Size</th>
                  <th>Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>MX {r.mx}</strong></td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}″</td>
                    <td>EU {r.eu}</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- Editorial Guide -->
    <section class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">The complete US to Mexico shoe sizing guide</h2>

        <p class="lead-paragraph">
          Shoppers buying boots from León, Guanajuato or purchasing footwear across the border encounter the Mexican Punto Calzado system. Understanding the formulas and naming habits ensures you choose the right fit.
        </p>

        <h3>How Mexican shoe sizing works: the Punto Calzado standard</h3>
        <p>
          Mexican footwear sizing relies on foot length in centimeters. Footwear measurement is designated as Punto Calzado (or Puntos), where each punto corresponds to one centimeter. A shoe marked Punto 27 indicates that the shoe last fits an anatomical foot length of 27.0 centimeters.
        </p>

        <h3>Men's conversion: subtracting 1.5 from US sizing</h3>
        <p>
          For men, convert US shoe sizes to Mexico by subtracting approximately 1.5 sizes from your standard American shoe size:
        </p>
        <ul>
          <li>US 7 to Mexico equals MX 5.5 (approx. 25.0 cm foot length).</li>
          <li>US 8 to Mexico equals MX 6.5 (approx. 26.0 cm foot length).</li>
          <li>US 9 to Mexico equals MX 7.5 (approx. 27.0 cm foot length).</li>
          <li>US 9.5 to Mexico equals MX 8.0 (approx. 27.5 cm foot length).</li>
          <li>US 10 to Mexico equals MX 8.5 (approx. 28.0 cm foot length).</li>
          <li>US 10.5 to Mexico equals MX 9.0 (approx. 28.5 cm foot length).</li>
          <li>US 11 to Mexico equals MX 9.5 (approx. 29.0 cm foot length).</li>
        </ul>

        <h3>Women's conversion: subtracting 3.0 from US sizing</h3>
        <p>
          In women's footwear, American sizing begins further down the scale. To calculate Mexican sizes for women, subtract approximately 3.0 sizes from your US size:
        </p>
        <ul>
          <li>US 5 Women equals Mexico 2.0 (Punto 22.0 cm).</li>
          <li>US 6 Women equals Mexico 3.0 (Punto 23.0 cm).</li>
          <li>US 7 Women equals Mexico 4.0 (Punto 24.0 cm).</li>
          <li>US 8 Women equals Mexico 5.0 (Punto 25.0 cm).</li>
          <li>US 9 Women equals Mexico 6.0 (Punto 26.0 cm).</li>
          <li>US 10 Women equals Mexico 7.0 (Punto 27.0 cm).</li>
        </ul>

        <h3>The dropped digit convention: Talla 7 vs Punto 27</h3>
        <p>
          In daily commerce across Mexican shops, clerks often drop the leading digit 2:
        </p>
        <ul>
          <li>Punto 28 cm is referred to as Talla 8.</li>
          <li>Punto 27 cm is referred to as Talla 7.</li>
          <li>Punto 26.5 cm is referred to as Talla 6.5.</li>
        </ul>
        <p>
          Both labels refer to the same centimeter length.
        </p>

        <h3>Leather boots from León: Cuadra, Flexi, and western lasts</h3>
        <p>
          León, Guanajuato is Mexico's center of footwear manufacturing. Bootmakers including Cuadra, Los Altos, and Flexi build shoes over structured wooden lasts. Pointed western boots taper at the toe, so your toes sit further back in the shoe cavity. Buyers with wider feet often order a half-size larger than their measured Mexican size.
        </p>

        <h3>Measuring your foot length</h3>
        <p>
          For a complete guide to tracing your feet and measuring centimeters accurately, view our instructions on <a href="/shoe-size-by-foot-length/">how to measure shoe size by foot length</a>.
        </p>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Answers to questions about converting US shoe sizes to Mexican sizes.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0 ? true : undefined}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <RelatedLinks title="Related shoe size converters and regional guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resUs = document.getElementById('res-us');
    const resUsSub = document.getElementById('res-us-sub');
    const resMx = document.getElementById('res-mx');
    const resMxSub = document.getElementById('res-mx-sub');
    const resCm = document.getElementById('res-cm');
    const resIntl = document.getElementById('res-intl');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.us);
        opt.textContent = `${item.us} US ${gender === 'men' ? 'Men' : gender === 'women' ? 'Women' : ''}`;
        if (gender === 'men' && item.us === 9.5) opt.selected = true;
        if (gender === 'women' && item.us === 8.0) opt.selected = true;
        if (gender === 'kids' && item.us === '10C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      if (gender === 'women') list = WOMEN;
      if (gender === 'kids') list = KIDS;

      const match = list.find(item => String(item.us) === String(val));
      if (!match) return;

      if (resUs) resUs.textContent = String(match.us);
      if (resUsSub) resUsSub.textContent = gender === 'men' ? "US Men's Standard" : gender === 'women' ? "US Women's Standard" : "US Kids' Standard";
      if (resMx) resMx.textContent = String(match.mx);
      if (resMxSub) resMxSub.textContent = `Talla ${match.mx} / Punto ${match.cm}`;
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resIntl) resIntl.textContent = match.inch ? `${match.inch} inches · EU ${match.eu}` : `EU ${match.eu} · ${match.stage || 'Youth'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Hero */
  .page-hero {
    padding: 56px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .page-inner { max-width: 960px; margin: 0 auto; }
  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 14px;
    color: var(--v-ink);
  }
  .hero-sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--v-body);
    max-width: 700px;
    margin: 0 auto 20px;
  }
