                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">Mexico (MX)</span>
                <span class="conv-val" id="res-mx">8.0</span>
                <span class="conv-note" id="res-mx-sub">Talla 8 / Punto 27.5</span>
