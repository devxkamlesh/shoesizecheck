          <h3 class="table-heading">Women's US to Mexico Shoe Size Chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>US Women Size</th>
                  <th>Mexico (Talla)</th>
                  <th>Punto Calzado (CM)</th>
                  <th>Inches</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>MX {r.mx}</strong></td>
                    <td>{r.cm} cm</td>
                    <td>{r.inch}″</td>
                    <td>EU {r.eu}</td>
                    <td>UK {r.uk}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Panel -->
