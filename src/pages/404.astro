---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/404.html`;
const pageTitle = 'Page Not Found (404) — Shoe Size Converter';
const pageDescription = 'The shoe size page you are looking for does not exist or has been moved. Explore our conversion calculators, country size charts, and measurement guides.';

const popularLinks = [
  { name: 'US to EU Converter', href: '/us-to-eu-shoe-size/', desc: 'Convert American to European sizes' },
  { name: 'UK to US Converter', href: '/uk-to-us-shoe-size/', desc: 'Convert British to American sizes' },
  { name: 'EU to US Converter', href: '/eu-to-us-shoe-size/', desc: 'Convert Continental to US sizes' },
  { name: 'US to UK Converter', href: '/us-to-uk-shoe-size/', desc: 'Convert US to British shoe sizes' },
  { name: 'US to India Converter', href: '/us-to-india-shoe-size/', desc: 'Convert American to Indian sizes' },
  { name: 'India to US Converter', href: '/india-to-us-shoe-size/', desc: 'Convert Indian to American sizes' },
  { name: 'US to Japan Converter', href: '/us-to-japan-shoe-size/', desc: 'Convert US to Japanese (CM) sizes' },
  { name: 'Shoe Size in CM', href: '/shoe-size-in-cm/', desc: 'Find shoe size by foot length in cm' },
  { name: 'Kids Size by Age', href: '/kids-shoe-size-by-age/', desc: 'Toddler, little kid & youth sizing' },
  { name: 'What is My Shoe Size?', href: '/what-is-my-shoe-size/', desc: 'Interactive step-by-step sizing tool' },
  { name: 'All Converters Directory', href: '/converters/', desc: 'Explore all 16 conversion pairs' },
  { name: 'Country Sizing Hub', href: '/country/', desc: 'Global regional size charts' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  robots="noindex, nofollow"
>
  <Header />

  <main id="main-content">
    <section class="error-hero">
      <div class="page-inner error-inner">
        <div class="error-badge-row">
          <span class="error-code-badge">Error 404</span>
          <span class="error-category-badge">Page Not Found</span>
        </div>

        <h1 class="display-xl error-title">We Couldn't Find That Size Page</h1>
        <p class="hero-sub body-lg error-desc">
          The link you followed may be broken, the URL might contain a typo, or the converter has moved to a new address. Don't worry—all 16 of our shoe size conversion tools and regional charts are available below.
        </p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            Return to Homepage
          </a>
          <a href="/converters/" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="7" height="7" x="3" y="3" rx="1"/>
              <rect width="7" height="7" x="14" y="3" rx="1"/>
              <rect width="7" height="7" x="14" y="14" rx="1"/>
              <rect width="7" height="7" x="3" y="14" rx="1"/>
            </svg>
            Browse All 16 Converters
          </a>
        </div>
      </div>
    </section>

    <!-- Quick Navigation Hub -->
    <section class="error-directory-band">
      <div class="page-inner">
        <div class="section-header-row">
          <div>
            <h2 class="heading-lg">Popular Shoe Size Converters &amp; Charts</h2>
            <p class="section-sub">Find your conversion instantly from our most frequently used calculators:</p>
          </div>
        </div>

        <div class="error-grid">
          {popularLinks.map(item => (
            <a href={item.href} class="error-card card-interactive">
              <div class="card-icon-wrap" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="card-text">
                <span class="card-title">{item.name}</span>
                <span class="card-desc">{item.desc}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .error-hero {
    padding: var(--space-16, 4rem) 0 var(--space-12, 3rem);
    text-align: center;
    background: radial-gradient(circle at 50% 20%, var(--color-surface-hover, rgba(59, 130, 246, 0.05)) 0%, transparent 70%);
  }

  .error-inner {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-badge-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .error-code-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    font-family: var(--font-geist-mono, monospace);
    border-radius: 9999px;
    background: var(--color-primary-subtle, rgba(59, 130, 246, 0.15));
    color: var(--color-primary, #2563eb);
    border: 1px solid var(--color-primary-border, rgba(59, 130, 246, 0.3));
  }

  .error-category-badge {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary, #6b7280);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .error-title {
    margin-bottom: 1rem;
    color: var(--color-text-primary, #111827);
  }

  .error-desc {
    margin-bottom: 2rem;
    color: var(--color-text-secondary, #4b5563);
    max-width: 40rem;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .error-directory-band {
    padding: var(--space-12, 3rem) 0 var(--space-20, 5rem);
    border-top: 1px solid var(--color-border-subtle, rgba(0, 0, 0, 0.06));
  }

  .section-header-row {
    margin-bottom: 2rem;
    text-align: center;
  }

  .error-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .error-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .error-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .error-card {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1.25rem;
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
    border-radius: var(--radius-lg, 0.75rem);
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .error-card:hover {
    border-color: var(--color-primary, #2563eb);
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
  }

  .card-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: var(--color-surface-hover, rgba(59, 130, 246, 0.08));
    color: var(--color-primary, #2563eb);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .error-card:hover .card-icon-wrap {
    transform: translateX(3px);
  }

  .card-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary, #111827);
  }

  .card-desc {
    font-size: 0.8125rem;
    color: var(--color-text-secondary, #6b7280);
    line-height: 1.4;
  }
</style>
