              <span class="snap-detail">10.6 inches · EU 42 · UK 8.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 10 Men → 28.0 CM</span>
              <span class="snap-detail">11.0 inches · EU 43 · UK 9.5</span>
