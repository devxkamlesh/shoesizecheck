    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-left: 3px solid var(--v-link);
    border-radius: var(--v-r-md);
    padding: 12px 18px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--v-ink);
    max-width: 640px;
    margin: 0 auto 24px;
    text-align: left;
  }
  .quick-stat-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .stat-badge {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-full);
    padding: 6px 16px;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .badge-label { color: var(--v-mute); }
  .badge-val { font-weight: 700; color: var(--v-ink); font-family: var(--font-mono); }

  /* Converter Band */
  .converter-band {
    padding: 36px 24px 48px;
    background: var(--v-canvas);
  }
  .conv-card {
    background: var(--v-elevated);
    border: 1px solid var(--v-hairline);
    border-radius: var(--v-r-lg);
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }
  .conv-card-header {
    margin-bottom: 24px;
    text-align: center;
  }
  .conv-card-header .heading-md {
    font-size: 20px;
