---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Footer from '../components/Footer.astro';
import { MEN_SIZE_ROWS, WOMEN_SIZE_ROWS, KIDS_SIZE_ROWS } from '../data/shoe-sizes';

const domain = 'https://allshoesizeconverter.com';
const pageCanonical = `${domain}/us-to-cm-shoe-size/`;
const pageTitle = "US to CM shoe size converter: men, women, and kids chart";
const pageDescription = "Convert US shoe sizes to centimeters with our men's, women's, and kids' chart. Find exact footbed lengths in centimeters, inches, EU, and UK sizes.";
const ogImage = `${domain}/og-image.png`;

// Derive table datasets from centralized single source of truth
const menSizes = MEN_SIZE_ROWS.map(r => ({ us: r.us, cm: r.cm, inch: r.inch, jp: r.cm, eu: r.eu, uk: r.uk }));
const womenSizes = WOMEN_SIZE_ROWS.map(r => ({ us: r.us, cm: r.cm, inch: r.inch, jp: r.cm, eu: r.eu, uk: r.uk }));
const kidsSizes = KIDS_SIZE_ROWS.map(r => ({ us: r.us, cm: r.cm, inch: r.inch, eu: r.eu, uk: r.uk, stage: r.stage }));

const faqs = [
  {
    q: 'How many centimeters correspond to each US shoe size?',
    a: 'In American shoe sizing, each full size step equals one-third of an inch (8.46 millimeters or approximately 0.85 cm), while each half size equals 4.23 mm (approximately 0.42 cm). In men\'s sizing, US 8 equals 26.0 cm, US 8.5 is 26.5 cm, US 9 is 27.0 cm, US 9.5 is 27.5 cm, and US 10 is 28.0 cm. In women\'s sizing, US 6 is 23.0 cm, US 7 is 24.0 cm, and US 8 is 25.0 cm.'
  },
  {
    q: 'How do I convert my US shoe size to centimeters?',
    a: 'To convert your US shoe size to centimeters, reference our conversion chart or use our calculator above. For men, foot length in centimeters is approximately (US Size × 0.85) + 19.3. For women, foot length in centimeters is approximately (US Size × 0.85) + 18.2. Checking your foot length in centimeters or Japanese (JP) size on the tongue tag of your running shoes provides the most reliable result.'
  },
  {
    q: 'Why is measuring foot size in centimeters more consistent than US shoe sizes?',
    a: 'Centimeters provide a standardized physical metric that does not vary between regional definitions. While an American size 9 can fit differently between Nike, Adidas, and Clarks due to varying manufacturing lasts and widths, 27.0 cm represents the exact anatomical length of the footbed.'
  },
  {
    q: 'Are centimeter measurements on shoe labels foot length or inner shoe length?',
    a: 'On international athletic footwear from brands including Nike, Adidas, New Balance, and Asics, the CM/JP measurement printed on the box and tongue tag indicates the recommended bare foot length for that shoe, not the internal cavity length. Manufacturers include approximately 1.0 to 1.5 cm of toe clearance beyond the stated foot length.'
  },
  {
    q: 'How much toe room should I leave when choosing a shoe size in centimeters?',
    a: 'Allow approximately 1.0 to 1.5 centimeters (about a thumb width) of space between your longest toe and the front tip of the shoe. This space allows your foot to expand during walking and prevents toe impact when running or descending stairs.'
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": `<p>${f.a}</p>` }
  }))
});

const relatedLinks = [
  { label: 'All Converters Directory', href: '/converters/' },
  { label: 'Shoe Size in Centimeters Guide', href: '/shoe-size-in-cm/' },
  { label: 'Shoe Size in Inches Guide', href: '/shoe-size-in-inches/' },
  { label: 'Shoe Size by Foot Length', href: '/shoe-size-by-foot-length/' },
  { label: 'US to EU Shoe Size Converter', href: '/us-to-eu-shoe-size/' },
  { label: 'US to UK Shoe Size Converter', href: '/us-to-uk-shoe-size/' },
  { label: 'United States Sizing Guide', href: '/country/us/' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Converters', href: '/converters/' },
      { label: 'US to CM Shoe Size' },
    ]} />

    <!-- Hero Section -->
    <section class="page-hero">
      <div class="page-inner">
        <p class="mono-eyebrow">Metric Footwear Calibration</p>
        <h1 class="display-xl">US to CM shoe size converter</h1>
        <p class="hero-sub body-lg">
          Convert American (US) shoe sizes to foot length in centimeters (CM). Check exact metric measurements across men's, women's, and children's shoes with our calculator and conversion charts.
        </p>
        <p class="hero-answer"><strong>Direct answer:</strong> US men's 10 is 28.0 cm, US men's 10.5 is 28.5 cm, and US men's 9 is 27.0 cm. Women's CM values use a different scale, so select the correct category.</p>

        <div class="quick-stat-row">
          <div class="stat-badge">
            <span class="badge-label">Men's US 9.0:</span>
            <span class="badge-val">27.0 CM (10.6″)</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Women's US 8.0:</span>
            <span class="badge-val">25.0 CM (9.8″)</span>
          </div>
          <div class="stat-badge">
            <span class="badge-label">Step Rate:</span>
            <span class="badge-val">~0.85 CM Per Full Size</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert American (US) size to centimeters (CM)</h2>
            <p class="conv-card-sub">Select your category and US shoe size to determine your exact footbed length in centimeters, inches, and international sizes.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> American (US) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select American shoe size">
                <option value="" disabled>Select US size</option>
                {menSizes.map(s => <option value={String(s.us)} selected={s.us === 9.0 ? true : undefined}>{s.us} US Men</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">United States (US)</span>
                <span class="conv-val" id="res-us">9</span>
                <span class="conv-note" id="res-us-sub">Men's Standard</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">Centimeters (CM)</span>
                <span class="conv-val" id="res-cm">27.0 cm</span>
                <span class="conv-note" id="res-cm-sub">Japanese JP 27.0</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Equivalent Sizes</span>
                <span class="conv-val-sm" id="res-inch">10.6 inches</span>
                <span class="conv-note" id="res-intl">EU 42 · UK 8.5</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Common US to CM shoe size benchmarks</h2>
        <p class="section-sub">Reference values for adult shoe sizes converted to centimeters and inches.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 8 Men → 26.0 CM</span>
              <span class="snap-detail">10.2 inches · EU 41 · UK 7.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 9 Men → 27.0 CM</span>
              <span class="snap-detail">10.6 inches · EU 42 · UK 8.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 10 Men → 28.0 CM</span>
              <span class="snap-detail">11.0 inches · EU 43 · UK 9.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 11 Men → 29.0 CM</span>
              <span class="snap-detail">11.4 inches · EU 44.5 · UK 10.5</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 7 Women → 24.0 CM</span>
              <span class="snap-detail">9.4 inches · EU 37.5 · UK 5.0</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women Popular</span>
            <div class="snap-body">
              <span class="snap-main">US 8 Women → 25.0 CM</span>
              <span class="snap-detail">9.8 inches · EU 38.5 · UK 6.0</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Comprehensive Conversion Tables -->
    <section class="charts-band">
      <div class="page-inner">
        <h2 class="section-title">US to CM shoe size conversion charts</h2>
        <p class="section-sub">Conversion tables for men's, women's, and children's shoes with CM, inch, EU, and UK references.</p>

        <!-- Tabs -->
        <div class="table-tabs" role="tablist" aria-label="Footwear Category Tables">
          <button class="tab-btn active" role="tab" aria-selected="true" data-target="panel-men">Men's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-women">Women's Sizes</button>
          <button class="tab-btn" role="tab" aria-selected="false" data-target="panel-kids">Kids' Sizes</button>
        </div>

        <!-- Men's Panel -->
        <div id="panel-men" class="table-panel active" role="tabpanel">
          <h3 class="table-heading">Men's US shoe size to CM chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>US Men Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                  <th>Japan (JP)</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                </tr>
              </thead>
              <tbody>
                {menSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>{r.cm} cm</strong></td>
                    <td>{r.inch}″</td>
                    <td>{r.jp}</td>
                    <td>EU {r.eu}</td>
                    <td>UK {r.uk}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Women's Panel -->
        <div id="panel-women" class="table-panel" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Women's US shoe size to CM chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>US Women Size</th>
                  <th>Foot Length (CM)</th>
                  <th>Inches</th>
                  <th>Japan (JP)</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                </tr>
              </thead>
              <tbody>
                {womenSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>{r.cm} cm</strong></td>
                    <td>{r.inch}″</td>
                    <td>{r.jp}</td>
                    <td>EU {r.eu}</td>
                    <td>UK {r.uk}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Kids' Panel -->
        <div id="panel-kids" class="table-panel" role="tabpanel" style="display: none;">
          <h3 class="table-heading">Kids' US shoe size to CM chart</h3>
          <div class="table-wrapper">
            <table class="size-table">
              <thead>
                <tr>
                  <th>US Kids Size</th>
                  <th>Footbed (CM)</th>
                  <th>Inches</th>
                  <th>EU Size</th>
                  <th>UK Size</th>
                  <th>Stage</th>
                </tr>
              </thead>
              <tbody>
                {kidsSizes.map(r => (
                  <tr>
                    <td class="primary-cell"><strong>US {r.us}</strong></td>
                    <td class="highlight-cell"><strong>{r.cm} cm</strong></td>
                    <td>{r.inch}″</td>
                    <td>EU {r.eu}</td>
                    <td>UK {r.uk}</td>
                    <td>{r.stage}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- Editorial Guide -->
    <section class="editorial-band">
      <div class="page-inner prose-article">
        <h2 class="editorial-main-title">US to CM shoe sizing: metric conversion, math, and measurement</h2>

        <p class="lead-paragraph">
          When buying footwear online from global retailers or choosing athletic sneakers, numerical sizes can vary by country. Learning how to convert US shoe sizes to centimeters gives you a standardized metric that clarifies sizing across brands. Centimeters represent the physical length of your footbed, providing a consistent baseline across American, Japanese, and European footwear.
        </p>

        <h3>How many centimeters correspond to each US shoe size</h3>
        <p>
          Shoe sizing in the United States derives from the imperial barleycorn unit, where each full size step equals one-third of an inch (1/3″). For full historical details on this scale, consult our <a href="/shoe-size-in-inches/">guide to shoe sizes in inches</a>. In metric terms:
        </p>
        <ul>
          <li>One full size step equals 1/3 inch, or 0.846 cm (8.46 mm).</li>
          <li>One half size step equals 1/6 inch, or 0.423 cm (4.23 mm).</li>
        </ul>
        <p>
          Footbed length expands by roughly 0.85 centimeters per full size and approximately 0.42 centimeters per half size:
        </p>
        <ul>
          <li>Men's US 7 fits a 25.0 cm footbed.</li>
          <li>Men's US 8 fits a 26.0 cm footbed.</li>
          <li>Men's US 9 fits a 27.0 cm footbed.</li>
          <li>Men's US 10 fits a 28.0 cm footbed.</li>
          <li>Men's US 11 fits a 29.0 cm footbed.</li>
        </ul>

        <h3>Why centimeters provide a consistent reference</h3>
        <p>
          US sizes use separate scales for men and women. An American women's size 8 is engineered for a 25.0 cm footbed, whereas an American men's size 8 is engineered for a 26.0 cm footbed.
        </p>
        <p>
          Centimeter measurements rely on an absolute physical unit. A foot measuring 26.5 cm remains 26.5 cm worldwide. When you know your exact measurement in centimeters, you reduce sizing errors across different shoe makers.
        </p>

        <h3>Measuring your foot length in centimeters</h3>
        <p>
          For our complete step-by-step tracing tutorial and sizing formulas, read our guide on <a href="/shoe-size-by-foot-length/">how to measure shoe size by foot length</a>.
        </p>

        <h3>Adding toe clearance between insole length and foot length</h3>
        <p>
          On modern athletic footwear from brands like Nike, Adidas, New Balance, and Asics, the centimeter measurement on the tongue tag indicates the recommended bare foot length. Shoemakers add approximately 10 to 15 mm of clearance beyond that figure to accommodate foot movement during walking and running. If you measure a removable insole directly with a tape measure, the insole will measure 1.0 to 1.5 cm longer than the foot. Compare your measured foot length directly to the brand footbed recommendation.
        </p>

        <h3>Japanese sizing and Mondopoint equivalents</h3>
        <p>
          Japanese footwear sizing (JP) uses foot length in centimeters. A Japanese size marked JP 27.0 corresponds to a 27.0 cm footbed, equivalent to US Men's 9.0. Mondopoint, codified under ISO 9407:2019, measures foot length and foot width in millimeters. A marking of 270 denotes a 270 mm length. Checking the JP or Mondopoint metric on athletic shoes, ski boots, or international imports gives an exact translation.
        </p>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-band">
      <div class="page-inner">
        <h2 class="section-title">Frequently asked questions</h2>
        <p class="section-sub">Answers to common questions about US shoe size to centimeter conversions.</p>

        <div class="faq-accordion-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0 ? true : undefined}>
              <summary class="faq-question">
                <span>{f.q}</span>
                <span class="faq-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <RelatedLinks title="Related shoe size converters and regional guides" links={relatedLinks} />

  </main>

  <Footer />
</Layout>

<!-- Client-side Interactive Engine Script -->
<script is:inline define:vars={{ menSizes, womenSizes, kidsSizes }}>
  // @ts-nocheck
  (function() {
    const MEN = menSizes;
    const WOMEN = womenSizes;
    const KIDS = kidsSizes;

    const genderSelect = document.getElementById('conv-gender');
    const sizeSelect = document.getElementById('conv-size');
    const resUs = document.getElementById('res-us');
    const resUsSub = document.getElementById('res-us-sub');
    const resCm = document.getElementById('res-cm');
    const resCmSub = document.getElementById('res-cm-sub');
    const resInch = document.getElementById('res-inch');
    const resIntl = document.getElementById('res-intl');

    function populateSizes() {
      const gender = genderSelect?.value || 'men';
      let data = MEN;
      if (gender === 'women') data = WOMEN;
      if (gender === 'kids') data = KIDS;

      if (!sizeSelect) return;
      sizeSelect.innerHTML = '';

      data.forEach(item => {
        const opt = document.createElement('option');
        opt.value = String(item.us);
        opt.textContent = `${item.us} US ${gender === 'men' ? 'Men' : gender === 'women' ? 'Women' : ''}`;
        if (gender === 'men' && item.us === 9.0) opt.selected = true;
        if (gender === 'women' && item.us === 8.0) opt.selected = true;
        if (gender === 'kids' && item.us === '10C') opt.selected = true;
        sizeSelect.appendChild(opt);
      });

      updateConversion();
    }

    function updateConversion() {
      const gender = genderSelect?.value || 'men';
      const val = sizeSelect?.value;
      if (!val) return;

      let list = MEN;
      if (gender === 'women') list = WOMEN;
      if (gender === 'kids') list = KIDS;

      const match = list.find(item => String(item.us) === String(val));
      if (!match) return;

      if (resUs) resUs.textContent = String(match.us);
      if (resUsSub) resUsSub.textContent = gender === 'men' ? "US Men's Standard" : gender === 'women' ? "US Women's Standard" : "US Kids' Standard";
      if (resCm) resCm.textContent = `${match.cm} cm`;
      if (resCmSub) resCmSub.textContent = match.jp ? `Japanese JP ${match.jp}` : `Mondopoint ${Math.round(match.cm * 10)}`;
      if (resInch) resInch.textContent = `${match.inch} inches`;
      if (resIntl) resIntl.textContent = match.uk ? `EU ${match.eu} · UK ${match.uk}` : `EU ${match.eu} · ${match.stage || 'Youth'}`;
    }

    genderSelect?.addEventListener('change', populateSizes);
    sizeSelect?.addEventListener('change', updateConversion);

    // Tab Controller
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.table-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          if (p.id === target) {
            p.style.display = 'block';
            p.classList.add('active');
          } else {
            p.style.display = 'none';
            p.classList.remove('active');
          }
        });
      });
    });
  })();
</script>

<style>
  /* Hero */
  .page-hero {
    padding: 56px 24px 36px;
    background: var(--v-canvas);
    border-bottom: 1px solid var(--v-hairline);
    text-align: center;
    background: radial-gradient(circle at 50% 0%, var(--v-mesh-1) 0%, transparent 70%);
  }
  .page-inner { max-width: 960px; margin: 0 auto; }
  .mono-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--v-link);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .display-xl {
    font-size: clamp(28px, 4.5vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 14px;
    color: var(--v-ink);
  }
  .hero-sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--v-body);
    max-width: 700px;
