        <p class="section-sub">Cross-comparison tables showing exact equivalent shoe sizes uk europe, footbed lengths in centimeters, and American sizes.</p>

        <div class="table-tabs" role="tablist">
          <button class="tab-btn active" data-target="tab-men" role="tab" aria-selected="true">Men's EU to UK Chart</button>
          <button class="tab-btn" data-target="tab-women" role="tab" aria-selected="false">Women's EU to UK Chart</button>
          <button class="tab-btn" data-target="tab-kids" role="tab" aria-selected="false">Kids' EU to UK Chart</button>
        </div>

        <!-- Men's Table -->
