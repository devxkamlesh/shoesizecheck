// Kids' table data (EU, UK, CM, US, Stage)
const kidsSizes = [
  { eu: 19.0, uk: '3.5C', cm: 11.5, us: '4C', stage: 'Toddler' },
  { eu: 22.0, uk: '5.5C', cm: 13.0, us: '6C', stage: 'Toddler' },
