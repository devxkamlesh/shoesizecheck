  { eu: 40.0, uk: 6.5, cm: 25.5, us: 8.5, inch: 10.0 },
  { eu: 40.5, uk: 7.0, cm: 26.0, us: 9.0, inch: 10.2 },
  { eu: 41.0, uk: 7.5, cm: 26.5, us: 9.5, inch: 10.4 },
  { eu: 42.0, uk: 8.0, cm: 27.0, us: 10.0, inch: 10.6 },
