---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageCanonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta name="keywords" content="eu to uk shoe size, uk size to eu shoes, eu size to uk, european shoe size to uk, european sizes to uk, uk foot size to eu, uk to eu shoe size, eu shoe size to uk, convert shoe size eu to uk, uk size 8 in eu, uk size 10 in eu, equivalent shoe sizes uk europe, convert euro shoe size to uk, euro foot size to uk, shoe size chart uk eu, eu foot size to uk" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <Header />

  <main id="main-content">
    <!-- Breadcrumbs -->
    <div class="page-inner pt-4">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Converters', href: '/converters/' },
        { label: 'EU to UK', href: '/eu-to-uk-shoe-size/' }
      ]} />
    </div>

    <!-- Hero Section -->
    <section class="hero-band">
      <div class="page-inner hero-content">
        <span class="badge-pill">Continental to British Converter</span>
        <h1 class="hero-title">EU to UK Shoe Size Converter</h1>
        <p class="hero-sub">Convert European (EU) shoe sizes to British (UK) sizes accurately. Compare comprehensive men's, women's, and children's charts with size 8, size 10 benchmarks, Paris Point to barleycorn rules, and centimeter lengths.</p>
        
        <div class="hero-stats">
          <div class="stat-pill">
            <span class="stat-label">European Standard</span>
            <span class="stat-val">Paris Point (6.67 mm)</span>
          </div>
          <div class="stat-pill">
            <span class="stat-label">British Standard</span>
            <span class="stat-val">1/3 Inch (8.46 mm)</span>
          </div>
          <div class="stat-pill">
            <span class="stat-label">General Formula</span>
            <span class="stat-val">UK ≈ EU − 33 to 34</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Calculator -->
    <section class="converter-band">
      <div class="page-inner">
        <div class="card-elevated conv-card">
          <div class="conv-card-header">
            <h2 class="heading-md">Convert EU to UK Shoe Size</h2>
            <p class="conv-card-sub">Select your gender and European (EU) footwear size to compute your exact British (UK) size, footbed length in centimeters, and US equivalent.</p>
          </div>

          <div class="conv-row">
            <div class="conv-field">
              <label class="step-label" for="conv-gender">
                <span class="step-num">1</span> Category
              </label>
              <select id="conv-gender" class="form-select" aria-label="Select category">
                <option value="men" selected>Men's Sizes</option>
                <option value="women">Women's Sizes</option>
                <option value="kids">Kids' Sizes</option>
              </select>
            </div>

            <div class="conv-field">
              <label class="step-label" for="conv-size">
                <span class="step-num">2</span> European (EU) Size
              </label>
              <select id="conv-size" class="form-select" aria-label="Select EU shoe size">
                <option value="" disabled>Select EU size</option>
                {menSizes.map(s => <option value={String(s.eu)} selected={s.eu === 42.0 ? true : undefined}>{s.eu.toFixed(1)} EU</option>)}
              </select>
            </div>
          </div>

          <!-- Dynamic Output Card -->
          <div class="conv-result-box" id="conv-result" aria-live="polite">
            <div class="conv-result-card">
              <div class="conv-col">
                <span class="conv-sys">European Union (EU)</span>
                <span class="conv-val" id="res-eu">42.0</span>
                <span class="conv-note" id="res-eu-sub">Paris Point Standard</span>
              </div>
              <div class="conv-arrow-wrap" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
              <div class="conv-col conv-target">
                <span class="conv-sys">United Kingdom (UK)</span>
                <span class="conv-val" id="res-uk">8.0</span>
                <span class="conv-note" id="res-uk-sub">Men's Standard</span>
              </div>
              <div class="conv-col conv-aux">
                <span class="conv-sys">Foot Length & US</span>
                <span class="conv-val-sm" id="res-aux">27.0 cm · US 9.0</span>
                <span class="conv-note" id="res-inch">10.6 inches</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmark Cards -->
    <section class="snapshot-band">
      <div class="page-inner">
        <h2 class="section-title">Popular European to UK Size Benchmarks</h2>
        <p class="section-sub">Quick reference for the most commonly searched European and British footwear sizes.</p>

        <div class="snapshot-grid">
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 42 → UK 8.0</span>
              <span class="snap-detail">Foot length: 27.0 cm · US Men 9.0 · uk size 8 in eu · 10.6 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 44.5 / 45 → UK 10.0</span>
              <span class="snap-detail">Foot length: 29.0 cm · US Men 11.0 · uk size 10 in eu · 11.4 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 38 → UK 5.0</span>
              <span class="snap-detail">Foot length: 24.0 cm · US Women 7.0 · 9.4 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Women's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 39 → UK 6.0</span>
              <span class="snap-detail">Foot length: 25.0 cm · US Women 8.0 · 9.8 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 40.5 / 41 → UK 7.0</span>
              <span class="snap-detail">Foot length: 26.0 cm · US Men 8.0 · 10.2 inches</span>
            </div>
          </div>
          <div class="snap-card">
            <span class="snap-tag">Men's Benchmark</span>
            <div class="snap-body">
              <span class="snap-main">EU 43 → UK 9.0</span>
              <span class="snap-detail">Foot length: 28.0 cm · US Men 10.0 · 11.0 inches</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Charts Section -->
    <section class="charts-band">
