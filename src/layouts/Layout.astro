---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
}

const {
  title = 'Shoe Size Converter: US, UK, EU and India Size Chart',
  description = 'Free shoe size converter for men, women, and kids. Convert US, UK, EU, India, Japan, and CM sizes instantly with accurate charts and size guides.',
  canonical = 'https://allshoesizeconverter.com',
  ogImage = 'https://allshoesizeconverter.com/og-image.png',
  robots = 'index, follow',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Google AdSense -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9040114877467261" crossorigin="anonymous"></script>

    <!-- Preconnect / DNS-prefetch for Google Analytics -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!-- Google tag (gtag.js) - Non-blocking idle/interaction loader for mobile performance -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EEM0XTBELZ');

      function initGtag() {
        if (window.__gtagLoaded) return;
        window.__gtagLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-EEM0XTBELZ';
        document.head.appendChild(s);
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() { setTimeout(initGtag, 1000); }, { timeout: 3000 });
      } else {
        window.addEventListener('load', function() { setTimeout(initGtag, 1000); });
      }
      ['touchstart', 'scroll', 'mousemove', 'keydown'].forEach(function(ev) {
        window.addEventListener(ev, initGtag, { once: true, passive: true });
      });
    </script>

    <!-- Microsoft Clarity tracking code for https://allshoesizeconverter.com/ -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "ymrx0shlnq");
    </script>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Shoe Size" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kamlesh Choudhary (devxkamlesh)" />
    <meta property="article:modified_time" content="2026-09-23" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="AllShoeSizeConverter" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Self-hosted Geist Fonts via Astro Fonts API -->
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />


    <!-- Theme Script (prevent flash of light/dark mode) -->
    <script is:inline>
      (function() {
        const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        }
      })();
    </script>

    <!-- Per-page head slot -->
    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Dynamic Hero Scroll & Interactive Converter Walkthrough Tour -->
    <script is:inline>
      (function() {
        function setupConverterTour() {
          const converterBand = document.querySelector('.converter-band, #converter, .converter-section');
          if (!converterBand) return;

          // 1. Ensure converter has an ID for smooth anchor jump
          if (!converterBand.id) {
            converterBand.id = 'converter-tool';
          }

          // 2. Add hero scroll down button if not already present
          const heroInner = document.querySelector('.page-hero .page-inner, .hero-band .hero-content');
          if (heroInner && !heroInner.querySelector('.hero-scroll-wrap')) {
            const scrollWrap = document.createElement('div');
            scrollWrap.className = 'hero-scroll-wrap';
            scrollWrap.innerHTML = [
              '<a href="#' + converterBand.id + '" class="hero-scroll-btn" aria-label="Scroll to conversion tool">',
              '  <span>Scroll to Converter</span>',
              '  <svg class="hero-scroll-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">',
              '    <path d="M12 5v14M19 12l-7 7-7-7"/>',
              '  </svg>',
              '</a>'
            ].join('');

            const scrollLink = scrollWrap.querySelector('a');
            scrollLink?.addEventListener('click', function(e) {
              e.preventDefault();
              converterBand.scrollIntoView({ behavior: 'smooth' });
            });

            const tags = heroInner.querySelector('.hero-badges, .quick-stat-row, .hero-stats');
            if (tags && tags.nextSibling) {
              heroInner.insertBefore(scrollWrap, tags.nextSibling);
            } else {
              heroInner.appendChild(scrollWrap);
            }
          }

          // 3. Add simple tour trigger button before tool card if not present
          const toolCard = converterBand.querySelector('.converter-inline, .conv-card, .card-elevated, .converter-card');
          if (!toolCard || converterBand.querySelector('.tour-simple-trigger-bar')) return;

          const triggerBar = document.createElement('div');
          triggerBar.className = 'tour-simple-trigger-bar';
          triggerBar.innerHTML = [
            '<button type="button" class="tour-simple-trigger-btn" id="start-converter-tour-btn">',
            '  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">',
            '    <circle cx="12" cy="12" r="10"></circle>',
            '    <line x1="12" y1="16" x2="12" y2="12"></line>',
            '    <line x1="12" y1="8" x2="12.01" y2="8"></line>',
            '  </svg>',
            '  <span>How to use this converter</span>',
            '</button>'
          ].join('');

          toolCard.parentNode?.insertBefore(triggerBar, toolCard);

          // 4. Create backdrop and popup elements if not already in document
          let backdrop = document.querySelector('.converter-tour-backdrop');
          if (!backdrop) {
            backdrop = document.createElement('div');
            backdrop.className = 'converter-tour-backdrop';
            document.body.appendChild(backdrop);
          }

          let popup = document.querySelector('.converter-tour-popup');
          if (!popup) {
            popup = document.createElement('div');
            popup.className = 'converter-tour-popup';
            popup.id = 'converter-tour-popup';
            popup.setAttribute('role', 'dialog');
            popup.setAttribute('aria-modal', 'true');
            popup.innerHTML = [
              '<div class="tour-popup-arrow tour-arrow-up" id="tour-popup-arrow"></div>',
              '<div class="tour-popup-header">',
              '  <span class="tour-popup-step-tag" id="tour-popup-step-badge">Step 1 of 3</span>',
              '  <button type="button" class="tour-popup-close-btn" id="tour-popup-close-btn" aria-label="Close walkthrough">',
              '    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">',
              '      <line x1="18" y1="6" x2="6" y2="18"></line>',
              '      <line x1="6" y1="6" x2="18" y2="18"></line>',
              '    </svg>',
              '  </button>',
              '</div>',
              '<div class="tour-popup-body">',
              '  <h4 class="tour-popup-title" id="tour-popup-title">Select your shoe size</h4>',
              '  <p class="tour-popup-desc" id="tour-popup-desc">Pick your known footwear size from this dropdown menu.</p>',
              '</div>',
              '<div class="tour-popup-footer">',
              '  <button type="button" class="tour-skip-btn" id="tour-popup-skip-btn">Skip</button>',
              '  <div class="tour-action-group">',
              '    <button type="button" class="tour-prev-btn" id="tour-popup-prev-btn" style="display:none;">Previous</button>',
              '    <button type="button" class="tour-next-btn" id="tour-popup-next-btn">Next Step</button>',
              '  </div>',
              '</div>'
            ].join('');
            document.body.appendChild(popup);
          }

          // Walkthrough Tour State & Controller
          let tourActive = false;
          let currentStep = 1;
          const totalSteps = 3;
          let activeElement = null;

          const arrow = popup.querySelector('#tour-popup-arrow');
          const stepBadge = popup.querySelector('#tour-popup-step-badge');
          const titleEl = popup.querySelector('#tour-popup-title');
          const descEl = popup.querySelector('#tour-popup-desc');
          const closeBtn = popup.querySelector('#tour-popup-close-btn');
          const skipBtn = popup.querySelector('#tour-popup-skip-btn');
          const prevBtn = popup.querySelector('#tour-popup-prev-btn');
          const nextBtn = popup.querySelector('#tour-popup-next-btn');

          function getStepTarget(step) {
            if (step === 1) {
              const sizeSelect = converterBand.querySelector('select[id*="size"], select#from-size, select#conv-size');
              if (sizeSelect && sizeSelect.closest('.ci-field, .conv-field, .converter-field')) {
                return sizeSelect.closest('.ci-field, .conv-field, .converter-field');
              }
              return sizeSelect || converterBand.querySelector('.ci-field, .conv-field') || toolCard;
            } else if (step === 2) {
              const genderSelect = converterBand.querySelector('.converter-tabs, select[id*="gender"], .table-tabs, [role="tablist"]');
              if (genderSelect && genderSelect.closest('.ci-field, .conv-field, .converter-field')) {
                return genderSelect.closest('.ci-field, .conv-field, .converter-field');
              }
              return genderSelect || converterBand.querySelector('.ci-field:nth-child(2), .conv-field:nth-child(1)') || toolCard;
            } else {
              return converterBand.querySelector('.converter-results, #converter-results, .ci-results, #conv-result, .conv-result-box, #output-card, .results-grid') || toolCard;
            }
          }

          function getStepData(step) {
            if (step === 1) {
              return {
                title: 'Select your shoe size',
                desc: 'Click this dropdown to select your current footwear size.'
              };
            } else if (step === 2) {
              return {
                title: 'Choose category or gender',
                desc: 'Pick Men, Women, or Kids to calibrate the sizing chart.'
              };
            } else {
              return {
                title: 'Review conversion results',
                desc: 'Your converted shoe sizes and exact foot measurements appear here in real time.'
              };
            }
          }

          function positionPopup() {
            if (!tourActive || !activeElement) return;

            popup.style.display = 'block';
            popup.classList.add('visible');

            const targetRect = activeElement.getBoundingClientRect();
            const popupRect = popup.getBoundingClientRect();
            const viewportWidth = window.innerWidth || document.documentElement.clientWidth;
            const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

            const spaceBelow = viewportHeight - targetRect.bottom;
            const spaceAbove = targetRect.top;
            const placeBelow = spaceBelow >= (popupRect.height + 16) || spaceBelow >= spaceAbove;

            let top = placeBelow ? (targetRect.bottom + 12) : (targetRect.top - popupRect.height - 12);
            top = Math.max(10, Math.min(top, viewportHeight - popupRect.height - 10));

            popup.style.top = Math.round(top) + 'px';

            const targetCenter = targetRect.left + (targetRect.width / 2);

            if (viewportWidth <= 640) {
              popup.style.left = '14px';
              popup.style.right = '14px';
              popup.style.width = 'auto';

              if (arrow) {
                const arrowLeft = Math.max(16, Math.min(targetCenter - 14 - 8, popupRect.width - 32));
                arrow.style.left = Math.round(arrowLeft) + 'px';
                arrow.className = placeBelow ? 'tour-popup-arrow tour-arrow-up' : 'tour-popup-arrow tour-arrow-down';
              }
            } else {
              popup.style.right = 'auto';
              popup.style.width = '320px';
              let left = targetCenter - (popupRect.width / 2);
              if (left + popupRect.width > viewportWidth - 16) {
                left = viewportWidth - popupRect.width - 16;
              }
              if (left < 16) {
                left = 16;
              }
              popup.style.left = Math.round(left) + 'px';

              if (arrow) {
                const arrowLeft = Math.max(16, Math.min(targetCenter - left - 8, popupRect.width - 32));
                arrow.style.left = Math.round(arrowLeft) + 'px';
                arrow.className = placeBelow ? 'tour-popup-arrow tour-arrow-up' : 'tour-popup-arrow tour-arrow-down';
              }
            }
          }

          function showStep(step) {
            currentStep = step;
            const data = getStepData(currentStep);

            if (stepBadge) stepBadge.textContent = 'Step ' + currentStep + ' of ' + totalSteps;
            if (titleEl) titleEl.textContent = data.title;
            if (descEl) descEl.textContent = data.desc;

            if (prevBtn) prevBtn.style.display = currentStep > 1 ? 'inline-flex' : 'none';
            if (nextBtn) nextBtn.textContent = currentStep === totalSteps ? 'Finish' : 'Next Step';

            if (activeElement) {
              activeElement.classList.remove('tour-highlighted-element');
            }

            activeElement = getStepTarget(currentStep);
            if (activeElement) {
              activeElement.classList.add('tour-highlighted-element');

              const rect = activeElement.getBoundingClientRect();
              const inView = rect.top >= 60 && rect.bottom <= (window.innerHeight - 180);
              if (!inView) {
                activeElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
            }

            positionPopup();
            setTimeout(positionPopup, 60);
            setTimeout(positionPopup, 200);
            setTimeout(positionPopup, 380);
          }

          function startTour() {
            tourActive = true;
            backdrop.classList.add('active');
            showStep(1);
            window.addEventListener('resize', positionPopup, { passive: true });
            window.addEventListener('scroll', positionPopup, { passive: true });
          }

          function endTour() {
            tourActive = false;
            backdrop.classList.remove('active');
            popup.classList.remove('visible');
            popup.style.display = 'none';

            if (activeElement) {
              activeElement.classList.remove('tour-highlighted-element');
              activeElement = null;
            }

            window.removeEventListener('resize', positionPopup);
            window.removeEventListener('scroll', positionPopup);
          }

          const startBtn = triggerBar.querySelector('#start-converter-tour-btn');
          startBtn?.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            startTour();
          });
          closeBtn?.addEventListener('click', endTour);
          skipBtn?.addEventListener('click', endTour);
          backdrop.addEventListener('click', endTour);

          nextBtn?.addEventListener('click', function() {
            if (currentStep < totalSteps) {
              showStep(currentStep + 1);
            } else {
              endTour();
            }
          });

          prevBtn?.addEventListener('click', function() {
            if (currentStep > 1) {
              showStep(currentStep - 1);
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setupConverterTour);
        } else {
          setupConverterTour();
        }
      })();
    </script>
  </body>
</html>
